# Toolchain fetched by scripts/analyze -- binaries and generated type
# definitions, both reproducible from the versions pinned in the script.
.tooling/

# Place and model files. The models scripts/build.js writes into dist/ are
# built by CI and attached to each release rather than committed: a commit
# that changed the source and forgot to rebuild them shipped the old code.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
dist/
sourcemap.json

# The docs site's dependencies and build output.
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Wally.
Packages/
ServerPackages/
DevPackages/
wally.lock
