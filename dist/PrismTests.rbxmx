<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties>
			<string name="Name">PrismTests</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">Prism</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Requires are written out per branch rather than built from an interpolated
-- path. Require by string needs a literal, and routing every module through a
-- helper erased the types, so Prism.Properties used to resolve to any.
--
-- Properties also used to be server only here even though Properties/Client
-- existed and was fully written, which left the client with a nil field.

const RunService = game:GetService("RunService")
const IS_SERVER = RunService:IsServer()

const Prism = {}

if IS_SERVER then
    Prism.Properties = require("@self/Properties/Server")
    Prism.Objects = require("@self/Objects/Server")

    -- Before anything that creates an object: registering it is what puts the
    -- default scene in place, and an object cannot be built without one.
    Prism.Scenes = require("@self/Scenes/Server")
    Prism.Permissions = require("@self/Permissions/Server")

    -- After both: it applies through Objects, resolves scene copies through
    -- Scenes, and checks every operation against Permissions.
    Prism.Transactions = require("@self/Transactions/Server")

    -- After Transactions, which it records, and required whether or not a game
    -- ever calls it: a destroy is deferred on the way out and this is what
    -- takes hold of what was destroyed. Nothing claiming it is exactly how a
    -- destroy stays immediate -- but that decision has to be made by something
    -- that is there to make it.
    Prism.History = require("@self/History/Server")
    Prism.Database = require("@self/Database/Server")

    -- Required for the side effect: it wires up the join replay.
    require("@self/Replication")
else
    Prism.Properties = require("@self/Properties/Client")
    Prism.Objects = require("@self/Objects/Client")
    Prism.Scenes = require("@self/Scenes/Client")
    Prism.Permissions = require("@self/Permissions/Client")
    Prism.Transactions = require("@self/Transactions/Client")

    -- Client only, and not as a policy: it reads Objects/Client directly, so
    -- requiring it on the server would pull the client half of the object
    -- pipeline into a server process.
    Prism.Selection = require("@self/Selection")

    -- Client only, and only half the history: it keeps the steps of scenes this
    -- client owns and the order the two halves make together, and asks the
    -- server for the rest.
    Prism.History = require("@self/History/Client")
end

Prism.CustomEnum = require("@self/CustomEnum")
Prism.World = require("@self/World")
Prism.Compressor = require("@self/Compressor")
Prism.Networking = require("@self/Networking")
Prism.Handles = require("@self/Handles")
Prism.Encoding = require("@self/Encoding")
Prism.Varint = require("@self/Varint")
Prism.Codecs = require("@self/Codecs")
Prism.IdPool = require("@self/IdPool")
Prism.Logger = require("@self/Logger")
Prism.Try = require("@self/Try")

-- Announce only once every client module above has connected its handlers, then
-- keep asking until the server answers. The server's Replication module can
-- finish loading after this client does, and an unanswered announcement would
-- otherwise leave the client with an empty registry for the whole session.
--
-- Retried on a separate thread so requiring Prism never blocks on it.
if not IS_SERVER then
    const Ready = Prism.Networking:Get("Prism.Ready")

    task.spawn(function()
        const Acknowledged = Prism.Try(10, function()
            return Ready:Invoke()
        end)

        if not Acknowledged then
            Prism.Logger:Warn("Server never acknowledged readiness; is Prism required on the server?")
        end
    end)
end

return Prism
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX2">
				<Properties>
					<string name="Name">Channels</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Static channel manifest.
--
-- A channel's id is its index in this list, so the id must be identical on the
-- server and the client. Deriving ids from require order would be fragile, so
-- they live here instead. Append new channels at the end, never reorder, and
-- never reuse the slot of a removed channel during a live rollout.
--
-- Args/Returns are Codec lists. Anything not listed here cannot be sent.

const Codecs = require("./Codecs")

export type Channel = {
    Name: string,
    Args: {Codecs.Codec<any>},
    Returns: {Codecs.Codec<any>}?,
}

const Channels: {Channel} = {
    {
        Name = "Properties.PropertyRegistered",
        Args = {Codecs.Any}, -- PropertyRegistry: nested constraints, fires once per registration
    },

    {
        Name = "Objects.ObjectRegistered",
        Args = {Codecs.Any}, -- ObjectRegistry: same, fires once per registration
    },

    {
        Name = "Objects.ObjectAdded",
        -- RuntimeId, the scene instance holding it, Compressor:CompressObject,
        -- and the replicated instance if the object has one so the client can
        -- map a clicked part back to an object. The object's persistent id
        -- rides inside the buffer, so grouping by scene costs nothing here.
        Args = {Codecs.u32, Codecs.u32, Codecs.Buffer, Codecs.Optional(Codecs.Instance)},
    },

    {
        Name = "Objects.ObjectRemoved",
        Args = {Codecs.u32}, -- RuntimeId
    },

    {
        Name = "Objects.PropertyChanged",
        Args = {Codecs.u32, Codecs.u16, Codecs.Buffer}, -- RuntimeId, PropertyId, CompressValue
    },

    {
        -- A runtime id rather than a persistent one, and not only for the byte:
        -- a persistent id can name more than one live object once a scene has
        -- been instanced twice, and client input is the last place that should
        -- be ambiguous.
        Name = "Objects.SetProperty",
        Args = {Codecs.u32, Codecs.u16, Codecs.Buffer}, -- RuntimeId, PropertyId, CompressValue
        Returns = {Codecs.Bool},
    },

    {
        Name = "Objects.Destroy",
        Args = {Codecs.u32}, -- RuntimeId
        Returns = {Codecs.Bool},
    },

    {
        Name = "Permissions.Assigned",
        Args = {Codecs.Any}, -- the caller's own permission, so the editor UI can reflect it
    },

    {
        -- Client to server, once, after it has required Prism and connected its
        -- handlers. The server replays current state only then: firing at
        -- PlayerAdded raced the client's own module load, and a large registry
        -- could overflow the unhandled-event queue and lose entries outright.
        -- An invoke rather than an event so the client can tell whether anyone
        -- was listening. A fired event with no handler registered yet is
        -- dropped silently, and the server's Replication module can easily
        -- finish loading after a client has already announced itself.
        Name = "Prism.Ready",
        Args = {},
        Returns = {Codecs.Bool},
    },

    {
        -- Bulk replay of the property registry to a joining client. The replay
        -- used to fire once per registry and once per live object, so a join
        -- cost hundreds of packets in a single frame and blocked the server
        -- thread that was building them.
        Name = "Properties.RegistriesReplayed",
        Args = {Codecs.Array(Codecs.Any)},
    },

    {
        Name = "Objects.RegistriesReplayed",
        Args = {Codecs.Array(Codecs.Any)},
    },

    {
        -- Parallel arrays rather than one array of records: Codecs.Array needs
        -- a codec per element, and the three parts each have their own. The
        -- instance list carries false where an object has no instance, because
        -- a nil entry would leave a hole and shift every later index.
        Name = "Objects.ObjectsReplayed",
        Args = {
            Codecs.Array(Codecs.u32),
            Codecs.Array(Codecs.u32),
            Codecs.Array(Codecs.Buffer),
            Codecs.Array(Codecs.Any),
        },
    },

    {
        -- Scene registries replicate like property and object ones, and have to
        -- land before any object does: an object names the live copy holding
        -- it, and one arriving for a copy the client has not been told about
        -- cannot work out its own persistent identity.
        Name = "Scenes.SceneRegistered",
        Args = {Codecs.Any},
    },

    {
        Name = "Scenes.RegistriesReplayed",
        Args = {Codecs.Array(Codecs.Any)},
    },

    {
        -- A scene instance appearing. Objects name their instance rather than
        -- their scene, because a scene can be live more than once and an editor
        -- has to be able to tell the copies apart.
        Name = "Scenes.InstanceAdded",
        -- InstanceId, SceneId, and whether the server opened the copy rather
        -- than loading it. Without that a client cannot tell "the server built
        -- no part" from "the reference to the part did not survive the trip",
        -- and on a slow join it would draw a second part for every object.
        Args = {Codecs.u32, Codecs.Varint, Codecs.Bool},
    },

    {
        -- One packet for a whole instance going away. Unloading is a mass
        -- destroy, and an ObjectRemoved per object is precisely the flood the
        -- chunked join replay exists to avoid -- a five thousand object scene
        -- would cost five thousand packets in a frame.
        --
        -- Appearing has no such packet because it already has one: the objects
        -- go out through ObjectsReplayed, the same chunked path a joining
        -- player receives, only fired at everyone.
        Name = "Scenes.InstanceRemoved",
        Args = {Codecs.u32}, -- InstanceId
    },

    {
        Name = "Scenes.InstancesReplayed",
        Args = {Codecs.Array(Codecs.u32), Codecs.Array(Codecs.Varint), Codecs.Array(Codecs.Bool)},
    },

    {
        -- A scene ceasing to exist. Its copies have already gone one packet
        -- each, but the registry entry would otherwise sit on every client for
        -- the rest of the session, and a scene list is exactly the sort of
        -- thing an editor renders straight from that registry.
        Name = "Scenes.SceneUnregistered",
        Args = {Codecs.Varint}, -- SceneId
    },
    {
        -- A whole edit as one packet: create, set and destroy operations
        -- validated and applied together or not at all. The operation list is
        -- one buffer rather than a set of parallel arrays because the shapes
        -- differ per kind -- a create carries a variable number of values --
        -- and Codecs.Array needs one codec for every element it holds.
        --
        -- Returns whether the whole list applied, and the runtime ids of the
        -- objects it created, in the order the creates were declared. A client
        -- cannot name what it is about to create -- the server mints the id --
        -- so this is the only way it learns what it made.
        -- The bool is the transaction's Untracked: true keeps it out of this
        -- player's history. It rides here because the history that would record
        -- it is the server's, so a client asking to be left out has to say so
        -- where the recording happens.
        Name = "Transactions.Apply",
        Args = {Codecs.Buffer, Codecs.Bool}, -- Compressor:CompressTransaction, Untracked
        Returns = {Codecs.Bool, Codecs.Array(Codecs.u32)},
    },

    {
        -- The bulk form of PropertyChanged. A transaction that moves two
        -- hundred objects is one packet up; sending its result back as two
        -- hundred is the flood every other batched path here exists to avoid.
        Name = "Objects.PropertiesChanged",
        Args = {Codecs.Array(Codecs.u32), Codecs.Array(Codecs.u16), Codecs.Array(Codecs.Buffer)},
    },

    {
        -- The bulk form of ObjectRemoved, for the same reason. Unloading a
        -- whole copy still goes through Scenes.InstanceRemoved, which is one
        -- packet naming the copy rather than a list naming its objects.
        Name = "Objects.ObjectsRemoved",
        Args = {Codecs.Array(Codecs.u32)}, -- RuntimeIds
    },

    {
        -- A client handing over a scene it built locally: a name to register it
        -- under and the pack itself, which is the same format a server side
        -- scene is saved as. One packet for a whole document, and the reason it
        -- is not a transaction full of creates: a transaction spends one action
        -- per operation because each one touches the world as it stands, while
        -- this arrives whole and its cost is known from its size before a byte
        -- of it is read.
        --
        -- Answers with the id the server registered it under, or zero if it
        -- refused. The scene is registered, never loaded: putting a room in the
        -- world is the server's call, and the client asked for a document to be
        -- stored rather than spawned.
        Name = "Scenes.Commit",
        Args = {Codecs.String, Codecs.Buffer}, -- Name, Compressor:CompressScene
        Returns = {Codecs.Bool, Codecs.Varint}, -- accepted, SceneId
    },

    {
        -- One player's rights over one scene, sent to that player when they
        -- change and at the join replay. Nil rights mean they hold nothing on
        -- it any more. Permissions.Assigned carries their global rights.
        Name = "Permissions.SceneAssigned",
        Args = {Codecs.Varint, Codecs.Any}, -- SceneId, SceneRightsPayload?
    },

    {
        -- Registries going away. Scenes announced theirs from the start;
        -- properties used to drop theirs on the server and tell nobody, so
        -- every client kept serving the old one for the rest of the session.
        Name = "Properties.PropertyUnregistered",
        Args = {Codecs.u16}, -- PropertyId
    },

    {
        Name = "Objects.ObjectUnregistered",
        Args = {Codecs.u16}, -- ObjectIdentifier
    },

    {
        -- A client asking to hold objects, all of them or none. Answers
        -- whether it got them. Two clients dragging one object used to fight,
        -- and the loser's screen jumped when its edits were rolled back.
        Name = "Objects.Lock",
        Args = {Codecs.Array(Codecs.u32)}, -- RuntimeIds
        Returns = {Codecs.Bool},
    },

    {
        -- Releasing what it holds. Answers false if any named object is held
        -- by someone else, which stays theirs.
        Name = "Objects.Unlock",
        Args = {Codecs.Array(Codecs.u32)}, -- RuntimeIds
        Returns = {Codecs.Bool},
    },

    {
        -- Who holds which object now, to the players a scene admits.
        --
        -- Three lists rather than two because a holder need not be a player:
        -- the server can hold an object while it animates one, and a tool can
        -- hold one on nobody's behalf. Held says whether there is a hold at
        -- all, and the user id names who has it -- zero where the holder is not
        -- a player and there is no id to give. Ids are signed because Studio's
        -- test players are negative.
        Name = "Objects.LocksChanged",
        Args = {Codecs.Array(Codecs.u32), Codecs.Array(Codecs.SignedVarint), Codecs.Array(Codecs.Bool)},
    },

    {
        -- Taking back a step the server holds for this player. The id is the
        -- step the client believes is on top, not just "undo": the two sides
        -- keep separate halves of one order -- server scenes here, scenes the
        -- client owns there -- and naming the step is what makes a disagreement
        -- about which is on top answerable rather than silently wrong.
        Name = "History.Undo",
        Args = {Codecs.Varint}, -- StepId
        Returns = {Codecs.Bool},
    },

    {
        Name = "History.Redo",
        Args = {Codecs.Varint}, -- StepId
        Returns = {Codecs.Bool},
    },

    {
        -- This player's two stacks, oldest first, whenever either changes. The
        -- client holds no copy of what a server step does -- only where it sits
        -- in the order -- so this is what it reconciles its half against, and
        -- what tells it a step has been dropped past the limit.
        Name = "History.Changed",
        Args = {Codecs.Array(Codecs.Varint), Codecs.Array(Codecs.Varint)}, -- Undo, Redo
    },

    {
        -- Forget this player's steps: the redo stack alone, or both. Both is
        -- History:Clear. The redo stack alone is what a new action does, and it
        -- has to cross the wire because an action in a scene the client owns
        -- forks a history the server is holding half of -- one order means one
        -- fork, whichever side the new action happened on.
        --
        -- Either way it is where deferred destroys end: a step nobody can reach
        -- is a step whose objects nothing is keeping.
        --
        -- Invoked rather than fired, though nothing waits on the answer. Every
        -- edit a player makes reaches the server through the remote function,
        -- and Roblox orders nothing between that and the remote event: a set
        -- made just after History:Clear used to be recorded and then wiped by
        -- a Forget that arrived behind it. On the same remote, the two land in
        -- the order they were made.
        Name = "History.Forget",
        Args = {Codecs.Bool}, -- RedoOnly
        Returns = {Codecs.Bool},
    },
}

const ById: {Channel} = Channels
const ByName: {[string]: number} = {}

for Id, Channel in Channels do
    if ByName[Channel.Name] then
        error(`[ PRISM ] Duplicate channel name in manifest: {Channel.Name}`)
    end

    ByName[Channel.Name] = Id
end

if #Channels > 255 then
    error("[ PRISM ] Channel manifest exceeds 255 entries; widen the channel id from u8.")
end

return {
    List = ById,
    Ids = ByName,
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">Codecs</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Binary codecs for the networking layer.
-- A codec measures, writes and reads a single value. Values that cannot live in a
-- buffer (Instances, arbitrary tables) are pushed into a side channel array and
-- referenced by index, so a packet is always one buffer plus an optional table.

const Varint = require("./Varint")
const Logger = require("./Logger")

export type Codec<T> = {
    Measure: (Value: T) -> number,
    Write: (Buf: buffer, Offset: number, Value: T, Extras: {any}) -> number,
    Read: (Buf: buffer, Offset: number, Extras: {any}) -> (T, number),
}

const Codecs = {}

const function Fixed<T>(Size: number, Writer: (buffer, number, T) -> (), Reader: (buffer, number) -> T): Codec<T>
    return {
        Measure = function(): number
            return Size
        end,

        Write = function(Buf: buffer, Offset: number, Value: T): number
            Writer(Buf, Offset, Value)
            return Size
        end,

        Read = function(Buf: buffer, Offset: number): (T, number)
            return Reader(Buf, Offset), Size
        end,
    }
end

Codecs.u8 = Fixed(1, buffer.writeu8, buffer.readu8)
Codecs.u16 = Fixed(2, buffer.writeu16, buffer.readu16)
Codecs.u32 = Fixed(4, buffer.writeu32, buffer.readu32)
Codecs.i8 = Fixed(1, buffer.writei8, buffer.readi8)
Codecs.i16 = Fixed(2, buffer.writei16, buffer.readi16)
Codecs.i32 = Fixed(4, buffer.writei32, buffer.readi32)
Codecs.f32 = Fixed(4, buffer.writef32, buffer.readf32)
Codecs.f64 = Fixed(8, buffer.writef64, buffer.readf64)

-- Same LEB128 the storage format uses, so ids and counts cost one byte on the
-- wire below 128 instead of a flat u16 or u32.
Codecs.Varint = {
    Measure = function(Value: number): number
        return Varint.Measure(Value)
    end,

    Write = function(Buf: buffer, Offset: number, Value: number): number
        return Varint.Write(Buf, Offset, Value)
    end,

    Read = function(Buf: buffer, Offset: number): (number, number)
        return Varint.Read(Buf, Offset)
    end,
} :: Codec<number>

Codecs.SignedVarint = {
    Measure = function(Value: number): number
        return Varint.MeasureSigned(Value)
    end,

    Write = function(Buf: buffer, Offset: number, Value: number): number
        return Varint.WriteSigned(Buf, Offset, Value)
    end,

    Read = function(Buf: buffer, Offset: number): (number, number)
        return Varint.ReadSigned(Buf, Offset)
    end,
} :: Codec<number>

Codecs.Bool = {
    Measure = function(): number
        return 1
    end,

    Write = function(Buf: buffer, Offset: number, Value: boolean): number
        buffer.writeu8(Buf, Offset, Value and 1 or 0)
        return 1
    end,

    Read = function(Buf: buffer, Offset: number): (boolean, number)
        return buffer.readu8(Buf, Offset) == 1, 1
    end,
} :: Codec<boolean>

-- Up to 65535 bytes. Use LongString past that.
Codecs.String = {
    Measure = function(Value: string): number
        return 2 + #Value
    end,

    Write = function(Buf: buffer, Offset: number, Value: string): number
        -- The length field is a u16, so anything longer wraps and decodes as a
        -- different string rather than failing.
        if #Value > 65535 then
            Logger:Error(`String codec takes at most 65535 bytes, got {#Value}. Use LongString.`)
        end

        buffer.writeu16(Buf, Offset, #Value)
        buffer.writestring(Buf, Offset + 2, Value)
        return 2 + #Value
    end,

    Read = function(Buf: buffer, Offset: number): (string, number)
        const Length = buffer.readu16(Buf, Offset)
        return buffer.readstring(Buf, Offset + 2, Length), 2 + Length
    end,
} :: Codec<string>

Codecs.LongString = {
    Measure = function(Value: string): number
        return 4 + #Value
    end,

    Write = function(Buf: buffer, Offset: number, Value: string): number
        buffer.writeu32(Buf, Offset, #Value)
        buffer.writestring(Buf, Offset + 4, Value)
        return 4 + #Value
    end,

    Read = function(Buf: buffer, Offset: number): (string, number)
        const Length = buffer.readu32(Buf, Offset)
        return buffer.readstring(Buf, Offset + 4, Length), 4 + Length
    end,
} :: Codec<string>

Codecs.Buffer = {
    Measure = function(Value: buffer): number
        return 4 + buffer.len(Value)
    end,

    Write = function(Buf: buffer, Offset: number, Value: buffer): number
        const Length = buffer.len(Value)
        buffer.writeu32(Buf, Offset, Length)
        buffer.copy(Buf, Offset + 4, Value, 0)
        return 4 + Length
    end,

    Read = function(Buf: buffer, Offset: number): (buffer, number)
        const Length = buffer.readu32(Buf, Offset)

        -- The length comes straight off the wire, so a client can declare four
        -- gigabytes and have the server try to allocate it before anything else
        -- runs. Bound it by what the packet actually carries first.
        if Length > buffer.len(Buf) - Offset - 4 then
            Logger:Error(`Buffer codec length {Length} overruns the packet.`)
        end

        const Slice = buffer.create(Length)
        buffer.copy(Slice, 0, Buf, Offset + 4, Length)
        return Slice, 4 + Length
    end,
} :: Codec<buffer>

Codecs.Vector = {
    Measure = function(): number
        return 12
    end,

    Write = function(Buf: buffer, Offset: number, Value: Vector3): number
        buffer.writef32(Buf, Offset, Value.X)
        buffer.writef32(Buf, Offset + 4, Value.Y)
        buffer.writef32(Buf, Offset + 8, Value.Z)
        return 12
    end,

    Read = function(Buf: buffer, Offset: number): (Vector3, number)
        return Vector3.new(
            buffer.readf32(Buf, Offset),
            buffer.readf32(Buf, Offset + 4),
            buffer.readf32(Buf, Offset + 8)
        ), 12
    end,
} :: Codec<Vector3>

Codecs.Color = {
    Measure = function(): number
        return 3
    end,

    Write = function(Buf: buffer, Offset: number, Value: Color3): number
        buffer.writeu8(Buf, Offset, math.floor(Value.R * 255))
        buffer.writeu8(Buf, Offset + 1, math.floor(Value.G * 255))
        buffer.writeu8(Buf, Offset + 2, math.floor(Value.B * 255))
        return 3
    end,

    Read = function(Buf: buffer, Offset: number): (Color3, number)
        return Color3.fromRGB(
            buffer.readu8(Buf, Offset),
            buffer.readu8(Buf, Offset + 1),
            buffer.readu8(Buf, Offset + 2)
        ), 3
    end,
} :: Codec<Color3>

Codecs.CFrame = {
    Measure = function(): number
        return 48
    end,

    Write = function(Buf: buffer, Offset: number, Value: CFrame): number
        const Components = {Value:GetComponents()}
        for Index, Component in Components do
            buffer.writef32(Buf, Offset + (Index - 1) * 4, Component)
        end

        return 48
    end,

    Read = function(Buf: buffer, Offset: number): (CFrame, number)
        const Components = table.create(12)
        for Index = 1, 12 do
            Components[Index] = buffer.readf32(Buf, Offset + (Index - 1) * 4)
        end

        return CFrame.new(table.unpack(Components, 1, 12)), 48
    end,
} :: Codec<CFrame>

-- Side channel: the value rides alongside the buffer as a normal remote argument.
-- Two bytes on the wire, and Roblox handles the serialization.
Codecs.Any = {
    Measure = function(): number
        return 2
    end,

    Write = function(Buf: buffer, Offset: number, Value: any, Extras: {any}): number
        -- Index 0 means nil. table.insert would not grow the array for a nil
        -- value, so every later index would shift and decode as the wrong one.
        if Value == nil then
            buffer.writeu16(Buf, Offset, 0)
            return 2
        end

        table.insert(Extras, Value)
        buffer.writeu16(Buf, Offset, #Extras)
        return 2
    end,

    Read = function(Buf: buffer, Offset: number, Extras: {any}): (any, number)
        const Index = buffer.readu16(Buf, Offset)
        if Index == 0 then
            return nil, 2
        end

        return Extras[Index], 2
    end,
} :: Codec<any>

Codecs.Instance = Codecs.Any :: Codec<Instance>
Codecs.Player = Codecs.Any :: Codec<Player>

function Codecs.Optional<T>(Inner: Codec<T>): Codec<T?>
    return {
        Measure = function(Value: T?): number
            return if Value == nil then 1 else 1 + Inner.Measure(Value :: T)
        end,

        Write = function(Buf: buffer, Offset: number, Value: T?, Extras: {any}): number
            if Value == nil then
                buffer.writeu8(Buf, Offset, 0)
                return 1
            end

            buffer.writeu8(Buf, Offset, 1)
            return 1 + Inner.Write(Buf, Offset + 1, Value :: T, Extras)
        end,

        Read = function(Buf: buffer, Offset: number, Extras: {any}): (T?, number)
            if buffer.readu8(Buf, Offset) == 0 then
                return nil, 1
            end

            const Value, Length = Inner.Read(Buf, Offset + 1, Extras)
            return Value, 1 + Length
        end,
    }
end

function Codecs.Array<T>(Inner: Codec<T>): Codec<{T}>
    return {
        Measure = function(Value: {T}): number
            local Size = 2
            for _, Item in Value do
                Size += Inner.Measure(Item)
            end

            return Size
        end,

        Write = function(Buf: buffer, Offset: number, Value: {T}, Extras: {any}): number
            if #Value > 65535 then
                Logger:Error(`Array codec takes at most 65535 entries, got {#Value}.`)
            end

            buffer.writeu16(Buf, Offset, #Value)

            local Cursor = Offset + 2
            for _, Item in Value do
                Cursor += Inner.Write(Buf, Cursor, Item, Extras)
            end

            return Cursor - Offset
        end,

        Read = function(Buf: buffer, Offset: number, Extras: {any}): ({T}, number)
            const Count = buffer.readu16(Buf, Offset)
            const Out = table.create(Count)

            local Cursor = Offset + 2
            for Index = 1, Count do
                const Value, Length = Inner.Read(Buf, Cursor, Extras)
                Out[Index] = Value
                Cursor += Length
            end

            return Out, Cursor - Offset
        end,
    }
end

return Codecs
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Compressor</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Binary serialization for objects and database metadata.
--
-- The governing rule: a buffer is decodable with zero reference to the registry.
-- The registry decides how a decoded value is validated and applied, never how
-- the bytes are read. A developer can change a constraint, change a type, or
-- unregister a property entirely, and existing data still decodes byte exactly.
--
-- Every value carries a one byte tag:
--
--   wwwttttt   w = wire shape (how to read it), t = semantic type (what it means)
--
-- The wire shape is what makes the format survive change. A reader that has
-- never heard of semantic type 19 still knows type 19 is length prefixed, so it
-- skips it precisely and keeps reading. Without that, one unknown property makes
-- the rest of the record unreadable -- and since decoding runs inside DataStore
-- UpdateAsync transforms, an unreadable record used to brick the key.
--
-- Numbers pick their encoding from the value, not from the schema. A whole
-- number becomes a varint, a fractional one that survives f32 becomes four
-- bytes, anything else becomes eight. That is why changing AllowDecimals cannot
-- corrupt anything: the bytes describe themselves. It also ends the old bug
-- where every number went through f32, whose 24 bit mantissa silently mangles
-- any integer past 16,777,216 -- user ids and unix timestamps included.

const RunService = game:GetService("RunService")

const Properties = if RunService:IsClient()
    then require("./Properties/Client")
    else require("./Properties/Server")

const PropertyTypes = require("./Properties/Types")
const Handles = require("./Handles")
const DatabaseTypes = require("./Database/Types")
const ObjectTypes = require("./Objects/Types")
const TransactionTypes = require("./Transactions/Types")
const CustomEnum = require("./CustomEnum")
const Varint = require("./Varint")
const Logger = require("./Logger")

export type DecompressedObject = {
    __type: "DecompressedObject",

    -- The object's id within its scene, not the whole persistent id: the scene
    -- half is stamped on at load, which is what lets the same pack be loaded
    -- under two different scenes without the two colliding.
    LocalId: Handles.LocalId,

    Registry: ObjectTypes.ObjectIdentifier,
    Properties: {[PropertyTypes.PropertyIdentifier]: any},

    -- Property records this build could not place -- an id nobody registered,
    -- or a semantic type it has never heard of -- kept as their tagged bytes so
    -- writing the object back puts them back exactly as they were read. The
    -- wire shape exists so a reader can step over what it does not know and
    -- keep the rest; dropping the record anyway at the next save undid that.
    Unknown: {[PropertyTypes.PropertyIdentifier]: buffer}?,

    -- The bytes this record was read from, whole. A scene keeps them for an
    -- object whose type is not registered, and writes them back untouched.
    Source: buffer?,
}

const OBJECT_HEADER = "/oh"
const METADATA_HEADER = "/mh"
const PACK_HEADER = "/ph"

-- A packet rather than a record, and the only header here that never reaches
-- storage. See the Transactions section.
const TRANSACTION_HEADER = "/th"

-- Bump when the layout changes. Readers refuse anything newer than they know
-- rather than misreading it.
const FORMAT_VERSION = 1

--=============================================================================
-- Wire shapes
--=============================================================================

const WIRE_VARINT = 0
const WIRE_FIXED3 = 1
const WIRE_FIXED4 = 2
const WIRE_FIXED8 = 3
const WIRE_FIXED12 = 4
const WIRE_FIXED48 = 5
const WIRE_BYTES = 6

const FIXED_SIZES = {
    [WIRE_FIXED3] = 3,
    [WIRE_FIXED4] = 4,
    [WIRE_FIXED8] = 8,
    [WIRE_FIXED12] = 12,
    [WIRE_FIXED48] = 48,
}

const Compressor = {}

-- Reused for the f32 round trip test, so choosing a number encoding allocates
-- nothing.
const Probe = buffer.create(8)

const function MakeTag(Wire: number, Type: number): number
    return Wire * 32 + Type
end

const function SplitTag(Tag: number): (number, number)
    return Tag // 32, Tag % 32
end

-- Advances past a value knowing only its wire shape. This is what lets an old
-- reader skip a semantic type added after it shipped.
const function SkipValue(Buf: buffer, Offset: number, Wire: number): number
    if Wire == WIRE_VARINT then
        const _, Read = Varint.Read(Buf, Offset)
        return Read
    elseif Wire == WIRE_BYTES then
        const Length, Read = Varint.Read(Buf, Offset)
        return Read + Length
    end

    const Size = FIXED_SIZES[Wire]
    if not Size then
        Logger:Error(`Unknown wire shape {Wire} at offset {Offset}.`)
    end

    return Size
end

const function NumberWire(Value: number): number
    if Value % 1 == 0 and math.abs(Value) <= Varint.MAX_SIGNED then
        return WIRE_VARINT
    end

    buffer.writef32(Probe, 0, Value)
    if buffer.readf32(Probe, 0) == Value then
        return WIRE_FIXED4
    end

    return WIRE_FIXED8
end

-- Length prefixed payload used by Text, Enum and CustomEnum. Enum and
-- CustomEnum pack a name and a number inside; keeping that behind one length
-- means their internal layout can change without breaking skippability.
const function BytesBuffer(Inner: buffer): buffer
    const Length = buffer.len(Inner)
    const Prefix = Varint.Measure(Length)
    const Out = buffer.create(Prefix + Length)
    Varint.Write(Out, 0, Length)
    buffer.copy(Out, Prefix, Inner, 0)
    return Out
end

const function NamedNumber(Name: string, Value: number): buffer
    const NameLength = Varint.Measure(#Name)
    const ValueLength = Varint.Measure(Value)
    const Inner = buffer.create(NameLength + #Name + ValueLength)

    Varint.Write(Inner, 0, #Name)
    buffer.writestring(Inner, NameLength, Name)
    Varint.Write(Inner, NameLength + #Name, Value)
    return BytesBuffer(Inner)
end

const function ReadNamedNumber(Buf: buffer, Offset: number): (string, number)
    const NameLength, NameRead = Varint.Read(Buf, Offset)
    const Name = buffer.readstring(Buf, Offset + NameRead, NameLength)
    const Value = Varint.Read(Buf, Offset + NameRead + NameLength)
    return Name, Value
end

--=============================================================================
-- Values
--=============================================================================

-- Returns a self contained buffer: tag byte followed by the encoded value. The
-- receiver needs nothing else to read it back, which is why network payloads can
-- use this directly.
function Compressor:CompressValue(Type: PropertyTypes.PropertyType, Value: any?): buffer?
    if Value == nil then
        return nil
    end

    const TypeId = PropertyTypes:GetTypeId(Type)
    if not TypeId then
        Logger:Error(`Tried compressing unsupported value type: {Type}`)
    end

    local Wire: number
    local Payload: buffer

    if Type == "Text" then
        const Text = Value :: string
        const Inner = buffer.create(#Text)
        buffer.writestring(Inner, 0, Text)
        Wire, Payload = WIRE_BYTES, BytesBuffer(Inner)
    elseif Type == "Number" then
        const Number = Value :: number
        Wire = NumberWire(Number)

        if Wire == WIRE_VARINT then
            const Size = Varint.MeasureSigned(Number)
            Payload = buffer.create(Size)
            Varint.WriteSigned(Payload, 0, Number)
        elseif Wire == WIRE_FIXED4 then
            Payload = buffer.create(4)
            buffer.writef32(Payload, 0, Number)
        else
            Payload = buffer.create(8)
            buffer.writef64(Payload, 0, Number)
        end
    elseif Type == "Bool" then
        Wire = WIRE_VARINT
        Payload = buffer.create(1)
        buffer.writeu8(Payload, 0, Value and 1 or 0)
    elseif Type == "Color" then
        Wire = WIRE_FIXED3
        Payload = buffer.create(3)
        buffer.writeu8(Payload, 0, math.floor(Value.R * 255))
        buffer.writeu8(Payload, 1, math.floor(Value.G * 255))
        buffer.writeu8(Payload, 2, math.floor(Value.B * 255))
    elseif Type == "Vector" then
        Wire = WIRE_FIXED12
        Payload = buffer.create(12)
        buffer.writef32(Payload, 0, Value.X)
        buffer.writef32(Payload, 4, Value.Y)
        buffer.writef32(Payload, 8, Value.Z)
    elseif Type == "CFrame" then
        Wire = WIRE_FIXED48
        Payload = buffer.create(48)
        for Index, Component in {(Value :: CFrame):GetComponents()} do
            buffer.writef32(Payload, (Index - 1) * 4, Component)
        end
    elseif Type == "Enum" then
        Wire = WIRE_BYTES
        Payload = NamedNumber(tostring(Value.EnumType), Value.Value)
    elseif Type == "CustomEnum" then
        Wire = WIRE_BYTES
        Payload = NamedNumber(Value.Parent, Value.Id)
    elseif Type == "Object" then
        -- The target's local id and nothing else. Unsigned, because a local id
        -- is, and a varint so the ids a hand built scene actually uses cost one
        -- byte. Nothing is resolved on the way in or out: a pack is read with
        -- no world to resolve against, and a reference means whatever the copy
        -- reading it says it means -- which is exactly what lets two copies of
        -- one room each point at their own door.
        Wire = WIRE_VARINT
        const Target = Value :: number
        const Size = Varint.Measure(Target)
        Payload = buffer.create(Size)
        Varint.Write(Payload, 0, Target)
    else
        Logger:Error(`Tried compressing unsupported value type: {Type}`)
    end

    const Length = buffer.len(Payload)
    const Out = buffer.create(1 + Length)
    buffer.writeu8(Out, 0, MakeTag(Wire, TypeId))
    buffer.copy(Out, 1, Payload, 0)
    return Out
end

-- Reads the tag itself, so the caller does not have to know what it is reading.
-- Returns the value, how many bytes it consumed, and the semantic type the
-- writer recorded, which the caller can compare against what it expected.
function Compressor:DecompressValue(Buf: buffer, Offset: number?): (any?, number, PropertyTypes.PropertyType?)
    const At = Offset or 0
    const Wire, TypeId = SplitTag(buffer.readu8(Buf, At))
    const Type = PropertyTypes:GetTypeFromId(TypeId)

    if not Type then
        -- Unknown semantic type: the wire shape still says how far to move, so
        -- the rest of the record stays readable.
        return nil, 1 + SkipValue(Buf, At + 1, Wire), nil
    end

    const Body = At + 1

    if Type == "Text" then
        const Length, Read = Varint.Read(Buf, Body)
        return buffer.readstring(Buf, Body + Read, Length), 1 + Read + Length, Type
    elseif Type == "Number" then
        if Wire == WIRE_VARINT then
            const Value, Read = Varint.ReadSigned(Buf, Body)
            return Value, 1 + Read, Type
        elseif Wire == WIRE_FIXED4 then
            return buffer.readf32(Buf, Body), 5, Type
        elseif Wire == WIRE_FIXED8 then
            return buffer.readf64(Buf, Body), 9, Type
        end

        return nil, 1 + SkipValue(Buf, Body, Wire), Type
    elseif Type == "Bool" then
        const Value, Read = Varint.Read(Buf, Body)
        return Value == 1, 1 + Read, Type
    elseif Type == "Color" then
        return Color3.fromRGB(
            buffer.readu8(Buf, Body),
            buffer.readu8(Buf, Body + 1),
            buffer.readu8(Buf, Body + 2)
        ), 4, Type
    elseif Type == "Vector" then
        return Vector3.new(
            buffer.readf32(Buf, Body),
            buffer.readf32(Buf, Body + 4),
            buffer.readf32(Buf, Body + 8)
        ), 13, Type
    elseif Type == "CFrame" then
        const Components = table.create(12)
        for Index = 1, 12 do
            Components[Index] = buffer.readf32(Buf, Body + (Index - 1) * 4)
        end

        return CFrame.new(table.unpack(Components, 1, 12)), 49, Type
    elseif Type == "Enum" then
        const Length, Read = Varint.Read(Buf, Body)
        const Consumed = 1 + Read + Length
        const Name, Value = ReadNamedNumber(Buf, Body + Read)

        -- A saved enum can outlive the Roblox enum it names.
        const Found = (Enum :: any)[Name]
        if not Found then
            Logger:Warn(`Unknown enum {Name} while decompressing. Value dropped.`)
            return nil, Consumed, Type
        end

        const Ok, Item = pcall(function()
            return Found:FromValue(Value)
        end)

        if not Ok or not Item then
            Logger:Warn(`Unknown value {Value} for enum {Name}. Value dropped.`)
            return nil, Consumed, Type
        end

        return Item, Consumed, Type
    elseif Type == "CustomEnum" then
        const Length, Read = Varint.Read(Buf, Body)
        const Consumed = 1 + Read + Length
        const Name, Id = ReadNamedNumber(Buf, Body + Read)

        const Registered = CustomEnum:GetEnum(Name)
        if not Registered then
            return CustomEnum.UNKNOWN, Consumed, Type
        end

        return Registered:GetById(Id) or CustomEnum.UNKNOWN, Consumed, Type
    elseif Type == "Object" then
        const Value, Read = Varint.Read(Buf, Body)
        return Value, 1 + Read, Type
    end

    return nil, 1 + SkipValue(Buf, Body, Wire), Type
end

--=============================================================================
-- Properties
--=============================================================================

-- [varint property id][tag][value]
const function WriteProperty(
    Buffers: {buffer},
    Id: PropertyTypes.PropertyIdentifier,
    Type: PropertyTypes.PropertyType,
    Value: any?
): number
    const Tagged = Compressor:CompressValue(Type, Value)
    if not Tagged then
        return 0
    end

    const IdSize = Varint.Measure(Id)
    const Header = buffer.create(IdSize)
    Varint.Write(Header, 0, Id)

    table.insert(Buffers, Header)
    table.insert(Buffers, Tagged)
    return IdSize + buffer.len(Tagged)
end

-- The tagged value exactly as it sits in the buffer, for a record this build
-- cannot place but must not lose.
const function Slice(Buf: buffer, Offset: number, Length: number): buffer
    const Copy = buffer.create(Length)
    buffer.copy(Copy, 0, Buf, Offset, Length)
    return Copy
end

-- The fourth return is set instead of the value when the record is one this
-- build cannot place: the raw tagged bytes, for the caller to keep under the id.
-- A registered property whose type changed since the save is still dropped --
-- that is the registry deliberately saying something new about the property,
-- and the object carries the property under its new type either way.
const function ReadProperty(Buf: buffer, Offset: number): (PropertyTypes.PropertyIdentifier?, any?, number, buffer?)
    const PropertyId, IdRead = Varint.Read(Buf, Offset)
    const Value, ValueRead, Type = Compressor:DecompressValue(Buf, Offset + IdRead)
    const Consumed = IdRead + ValueRead

    const Registry = Properties:GetRegistry(PropertyId)
    if not Registry then
        Logger:Warn(`Property id {PropertyId} is not registered. Kept as saved, and written back unchanged.`)
        return PropertyId, nil, Consumed, Slice(Buf, Offset + IdRead, ValueRead)
    end

    if not Type then
        Logger:Warn(`Property {PropertyId} was saved with a type this build does not know. Kept as saved, and written back unchanged.`)
        return PropertyId, nil, Consumed, Slice(Buf, Offset + IdRead, ValueRead)
    end

    -- The registry changed type since the save. The bytes were still read
    -- correctly, so the record continues; only this value is dropped.
    if Registry.Type ~= Type then
        Logger:Warn(`Property {PropertyId} was saved as {Type} but is registered as {Registry.Type}. Skipping.`)
        return nil, nil, Consumed
    end

    return PropertyId, Value, Consumed
end

const function Concat(Header: string, Prefix: buffer, Buffers: {buffer}, Size: number): buffer
    const Compressed = buffer.create(#Header + buffer.len(Prefix) + Size)
    buffer.writestring(Compressed, 0, Header)
    buffer.copy(Compressed, #Header, Prefix, 0)

    local Offset = #Header + buffer.len(Prefix)
    for _, Part in Buffers do
        buffer.copy(Compressed, Offset, Part, 0)
        Offset += buffer.len(Part)
    end

    return Compressed
end

const function CheckVersion(Version: number, What: string)
    if Version > FORMAT_VERSION then
        Logger:Error(`{What} was written in format version {Version}; this build reads up to {FORMAT_VERSION}.`)
    end
end

--=============================================================================
-- Objects
--=============================================================================

-- [/oh][varint version][varint registry id][varint local id][varint count][properties...]
--
-- The local id is the object's identity within its scene and is what makes a
-- saved reference outlive the save. The scene half is not written -- the scene
-- knows which one it is, and leaving it out is what keeps a pack portable. The
-- runtime id is not written either, and never is: it names a live copy, and a
-- pack describes the thing rather than any copy of it.
--
-- WithUnknown writes the records the object is keeping without understanding
-- them (see DecompressedObject.Unknown). A save wants them; replication does
-- not -- a client has no more use for them than the server did.
function Compressor:CompressObject(Obj: ObjectTypes.Object | DecompressedObject, WithUnknown: boolean?): buffer
    local Size = 0
    local Count = 0
    const Buffers = {}
    const IsDecompressed = (Obj :: any).__type == "DecompressedObject"
    const Unknown: {[number]: buffer}? = if WithUnknown then (Obj :: any).Unknown else nil

    -- Walked in id order rather than hash order, so the same object always
    -- produces the same bytes. Hash order meant two identical objects serialized
    -- differently, which rules out hashing, diffing or deduplicating saves.
    const Keys = {}
    for Key in (Obj :: any).Properties do
        table.insert(Keys, Key)
    end

    -- A value the object carries wins over one it is keeping for the same id:
    -- the property has come back since, and what it holds now is the answer.
    if Unknown then
        for Key in Unknown do
            if (Obj :: any).Properties[Key] == nil then
                table.insert(Keys, Key)
            end
        end
    end

    table.sort(Keys)

    for _, Key in Keys do
        const Entry = (Obj :: any).Properties[Key]

        if Entry == nil and Unknown then
            const Raw = Unknown[Key]
            const IdSize = Varint.Measure(Key)
            const Header = buffer.create(IdSize)
            Varint.Write(Header, 0, Key)

            table.insert(Buffers, Header)
            table.insert(Buffers, Raw)
            Size += IdSize + buffer.len(Raw)
            Count += 1
            continue
        end

        local Id, Type, Value

        if IsDecompressed then
            const Registry = Properties:GetRegistry(Key)
            if not Registry then
                Logger:Warn(`Tried compressing an object with unregistered property id {Key}. Skipping.`)
                continue
            end

            Id, Type, Value = Key, Registry.Type, Entry
        else
            Id, Type, Value = Entry.Parent, Entry.Type, Entry.Value
        end

        const Written = WriteProperty(Buffers, Id, Type, Value)
        if Written > 0 then
            Size += Written
            Count += 1
        end
    end

    const LocalId = if IsDecompressed
        then (Obj :: DecompressedObject).LocalId
        else (Obj :: ObjectTypes.Object).LocalId

    const PrefixSize = Varint.Measure(FORMAT_VERSION)
        + Varint.Measure(Obj.Registry)
        + Varint.Measure(LocalId)
        + Varint.Measure(Count)

    const Prefix = buffer.create(PrefixSize)

    local At = Varint.Write(Prefix, 0, FORMAT_VERSION)
    At += Varint.Write(Prefix, At, Obj.Registry)
    At += Varint.Write(Prefix, At, LocalId)
    Varint.Write(Prefix, At, Count)

    return Concat(OBJECT_HEADER, Prefix, Buffers, Size)
end

function Compressor:DecompressObject(CompressedObj: buffer): DecompressedObject
    if buffer.readstring(CompressedObj, 0, #OBJECT_HEADER) ~= OBJECT_HEADER then
        Logger:Error("Tried to decompress invalid object buffer.")
    end

    local Offset = #OBJECT_HEADER

    const Version, VersionRead = Varint.Read(CompressedObj, Offset)
    CheckVersion(Version, "Object")
    Offset += VersionRead

    const TypeId, TypeIdRead = Varint.Read(CompressedObj, Offset)
    Offset += TypeIdRead

    const LocalId, LocalIdRead = Varint.Read(CompressedObj, Offset)
    Offset += LocalIdRead

    const Count, CountRead = Varint.Read(CompressedObj, Offset)
    Offset += CountRead

    const Obj: DecompressedObject = {
        __type = "DecompressedObject",
        LocalId = LocalId,
        Registry = TypeId,
        Properties = {},
        Source = CompressedObj,
    }

    for _ = 1, Count do
        const Id, Value, Consumed, Raw = ReadProperty(CompressedObj, Offset)
        Offset += Consumed

        if Raw and Id then
            local Unknown = Obj.Unknown
            if not Unknown then
                Unknown = {}
                Obj.Unknown = Unknown
            end

            (Unknown :: {[number]: buffer})[Id] = Raw
        elseif Id then
            Obj.Properties[Id] = Value
        end
    end

    return Obj
end

--=============================================================================
-- Metadata
--=============================================================================

-- [/mh][varint id][varint saved][varint published][varint count][properties...]
-- The format version lives on the containing pack rather than on every record.
function Compressor:CompressMetadata(Metadata: DatabaseTypes.Metadata): buffer
    local Size = 0
    local Count = 0
    const Buffers = {}

    for Index, Prop in Metadata do
        if type(Index) ~= "number" then
            continue
        end

        const Written = WriteProperty(Buffers, Prop.Parent, Prop.Type, Prop.Value)
        if Written > 0 then
            Size += Written
            Count += 1
        end
    end

    const PrefixSize = Varint.Measure(Metadata.Id)
        + Varint.Measure(Metadata.SavedVersion)
        + Varint.Measure(Metadata.PublishedVersion)
        + Varint.Measure(Count)

    const Prefix = buffer.create(PrefixSize)
    local At = Varint.Write(Prefix, 0, Metadata.Id)
    At += Varint.Write(Prefix, At, Metadata.SavedVersion)
    At += Varint.Write(Prefix, At, Metadata.PublishedVersion)
    Varint.Write(Prefix, At, Count)

    return Concat(METADATA_HEADER, Prefix, Buffers, Size)
end

function Compressor:DecompressMetadata(CompressedMetadata: buffer): DatabaseTypes.Metadata
    if buffer.readstring(CompressedMetadata, 0, #METADATA_HEADER) ~= METADATA_HEADER then
        Logger:Error("Tried to decompress invalid metadata buffer.")
    end

    local Offset = #METADATA_HEADER

    const Id, IdRead = Varint.Read(CompressedMetadata, Offset)
    Offset += IdRead

    const Saved, SavedRead = Varint.Read(CompressedMetadata, Offset)
    Offset += SavedRead

    const Published, PublishedRead = Varint.Read(CompressedMetadata, Offset)
    Offset += PublishedRead

    const Count, CountRead = Varint.Read(CompressedMetadata, Offset)
    Offset += CountRead

    const Metadata = {
        Id = Id,
        SavedVersion = Saved,
        PublishedVersion = Published,
    }

    for _ = 1, Count do
        const PropertyId, Value, Consumed, Raw = ReadProperty(CompressedMetadata, Offset)
        Offset += Consumed

        -- Metadata does not keep what it cannot place. It is a database's own
        -- bookkeeping rather than anybody's level, and has nowhere to hold it.
        if PropertyId and not Raw then
            const Prop = Properties.new(PropertyId)
            Prop:Set(Value)
            table.insert(Metadata, Prop)
        end
    end

    return Metadata :: any
end

--=============================================================================
-- Packing
--=============================================================================

-- [/ph][varint count][[varint length][bytes]...]
function Compressor:PackBuffers(Buffers: {buffer}): buffer
    local Size = 0
    for _, Part in Buffers do
        const Length = buffer.len(Part)
        Size += Varint.Measure(Length) + Length
    end

    const CountSize = Varint.Measure(#Buffers)
    const Pack = buffer.create(#PACK_HEADER + CountSize + Size)
    buffer.writestring(Pack, 0, PACK_HEADER)
    Varint.Write(Pack, #PACK_HEADER, #Buffers)

    local Offset = #PACK_HEADER + CountSize
    for _, Part in Buffers do
        const Length = buffer.len(Part)
        Offset += Varint.Write(Pack, Offset, Length)
        buffer.copy(Pack, Offset, Part, 0)
        Offset += Length
    end

    return Pack
end

function Compressor:UnpackBuffers(PackedBuffers: buffer, Offset: number?): {buffer}
    local At = Offset or 0
    if buffer.readstring(PackedBuffers, At, #PACK_HEADER) ~= PACK_HEADER then
        Logger:Error("Tried to unpack invalid buffer pack.")
    end

    At += #PACK_HEADER

    const Count, CountRead = Varint.Read(PackedBuffers, At)
    At += CountRead

    const Unpacked = table.create(Count)
    for Index = 1, Count do
        const Length, LengthRead = Varint.Read(PackedBuffers, At)
        At += LengthRead

        const Slice = buffer.create(Length)
        buffer.copy(Slice, 0, PackedBuffers, At, Length)
        Unpacked[Index] = Slice
        At += Length
    end

    return Unpacked
end

-- [varint version][varint last id][pack of metadata buffers]
function Compressor:CompressMetadatas(LastId: number, Metadatas: {DatabaseTypes.Metadata}): buffer
    const Compressed = table.create(#Metadatas)
    for Index, Metadata in Metadatas do
        Compressed[Index] = Compressor:CompressMetadata(Metadata)
    end

    const Packed = Compressor:PackBuffers(Compressed)
    const PrefixSize = Varint.Measure(FORMAT_VERSION) + Varint.Measure(LastId)

    const Result = buffer.create(PrefixSize + buffer.len(Packed))
    const At = Varint.Write(Result, 0, FORMAT_VERSION)
    Varint.Write(Result, At, LastId)
    buffer.copy(Result, PrefixSize, Packed, 0)
    return Result
end

function Compressor:DecompressMetadatas(CompressedMetadatas: buffer): (number, {DatabaseTypes.Metadata})
    const Version, VersionRead = Varint.Read(CompressedMetadatas, 0)
    CheckVersion(Version, "Metadata pack")

    const LastId, LastIdRead = Varint.Read(CompressedMetadatas, VersionRead)
    const Metadatas = {}

    for _, Compressed in Compressor:UnpackBuffers(CompressedMetadatas, VersionRead + LastIdRead) do
        table.insert(Metadatas, Compressor:DecompressMetadata(Compressed))
    end

    return LastId, Metadatas
end

--=============================================================================
-- Scenes
--=============================================================================

-- [varint version][varint last id][pack of object buffers]
--
-- The same shape as a metadata pack, and for the same reason: LastId is what
-- stops a scene reopening a local id after the object holding it is gone.
-- Without it, unload and load would restart the counter and the second object
-- ever created would answer to the name the first one was saved under.
--
-- An entry that is already a buffer is an object record kept whole -- one whose
-- type this build does not have -- and goes back in exactly as it was read.
function Compressor:CompressScene(LastId: number, Objects: {ObjectTypes.Object | DecompressedObject | buffer}): buffer
    const Compressed = table.create(#Objects)
    for Index, Obj in Objects do
        Compressed[Index] = if type(Obj) == "buffer" then Obj else Compressor:CompressObject(Obj, true)
    end

    const Packed = Compressor:PackBuffers(Compressed)
    const PrefixSize = Varint.Measure(FORMAT_VERSION) + Varint.Measure(LastId)

    const Result = buffer.create(PrefixSize + buffer.len(Packed))
    const At = Varint.Write(Result, 0, FORMAT_VERSION)
    Varint.Write(Result, At, LastId)
    buffer.copy(Result, PrefixSize, Packed, 0)
    return Result
end

function Compressor:DecompressScene(CompressedScene: buffer): (number, {DecompressedObject})
    const Version, VersionRead = Varint.Read(CompressedScene, 0)
    CheckVersion(Version, "Scene pack")

    const LastId, LastIdRead = Varint.Read(CompressedScene, VersionRead)
    const Objects = {}

    for _, Compressed in Compressor:UnpackBuffers(CompressedScene, VersionRead + LastIdRead) do
        table.insert(Objects, Compressor:DecompressObject(Compressed))
    end

    return LastId, Objects
end

--=============================================================================
-- Transactions
--=============================================================================

-- [/th][varint version][varint count][operations...]
--
--   create   [1][varint object type][varint scene copy][varint count][properties...]
--                [varint count][varint property id][varint operation]...
--   set      [2][varint runtime id][varint property id][tag][value]
--   destroy  [3][varint runtime id]
--   lock     [4][varint runtime id]
--   unlock   [5][varint runtime id]
--   load     [6][varint scene id]
--   unload   [7][varint scene copy]
--
-- A create's second list is its references: Object properties pointing at
-- something this same transaction creates, which cannot be written as values
-- because the ids they will hold are minted at the far end. Each entry names
-- the property and the operation whose new object it points at. Empty for
-- almost every create ever written, and one byte when it is.
--
-- The only format here that is never written to disk. It lives beside the ones
-- that are because it is the same problem -- tagged values authored by a peer
-- running a different build -- and because sharing the property writer is what
-- makes a value mean the same thing in a packet as it does in a save.
--
-- An operation of an unknown kind is refused rather than skipped. A value can be
-- stepped over knowing only its wire shape, which is what keeps an old reader
-- reading a new record; an operation cannot, and a transaction that quietly
-- drops the part it did not understand is no longer applied as a unit.
const function WriteValues(Buffers: {buffer}, Values: {[PropertyTypes.PropertyIdentifier]: any}): (number, number)
    local Size = 0
    local Count = 0

    -- Id order, like an object's properties, so the same edit always produces
    -- the same bytes -- which is what lets one history entry be compared
    -- against another rather than only replayed.
    const Keys = {}
    for Key in Values do
        table.insert(Keys, Key)
    end

    table.sort(Keys)

    -- Refused rather than skipped, unlike an object being saved. A record that
    -- drops a value it could not write is a record missing a field; a
    -- transaction that does it is a different transaction from the one the
    -- caller built, applied in full at the far end and reported as a success.
    for _, Key in Keys do
        const Registry = Properties:GetRegistry(Key)
        if not Registry then
            Logger:Error(`Cannot write an operation carrying unregistered property id {Key}.`)
        end

        const Written = WriteProperty(Buffers, Key, Registry.Type, Values[Key])
        if Written == 0 then
            Logger:Error(`Cannot write {Registry.Name} as a {Registry.Type}: the value it was given cannot be encoded.`)
        end

        Size += Written
        Count += 1
    end

    return Size, Count
end

-- Throws rather than dropping, for the same reason. The caller is the author of
-- the list, not a peer, so an operation that cannot be written is a mistake to
-- be shown rather than a difference to be tolerated -- and the one thing this
-- must never do is quietly send four of five operations.
const function WriteOperation(Operation: TransactionTypes.Operation): buffer
    if Operation.Kind == "Create" then
        const Buffers = {}
        const Size, Count = WriteValues(Buffers, Operation.Properties)

        -- Sorted, like the values above and for the same reason: the same
        -- transaction has to produce the same bytes every time it is written.
        const Referenced = {}
        if Operation.References then
            for PropertyId in Operation.References do
                table.insert(Referenced, PropertyId)
            end

            table.sort(Referenced)
        end

        local ReferenceSize = Varint.Measure(#Referenced)
        for _, PropertyId in Referenced do
            ReferenceSize += Varint.Measure(PropertyId)
                + Varint.Measure((Operation.References :: any)[PropertyId])
        end

        const PrefixSize = 1
            + Varint.Measure(Operation.Object)
            + Varint.Measure(Operation.Instance)
            + Varint.Measure(Count)

        const Prefix = buffer.create(PrefixSize)
        buffer.writeu8(Prefix, 0, TransactionTypes.Kinds.Create)

        local At = 1 + Varint.Write(Prefix, 1, Operation.Object)
        At += Varint.Write(Prefix, At, Operation.Instance)
        Varint.Write(Prefix, At, Count)

        -- After the values rather than in the prefix, so a reader walks the
        -- properties with the count it already has and finds this where the
        -- record ends.
        const Tail = buffer.create(ReferenceSize)
        local Cursor = Varint.Write(Tail, 0, #Referenced)
        for _, PropertyId in Referenced do
            Cursor += Varint.Write(Tail, Cursor, PropertyId)
            Cursor += Varint.Write(Tail, Cursor, (Operation.References :: any)[PropertyId])
        end

        table.insert(Buffers, Tail)
        return Concat("", Prefix, Buffers, Size + ReferenceSize)
    elseif Operation.Kind == "Set" then
        const Registry = Properties:GetRegistry(Operation.Property)
        if not Registry then
            Logger:Error(`Cannot write a set for unregistered property id {Operation.Property}.`)
        end

        const Buffers = {}
        const Size = WriteProperty(Buffers, Operation.Property, Registry.Type, Operation.Value)
        if Size == 0 then
            Logger:Error(`Cannot write a set of {Registry.Name}: the value it was given cannot be encoded.`)
        end

        const Prefix = buffer.create(1 + Varint.Measure(Operation.Target))
        buffer.writeu8(Prefix, 0, TransactionTypes.Kinds.Set)
        Varint.Write(Prefix, 1, Operation.Target)

        return Concat("", Prefix, Buffers, Size)
    elseif Operation.Kind == "Destroy" then
        const Encoded = buffer.create(1 + Varint.Measure(Operation.Target))
        buffer.writeu8(Encoded, 0, TransactionTypes.Kinds.Destroy)
        Varint.Write(Encoded, 1, Operation.Target)

        return Encoded
    elseif Operation.Kind == "Lock" or Operation.Kind == "Unlock" then
        const Encoded = buffer.create(1 + Varint.Measure(Operation.Target))
        buffer.writeu8(Encoded, 0, TransactionTypes.Kinds[Operation.Kind])
        Varint.Write(Encoded, 1, Operation.Target)

        return Encoded
    elseif Operation.Kind == "Load" then
        const Encoded = buffer.create(1 + Varint.Measure(Operation.Scene))
        buffer.writeu8(Encoded, 0, TransactionTypes.Kinds.Load)
        Varint.Write(Encoded, 1, Operation.Scene)

        return Encoded
    elseif Operation.Kind == "Unload" then
        const Encoded = buffer.create(1 + Varint.Measure(Operation.Instance))
        buffer.writeu8(Encoded, 0, TransactionTypes.Kinds.Unload)
        Varint.Write(Encoded, 1, Operation.Instance)

        return Encoded
    end

    Logger:Error(`Cannot write an operation of unknown kind {tostring((Operation :: any).Kind)}.`)
end

function Compressor:CompressTransaction(Operations: {TransactionTypes.Operation}): buffer
    const Buffers = {}
    local Size = 0
    local Count = 0

    for _, Operation in Operations do
        const Encoded = WriteOperation(Operation)

        table.insert(Buffers, Encoded)
        Size += buffer.len(Encoded)
        Count += 1
    end

    const PrefixSize = Varint.Measure(FORMAT_VERSION) + Varint.Measure(Count)
    const Prefix = buffer.create(PrefixSize)

    const At = Varint.Write(Prefix, 0, FORMAT_VERSION)
    Varint.Write(Prefix, At, Count)

    return Concat(TRANSACTION_HEADER, Prefix, Buffers, Size)
end

-- Everything below is reading bytes a client authored, so it is written to throw
-- rather than to cope: the caller runs it inside a pcall and drops the packet. A
-- truncated buffer throws out of Varint or out of buffer itself, which is the
-- same answer by a different route.
function Compressor:DecompressTransaction(CompressedTransaction: buffer): {TransactionTypes.Operation}
    if buffer.readstring(CompressedTransaction, 0, #TRANSACTION_HEADER) ~= TRANSACTION_HEADER then
        Logger:Error("Tried to decompress invalid transaction buffer.")
    end

    local Offset = #TRANSACTION_HEADER

    const Version, VersionRead = Varint.Read(CompressedTransaction, Offset)
    CheckVersion(Version, "Transaction")
    Offset += VersionRead

    const Count, CountRead = Varint.Read(CompressedTransaction, Offset)
    Offset += CountRead

    const Operations = {}

    for _ = 1, Count do
        const Kind = buffer.readu8(CompressedTransaction, Offset)
        Offset += 1

        if Kind == TransactionTypes.Kinds.Create then
            const Object, ObjectRead = Varint.Read(CompressedTransaction, Offset)
            Offset += ObjectRead

            const Live, LiveRead = Varint.Read(CompressedTransaction, Offset)
            Offset += LiveRead

            const Total, TotalRead = Varint.Read(CompressedTransaction, Offset)
            Offset += TotalRead

            const Values = {}
            for _ = 1, Total do
                -- Skipped and warned about, like restoring a saved object: a
                -- value for a property this build has never heard of is not a
                -- reason to refuse the object that carried it.
                const Id, Value, Consumed = ReadProperty(CompressedTransaction, Offset)
                Offset += Consumed

                if Id then
                    Values[Id] = Value
                end
            end

            const Referenced, ReferencedRead = Varint.Read(CompressedTransaction, Offset)
            Offset += ReferencedRead

            local References: {[PropertyTypes.PropertyIdentifier]: number}? = nil
            for _ = 1, Referenced do
                const PropertyId, PropertyRead = Varint.Read(CompressedTransaction, Offset)
                Offset += PropertyRead

                const Operation, OperationRead = Varint.Read(CompressedTransaction, Offset)
                Offset += OperationRead

                -- Kept whatever the property turns out to be. Unlike a value,
                -- which can be dropped and leave a readable record behind, a
                -- reference is a claim about another operation in this same
                -- transaction: the receiver checks it against the list it
                -- decoded and refuses the transaction if it does not hold.
                if not References then
                    References = {}
                end

                (References :: any)[PropertyId] = Operation
            end

            table.insert(Operations, {
                Kind = "Create" :: "Create",
                Object = Object,
                Instance = Live,
                Properties = Values,
                References = References,
            })
        elseif Kind == TransactionTypes.Kinds.Set then
            const Target, TargetRead = Varint.Read(CompressedTransaction, Offset)
            Offset += TargetRead

            const Property, PropertyRead = Varint.Read(CompressedTransaction, Offset)
            Offset += PropertyRead

            -- Read raw rather than through ReadProperty, which drops a value
            -- whose type has drifted and warns. Here the drift is the thing the
            -- receiver has to be told about: it decides whether the type the
            -- author wrote matches the property being set, and refuses the whole
            -- transaction when it does not.
            const Value, ValueRead, Type = Compressor:DecompressValue(CompressedTransaction, Offset)
            Offset += ValueRead

            table.insert(Operations, {
                Kind = "Set" :: "Set",
                Target = Target,
                Property = Property,
                Value = Value,
                Type = Type,
            })
        elseif Kind == TransactionTypes.Kinds.Destroy then
            const Target, TargetRead = Varint.Read(CompressedTransaction, Offset)
            Offset += TargetRead

            table.insert(Operations, {
                Kind = "Destroy" :: "Destroy",
                Target = Target,
            })
        elseif Kind == TransactionTypes.Kinds.Lock or Kind == TransactionTypes.Kinds.Unlock then
            const Target, TargetRead = Varint.Read(CompressedTransaction, Offset)
            Offset += TargetRead

            table.insert(Operations, {
                Kind = if Kind == TransactionTypes.Kinds.Lock then "Lock" :: "Lock" else "Unlock" :: "Unlock",
                Target = Target,
            })
        elseif Kind == TransactionTypes.Kinds.Load then
            const Scene, SceneRead = Varint.Read(CompressedTransaction, Offset)
            Offset += SceneRead

            table.insert(Operations, {
                Kind = "Load" :: "Load",
                Scene = Scene,
            })
        elseif Kind == TransactionTypes.Kinds.Unload then
            const Instance_, InstanceRead = Varint.Read(CompressedTransaction, Offset)
            Offset += InstanceRead

            table.insert(Operations, {
                Kind = "Unload" :: "Unload",
                Instance = Instance_,
            })
        else
            Logger:Error(`Transaction carries an operation of unknown kind {Kind}.`)
        end
    end

    return Operations
end

return Compressor
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">CustomEnum</string>
					<ProtectedString name="Source"><![CDATA[--!strict
const Logger = require("./Logger")
const Listeners = require("./Listeners")

export type EnumName = string
export type OptionId = number
export type EnumOptions<T> = {[T]: OptionId}
export type RegisteredOption<T> = {
    __type: "CustomEnumOption",
    Id: OptionId,
    Value: T,
    Parent: EnumName
}

export type CustomEnum<T> = {
    __type: "CustomEnum",
    Name: EnumName,
    Options: {RegisteredOption<T>},
    ById: {[OptionId]: RegisteredOption<T>},

    GetById: (self: CustomEnum<T>, Id: number) -> RegisteredOption<T>?,
    GetByValue: (self: CustomEnum<T>, Value: T) -> RegisteredOption<T>?,
}

const MAX_OPTION_ID = 65535

const CustomEnum = {}
const Registered: {[EnumName]: CustomEnum<any>} = {}
const OnRegistered: {(Enum: CustomEnum<any>) -> ()} = {}

-- Indexed rather than scanned: the compressor calls this for every CustomEnum
-- property it decodes.
const function __get_by_id<T>(self: CustomEnum<T>, Id: number): RegisteredOption<T>?
    return self.ById[Id]
end

const function __get_by_value<T>(self: CustomEnum<T>, Value: T): RegisteredOption<T>?
    for _, Option in self.Options do
        if Option.Value == Value then
            return Option
        end
    end

    return nil
end

function CustomEnum:Register<T>(Name: string, Options: EnumOptions<T>): CustomEnum<T>?
    if Registered[Name] then
        Logger:Warn(`Custom enum {Name} is already registered.`)
        return nil
    end

    const ById = {}
    const Valid = {}

    for Value, Id in Options do
        if type(Id) ~= "number" or Id ~= math.floor(Id) then
            Logger:Warn(`Cannot register custom enum option {Value} with a non integer id, got {Id}. Will be skipped`)
            continue
        end

        -- The compressor writes option ids as a u16.
        if Id < 0 or Id > MAX_OPTION_ID then
            Logger:Warn(`Cannot register custom enum option {Value} with id {Id}, outside 0 to {MAX_OPTION_ID}. Will be skipped`)
            continue
        end

        if ById[Id] then
            Logger:Warn(`Cannot register custom enum option {Value} with duplicate id, {ById[Id].Value} already uses id {Id}. Will be skipped`)
            continue
        end

        const Option = {
            __type = "CustomEnumOption",
            Id = Id,
            Value = Value,
            Parent = Name,
        }

        ById[Id] = Option
        table.insert(Valid, Option)
    end

    -- Options is built by iterating a dictionary, so without this the array
    -- order changes between runs.
    table.sort(Valid, function(A, B)
        return A.Id < B.Id
    end)

    const Enum = {
        __type = "CustomEnum",
        Name = Name,
        Options = Valid,
        ById = ById,

        GetById = __get_by_id,
        GetByValue = __get_by_value,
    }

    Registered[Name] = Enum :: any
    Listeners.Notify(OnRegistered, Enum)
    return Enum :: any
end

-- Fired for every enum registered from here on. A client resolves the custom
-- enum constraints the server sent by name against this side's enums, and one
-- registered after those properties arrived has to be resolved then.
function CustomEnum:OnRegistered(Callback: (Enum: CustomEnum<any>) -> ()): () -> ()
    return Listeners.Watch(OnRegistered, Callback, "custom enums")
end

function CustomEnum:GetEnum<T>(Name: string): CustomEnum<T>?
    return Registered[Name]
end

function CustomEnum:GetRegistered(): {[EnumName]: CustomEnum<any>}
    return Registered
end

const Unknown = CustomEnum:Register("Unknown", {
    Unknown = 1,
})

if not Unknown then
    Logger:Error("Failed to register the built in Unknown enum.")
end

-- Returned by the compressor when a saved option no longer resolves.
CustomEnum.UNKNOWN = (Unknown :: CustomEnum<string>).ById[1]

return CustomEnum
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX6">
				<Properties>
					<string name="Name">Database</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX7">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Sharded metadata storage with a three tier cache.
--
-- Layout
--
-- {Key}:Manifest  small table: shard count and the id boundary of each sealed
--                 shard. Boundaries only change when a shard seals.
-- {Key}:1..N      compressed records. Shard k covers ids in
--                 (Boundaries[k - 1], Boundaries[k]]. Only the last shard is
--                 appended to.
--
-- Ids come from a monotonic counter, so a record never changes shard: when the
-- tail shard approaches the value limit its boundary freezes and a new tail
-- opens. Nothing is moved, merged or rebalanced, and sealing is a single write
-- to the manifest, so there is no multi key transaction to get wrong.
--
-- This also removes the write contention of the old single key layout, where
-- every edit in the game did UpdateAsync against the same key: read the whole
-- corpus, decompress it, change one record, recompress, write it back. Edits to
-- different shards no longer contend at all.
--
-- Cache tiers
--
-- 1. In process pages and shards, 90s.
-- 2. MemoryStore pages, 90s. Absorbs cold servers so they do not all hit the
--    DataStore at once. Pages rather than shards because a MemoryStore value
--    caps at 32KB and a shard is measured in megabytes.
-- 3. DataStore, the source of truth.
--
-- There is no cross server invalidation: a write is visible elsewhere within the
-- expiration window. The writing server skips tier 2 for that window so it still
-- reads its own writes, and repopulates the shared page as it goes.

const MemoryStoreService = game:GetService("MemoryStoreService")
const DataStoreService = game:GetService("DataStoreService")

const PropertyTypes = require("../Properties/Types")
const Properties = require("../Properties/Server")
const Compressor = require("../Compressor")
const Encoding = require("../Encoding")
const Logger = require("../Logger")
const Types = require("./Types")
const Try = require("../Try")

export type MetadataValue = Types.MetadataValue
export type ValueTransformer<T> = Types.ValueTransformer<T>
export type Fields<T> = Types.Fields<T>
export type Metadata = Types.Metadata
export type Sort = Types.Sort
export type Predicate = Types.Predicate
export type Manifest = Types.Manifest
export type CacheConfig = Types.CacheConfig
export type Cache = Types.Cache
export type Page = Types.Page
export type Database<T> = Types.Database<T>

const MANIFEST_KEY = "Manifest"
const DEFAULT_EXPIRATION = 90
const DEFAULT_PAGE_SIZE = 50
const ATTEMPTS = 5

-- DataStore caps a value at 4MB. Sealing at 3MB leaves room for the record that
-- crosses the line to still fit.
const DEFAULT_SHARD_LIMIT = 3 * 1024 * 1024

-- MemoryStore caps a value at 32KB and base64 inflates by a third, so a page
-- past this cannot be shared however many times it is retried.
const MEMORYSTORE_VALUE_LIMIT = 31 * 1024

-- A fresh table each time: returning one shared constant would let a caller
-- mutating Records corrupt every later empty result.
const function EmptyPage(): Page
    return {Records = {}, HasMore = false}
end

-- FreezeRecords froze each record but not the array holding them, and Get hands
-- the same page table to every caller out of its cache. One table.insert or
-- table.remove on a returned page therefore rewrote what every other reader on
-- this server would see next.
const function FreezePage(Page: Page): Page
    if not table.isfrozen(Page.Records) then
        table.freeze(Page.Records)
    end

    if not table.isfrozen(Page) then
        table.freeze(Page)
    end

    return Page
end

const Database = {}

const function ShardKey<T>(self: Database<T>, Index: number): string
    return `{self.Key}:{Index}`
end

const function PageKey<T>(self: Database<T>, Cache: string, Page: number): string
    return `{self.Key}:{Cache}:{Page}`
end

--=============================================================================
-- Manifest
--=============================================================================

-- Force skips the cache. A caller about to write needs the current shard
-- layout; readers are fine with one up to Expiration old.
const function GetManifest<T>(self: Database<T>, Force: boolean?): Manifest
    if not Force and self.Manifest and os.clock() < self.ManifestExpiry then
        return self.Manifest
    end

    const Success, Stored = Try(ATTEMPTS, self.DataStore.GetAsync, self.DataStore, MANIFEST_KEY)
    if not Success then
        -- A stale manifest still addresses every existing shard correctly; only
        -- a very recent seal would be missing from it.
        return self.Manifest or {Count = 1, Boundaries = {}}
    end

    const Manifest: Manifest = if type(Stored) == "table"
        then {Count = math.max(1, Stored.Count or 1), Boundaries = Stored.Boundaries or {}}
        else {Count = 1, Boundaries = {}}

    self.Manifest = Manifest
    self.ManifestExpiry = os.clock() + self.Expiration
    return Manifest
end

-- Which shard owns an id. Boundaries are ascending, so this is a walk over a
-- handful of numbers and costs no request.
const function ShardForId(Manifest: Manifest, Id: number): number
    for Index, Boundary in Manifest.Boundaries do
        if Id <= Boundary then
            return Index
        end
    end

    return Manifest.Count
end

-- Freezes the tail shard at its current highest id and opens a new one. A single
-- manifest write, so a reader either sees the old shard set or the new one.
const function Seal<T>(self: Database<T>, LastId: number)
    const Success = Try(ATTEMPTS, self.DataStore.UpdateAsync, self.DataStore, MANIFEST_KEY, function(Old)
        const Count = if type(Old) == "table" then math.max(1, Old.Count or 1) else 1
        const Boundaries = if type(Old) == "table" then (Old.Boundaries or {}) else {}

        -- Idempotent: if the newest boundary already covers this id, another
        -- server sealed the same tail first and there is nothing to do.
        const Newest = Boundaries[#Boundaries]
        if Newest and Newest >= LastId then
            return nil
        end

        const Next = table.clone(Boundaries)
        table.insert(Next, LastId)
        return {Count = Count + 1, Boundaries = Next}
    end)

    if Success then
        self.Manifest = nil
        self.ManifestExpiry = 0
        Logger:Log(`Sealed shard for {self.Key} at id {LastId}.`)
    end
end

--=============================================================================
-- Shards
--=============================================================================

-- Returns Ok separately from an empty result. A shard that exists but fails to
-- decode must not be treated as empty: inside an UpdateAsync transform that
-- would write an empty shard back and destroy every record in it.
const function DecodeShard(Packed: any): ({Metadata}, number, boolean)
    if not Packed then
        return {}, 0, true
    end

    const Ok, LastId, Records = pcall(function()
        return Compressor:DecompressMetadatas(Packed)
    end)

    if not Ok then
        return {}, 0, false
    end

    return Records :: {Metadata}, LastId :: number, true
end

-- Get and Find hand cached record tables straight back to callers. Without this,
-- record[1]:Set(...) on a returned page silently rewrote the cache for every
-- other reader on this server, and the change never reached the DataStore.
-- Frozen, that mistake throws instead. Writes go through Edit, which decodes its
-- own copy inside the UpdateAsync transform and is unaffected.
--
-- Note this also makes OnChange unavailable on a cached record, which is correct:
-- these are read-only snapshots, not live objects.
const function FreezeRecords(Records: {Metadata})
    for _, Record in Records do
        for Key, Prop in Record do
            if type(Key) == "number" then
                table.freeze(Prop)
            end
        end

        table.freeze(Record)
    end
end

const function GetShard<T>(self: Database<T>, Index: number): ({Metadata}, number)
    const Cached = self.Shards[Index]
    if Cached and os.clock() < Cached.Expiry then
        return Cached.Records, Cached.LastId
    end

    const Success, Packed = Try(ATTEMPTS, self.DataStore.GetAsync, self.DataStore, ShardKey(self, Index))
    if not Success then
        if Cached then
            return Cached.Records, Cached.LastId
        end

        return {}, 0
    end

    const Records, LastId, Ok = DecodeShard(Packed)
    if not Ok then
        Logger:Warn(`Shard {Index} of {self.Key} failed to decode.`)
        if Cached then
            return Cached.Records, Cached.LastId
        end

        return {}, 0
    end

    FreezeRecords(Records)

    self.Shards[Index] = {
        Records = Records,
        LastId = LastId,
        Expiry = os.clock() + self.Expiration,
    }

    self.ShardEpoch += 1
    return Records, LastId
end

const function DropLocal<T>(self: Database<T>)
    table.clear(self.Shards)
    table.clear(self.Pages)

    -- The epoch alone would force a rebuild, but clearing releases the copy of
    -- the corpus a sorted cache is holding instead of retaining it until the
    -- next read.
    for _, Cache in self.Caches do
        Cache.Sorted = nil
        Cache.SortedEpoch = nil
    end

    self.ShardEpoch += 1
end

-- Called after any successful write. Local caches go immediately; the shared
-- MemoryStore tier is skipped for the expiration window rather than deleted,
-- because a write can shift every page and there is no cheap way to enumerate
-- them.
const function AfterWrite<T>(self: Database<T>)
    DropLocal(self)
    self.BypassUntil = os.clock() + self.Expiration
end

-- Which shard actually holds an id.
--
-- ShardForId answers from the manifest, and the manifest is cached for the
-- expiration window. If another server sealed the tail inside that window, this
-- server can have appended a record to the old tail whose id now falls past
-- that shard's frozen boundary, so the manifest points at the shard after the
-- one the record is really in. Listings walk every shard and still showed it,
-- while GetById, Edit and Delete looked only where the manifest said and came
-- back empty.
--
-- The expected shard is checked first, so the common path is still one read.
const function LocateShard<T>(self: Database<T>, Id: number): number
    const Manifest = GetManifest(self)
    const Expected = ShardForId(Manifest, Id)

    -- Assigned first rather than iterated inline: GetShard returns the records
    -- and the shard's last id, and feeding both into a generic for puts that
    -- second value in the loop's state slot. CollectOrdered already reads it
    -- this way; the rest of the file now matches.
    const Here = GetShard(self, Expected)
    for _, Record in Here do
        if Record.Id == Id then
            return Expected
        end
    end

    -- Only the shard immediately before it can hold a stranded record: the case
    -- is a record appended to a tail that another server sealed underneath this
    -- one, which leaves it exactly one shard behind where the boundary now
    -- points. Scanning the rest would pull the whole corpus into memory every
    -- time a caller passes an id that does not exist.
    const Previous = Expected - 1
    if Previous >= 1 then
        const Behind = GetShard(self, Previous)
        for _, Record in Behind do
            if Record.Id == Id then
                return Previous
            end
        end
    end

    -- Neither: keep the manifest's answer so a caller acting on an id that does
    -- not exist yet still targets the shard the layout says owns it.
    return Expected
end

--=============================================================================
-- Reading
--=============================================================================

const function __register_cache<T>(self: Database<T>, Name: string, Config: CacheConfig)
    if self.Caches[Name] then
        Logger:Error(`Cache {Name} is already registered.`)
    end

    if not Config.IdOrdered and not Config.Sort then
        Logger:Error(`Cache {Name} needs either IdOrdered or Sort.`)
    end

    self.Caches[Name] = {
        Name = Name,
        PageSize = math.max(1, Config.PageSize or DEFAULT_PAGE_SIZE),
        IdOrdered = Config.IdOrdered,
        Sort = Config.Sort,
    }
end

-- Id ordered paging. Shard order already matches result order, so shards are
-- read one at a time and the walk stops as soon as the page is full. Page 1 of
-- a "newest first" browse touches exactly one shard however many exist.
const function CollectOrdered<T>(self: Database<T>, Cache: Cache, Page: number): Page
    const Manifest = GetManifest(self)
    const Descending = Cache.IdOrdered == "Desc"
    const Skip = (Page - 1) * Cache.PageSize

    -- One past the page so HasMore is known without a second request.
    const Wanted = Cache.PageSize + 1
    const Collected = {}
    local Skipped = 0

    for Step = 1, Manifest.Count do
        const Index = if Descending then Manifest.Count - Step + 1 else Step
        const Records = GetShard(self, Index)
        const Count = #Records

        if Skipped + Count <= Skip then
            Skipped += Count
            continue
        end

        for Offset = 1, Count do
            const Record = if Descending then Records[Count - Offset + 1] else Records[Offset]
            if not Record then
                continue
            end

            if Skipped < Skip then
                Skipped += 1
                continue
            end

            table.insert(Collected, Record)
            if #Collected >= Wanted then
                break
            end
        end

        if #Collected >= Wanted then
            break
        end
    end

    const HasMore = #Collected > Cache.PageSize
    if HasMore then
        table.remove(Collected)
    end

    return {Records = Collected, HasMore = HasMore}
end

-- Any other order. A record in the last shard can rank first, so stopping early
-- would silently return the wrong page: every shard is read, then sorted.
const function CollectSorted<T>(self: Database<T>, Cache: Cache, Page: number): Page
    local All = Cache.Sorted

    -- Rebuilt only when a shard actually changed underneath it, so paging
    -- through a sorted browse sorts once rather than once per page.
    if not All or Cache.SortedEpoch ~= self.ShardEpoch then
        const Manifest = GetManifest(self)
        const Collected = {}

        for Index = 1, Manifest.Count do
            const Records = GetShard(self, Index)
            for _, Record in Records do
                table.insert(Collected, Record)
            end
        end

        table.sort(Collected, Cache.Sort :: Sort)

        All = Collected
        Cache.Sorted = Collected
        Cache.SortedEpoch = self.ShardEpoch
    end

    const Sorted = All :: {Metadata}
    const StartIndex = (Page - 1) * Cache.PageSize + 1
    const EndIndex = math.min(Page * Cache.PageSize, #Sorted)
    if StartIndex > EndIndex then
        return EmptyPage()
    end

    return {
        Records = table.move(Sorted, StartIndex, EndIndex, 1, {}),
        HasMore = EndIndex < #Sorted,
    }
end

const function __get<T>(self: Database<T>, CacheName: string, Page: number?): Page
    const Cache = self.Caches[CacheName]
    if not Cache then
        Logger:Warn(`Cache {CacheName} is not registered for {self.Key}.`)
        return FreezePage(EmptyPage())
    end

    const At = math.max(1, Page or 1)
    const Key = PageKey(self, CacheName, At)
    const Now = os.clock()

    const Local = self.Pages[Key]
    if Local and Now < Local.Expiry then
        return Local.Page
    end

    const Bypassing = Now < self.BypassUntil
    if not Bypassing then
        const Success, Stored = Try(ATTEMPTS, self.MemoryStore.GetAsync, self.MemoryStore, Key)
        if Success and type(Stored) == "table" and type(Stored.Data) == "string" then
            const Ok, Records = pcall(function()
                const _, Decoded = Compressor:DecompressMetadatas(Encoding.Decode(Stored.Data))
                return Decoded
            end)

            if Ok then
                FreezeRecords(Records :: {Metadata})
                const Result = FreezePage({Records = Records :: {Metadata}, HasMore = Stored.HasMore == true})
                self.Pages[Key] = {Page = Result, Expiry = Now + self.Expiration}
                return Result
            end
        end
    end

    const Collected = if Cache.IdOrdered
        then CollectOrdered(self, Cache, At)
        else CollectSorted(self, Cache, At)

    const Result = FreezePage(Collected)

    self.Pages[Key] = {Page = Result, Expiry = os.clock() + self.Expiration}

    -- Repopulate the shared tier, including on the bypass path: the data just
    -- came from the DataStore, so it is the freshest anyone has.
    const Ok, Encoded = pcall(function()
        return Encoding.Encode(Compressor:CompressMetadatas(0, Result.Records))
    end)

    -- An oversized page is skipped rather than attempted: SetAsync would refuse
    -- the value, and Try would spend three attempts with backoff on a failure
    -- that cannot succeed, on every single cache miss.
    if Ok and #(Encoded :: string) <= MEMORYSTORE_VALUE_LIMIT then
        Try(3, self.MemoryStore.SetAsync, self.MemoryStore, Key, {
            Data = Encoded,
            HasMore = Result.HasMore,
        }, self.Expiration)
    end

    return Result
end

-- One shard read rather than a scan of everything.
const function __get_by_id<T>(self: Database<T>, Id: number): Metadata?
    if not Id then
        return nil
    end

    const Records = GetShard(self, LocateShard(self, Id))
    for _, Record in Records do
        if Record.Id == Id then
            return Record
        end
    end

    return nil
end

-- Filtering with no global ordering, so it can stop as soon as it has enough.
-- Search by name and list by creator both land here.
const function __find<T>(self: Database<T>, Predicate: Predicate, Limit: number?): {Metadata}
    const Manifest = GetManifest(self)
    const Wanted = Limit or math.huge
    const Found = {}

    for Index = 1, Manifest.Count do
        const Records = GetShard(self, Index)
        for _, Record in Records do
            if Predicate(Record) then
                table.insert(Found, Record)
                if #Found >= Wanted then
                    return Found
                end
            end
        end
    end

    return Found
end

--=============================================================================
-- Writing
--=============================================================================

-- Every record gets its own Property instances. A shallow clone of
-- InitialMetadata gave every record in the database one shared set of property
-- tables, so editing any record rewrote all of them.
const function BuildMetadata<T>(self: Database<T>, Id: number): Metadata
    const New = {
        Id = Id,
        SavedVersion = 0,
        PublishedVersion = 0,
    }

    for _, Template in self.InitialMetadata do
        const Prop = Properties.new(Template.Parent)
        Prop:Set(Template.Value)
        table.insert(New, Prop)
    end

    return New :: any
end

const function __create<T>(self: Database<T>): (boolean, number?)
    -- Read through rather than trusting the cached copy. A stale manifest here
    -- means appending to a tail another server already sealed, stranding the new
    -- record in a shard whose boundary no longer covers its id. Creates are rare
    -- enough that the extra request does not matter.
    const Manifest = GetManifest(self, true)
    const Index = Manifest.Count

    -- A fresh tail shard has no records, so its id counter continues from the
    -- boundary the previous shard was sealed at.
    const Floor = Manifest.Boundaries[Index - 1] or 0

    local Created: number? = nil
    local Size = 0

    const Success = Try(ATTEMPTS, self.DataStore.UpdateAsync, self.DataStore, ShardKey(self, Index), function(Old)
        const Records, StoredLastId, Ok = DecodeShard(Old)
        if not Ok then
            return nil
        end

        const LastId = math.max(StoredLastId, Floor) + 1

        table.insert(Records, BuildMetadata(self, LastId))

        const Packed = Compressor:CompressMetadatas(LastId, Records)
        Created = LastId
        Size = buffer.len(Packed)
        return Packed
    end)

    if not Success then
        return false, nil
    end

    AfterWrite(self)

    -- Sealing is deliberately outside the transform: UpdateAsync may run its
    -- callback more than once, and a seal must happen exactly once per commit.
    if Size >= self.ShardLimit and Created then
        Seal(self, Created)
    end

    return true, Created
end

const function __edit<T>(self: Database<T>, Id: number, ToChange: {[PropertyTypes.PropertyIdentifier]: any}): boolean
    const Valid = {}
    local IsAnyValid = false

    for PropId, Value in ToChange do
        const Property = Properties:GetRegistry(PropId)
        if not Property then
            Logger:Warn(`Cannot set unregistered property {PropId}. Will be skipped`)
            continue
        end

        if not PropertyTypes:IsValid(Property.Type, Value, Property.Constraints) then
            Logger:Warn(`Value {Value} is not valid for property {Property.Name} (id {PropId}). Will be skipped`)
            continue
        end

        Valid[PropId] = Value
        IsAnyValid = true
    end

    if not IsAnyValid then
        return false
    end

    const Index = LocateShard(self, Id)
    local Found = false
    local Dirty = false

    const Success = Try(ATTEMPTS, self.DataStore.UpdateAsync, self.DataStore, ShardKey(self, Index), function(Old)
        -- Rebuilt from Old on every attempt: UpdateAsync can retry, and carrying
        -- state across attempts would apply an edit twice.
        Found = false
        Dirty = false
        if not Old then
            return nil
        end

        const Records, LastId, Ok = DecodeShard(Old)
        if not Ok then
            return nil
        end

        const Remaining = table.clone(Valid)

        for _, Record in Records do
            if Record.Id ~= Id then
                continue
            end

            for Key, Prop in Record do
                if type(Key) ~= "number" then
                    continue
                end

                if Remaining[Prop.Parent] ~= nil then
                    -- Accepted and Changed are separate: setting a property to
                    -- the value it already holds is a successful edit with
                    -- nothing to persist. Treating that as a write meant every
                    -- no-op edit cost a full shard rewrite.
                    const Accepted, Changed = Prop:Set(Remaining[Prop.Parent])
                    if Accepted then
                        Found = true
                        Dirty = Dirty or Changed
                    end

                    Remaining[Prop.Parent] = nil
                end
            end

            for PropId, Value in Remaining do
                const NewProperty = Properties.new(PropId)
                if NewProperty:Set(Value) then
                    Found = true
                    Dirty = true
                    table.insert(Record, NewProperty)
                end
            end

            break
        end

        if not Found or not Dirty then
            return nil
        end

        return Compressor:CompressMetadatas(LastId, Records)
    end)

    if Dirty and Success then
        AfterWrite(self)
    end

    return Found and Success
end

const function __delete<T>(self: Database<T>, Id: number): boolean
    if not Id then
        return false
    end

    const Index = LocateShard(self, Id)
    local Found = false

    const Success = Try(ATTEMPTS, self.DataStore.UpdateAsync, self.DataStore, ShardKey(self, Index), function(Old)
        Found = false
        if not Old then
            return nil
        end

        const Records, LastId, Ok = DecodeShard(Old)
        if not Ok then
            return nil
        end

        for Position, Record in Records do
            if Record.Id == Id then
                table.remove(Records, Position)
                Found = true
                break
            end
        end

        if not Found then
            return nil
        end

        -- LastId is preserved so a deleted id is never handed out again.
        return Compressor:CompressMetadatas(LastId, Records)
    end)

    if Found and Success then
        AfterWrite(self)
    end

    return Found and Success
end

const function __refresh<T>(self: Database<T>)
    DropLocal(self)
    self.Manifest = nil
    self.ManifestExpiry = 0
end

function Database.new<T>(Config: {
    Key: string,
    InitialMetadata: {PropertyTypes.Property<T>},
    Expiration: number?,
    ShardLimit: number?,
}): Database<T>
    const db = {}
    db.Key = Config.Key
    db.InitialMetadata = Config.InitialMetadata

    -- Every record reads and writes these, so none of them may be unregistered
    -- while the database stands.
    for _, Template in Config.InitialMetadata do
        Properties.Retain(Template.Parent)
    end
    db.Expiration = Config.Expiration or DEFAULT_EXPIRATION
    db.ShardLimit = Config.ShardLimit or DEFAULT_SHARD_LIMIT

    db.DataStore = DataStoreService:GetDataStore(Config.Key)
    db.MemoryStore = MemoryStoreService:GetHashMap(Config.Key)

    db.Caches = {}
    db.Shards = {}
    db.Pages = {}
    db.ShardEpoch = 0

    db.Manifest = nil
    db.ManifestExpiry = 0
    db.BypassUntil = 0

    db.RegisterCache = __register_cache
    db.Create = __create
    db.Get = __get
    db.GetById = __get_by_id
    db.Find = __find
    db.Edit = __edit
    db.Delete = __delete
    db.Refresh = __refresh

    return db :: any
end

return Database
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const PropertyTypes = require("../Properties/Types")
const CustomEnum = require("../CustomEnum")

export type MetadataValue = string | number | boolean | Color3 | Vector3 | CFrame | EnumItem | CustomEnum.RegisteredOption<any>

export type ValueTransformer<T> = (Value: T) -> MetadataValue
export type Fields<T> = {[string]: MetadataValue | ValueTransformer<T>}

export type Metadata = {
    Id: number,
    SavedVersion: number,
    PublishedVersion: number,

    [number]: PropertyTypes.Property<any>,
}

export type Sort = (A: Metadata, B: Metadata) -> boolean
export type Predicate = (Metadata: Metadata) -> boolean

-- Shard k covers ids in (Boundaries[k - 1], Boundaries[k]]. The last shard has
-- no upper boundary and is the only one new records are appended to.
export type Manifest = {
    Count: number,
    Boundaries: {number},
}

export type CacheConfig = {
    PageSize: number?,

    -- Declares that this cache's order matches shard order, which is the only
    -- case where paging may stop before reading every shard. Ids come from a
    -- monotonic counter, so "Asc" is oldest first and "Desc" is newest first.
    --
    -- Leave nil and supply Sort for any other order. A sort by plays or name
    -- can rank a record from the last shard first, so every shard has to be
    -- read before the page is correct.
    IdOrdered: ("Asc" | "Desc")?,
    Sort: Sort?,
}

export type Cache = {
    Name: string,
    PageSize: number,
    IdOrdered: ("Asc" | "Desc")?,
    Sort: Sort?,

    -- Sorted caches have to read every shard, so without memoising this a
    -- second page re-sorted the entire corpus. Epoch is the shard epoch the
    -- array was built at; a mismatch means a shard reloaded underneath it.
    Sorted: {Metadata}?,
    SortedEpoch: number?,
}

export type Page = {
    -- Frozen rather than read-only in the type: `read` fields need the new
    -- type solver, which this code is not checked under, and FreezePage calls
    -- table.freeze on Records before a page is ever handed out. The guarantee
    -- is the freeze; the annotation was only ever restating it.
    Records: {Metadata},
    HasMore: boolean,
}

export type ShardCache = {
    Records: {Metadata},
    LastId: number,
    Expiry: number,
}

export type Database<T> = {
    Key: string,
    InitialMetadata: {PropertyTypes.Property<T>},
    Expiration: number,
    ShardLimit: number,

    DataStore: GlobalDataStore,
    MemoryStore: MemoryStoreHashMap,

    Caches: {[string]: Cache},
    Shards: {[number]: ShardCache},
    Pages: {[string]: {Page: Page, Expiry: number}},

    -- Bumped whenever a shard is loaded or dropped, so a memoised sort knows
    -- its input changed without every cache having to be notified.
    ShardEpoch: number,

    Manifest: Manifest?,
    ManifestExpiry: number,
    -- Set after this server writes. Until it passes, reads skip the shared
    -- MemoryStore tier so the writer sees its own change instead of the stale
    -- page another server cached.
    BypassUntil: number,

    RegisterCache: (self: Database<T>, Name: string, Config: CacheConfig) -> (),
    Create: (self: Database<T>) -> (boolean, number?),
    Get: (self: Database<T>, Cache: string, Page: number?) -> Page,
    GetById: (self: Database<T>, Id: number) -> Metadata?,
    Find: (self: Database<T>, Predicate: Predicate, Limit: number?) -> {Metadata},
    Edit: (self: Database<T>, Id: number, ToChange: {[number]: any}) -> boolean,
    Delete: (self: Database<T>, Id: number) -> boolean,
    Refresh: (self: Database<T>) -> (),
}

return true
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<string name="Name">Encoding</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MemoryStore JSON serializes its values, so a raw buffer cannot be stored in
-- it directly. Base64 output is ASCII, which survives that round trip.
--
-- Kept as a thin wrapper on purpose: if the EncodingService signature differs
-- from what is written here, this is the only file that needs touching.

const EncodingService = game:GetService("EncodingService")

const Encoding = {}

function Encoding.Encode(Buf: buffer): string
    return buffer.tostring(EncodingService:Base64Encode(Buf))
end

function Encoding.Decode(Text: string): buffer
    return EncodingService:Base64Decode(buffer.fromstring(Text))
end

return Encoding
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">Handles</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The persistent half of an object's identity.
--
--     PersistentId = SceneId * 2^32 + LocalId
--
-- This is what a pack means by an object, and the only identity that outlives
-- the session. It is deliberately not unique among live objects: the same scene
-- can be instanced more than once, and every copy answers to the ids its pack
-- was written with. Telling two live copies apart is the runtime id's job.
--
-- Only the low half is ever written. The scene stamps its own id back on at
-- load, which is what keeps a pack portable: the same prefab loaded under two
-- scenes yields two distinct persistent identities, and references between
-- objects inside one pack stay valid because they all move by the same amount.
--
-- 48 bits in total, well inside the 53 a Luau number carries exactly, so a
-- saved reference is a plain number rather than a pair every caller has to
-- thread through.

const SCALE = 4294967296 -- 2^32

const Handles = {}

export type SceneIdentifier = number
export type LocalId = number
export type PersistentId = number

-- The scene half is bounded by the u16 registry ids everywhere else uses, the
-- object half by what fits below the scene bits.
Handles.MAX_SCENE = 65535
Handles.MAX_LOCAL = 4294967295

function Handles.Join(Scene: SceneIdentifier, Local: LocalId): PersistentId
    return Scene * SCALE + Local
end

function Handles.Split(Persistent: PersistentId): (SceneIdentifier, LocalId)
    const Local = Persistent % SCALE
    return (Persistent - Local) / SCALE, Local
end

function Handles.Scene(Persistent: PersistentId): SceneIdentifier
    return (Persistent - Persistent % SCALE) / SCALE
end

function Handles.Local(Persistent: PersistentId): LocalId
    return Persistent % SCALE
end

return Handles
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX11">
				<Properties>
					<string name="Name">History</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX12">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Undo and redo, as one order, from the client.
--
-- The steps themselves live on two sides now. Anything done to a scene the
-- server owns is recorded there, by History/Server, because that is where the
-- objects are: a destroy suspends its object and the step holds it, so undoing
-- brings back that object rather than building a lookalike. Anything done in a
-- scene this client owns is recorded here, for the same reason in reverse --
-- nobody else has a claim on those objects, so nothing about them needs asking.
--
-- What this module owns outright is the *order*. Ctrl+Z should take back the
-- last thing the player did, and the player does not know or care which side
-- recorded it, so the two halves are kept as one list of tokens: a step of this
-- client's own, or the id of one the server is holding. Undo looks at the top
-- token and either applies it here or asks the server for that exact step.
--
-- Naming the step matters. The two halves can drift -- the server drops the
-- oldest when a player's stack is full, and it does that without being asked --
-- so an undo says which step it means and is told no if that is not the one on
-- top. Being told no comes with a fresh picture of the server's stacks, which
-- is what this reconciles against.

const Objects = require("../Objects/Client")
const Transactions = require("../Transactions/Client")
const Network = require("./Network")
const Listeners = require("../Listeners")
const Logger = require("../Logger")
const Types = require("../Objects/Types")

const History = {}

-- Steps of this client's own kept on each stack, across every scene this client
-- owns. One count for all of them, for the reason the server keeps one for all
-- of its own: what a player takes back is one sequence of things they did, not
-- one per room.
--
-- The two halves count separately, which is the one line the order does not
-- draw: a step here and a step the server holds are the same kind of thing to
-- undo, but only this side can count them together, and a client that has gone
-- quiet must not be what decides how much the server holds. So each side keeps
-- its own hundred, and a player who edits only one kind of scene sees exactly
-- that many either way.
local LIMIT = 100

-- Objects this client's own steps may hold between them, beside the count. The
-- server's twin; see HELD_LIMIT there for why a count alone limits nothing.
local HELD_LIMIT = 10000

-- How long a run of sets to one property may pause and still be one step. A
-- drag sets every frame; two edits a few seconds apart are two actions.
const MERGE_WINDOW = 1

-- A copy appearing and going is a step like any other, and the same act in
-- opposite directions: undoing a load withdraws the copy it made, undoing an
-- unload puts back the one it took. Both are suspends, so what comes back is
-- what was there -- objects, values, ids and all -- rather than what the scene
-- last committed.
--
-- Holds are not here. A lock is not a change to the world, and an undo that
-- took somebody's hold back would be taking back something they may still be
-- using.
type Entry = {
    Kind: "Set" | "Create" | "Destroy" | "Load" | "Unload",

    -- One or the other: an object for the first three, a live copy for the two
    -- below them.
    Target: Types.Object?,
    Copy: any?,

    Property: number?,
    Before: any,
    After: any,
}

-- A step the game wrote itself, for the things Prism does not model. The
-- server's twin; see History/Server for what each verb is for.
export type Action = {
    Undo: () -> (),
    Redo: () -> (),
    Clear: (() -> ())?,
}

-- Either the game's or Prism's, never both.
type Step = {
    Entries: {Entry},
    Custom: Action?,
    Run: {Target: Types.RuntimeId, Property: number, At: number}?,

    -- Objects the step keeps alive, counted against HELD_LIMIT. See Weigh.
    Weight: number?,
}

-- One place in the order. Exactly one of the two is set: a step this client
-- holds, or the id of one the server does.
type Token = {
    Step: Step?,
    Server: number?,
}

const UndoOrder: {Token} = {}
const RedoOrder: {Token} = {}
const Changed: {() -> ()} = {}

-- Set while this module applies a step of its own, so the edits it makes are
-- not recorded as new actions. Reviving an object fires the added signal like
-- any other object appearing, and without this an undone destroy would record
-- itself as a create.
local Applying = false

-- One undo or redo at a time: asking the server yields, and a second one
-- started meanwhile would reverse a step the first has not finished with.
local Busy = false

--=============================================================================
-- Clear
--=============================================================================

-- The end of a step of this client's own. Anything it was holding against an
-- undo that will now never come is disposed, which is the point at which a
-- deferred destroy finally happens.
--
-- Only an entry that caused the suspension owns the object: a Set names an
-- object it did not remove. See History/Server, which reasons the same way over
-- the same shape.
const function Clear(Step: Step)
    const Custom = Step.Custom
    if Custom then
        -- The game's, so it is allowed to throw without taking the stack with
        -- it: this runs while a new action is being recorded, which is no
        -- moment to fail.
        if Custom.Clear then
            const Ok, Err = pcall(Custom.Clear)
            if not Ok then
                Logger:Warn(`A custom history action failed to clear: {Err}`)
            end
        end

        Step.Custom = nil
        return
    end

    for _, Entry in Step.Entries do
        const Copy = Entry.Copy
        if Copy then
            -- A copy this step was holding against an undo that will now never
            -- come. Its objects end here, and the folder they were in.
            if Copy.Suspended then
                Copy:Dispose()
            end

            continue
        end

        const Target = Entry.Target
        if Target and Entry.Kind ~= "Set" and Target.Suspended then
            Objects.Dispose(Target)
        end
    end

    table.clear(Step.Entries)
end

const function ClearTokens(Order: {Token})
    for _, Token in Order do
        if Token.Step then
            Clear(Token.Step)
        end
    end

    table.clear(Order)
end

-- A step of this client's own joining the order. A server step arrives the
-- other way round -- the server records it and says so -- and is appended when
-- its id turns up in a picture this client has not seen before.
-- How many objects a step keeps alive, as the server weighs its own: one per
-- create or destroy, and every object in a copy it loaded or unloaded.
const function Weigh(Step: Step): number
    local Held = 0

    for _, Entry in Step.Entries do
        const Copy = Entry.Copy
        if Copy then
            if Copy.Suspended then
                Held += #Copy.Suspended
            elseif Copy.Objects then
                for _ in Copy.Objects do
                    Held += 1
                end
            end
        elseif Entry.Kind == "Create" or Entry.Kind == "Destroy" then
            Held += 1
        end
    end

    return Held
end

-- Tells the server to drop this player's redo stack, or both. Invoked on a
-- thread of its own so neither caller yields, and spawned rather than deferred
-- so the request leaves now: it has to reach the server ahead of any edit made
-- after it, which also goes through the remote function, and an event used to
-- arrive behind such an edit and wipe the step it had just recorded.
const function Forget(RedoOnly: boolean)
    task.spawn(function()
        pcall(function()
            return Network.Forget:Invoke(RedoOnly)
        end)
    end)
end

const function Push(Step: Step)
    Step.Weight = Weigh(Step)
    table.insert(UndoOrder, {Step = Step})

    -- Past the end of what is kept, by count or by what the steps hold, and
    -- gone for good, so it lets go of whatever it was holding. Walked newest
    -- first, so the newest step is always kept however much it holds. Only this
    -- client's own steps count against these limits; the server enforces the
    -- same ones over its own.
    local Steps = 0
    local Held = 0
    for Index = #UndoOrder, 1, -1 do
        const Token = UndoOrder[Index]
        const Kept = Token.Step
        if not Kept then
            continue
        end

        Steps += 1
        Held += Kept.Weight or 0

        if Steps > 1 and (Steps > LIMIT or Held > HELD_LIMIT) then
            Clear(Kept)
            table.remove(UndoOrder, Index)
        end
    end

    -- A new action forks the history: everything that was undone is unreachable
    -- now, on both sides. The server forks its own half when it records an
    -- action of its own, but this one happened here, so it has to be told --
    -- and told before its half is dropped from the order, or the steps it is
    -- still holding would have nothing left to reach them.
    local Theirs = false
    for _, Token in RedoOrder do
        if Token.Server then
            Theirs = true
            break
        end
    end

    if Theirs then
        Forget(true)
    end

    ClearTokens(RedoOrder)
    Listeners.Notify(Changed)
end

--=============================================================================
-- Applying a step of this client's own
--=============================================================================

const function Present(Entry: Entry, Forward: boolean): boolean
    return (Entry.Kind == "Create" or Entry.Kind == "Load") == Forward
end

const function Ends(Entry: Entry, Forward: boolean): (any, any)
    if Forward then
        return Entry.Before, Entry.After
    end

    return Entry.After, Entry.Before
end

const function Ordered(Entries: {Entry}, Forward: boolean): {Entry}
    if Forward then
        return Entries
    end

    const Reversed = table.create(#Entries)
    for Index = #Entries, 1, -1 do
        table.insert(Reversed, Entries[Index])
    end

    return Reversed
end

const function ApplyLocal(Step: Step, Forward: boolean): boolean
    Applying = true

    const Custom = Step.Custom
    if Custom then
        const Ok, Err = pcall(if Forward then Custom.Redo else Custom.Undo)
        Applying = false

        if not Ok then
            -- Left where it was, like any other refusal, so it can be tried
            -- again once whatever the action needed is there.
            Logger:Warn(`A custom history action failed and was left on the stack: {Err}`)
            return false
        end

        return true
    end

    for _, Entry in Ordered(Step.Entries, Forward) do
        const Copy = Entry.Copy
        if Copy then
            if Present(Entry, Forward) then
                Copy:Revive()
            else
                Copy:Suspend()
            end

            continue
        end

        const Obj = Entry.Target :: Types.Object

        if Entry.Kind == "Set" then
            const Prop = if Obj.Destroyed then nil else Obj.Properties[Entry.Property :: number]
            const From, To = Ends(Entry, Forward)

            -- Changed since by something other than this step: left alone.
            if Prop and Prop.Value == From then
                Obj:Set(Entry.Property :: number, if To == nil then Prop.DefaultValue else To)
            end
        elseif Present(Entry, Forward) then
            Objects.Revive(Obj)
        else
            Objects.Suspend(Obj)
        end
    end

    Applying = false
    return true
end

const function Move(From: {Token}, To: {Token}, Forward: boolean): boolean
    const Token = From[#From]
    if not Token or Busy then
        return false
    end

    Busy = true

    local Ok, Result
    if Token.Step then
        Ok, Result = pcall(ApplyLocal, Token.Step, Forward)
    else
        const Channel = if Forward then Network.Redo else Network.Undo
        Ok, Result = pcall(function()
            return Channel:Invoke(Token.Server)
        end)
    end

    Busy = false
    Applying = false

    -- Refused -- rights, a lock, a step the server no longer has on top -- and
    -- so left where it was, to be tried again. A server refusal comes with a
    -- fresh picture of its stacks, which reconciles the order whenever it
    -- lands.
    if not Ok or Result ~= true then
        return false
    end

    -- Not table.remove of the last: reconciling may have moved things while the
    -- invoke above was in flight.
    const At = table.find(From, Token)
    if At then
        table.remove(From, At)
    end

    if Token.Step then
        Token.Step.Run = nil
    end

    table.insert(To, Token)
    Listeners.Notify(Changed)
    return true
end

--=============================================================================
-- The order
--=============================================================================

-- Takes back the most recent step, whichever side is holding it. Yields while
-- the server answers for one of its own. False if there is nothing to undo,
-- another undo or redo is still going, or it was refused -- in which case the
-- step stays where it is.
function History:Undo(): boolean
    return Move(UndoOrder, RedoOrder, false)
end

function History:Redo(): boolean
    return Move(RedoOrder, UndoOrder, true)
end

-- An action of the game's own, in the order the player's own edits are in, so
-- undoing reaches it exactly where it happened. For the things Prism does not
-- model -- a tool's own state, a panel's own data -- so that Ctrl+Z means one
-- thing in an editor rather than two.
--
-- Push it as the action happens; Undo and Redo are how to take it back and do
-- it again, and Clear, if it holds anything, is where that goes when the step
-- can no longer be reached.
function History:Push(Action: Action): boolean
    if type(Action) ~= "table" or type(Action.Undo) ~= "function" or type(Action.Redo) ~= "function" then
        Logger:Warn("A custom history action needs an Undo and a Redo function.")
        return false
    end

    Push({Entries = {}, Custom = Action})
    return true
end

function History:CanUndo(): boolean
    return #UndoOrder > 0 and not Busy
end

function History:CanRedo(): boolean
    return #RedoOrder > 0 and not Busy
end

-- Forgets everything, on both sides. The server disposes of every object its
-- steps were holding for this player; this does the same for its own.
function History:Clear()
    ClearTokens(UndoOrder)
    ClearTokens(RedoOrder)
    Forget(false)
    Listeners.Notify(Changed)
end

-- How much this client's own half keeps, as History:SetLimits does on the
-- server for its half. Either may be left out; takes effect at the next step.
function History:SetLimits(Limits: {Steps: number?, Objects: number?})
    if Limits.Steps and Limits.Steps >= 1 then
        LIMIT = math.floor(Limits.Steps)
    end

    if Limits.Objects and Limits.Objects >= 0 then
        HELD_LIMIT = math.floor(Limits.Objects)
    end
end

function History:GetLimits(): {Steps: number, Objects: number}
    return {Steps = LIMIT, Objects = HELD_LIMIT}
end

-- Fired whenever either stack changes, for an editor greying its buttons.
function History:OnChange(Callback: () -> ()): () -> ()
    return Listeners.Watch(Changed, Callback, "the history")
end

-- The server's picture of its own two stacks, oldest first. Its steps are
-- appended in the order it reports them and dropped when it stops reporting
-- them, which is how a step it dropped past its own limit -- something this
-- side never asked for and would not otherwise hear about -- leaves the order.
Network.Changed:Connect(function(Undo: {number}, Redo: {number})
    const Live: {[number]: true} = {}
    for _, Id in Undo do
        Live[Id] = true
    end

    for _, Id in Redo do
        Live[Id] = true
    end

    const Known: {[number]: true} = {}

    const function Sweep(Order: {Token})
        for Index = #Order, 1, -1 do
            const Server = Order[Index].Server
            if not Server then
                continue
            end

            if Live[Server] then
                Known[Server] = true
            else
                table.remove(Order, Index)
            end
        end
    end

    Sweep(UndoOrder)
    Sweep(RedoOrder)

    -- Steps the server has and this side has never placed: its own recording of
    -- what this client just did, in the order it recorded them.
    local Fresh = false
    for _, Id in Undo do
        if not Known[Id] then
            table.insert(UndoOrder, {Server = Id})
            Fresh = true
        end
    end

    for _, Id in Redo do
        if not Known[Id] then
            table.insert(RedoOrder, {Server = Id})
        end
    end

    -- A step this side had never seen is a new action, and a new action forks
    -- the whole order. The server has already dropped its own half of the redo
    -- stack; this drops the rest, which is also where the local steps in it let
    -- go of what they were holding.
    if Fresh then
        ClearTokens(RedoOrder)
    end

    Listeners.Notify(Changed)
end)

--=============================================================================
-- Recording
--=============================================================================

-- Only scenes this client owns. What it does to the server's is recorded there,
-- where the objects are, and reaches this side as a step id and nothing else.

-- A local transaction is one step, which is what a transaction is for. The two
-- hooks are why it can be: the first stops the object by object recording below
-- from firing while the edit runs, and the second hands the whole thing over.
-- Without the first, a transaction creating three objects would land as three
-- steps and then a fourth.
Transactions.OnApplying(function()
    Applying = true
end)

Transactions.OnApplied(function(Record): boolean
    Applying = false

    -- Nil when the apply came apart and was rolled back: nothing happened, so
    -- there is nothing to take back.
    if not Record then
        return false
    end

    const Entries: {Entry} = {}
    local Creates = 0

    for Index, Operation in Record.Operations do
        const Op = Operation :: any

        if Op.Kind == "Create" then
            Creates += 1
            const Made = Record.Created[Creates]
            if Made then
                table.insert(Entries, {Kind = "Create" :: "Create", Target = Made})
            end
        elseif Op.Kind == "Set" then
            const Obj = Record.Targets[Index]
            if Obj then
                table.insert(Entries, {
                    Kind = "Set" :: "Set",
                    Target = Obj,
                    Property = Op.Property,
                    Before = Record.Before[Index],
                    After = Op.Value,
                })
            end
        elseif Op.Kind == "Destroy" then
            const Obj = Record.Targets[Index]

            -- Named twice in one transaction is one destroy by the time it
            -- lands, and the second naming has no object suspended of its own.
            if Obj and Obj.Suspended then
                table.insert(Entries, {Kind = "Destroy" :: "Destroy", Target = Obj})
            end
        end
    end

    for _, Live in Record.Loaded do
        table.insert(Entries, {Kind = "Load" :: "Load", Copy = Live})
    end

    for _, Live in Record.Withdrew do
        table.insert(Entries, {Kind = "Unload" :: "Unload", Copy = Live})
    end

    if #Entries == 0 then
        return false
    end

    Push({Entries = Entries})
    return true
end)

Objects:OnEdited(function(Obj, Property, Before, After)
    if Applying or not Obj.Local then
        return
    end

    const Now = os.clock()
    const Top = UndoOrder[#UndoOrder]
    const Step = if Top then Top.Step else nil
    const Run = if Step then Step.Run else nil

    if
        Run
        and Run.Target == Obj.RuntimeId
        and Run.Property == Property
        and Now - Run.At <= MERGE_WINDOW
    then
        -- Still the same drag: the step now ends where this set did, and still
        -- begins where the first set in it started.
        (Step :: Step).Entries[1].After = After
        Run.At = Now
        return
    end

    Push({
        Entries = {{Kind = "Set" :: "Set", Target = Obj, Property = Property, Before = Before, After = After}},
        Run = {Target = Obj.RuntimeId, Property = Property, At = Now},
    })
end)

-- A local object appearing, which in a scene this client owns is someone
-- creating one. Not a copy reading its own pack back -- that is Restored, and
-- loading a level is not an action anybody takes back a step at a time. Not a
-- revive either: that fires this like any other object appearing, and an undo
-- recording its own reversal would never let the stack empty.
Objects:OnAdded(function(Obj, Restored)
    if Applying or Restored or not Obj.Local then
        return
    end

    Push({Entries = {{Kind = "Create" :: "Create", Target = Obj}}})
end)

-- A local object going. Claimed, which is what keeps it whole: nothing else on
-- this side is holding it, so answering false here is what makes a destroy in a
-- client owned scene final.
Objects.OnRetired(function(Obj): boolean
    if Applying or not Obj.Local then
        return false
    end

    Push({Entries = {{Kind = "Destroy" :: "Destroy", Target = Obj}}})
    return true
end)

return History
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX13">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")

return {
    Undo = Networking:Get("History.Undo"),
    Redo = Networking:Get("History.Redo"),
    Changed = Networking:Get("History.Changed"),
    Forget = Networking:Get("History.Forget"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX14">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Undo and redo for the scenes the server owns, kept per player, here.
--
-- It used to live entirely on the client, which could record what it had done
-- but could not hold on to what it had undone: the server destroyed an object
-- the moment a destroy landed, so undoing one built a new object in its place.
-- A new object gets a new local id, and every reference still naming the old
-- one was left pointing at nothing. An undo that loses the wiring is not an
-- undo.
--
-- So the stack lives where the objects do. A destroy suspends its object --
-- out of the world by every measure, but whole -- and the step that caused it
-- holds it. Undoing revives that same object, under its own runtime id and its
-- own local id, and everything that pointed at it is pointing at it again.
--
-- Three things can happen to a step, and each of them is spelled out below:
--
--   Undo    put the world back the way it was before the step
--   Redo    do it again
--   Clear   the step will never be applied again, so anything it was holding
--           against an undo can finally go
--
-- Clear is what makes the rest safe. A suspended object is a real object out
-- of sight, and something has to end it: a step is cleared when a new action
-- forks the redo stack it was sitting on, when it falls off the end of the
-- undo stack past the limit, and when the player it belongs to leaves. Those
-- are the only three ways a step stops being reachable, so they are the only
-- three ways an object can be kept and then quietly abandoned.
--
-- Scenes a client owns are not here. The client is the authority in those, so
-- it keeps its own half of the order and applies its own steps; History/Client
-- is where that lives and how the two halves are kept in one order.

const Players = game:GetService("Players")

const PropertyTypes = require("../Properties/Types")
const Permissions = require("../Permissions/Server")
const Transactions = require("../Transactions/Server")
const Compressor = require("../Compressor")
const ObjectTypes = require("../Objects/Types")
const Objects = require("../Objects/Server")
const Audience = require("../Scenes/Audience")
const Scenes = require("../Scenes/Server")
const Network = require("./Network")
const Logger = require("../Logger")

export type Object = ObjectTypes.Object

const History = {}

-- Steps kept on each stack, per player and across every scene the server owns.
-- One count, not one per scene: a player editing two rooms has done one
-- sequence of things and takes them back in the order they did them, so a limit
-- per scene would drop a step that is nowhere near the oldest thing they did.
--
-- The oldest goes when a new one arrives past this, and goes for good:
-- whatever it was holding is disposed.
local LIMIT = 100

-- Objects the kept steps may hold between them, alongside the count above. A
-- step can hold a whole withdrawn copy -- every object in it, and every part --
-- so a hundred steps was a limit on nothing: a hundred unloads of a large room
-- kept a hundred large rooms alive. The oldest steps go until what is left fits,
-- except the newest, which is kept however much it holds: an undo that cannot
-- take back the thing just done is worse than one room too many in memory.
local HELD_LIMIT = 10000

-- How long a run of single sets to one property may pause and still count as
-- one step. A drag sets every frame; two edits a few seconds apart are two
-- actions.
const MERGE_WINDOW = 1

-- An entry names an object rather than an id, and holds it. That is the whole
-- change: a destroy no longer has to describe the object well enough to build
-- another one, because it kept the one it took.
--
-- Create and Destroy carry the same thing and differ only in which direction
-- means "in the world" -- undoing a create and redoing a destroy are the same
-- act on the same object.
-- A copy appearing and going is a step like any other, and the same act in
-- opposite directions: undoing a load withdraws the copy it made, undoing an
-- unload puts back the one it took. Both are suspends, so what comes back is
-- what was there -- objects, values, ids and all -- rather than what the scene
-- last committed.
--
-- Holds are not here. A lock is not a change to the world, and an undo that
-- took somebody's hold back would be taking back something they may still be
-- using.
type Entry = {
    Kind: "Set" | "Create" | "Destroy" | "Load" | "Unload",

    -- One or the other: an object for the first three, a live copy for the two
    -- below them.
    Target: Object?,
    Copy: any?,

    Property: PropertyTypes.PropertyIdentifier?,
    Before: any,
    After: any,
}

-- A step the game wrote itself, for the things Prism does not model: a camera
-- bookmark, a layer renamed in a game's own data, anything an editor wants
-- Ctrl+Z to reach. Three verbs, the same three every step has, and the game
-- fills them in.
--
-- Clear is optional and is the one worth reading twice: it runs when the step
-- becomes unreachable -- forked off the redo stack, pushed past the limit, or
-- the player leaving -- and is where an action that was holding something of
-- its own lets go of it, exactly as Prism's own steps let go of the objects
-- they were keeping.
export type Action = {
    Undo: () -> (),
    Redo: () -> (),
    Clear: (() -> ())?,
}

-- Either the game's or Prism's, never both. Mixing them would mean deciding
-- what order a custom verb runs in among entries it knows nothing about, and
-- an editor that wants both can push two steps.
type Step = {
    Id: number,
    Entries: {Entry},
    Custom: Action?,

    -- The property a run of single sets is still building, while the step is
    -- on top and recent enough to keep merging into.
    Run: {Target: ObjectTypes.RuntimeId, Property: PropertyTypes.PropertyIdentifier, At: number}?,

    -- Objects the step keeps alive, counted against HELD_LIMIT. See Weigh.
    Weight: number?,
}

type Shelf = {
    Undo: {Step},
    Redo: {Step},

    -- One step at a time for this player. Prism's own entries never yield, but
    -- a custom action is the game's code and may; a second undo starting
    -- meanwhile would reverse a step the first has not finished with.
    Busy: boolean?,

    -- Step ids are per player and only climb. The client names the step it
    -- believes is on top, and an id that has been reused would let a stale
    -- request undo something else entirely.
    Next: number,
}

-- Dropped when the player leaves, along with everything their steps were
-- holding. Keyed by the player rather than the user id on purpose: a step names
-- live objects, and someone rejoining comes back to a world whose objects have
-- moved on without them.
const Shelves: {[Player]: Shelf} = {}

-- Set while a step is being applied, so nothing done in the course of reversing
-- one is recorded as a new action. Prism's own entries reach past the recorders
-- anyway -- they write to properties and objects directly -- but a custom
-- action is the game's code, free to use the ordinary API, and every edit it
-- made while undoing would otherwise land on the stack on top of the step doing
-- the undoing.
local Applying = false

const function ShelfFor(Plr: Player): Shelf
    local Shelf = Shelves[Plr]
    if not Shelf then
        Shelf = {Undo = {}, Redo = {}, Next = 1, Busy = false}
        Shelves[Plr] = Shelf
    end

    return Shelf
end

const function Ids(Steps: {Step}): {number}
    const List = table.create(#Steps)
    for Index, Step in Steps do
        List[Index] = Step.Id
    end

    return List
end

-- The client keeps no copy of what a step does, only where it sits in the
-- order, so this is the whole of what it is told.
const function Announce(Plr: Player)
    const Shelf = Shelves[Plr]
    if not Shelf or not Plr.Parent then
        return
    end

    Network.Changed:Fire(Plr, Ids(Shelf.Undo), Ids(Shelf.Redo))
end

--=============================================================================
-- Clear
--=============================================================================

-- The end of a step. Anything it was holding against an undo that will now
-- never come is disposed, which is the point at which a destroy that has been
-- deferred all this time actually happens.
--
-- Only an entry that caused the suspension owns the object: a Set entry names
-- an object it did not remove, and disposing it would end something another
-- step is keeping. That leaves Create and Destroy, and at most one live step
-- can own any one object -- a second destroy of the same object can only be
-- recorded after an undo revived it, and that undo is what moved the first step
-- onto the redo stack, where the new action clears it.
const function Clear(Step: Step)
    const Custom = Step.Custom
    if Custom then
        -- The game's, so it is allowed to throw without taking the stack with
        -- it: this runs while a new action is being recorded or a player is
        -- leaving, and neither is a good moment to fail.
        if Custom.Clear then
            const Ok, Err = pcall(Custom.Clear)
            if not Ok then
                Logger:Warn(`A custom history action failed to clear: {Err}`)
            end
        end

        Step.Custom = nil
        return
    end

    for _, Entry in Step.Entries do
        const Copy = Entry.Copy
        if Copy then
            -- A copy this step was holding against an undo that will now never
            -- come. Its objects end here, and the folder they were in.
            if Copy.Suspended then
                Copy:Dispose()
            end

            continue
        end

        const Target = Entry.Target
        if Target and Entry.Kind ~= "Set" and Target.Suspended then
            Objects.Dispose(Target)
        end
    end

    table.clear(Step.Entries)
end

const function ClearAll(Steps: {Step})
    for _, Step in Steps do
        Clear(Step)
    end

    table.clear(Steps)
end

-- How many objects a step keeps alive: one per create or destroy -- whichever
-- way the step was last applied, one of the two is holding a suspended object
-- -- and every object in a copy it loaded or unloaded. Weighed once, when the
-- step is recorded; objects created in a loaded copy afterwards are steps of
-- their own and weigh there.
const function Weigh(Step: Step): number
    local Held = 0

    for _, Entry in Step.Entries do
        const Copy = Entry.Copy
        if Copy then
            if Copy.Suspended then
                Held += #Copy.Suspended
            else
                for _ in Copy.Objects do
                    Held += 1
                end
            end
        elseif Entry.Kind == "Create" or Entry.Kind == "Destroy" then
            Held += 1
        end
    end

    return Held
end

const function Push(Plr: Player, Shelf: Shelf, Step: Step)
    Step.Weight = Weigh(Step)
    table.insert(Shelf.Undo, Step)

    local Held = 0
    for _, Kept in Shelf.Undo do
        Held += Kept.Weight or 0
    end

    -- Past the end of what is kept, by count or by what the steps hold. The
    -- step is gone for good, so it lets go of what it was holding.
    while #Shelf.Undo > 1 and (#Shelf.Undo > LIMIT or Held > HELD_LIMIT) do
        const Oldest = table.remove(Shelf.Undo, 1)
        if not Oldest then
            break
        end

        Held -= Oldest.Weight or 0
        Clear(Oldest)
    end

    -- A new action forks the history: everything that was undone is now
    -- unreachable, and every object those steps were keeping alive against a
    -- redo that will never come goes with them.
    ClearAll(Shelf.Redo)
    Announce(Plr)
end

--=============================================================================
-- Applying
--=============================================================================

-- Whether the entry's object should be in the world once this step has been
-- applied in this direction. Undoing a create takes it away; undoing a destroy
-- brings it back; redoing does the opposite of each.
const function Present(Entry: Entry, Forward: boolean): boolean
    return (Entry.Kind == "Create" or Entry.Kind == "Load") == Forward
end

const function Ends(Entry: Entry, Forward: boolean): (any, any)
    if Forward then
        return Entry.Before, Entry.After
    end

    return Entry.After, Entry.Before
end

const function Ordered(Entries: {Entry}, Forward: boolean): {Entry}
    if Forward then
        return Entries
    end

    const Reversed = table.create(#Entries)
    for Index = #Entries, 1, -1 do
        table.insert(Reversed, Entries[Index])
    end

    return Reversed
end

-- Everything the step would do, checked before any of it is done. A refusal
-- here leaves the step where it was, to be tried again once the lock is
-- released or the right is granted back; it is not skipped and not partly
-- applied.
--
-- A value someone else has changed since is the one thing that is skipped
-- rather than refused. Their edit is theirs, and an undo that would write over
-- it takes back what it still can and leaves the rest alone.
const function Allowed(Plr: Player, Step: Step, Forward: boolean): boolean
    for _, Entry in Step.Entries do
        const Copy = Entry.Copy
        if Copy then
            -- Putting a copy back is loading it and taking it away is
            -- unloading it, so each asks for what the operation asked for.
            const Owner = Scenes:GetById(Copy.Scene)
            const Rights = if Owner then Owner:GetRights(Plr) else nil
            if not Rights then
                return false
            end

            if Present(Entry, Forward) then
                if not Rights.CanCreate then
                    return false
                end
            elseif not Rights.CanDestroy then
                return false
            end

            continue
        end

        const Obj = Entry.Target :: Object

        if not Audience.Sees(Plr, Obj.Scene) then
            return false
        end

        if Entry.Kind == "Set" then
            -- Checked even while the object is suspended, which it can be when
            -- the same step revives it: it still knows its scene and its type,
            -- and a lock it cannot be under answers no on its own.
            if Objects.LockedAgainst(Obj, Plr) then
                return false
            end

            if not Permissions:Can(Plr, "Edit", Obj, Entry.Property) then
                return false
            end
        elseif Present(Entry, Forward) then
            -- Bringing it back is making it: the same right a create needs, on
            -- the scene it would come back into.
            if not Permissions:Can(Plr, "Create", {Scene = Obj.Scene, Registry = Obj.Registry}) then
                return false
            end
        else
            if Objects.LockedAgainst(Obj, Plr) then
                return false
            end

            if not Permissions:Can(Plr, "Destroy", Obj) then
                return false
            end
        end
    end

    return true
end

const function Apply(Plr: Player, Step: Step, Forward: boolean): boolean
    const Custom = Step.Custom
    if Custom then
        -- One action, so one unit of the budget: the game decides what it does,
        -- and this side has no way to weigh it.
        if not Permissions:Consume(Plr, 1) then
            return false
        end

        -- Recording is off while it runs. A custom verb is free to move objects
        -- around through the ordinary API, and every one of those would
        -- otherwise be recorded as a fresh action on top of the step being
        -- reversed -- a stack that grows every time it is undone.
        Applying = true
        const Ok, Err = pcall(if Forward then Custom.Redo else Custom.Undo)
        Applying = false

        if not Ok then
            -- Left where it was, like any other refusal, so the player can try
            -- again once whatever the action needed is there.
            Logger:Warn(`A custom history action failed and was left on the stack: {Err}`)
            return false
        end

        return true
    end

    if not Allowed(Plr, Step, Forward) then
        return false
    end

    -- One action for the step, whatever is in it. A transaction is one thing to
    -- take back however many operations it carried, and charging by the entry
    -- would mean a player who committed an edit at their ceiling could not undo
    -- it -- which is the moment they most want to.
    --
    -- The same reasoning a load is charged by, and the same trade: what bounds
    -- how much work a player can ask for this way is how often they may ask,
    -- not how big each ask is.
    if not Permissions:Consume(Plr, 1) then
        return false
    end

    Applying = true

    const Changes: {{Object: Object, Property: PropertyTypes.PropertyIdentifier, Value: buffer}} = {}

    for _, Entry in Ordered(Step.Entries, Forward) do
        const Copy = Entry.Copy
        if Copy then
            if Present(Entry, Forward) then
                Copy:Revive()
            else
                Copy:Suspend()
            end

            continue
        end

        const Obj = Entry.Target :: Object

        if Entry.Kind == "Set" then
            const Prop = if Obj.Suspended then nil else Obj.Properties[Entry.Property :: number]
            const From, To = Ends(Entry, Forward)

            -- Changed since by something other than this step: left alone.
            if not Prop or Prop.Value ~= From then
                continue
            end

            -- The property rather than the object's Set, which would send a
            -- packet each. Links are property listeners, so they still run.
            const _, Altered = Prop:Set(if To == nil then Prop.DefaultValue else To)
            if not Altered then
                continue
            end

            const Compressed = Compressor:CompressValue(Prop.Type, Prop.Value)
            if Compressed then
                table.insert(Changes, {Object = Obj, Property = Entry.Property :: number, Value = Compressed})
            end
        elseif Present(Entry, Forward) then
            -- Announces itself, as its own kind of packet: an object arriving
            -- is not a property changing.
            Objects.Revive(Obj)
        else
            Objects.Suspend(Obj)
        end
    end

    -- A property put back on an object the same step went on to withdraw is not
    -- worth a packet: the removal already says everything a client needs, and
    -- this is a step redoing "edit it, then destroy it".
    const Announced = {}
    for _, Change in Changes do
        if not Change.Object.Destroyed then
            table.insert(Announced, Change)
        end
    end

    Applying = false

    if #Announced > 0 then
        Objects.AnnounceChanged(Announced)
    end

    return true
end

const function Move(Plr: Player, Shelf: Shelf, From: {Step}, To: {Step}, Forward: boolean, Named: number?): boolean
    const Step = From[#From]
    if not Step or Shelf.Busy then
        return false
    end

    -- The client names the step it means. The two halves of one order live on
    -- opposite sides of the wire, so a client whose picture has drifted asks
    -- for something that is no longer on top -- and is told no and resynced,
    -- rather than quietly undoing a step it did not mean.
    if Named and Step.Id ~= Named then
        Announce(Plr)
        return false
    end

    -- Wrapped, and not only to answer the caller: Apply turns recording off
    -- while it runs, and an error escaping it would leave this player's edits
    -- going unrecorded for the rest of the session.
    Shelf.Busy = true
    const Ok, Result = pcall(Apply, Plr, Step, Forward)
    Shelf.Busy = false
    Applying = false

    if not Ok then
        Logger:Warn(`A history step failed to apply and was left on the stack: {Result}`)
        return false
    end

    if not Result then
        return false
    end

    table.remove(From)

    -- A step that has moved is finished; a later set starts a run of its own.
    Step.Run = nil
    table.insert(To, Step)

    Announce(Plr)
    return true
end

--=============================================================================
-- The server's own handle on it
--=============================================================================

-- Takes back a player's most recent step in the scenes the server owns. What a
-- game would call from a button of its own; the client's History calls the
-- channel below, which lands here.
function History:Undo(Plr: Player): boolean
    const Shelf = Shelves[Plr]
    return if Shelf then Move(Plr, Shelf, Shelf.Undo, Shelf.Redo, false) else false
end

function History:Redo(Plr: Player): boolean
    const Shelf = Shelves[Plr]
    return if Shelf then Move(Plr, Shelf, Shelf.Redo, Shelf.Undo, true) else false
end

-- An action of the game's own, on this player's stack, in the order their own
-- edits are in: undoing reaches it exactly where it happened. For the things
-- Prism does not model -- a camera bookmark, a rename in a game's own data --
-- so that Ctrl+Z means one thing in an editor rather than two.
--
-- Push it as the action happens; Undo and Redo are how to take it back and do
-- it again, and Clear, if it holds anything, is where that goes when the step
-- can no longer be reached. It costs one action of the player's budget to
-- reverse, because there is no way from here to know what it does.
function History:Push(Plr: Player, Action: Action): boolean
    if type(Action) ~= "table" or type(Action.Undo) ~= "function" or type(Action.Redo) ~= "function" then
        Logger:Warn("A custom history action needs an Undo and a Redo function.")
        return false
    end

    const Shelf = ShelfFor(Plr)
    Push(Plr, Shelf, {Id = Shelf.Next, Entries = {}, Custom = Action})
    Shelf.Next += 1
    return true
end

function History:CanUndo(Plr: Player): boolean
    const Shelf = Shelves[Plr]
    return Shelf ~= nil and #Shelf.Undo > 0
end

-- How much each player's stack keeps: Steps by count, Objects by what the
-- steps hold between them. Either may be left out to keep what it was. Takes
-- effect at the next step recorded; nothing already kept is dropped by asking.
function History:SetLimits(Limits: {Steps: number?, Objects: number?})
    if Limits.Steps and Limits.Steps >= 1 then
        LIMIT = math.floor(Limits.Steps)
    end

    if Limits.Objects and Limits.Objects >= 0 then
        HELD_LIMIT = math.floor(Limits.Objects)
    end
end

function History:GetLimits(): {Steps: number, Objects: number}
    return {Steps = LIMIT, Objects = HELD_LIMIT}
end

function History:CanRedo(Plr: Player): boolean
    const Shelf = Shelves[Plr]
    return Shelf ~= nil and #Shelf.Redo > 0
end

-- Forgets everything this player could undo, and lets go of everything those
-- steps were holding. What a game calls when it hands the player a different
-- level to edit and the old one's steps would be nonsense.
function History:Clear(Plr: Player)
    const Shelf = Shelves[Plr]
    if not Shelf then
        return
    end

    ClearAll(Shelf.Undo)
    ClearAll(Shelf.Redo)
    Announce(Plr)
end

-- Just the redo stack. A new action forks the history, and this side forks its
-- own whenever it records one -- but the player's actions in a scene the client
-- owns are recorded over there, and they fork this half too. One order, one
-- fork.
function History:Fork(Plr: Player)
    const Shelf = Shelves[Plr]
    if not Shelf or #Shelf.Redo == 0 then
        return
    end

    ClearAll(Shelf.Redo)
    Announce(Plr)
end

--=============================================================================
-- Recording
--=============================================================================

-- A whole transaction is one step, which is what a transaction is for: one
-- packet, one permission pass, one thing to take back. Taking the record means
-- taking the objects its destroys suspended, so this answers true.
Transactions.OnApplied(function(Plr: Player, Record): boolean
    if Applying then
        return false
    end

    const Entries: {Entry} = {}
    local Creates = 0

    for Index, Operation in Record.Operations do
        const Op = Operation :: any

        if Op.Kind == "Create" then
            Creates += 1
            const Made = Record.Created[Creates]
            if Made then
                table.insert(Entries, {Kind = "Create" :: "Create", Target = Made})
            end
        elseif Op.Kind == "Set" then
            const Obj = Record.Targets[Index]
            if Obj then
                table.insert(Entries, {
                    Kind = "Set" :: "Set",
                    Target = Obj,
                    Property = Op.Property,
                    Before = Record.Before[Index],
                    After = Op.Value,
                })
            end
        elseif Op.Kind == "Destroy" then
            const Obj = Record.Targets[Index]

            -- Named twice in one transaction is one destroy by the time it
            -- lands, and the second naming has no object suspended of its own.
            if Obj and Obj.Suspended then
                table.insert(Entries, {Kind = "Destroy" :: "Destroy", Target = Obj})
            end
        end
    end

    for _, Live in Record.Loaded do
        table.insert(Entries, {Kind = "Load" :: "Load", Copy = Live})
    end

    for _, Live in Record.Withdrew do
        table.insert(Entries, {Kind = "Unload" :: "Unload", Copy = Live})
    end

    if #Entries == 0 then
        return false
    end

    const Shelf = ShelfFor(Plr)
    Push(Plr, Shelf, {Id = Shelf.Next, Entries = Entries})
    Shelf.Next += 1
    return true
end)

-- A single set, and a run of them to one property merged into one step, so a
-- drag undoes as the drag it was rather than as a hundred frames.
Objects.OnPlayerEdited(function(Plr, Obj, Property, Before, After)
    if Applying then
        return
    end

    const Now = os.clock()
    const Shelf = ShelfFor(Plr)
    const Top = Shelf.Undo[#Shelf.Undo]
    const Run = if Top then Top.Run else nil

    if
        Run
        and Run.Target == Obj.RuntimeId
        and Run.Property == Property
        and Now - Run.At <= MERGE_WINDOW
    then
        -- Still the same drag: the step now ends where this set did, and still
        -- begins where the first set in it started.
        Top.Entries[1].After = After
        Run.At = Now

        -- The run began with a push, which forked the history then. Anything
        -- that has arrived on the redo stack since is a step this player can no
        -- longer reach past a drag in progress, so it goes -- but only if there
        -- is any, because this runs once a frame for as long as the drag lasts
        -- and a packet a frame saying nothing changed is worse than the drag.
        if #Shelf.Redo > 0 then
            ClearAll(Shelf.Redo)
            Announce(Plr)
        end

        return
    end

    Push(Plr, Shelf, {
        Id = Shelf.Next,
        Entries = {{Kind = "Set" :: "Set", Target = Obj, Property = Property, Before = Before, After = After}},
        Run = {Target = Obj.RuntimeId, Property = Property, At = Now},
    })

    Shelf.Next += 1
end)

-- A lone destroy, which used to be the one edit nothing could take back: it
-- went through neither a transaction nor a set, so the client's history never
-- saw it. Claiming it here is what keeps the object.
Objects.OnRetired(function(Plr, Obj): boolean
    -- Nothing is kept while a step is being applied. A custom action that
    -- destroys something as part of undoing is destroying it for good, because
    -- the step it is part of is the thing that would have to bring it back and
    -- that step is already busy being that.
    if not Plr or Applying then
        return false
    end

    const Shelf = ShelfFor(Plr)
    Push(Plr, Shelf, {Id = Shelf.Next, Entries = {{Kind = "Destroy" :: "Destroy", Target = Obj}}})
    Shelf.Next += 1
    return true
end)

--=============================================================================
-- Channels
--=============================================================================

Network.Undo.OnInvoke = function(Plr: Player, Step: number): boolean
    const Shelf = Shelves[Plr]
    return if Shelf then Move(Plr, Shelf, Shelf.Undo, Shelf.Redo, false, Step) else false
end

Network.Redo.OnInvoke = function(Plr: Player, Step: number): boolean
    const Shelf = Shelves[Plr]
    return if Shelf then Move(Plr, Shelf, Shelf.Redo, Shelf.Undo, true, Step) else false
end

Network.Forget.OnInvoke = function(Plr: Player, RedoOnly: boolean): boolean
    if RedoOnly then
        History:Fork(Plr)
    else
        History:Clear(Plr)
    end

    return true
end

-- Their stacks go with them, and so does everything those stacks were holding.
-- Keeping them for a rejoin would mean keeping every object they had destroyed,
-- against a player who may never come back, in a world that has moved on.
Players.PlayerRemoving:Connect(function(Plr: Player)
    const Shelf = Shelves[Plr]
    if not Shelf then
        return
    end

    Shelves[Plr] = nil
    ClearAll(Shelf.Undo)
    ClearAll(Shelf.Redo)
end)

return History
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">IdPool</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Registry id allocation.
--
-- The previous per module GetNextFreeId scanned the whole registry on every call
-- and could never hand out an id below the lowest one already taken, so a pool
-- holding only id 2 would allocate 3 and leak 1 forever. This keeps a counter
-- plus a free set instead: O(1), reuses released ids, and refuses to hand out
-- anything the wire format cannot carry.

const Logger = require("./Logger")

export type IdPool = {
    Counter: number,
    Max: number,
    Recycle: boolean,
    Used: {[number]: true},
    Free: {[number]: true},

    Claim: (self: IdPool) -> number?,
    Release: (self: IdPool, Id: number) -> (),
    IsUsed: (self: IdPool, Id: number) -> boolean,
}

const IdPool = {}

-- The pool hands out ids and is never told which one to hand out. It used to
-- take one, for registries that wanted to pin an id, and that was a way to
-- reuse a retired one: an explicit claim only checked whether the id was in use
-- now, not whether it had ever been. Unregister a Number property called Plays,
-- register a Number called Rating under its old id, and every saved record
-- applies its Plays value as a Rating -- the types match, so nothing detects
-- it. Not being able to ask is what makes that unreachable.
const function __claim(self: IdPool): number?
    const Reused = next(self.Free)
    if Reused then
        self.Free[Reused] = nil
        self.Used[Reused] = true
        return Reused
    end

    if self.Counter >= self.Max then
        Logger:Error(`Id pool exhausted (max {self.Max}).`)
    end

    self.Counter += 1
    self.Used[self.Counter] = true
    return self.Counter
end

const function __release(self: IdPool, Id: number)
    if not self.Used[Id] then
        return
    end

    self.Used[Id] = nil

    -- A recycled id is silent corruption for anything persisted. Unregister a
    -- Number property called Plays, register a Number called Rating, let it
    -- reuse the same id, and every saved record applies its old Plays value as
    -- a Rating -- the types match, so nothing detects it.
    if self.Recycle then
        self.Free[Id] = true
    end
end

const function __is_used(self: IdPool, Id: number): boolean
    return self.Used[Id] == true
end

-- Recycle defaults to true, which suits runtime ids. Pass false for anything
-- whose ids end up inside saved data, where handing the same id to a different
-- meaning later would misread every record that still carries the old one.
--
-- Max stays at 65535 because the network layer addresses property ids with a
-- u16, even though storage now varints them and no longer cares.
function IdPool.new(Max: number?, Recycle: boolean?): IdPool
    const self = {}
    self.Counter = 0
    self.Max = Max or 65535
    self.Recycle = Recycle ~= false
    self.Used = {}
    self.Free = {}

    self.Claim = __claim
    self.Release = __release
    self.IsUsed = __is_used
    return self :: IdPool
end

return IdPool
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">Listeners</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Plain listener lists.
--
-- Change notification follows Properties and Selection: a list of callbacks and
-- a disconnect function, rather than a signal object standing there for the
-- many games that never listen. Each callback runs on a thread of its own, so
-- one that yields or throws holds up neither the rest nor the code that fired.

const Logger = require("./Logger")

const Listeners = {}

-- Adds a callback and hands back its disconnect, which is safe to call twice.
-- What names the thing being watched, for the error a non-function gets.
function Listeners.Watch(List: {any}, Callback: any, What: string): () -> ()
    if typeof(Callback) ~= "function" then
        Logger:Error(`Invalid callback. Tried watching {What} with a {typeof(Callback)}.`)
    end

    table.insert(List, Callback)

    local Disconnected = false
    return function()
        if Disconnected then
            return
        end

        Disconnected = true

        const Position = table.find(List, Callback)
        if Position then
            table.remove(List, Position)
        end
    end
end

-- Cloned first, so a callback that disconnects itself or connects another does
-- not change which ones this call reaches.
function Listeners.Notify(List: {any}, ...: any)
    for _, Callback in table.clone(List) do
        task.spawn(Callback, ...)
    end
end

return Listeners
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">Logger</string>
					<ProtectedString name="Source"><![CDATA[--!strict
const Logger = {}
const PREFIX = "[ PRISM ]"

function Logger:Log(Message: string)
    print(`{PREFIX} {Message}`)
end

function Logger:Warn(Message: string)
    warn(`{PREFIX} {Message}`)
end

-- Annotated never so the analyser knows control does not come back. Without it
-- every `if not X then Logger:Error(...) end` guard leaves X still nilable for
-- the rest of the function.
function Logger:Error(Message: string): never
    error(`{PREFIX} {Message}`, 2)
end

return Logger
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">Networking</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Schema driven transport.
--
-- Every channel declares the codec for each of its parameters in Channels.luau,
-- so a packet is a single buffer: one byte of channel id followed by the packed
-- arguments. Values that cannot be packed (Instances, registry tables) ride in a
-- side channel array next to the buffer.
--
-- Server to client invokes are deliberately absent: InvokeClient yields the
-- calling thread until the client answers, and a client that never answers holds
-- that thread forever. Push with Fire and let the client invoke back.

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

const Channels = require("./Channels")
const Codecs = require("./Codecs")
const Logger = require("./Logger")

const IS_SERVER = RunService:IsServer()
const WAIT_TIMEOUT = 10

export type Codec<T> = Codecs.Codec<T>

export type Entry = {
    Id: number,
    Name: string,
    Args: {Codec<any>},
    Returns: {Codec<any>}?,
    Connections: {(...any) -> ()},
    OnInvoke: ((...any) -> ...any)?,

    Fire: (self: Entry, ...any) -> (),
    FireAll: (self: Entry, ...any) -> (),
    Invoke: (self: Entry, ...any) -> ...any,
    Connect: (self: Entry, Callback: (...any) -> ()) -> () -> (),
}

const Networking = {}
const Registered: {Entry} = {}

local Event: RemoteEvent
local Function: RemoteFunction

const function Pack(Id: number, Schema: {Codec<any>}, Args: {any}, Count: number): (buffer, {any}?)
    -- Checked in both directions. Too few arguments used to fall through to a
    -- codec writing a nil, which surfaced as an opaque buffer error rather than
    -- naming the channel that was called wrongly.
    if Count ~= #Schema then
        Logger:Error(`Channel {Channels.List[Id].Name} takes {#Schema} argument(s), got {Count}.`)
    end

    const Extras = {}
    local Size = 1
    for Index = 1, #Schema do
        Size += Schema[Index].Measure(Args[Index])
    end

    const Buf = buffer.create(Size)
    buffer.writeu8(Buf, 0, Id)

    local Offset = 1
    for Index = 1, #Schema do
        Offset += Schema[Index].Write(Buf, Offset, Args[Index], Extras)
    end

    return Buf, if #Extras > 0 then Extras else nil
end

const function Unpack(Schema: {Codec<any>}, Buf: buffer, Extras: {any}?): {any}
    const Side = Extras or {}
    const Args = table.create(#Schema)

    local Offset = 1
    for Index, Codec in Schema do
        const Value, Length = Codec.Read(Buf, Offset, Side)
        Args[Index] = Value
        Offset += Length
    end

    return Args
end

-- Everything past this point may be handling a packet a client authored, so a
-- malformed buffer has to fail as a dropped packet rather than a thrown error.
const function Decode(Buf: any, Extras: any): (Entry?, {any}?)
    if typeof(Buf) ~= "buffer" or buffer.len(Buf) < 1 then
        return nil
    end

    if Extras ~= nil and typeof(Extras) ~= "table" then
        return nil
    end

    const Entry = Registered[buffer.readu8(Buf, 0)]
    if not Entry then
        return nil
    end

    const Ok, Args = pcall(Unpack, Entry.Args, Buf, Extras)
    if not Ok then
        return nil
    end

    return Entry, Args :: {any}
end

const function __fire(self: Entry, ...)
    if not IS_SERVER then
        const Buf, Extras = Pack(self.Id, self.Args, table.pack(...), select("#", ...))
        Event:FireServer(Buf, Extras)
        return
    end

    const Target = ...
    const Args = table.pack(select(2, ...))
    const Buf, Extras = Pack(self.Id, self.Args, Args, Args.n)

    if typeof(Target) == "Instance" and Target:IsA("Player") then
        Event:FireClient(Target, Buf, Extras)
        return
    end

    if type(Target) == "table" then
        for _, Plr in Target do
            if typeof(Plr) == "Instance" and Plr:IsA("Player") then
                Event:FireClient(Plr, Buf, Extras)
            end
        end

        return
    end

    Logger:Error(`Fire on {self.Name} needs a Player or a list of Players as its first argument.`)
end

const function __fire_all(self: Entry, ...)
    const Buf, Extras = Pack(self.Id, self.Args, table.pack(...), select("#", ...))
    if IS_SERVER then
        Event:FireAllClients(Buf, Extras)
    else
        Event:FireServer(Buf, Extras)
    end
end

const function __invoke(self: Entry, ...): ...any
    if IS_SERVER then
        Logger:Error(`Invoke on {self.Name} is client to server only.`)
    end

    const Buf, Extras = Pack(self.Id, self.Args, table.pack(...), select("#", ...))
    const Ok, ReturnBuf, ReturnExtras = Function:InvokeServer(Buf, Extras)
    if not Ok then
        Logger:Error(`No handler is registered on the server for {self.Name}.`)
    end

    const Returns = self.Returns
    if not Returns then
        return
    end

    return table.unpack(Unpack(Returns, ReturnBuf, ReturnExtras), 1, #Returns)
end

const function __connect(self: Entry, Callback: (...any) -> ()): () -> ()
    if typeof(Callback) ~= "function" then
        Logger:Error(`Invalid callback. Tried connecting a {typeof(Callback)} to {self.Name}.`)
    end

    table.insert(self.Connections, Callback)
    return function()
        const Position = table.find(self.Connections, Callback)
        if Position then
            table.remove(self.Connections, Position)
        end
    end
end

for Id, Channel in Channels.List do
    Registered[Id] = {
        Id = Id,
        Name = Channel.Name,
        Args = Channel.Args,
        Returns = Channel.Returns,
        Connections = {},
        OnInvoke = nil,

        Fire = __fire,
        FireAll = __fire_all,
        Invoke = __invoke,
        Connect = __connect,
    } :: Entry
end

if IS_SERVER then
    Event = Instance.new("RemoteEvent")
    Event.Name = "__prism_event"
    Event.Parent = ReplicatedStorage

    Function = Instance.new("RemoteFunction")
    Function.Name = "__prism_function"
    Function.Parent = ReplicatedStorage

    Event.OnServerEvent:Connect(function(Plr: Player, Buf: any, Extras: any)
        const Entry, Args = Decode(Buf, Extras)
        if not Entry or not Args then
            return
        end

        for _, Callback in table.clone(Entry.Connections) do
            task.spawn(Callback, Plr, table.unpack(Args, 1, #Entry.Args))
        end
    end)

    Function.OnServerInvoke = function(Plr: Player, Buf: any, Extras: any)
        const Entry, Args = Decode(Buf, Extras)
        if not Entry or not Args then
            return false
        end

        const Handler = Entry.OnInvoke
        if not Handler then
            return false
        end

        const Returns = Entry.Returns
        if not Returns then
            Handler(Plr, table.unpack(Args, 1, #Entry.Args))
            return true
        end

        const Results = table.pack(Handler(Plr, table.unpack(Args, 1, #Entry.Args)))
        const ReturnBuf, ReturnExtras = Pack(Entry.Id, Returns, Results, Results.n)
        return true, ReturnBuf, ReturnExtras
    end
else
    const FoundEvent = ReplicatedStorage:WaitForChild("__prism_event", WAIT_TIMEOUT)
    if not FoundEvent then
        Logger:Error("Failed to retrieve networking remote event.")
    end

    const FoundFunction = ReplicatedStorage:WaitForChild("__prism_function", WAIT_TIMEOUT)
    if not FoundFunction then
        Logger:Error("Failed to retrieve networking remote function.")
    end

    Event = FoundEvent :: RemoteEvent
    Function = FoundFunction :: RemoteFunction

    Event.OnClientEvent:Connect(function(Buf: any, Extras: any)
        const Entry, Args = Decode(Buf, Extras)
        if not Entry or not Args then
            return
        end

        for _, Callback in table.clone(Entry.Connections) do
            task.spawn(Callback, table.unpack(Args, 1, #Entry.Args))
        end
    end)
end

function Networking:Get(Name: string): Entry
    const Id = Channels.Ids[Name]
    if not Id then
        Logger:Error(`Unknown channel {Name}. Add it to Channels.luau.`)
    end

    return Registered[Id]
end

return Networking
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX19">
				<Properties>
					<string name="Name">Objects</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX20">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const CollectionService = game:GetService("CollectionService")
const Players = game:GetService("Players")

const Properties = require("../Properties/Client")
const PropertyTypes = require("../Properties/Types")
const Compressor = require("../Compressor")
const Network = require("./Network")
const Shared = require("./Shared")
const Handles = require("../Handles")
const Logger = require("../Logger")
const Listeners = require("../Listeners")
const Types = require("./Types")

export type ObjectIdentifier = Types.ObjectIdentifier
export type ObjectRegistry = Types.ObjectRegistry
export type RuntimeId = Types.RuntimeId
export type Object = Types.Object

const Objects = {}

const Registered: {[ObjectIdentifier]: ObjectRegistry} = {}
const Workspace: {[RuntimeId]: Object} = {}
const ByPart: {[Instance]: RuntimeId} = setmetatable({}, {__mode = "k"}) :: any

-- The other direction, and the reason an object can find its instance at all
-- when the reference sent beside it did not survive: a tagged part carries its
-- runtime id, so it can be filed here before its object arrives and claimed
-- afterwards. Weak valued, so a part that is destroyed or streamed out is not
-- held here by this table alone.
const ByRuntimeId: {[RuntimeId]: Instance} = setmetatable({}, {__mode = "v"}) :: any

-- Objects grouped by the live scene copy holding them. A copy going away is one
-- packet naming it, not an ObjectRemoved per object, so the client has to be
-- able to answer for a whole copy without walking the workspace.
--
-- By copy and not by scene, because a scene can be live more than once and an
-- editor showing two copies of one room has to keep them apart.
const ByInstance: {[Types.SceneInstanceId]: {[RuntimeId]: Object}} = {}

-- The same objects by the id a reference names them with, per copy. A local id
-- is unique only inside one copy, so this is two levels deep for the same
-- reason instance:Find is scoped to a copy.
const LocalIds: {[Types.SceneInstanceId]: {[number]: Object}} = {}

-- Which scene each live copy came from. Kept here rather than in Scenes/Client
-- because an arriving object needs it to work out its own persistent identity,
-- and Objects cannot require Scenes without a cycle.
const InstanceScene: {[Types.SceneInstanceId]: Types.SceneIdentifier} = {}

-- The folder this client draws each opened copy into. A copy with no entry
-- here is one the server loaded, whose parts are the server's.
const DrawInto: {[Types.SceneInstanceId]: Folder} = {}

-- Copies of scenes this client owns. The distinction the server never has to
-- make and this side cannot do without: an edit to one of these applies here
-- and now, and an edit to any other copy is a request. A transaction reads it
-- to know whether committing means sending a packet or doing the work.
const LocalCopies: {[Types.SceneInstanceId]: true} = {}

-- Scenes this client owns, by id. Kept beside the copies because a scene can be
-- asked for before it has any: loading one is exactly the case where there are
-- no copies yet to read the answer off.
const LocalScenes: {[Types.SceneIdentifier]: true} = {}

-- Every object appearing here and going, whichever way it came: replicated
-- from the server, built in a scene this client owns, or drawn for a copy the
-- server opened. UI used to poll GetWorkspace to notice any of it.
-- Restored says the object came back from a pack under the id it was saved
-- with -- a copy reading itself in, rather than anything anyone did. A history
-- would record a step per object in a level without it.
const Added: {(Obj: Object, Restored: boolean) -> ()} = {}
const Removed: {(Obj: Object) -> ()} = {}

-- This client's own edits through Object:Set, with the value either side --
-- which is what an undo history records. Not changes arriving from the server
-- or another player, and not a refused set rolling back.
const Edited: {(Obj: Object, Property: PropertyTypes.PropertyIdentifier, Before: any, After: any) -> ()} = {}

function Objects:OnEdited(Callback: (Obj: Object, Property: PropertyTypes.PropertyIdentifier, Before: any, After: any) -> ()): () -> ()
    return Listeners.Watch(Edited, Callback, "edits")
end

-- Fired once the object is filed everywhere it will be, so a listener can look
-- it up by runtime id or through its copy straight away.
function Objects:OnAdded(Callback: (Obj: Object, Restored: boolean) -> ()): () -> ()
    return Listeners.Watch(Added, Callback, "objects appearing")
end

-- Fired after teardown, so the object handed over already reports Destroyed
-- and is gone from the workspace. It still carries its ids, which is what a
-- listener needs to drop whatever it kept for it.
function Objects:OnRemoved(Callback: (Obj: Object) -> ()): () -> ()
    return Listeners.Watch(Removed, Callback, "objects going")
end

--=============================================================================
-- Locks
--=============================================================================

-- Who holds each locked object, by runtime id, as the server last said. Told
-- only for scenes this player is admitted to.
-- Which objects are held, and by whom where that is a person. A holder need
-- not be one -- the server can hold an object while it animates it -- so being
-- held and being held by somebody are two different questions and get two
-- tables' worth of answer: an entry here means held, and its value is the user
-- id or nil.
const Locks: {[RuntimeId]: true} = {}
const Holders: {[RuntimeId]: number} = {}
const LockChanged: {(RuntimeId: RuntimeId, UserId: number?, Held: boolean) -> ()} = {}

-- One object's hold as this client now knows it, from whichever of two places
-- says so first: the answer to its own Lock or Unlock, or the broadcast. Both
-- arrive for this client's own holds, so listeners hear a change once rather
-- than the same hold twice.
const function Record(Identifier: RuntimeId, IsHeld: boolean, UserId: number?)
    const Holder = if IsHeld then UserId else nil
    if (Locks[Identifier] == true) == IsHeld and Holders[Identifier] == Holder then
        return
    end

    Locks[Identifier] = if IsHeld then true else nil
    Holders[Identifier] = Holder

    Listeners.Notify(LockChanged, Identifier, Holder, IsHeld)
end

-- Whether someone other than this player holds an object, as far as this client
-- has been told. The server refuses an edit to it whatever this says; asking
-- here first is what keeps an edit that is bound to be refused from showing on
-- screen and then snapping back.
const function HeldByOther(RuntimeId: RuntimeId): boolean
    return Locks[RuntimeId] == true and Holders[RuntimeId] ~= Players.LocalPlayer.UserId
end

const function Named(Refs: Object | {Object}): {Object}
    return if (Refs :: any).RuntimeId ~= nil then {Refs :: Object} else Refs :: {Object}
end

-- The ids worth asking the server about. An object in a scene this client owns
-- is nobody else's to touch, so there is nothing to lock.
const function Remote(List: {Object}): {RuntimeId}
    const Ids = {}
    for _, Obj in List do
        if not Obj.Local and not Obj.Destroyed then
            table.insert(Ids, Obj.RuntimeId)
        end
    end

    return Ids
end

-- Takes an object, or several at once, all or none. Yields for the server's
-- answer: while this player holds them, nobody else may edit or destroy them.
function Objects:Lock(Refs: Object | {Object}): boolean
    const Ids = Remote(Named(Refs))
    if #Ids == 0 then
        return true
    end

    const Ok, Granted = pcall(function()
        return Network.Lock:Invoke(Ids)
    end)

    if not Ok or Granted ~= true then
        return false
    end

    -- Recorded from the answer rather than left to the broadcast. The answer
    -- comes back on the remote function and the broadcast on the remote event,
    -- and Roblox orders nothing across the two, so IsLocked used to say free
    -- for a moment after Lock had said yes.
    const Me = Players.LocalPlayer.UserId
    for _, Identifier in Ids do
        Record(Identifier, true, Me)
    end

    return true
end

-- Lets go of what this player holds among the objects named. False if any of
-- them is held by someone else.
function Objects:Unlock(Refs: Object | {Object}): boolean
    const Ids = Remote(Named(Refs))
    if #Ids == 0 then
        return true
    end

    const Ok, Released = pcall(function()
        return Network.Unlock:Invoke(Ids)
    end)

    if not Ok or Released ~= true then
        return false
    end

    -- True means nobody else holds any of them, so every one named is free
    -- now: this player let go of it or nobody held it. A false answer released
    -- some and not others, and which is left to the broadcast.
    for _, Identifier in Ids do
        Record(Identifier, false, nil)
    end

    return true
end

-- The same, for a transaction the server applied: it takes and releases holds
-- in its own packet and has the same answer to record ahead of the broadcast.
function Objects.RecordHolds(Ids: {RuntimeId}, IsHeld: boolean)
    const Me = if IsHeld then Players.LocalPlayer.UserId else nil
    for _, Identifier in Ids do
        Record(Identifier, IsHeld, Me)
    end
end

-- The user id holding an object, or nil when it is free, when the holder is not
-- a person, or when this player is not admitted to its scene and so is not told.
-- IsLocked answers the other half: whether anything holds it at all.
function Objects:GetLock(Ref: Object | RuntimeId): number?
    return Holders[if type(Ref) == "number" then Ref else Ref.RuntimeId]
end

function Objects:IsLocked(Ref: Object | RuntimeId): boolean
    return Locks[if type(Ref) == "number" then Ref else Ref.RuntimeId] == true
end

-- Fired with a runtime id, the user id now holding it -- nil for nobody or for
-- a holder that is not a person -- and whether it is held at all.
function Objects:OnLockChanged(Callback: (RuntimeId: RuntimeId, UserId: number?, Held: boolean) -> ()): () -> ()
    return Listeners.Watch(LockChanged, Callback, "locks")
end

-- A scene this player is no longer admitted to stops telling them its locks,
-- so what they knew of them is dropped rather than left to go stale.
function Objects.ForgetLocks(Scene: Types.SceneIdentifier)
    for Identifier in table.clone(Locks) do
        const Obj = Workspace[Identifier]
        if not Obj or Obj.Scene == Scene then
            Locks[Identifier] = nil
            Holders[Identifier] = nil
            Listeners.Notify(LockChanged, Identifier, nil, false)
        end
    end
end

const function Index(Obj: Object)
    local Held = ByInstance[Obj.InstanceId]
    if not Held then
        Held = {}
        ByInstance[Obj.InstanceId] = Held
    end

    Held[Obj.RuntimeId] = Obj

    local ByLocal = LocalIds[Obj.InstanceId]
    if not ByLocal then
        ByLocal = {}
        LocalIds[Obj.InstanceId] = ByLocal
    end

    ByLocal[Obj.LocalId] = Obj
end

const function Unindex(Obj: Object)
    const ByLocal = LocalIds[Obj.InstanceId]
    if ByLocal then
        -- Only if it is still the one filed there, like the server's Release.
        -- An object rebuilt under the id a torn down one held must not have the
        -- loser clear the winner's entry.
        if ByLocal[Obj.LocalId] == Obj then
            ByLocal[Obj.LocalId] = nil
        end

        if next(ByLocal) == nil then
            LocalIds[Obj.InstanceId] = nil
        end
    end

    const Held = ByInstance[Obj.InstanceId]
    if not Held then
        return
    end

    Held[Obj.RuntimeId] = nil
    if next(Held) == nil then
        ByInstance[Obj.InstanceId] = nil
    end
end

-- One object in one copy by the id a reference stores. The server reads its
-- copy's ByLocal for this; a copy the server owns has no such table on this
-- side, so the index above is kept for every object the client holds however it
-- arrived -- replicated, drawn, or built in a scene this client owns.
const function Find(Copy: Types.SceneInstanceId, Local: number): Object?
    const ByLocal = LocalIds[Copy]
    return if ByLocal then ByLocal[Local] else nil
end

-- Every optimistic set takes a ticket, and only the newest outstanding one for
-- a property is allowed to roll back. Dragging issues a set per frame: without
-- this, a refusal for frame 1 arriving after frame 2 applied would roll the
-- value back to what it held before frame 1 and discard frame 2 entirely.
-- Weak keyed so a destroyed object's properties do not pin entries here.
local Ticket = 0
const Pending: {[any]: number} = setmetatable({}, {__mode = "k"}) :: any

-- The value the server has actually asserted for a property. A refusal rolls
-- back to this rather than to whatever was on screen just before the refused
-- set: two refused sets in a row used to leave the second one's starting value
-- in place, which is the first refused value, and no broadcast follows a
-- refusal to correct it. Seeded when the object arrives, updated on every
-- PropertyChanged.
const Confirmed: {[any]: any} = setmetatable({}, {__mode = "k"}) :: any

-- Properties being set with ClientSided, and the value each held before the
-- first of those sets. A drag used to send a set per frame, which at sixty
-- frames a second sat exactly on the default budget: the limiter refused half
-- way through and every refusal snapped the value back while the player was
-- still holding it. The game knows when a drag starts and ends and the wire
-- does not, so the game says so: every frame is shown here and nowhere else,
-- and the set that ends it is the one edit anybody hears about, starting from
-- the value it started from. Weak keyed, like the two tables above.
const Previewing: {[any]: {Before: any}} = setmetatable({}, {__mode = "k"}) :: any

-- Starts or continues a preview: the value is shown and nothing else happens.
-- Nobody is told of an edit, because there has not been one yet.
const function Preview(Prop: any, Val: any): boolean
    if not Previewing[Prop] then
        Previewing[Prop] = {Before = Prop.Value}
    end

    const Accepted = Prop:Set(Val)
    return Accepted
end

-- Runtime ids for objects this client made itself, counted down from the top
-- while the server counts up from one. The two meet only if a single session
-- mints four billion objects, and a local id never crosses the wire in any
-- case: a local object is not replicated, and committing its scene sends a
-- pack, which carries no runtime ids at all.
const MAX_RUNTIME_ID = 4294967295
local LocalRuntime = MAX_RUNTIME_ID

-- The copy each object of a scene this client owns was built in, so it can be
-- duplicated back into it. Weak keyed: an object nobody holds any more is not
-- kept alive by this table alone.
const LocalCopy: {[any]: any} = setmetatable({}, {__mode = "k"}) :: any

-- Types already warned about, so a template that cannot be seen here is said
-- once rather than once per object.
const WarnedTemplate: {[ObjectIdentifier]: true} = {}

-- The template to build a type's instances from here, for an object in a scene
-- this client owns or in a copy it draws. Warned about the first time it is
-- missing for a type that has one -- the moment it matters, and on the side it
-- matters to. Registration used to guess from where the template sat, which
-- warned for every type in ServerStorage, including every type in a game whose
-- clients never build anything.
const function TemplateOf(Registry: ObjectRegistry): Instance?
    if Registry.Instance then
        return Registry.Instance
    end

    if Registry.HasTemplate and not WarnedTemplate[Registry.Id] then
        WarnedTemplate[Registry.Id] = true
        Logger:Warn(`Object {Registry.Name} has a template that does not replicate to this client, so its objects are built here with no instance. Put the template in ReplicatedStorage.`)
    end

    return nil
end

const function __getter(self: Object, Reference: Types.PropertyReference): any?
    const Prop = Shared.GetProperty(self, Reference)
    if not Prop then
        return nil
    end

    const Value = if Prop.Value == nil then Prop.DefaultValue else Prop.Value

    -- The live object rather than the id it is stored as, exactly as on the
    -- server. Nil while the target has not replicated here yet, which is the
    -- same nil a destroyed target reads as: the id is kept either way, so the
    -- link comes back the moment the object does.
    if Prop.Type == "Object" then
        return Shared.ResolveReference(self.InstanceId, Value, Find)
    end

    return Value
end

-- Applies locally first, then confirms with the server on a separate thread. The
-- previous version blocked the caller on a RemoteFunction for every single set,
-- which in an editor means a yield per axis per frame while dragging.
--
-- If the server refuses (permissions, validation) the local value rolls back.
-- If it accepts, its PropertyChanged broadcast reasserts the authoritative value.
--
-- ClientSided shows the value here and sends nothing; see Previewing. The next
-- set without it sends the value it lands on, once, even when the preview had
-- already put that value on screen.
const function __setter(self: Object, Reference: Types.PropertyReference, Value: any?, ClientSided: boolean?): boolean
    const Prop = Shared.GetProperty(self, Reference)
    if not Prop then
        return false
    end

    -- Held by somebody else: the server would refuse it, and an optimistic set
    -- would show the value and then take it back. A preview already open when
    -- the hold was taken is put back now, since nothing can land it.
    if HeldByOther(self.RuntimeId) then
        if Previewing[Prop] then
            Previewing[Prop] = nil
            Prop:Set(Confirmed[Prop])
        end

        return false
    end

    -- A reference given as the target object, resolved to the id that is
    -- actually stored before anything is applied or sent. Refused here rather
    -- than by the server, which would cost a round trip to be told what this
    -- side already knows.
    const Holdable, Val = Shared.Accept(self, Prop, Value, Find)
    if not Holdable then
        return false
    end

    if ClientSided then
        return Preview(Prop, Val)
    end

    -- A preview ending. What it showed was never sent, so the edit runs from
    -- where the server last had it rather than from the frame before.
    const Held = Previewing[Prop]
    Previewing[Prop] = nil

    const Before = if Held then Held.Before else Prop.Value
    const Accepted, Changed = Prop:Set(Val)
    if not Accepted then
        if Held then
            Prop:Set(Confirmed[Prop])
        end

        return false
    end

    -- Setting a property to the value it already holds is a no-op, not a reason
    -- to spend a round trip. After a preview the question is whether it differs
    -- from what the server holds, not from the last frame: a drag let go where
    -- it started is a cancel, and costs nothing.
    if Held then
        if Prop.Value == Confirmed[Prop] then
            return true
        end
    elseif not Changed then
        return true
    end

    -- Told as it is made, like the value is shown. A refusal rolls the value
    -- back without telling anyone, which leaves an undo of it with nothing to
    -- do: the property no longer holds what the edit set.
    Listeners.Notify(Edited, self, Prop.Parent, Before, Prop.Value)

    const Compressed = Compressor:CompressValue(Prop.Type, Prop.Value)
    if not Compressed then
        return false
    end

    const RuntimeId = self.RuntimeId
    const PropId = Prop.Parent

    Ticket += 1
    const Mine = Ticket
    Pending[Prop] = Mine

    task.spawn(function()
        const Ok, Allowed = pcall(function()
            return Network.SetProperty:Invoke(RuntimeId, PropId, Compressed)
        end)

        -- Superseded while in flight: the newer set owns the value now, and its
        -- own answer will decide whether to roll back.
        if Pending[Prop] ~= Mine then
            return
        end

        Pending[Prop] = nil

        -- A new drag started while this was in flight. The refused value is
        -- already off screen, and the drag's own last set will be judged on
        -- its own; snapping back now would yank it out of the player's hand.
        if (not Ok or not Allowed) and not self.Destroyed and not Previewing[Prop] then
            Prop:Set(Confirmed[Prop])
        end
    end)

    return true
end

const function __destroy(self: Object): boolean
    -- Not worth the round trip: the server refuses a destroy of an object
    -- somebody else holds, and this client already knows they do.
    if self.Destroyed or HeldByOther(self.RuntimeId) then
        return false
    end

    const Ok, Allowed = pcall(function()
        return Network.Destroy:Invoke(self.RuntimeId)
    end)

    return Ok and Allowed == true
end

-- Leaving the world, which is not the same as ceasing to exist. Everything here
-- can be taken back: the object is unfiled, its part goes and anything watching
-- is told it went, but the table, its values and both its ids survive. A scene
-- this client owns is the client's to undo in, and an undone destroy has to
-- bring back the object it took -- under its own local id, or every reference
-- to it comes back pointing at nothing.
const function Withdraw(Obj: Object)
    Shared.ReleaseLinks(Obj.Links)
    Obj.Links = nil

    if Obj.Instance then
        ByPart[Obj.Instance] = nil

        -- A local or drawn part was cloned here, so it is this side's to move:
        -- out of the world and kept, so an object that comes back comes back
        -- with the part it had rather than a fresh copy of the template.
        -- Destroying it is Dispose's, once nothing can bring the object back.
        --
        -- A replicated one belongs to the server and goes when the server takes
        -- it away. There is nothing here to keep and nothing here to destroy,
        -- so only the reference is dropped.
        if Obj.Local or Obj.Drawn then
            Obj.Instance.Parent = nil
        else
            Obj.Instance = nil
        end
    end

    ByRuntimeId[Obj.RuntimeId] = nil
    Unindex(Obj)

    -- Its removal is the only news a listener needs; no lock change follows.
    Locks[Obj.RuntimeId] = nil
    Holders[Obj.RuntimeId] = nil

    -- Out of the scene copy before out of the workspace, so a copy walking its
    -- own objects while they are torn down never sees one that is already gone
    -- from the world but still listed as its own.
    if Obj.Release then
        Obj.Release()
        Obj.Release = nil
    end

    -- Cleared here rather than by each caller. The two callers that come off
    -- the wire did it themselves and a local Destroy did not, so an object this
    -- client destroyed stayed answerable through Objects:Get for the rest of
    -- the session -- destroyed, but still there to be found.
    Workspace[Obj.RuntimeId] = nil

    -- Not table.clear: a stale reference should still be able to report its own
    -- handle and read Destroyed rather than turning into an empty table
    -- whose every method throws.
    Obj.Get = Shared.Destroyed.Get
    Obj.Set = Shared.Destroyed.Set
    Obj.GetProperty = Shared.Destroyed.GetProperty
    Obj.OnChange = Shared.Destroyed.OnChange
    Obj.Destroy = Shared.Destroyed.Destroy

    Listeners.Notify(Removed, Obj)
end

-- The part that cannot be taken back: the values go, the part this side owns
-- goes, and with them any chance of this object being itself again.
const function Dispose(Obj: Object)
    Obj.Suspended = nil

    -- Only ever one this client cloned: a replicated part is the server's and
    -- Withdraw already let go of the reference to it.
    if Obj.Instance then
        Obj.Instance:Destroy()
        Obj.Instance = nil
    end

    for _, Prop in Obj.Properties do
        Prop:Destroy()
    end
end

const function Teardown(Obj: Object)
    if Obj.Destroyed then
        return
    end

    Obj.Destroyed = true
    Withdraw(Obj)
    Dispose(Obj)
end

--=============================================================================
-- Scenes this client owns
--=============================================================================

-- A local object answers for itself. There is nobody to ask, nothing to roll
-- back to and no broadcast coming to confirm it: for a scene the client owns,
-- the client is the authority, which is the whole point of owning one.
--
-- Links still fire, because a link is a listener on the property rather than
-- anything to do with the network.
--
-- ClientSided means the same here as on a replicated object, although nothing
-- is sent either way: the edit is told once, when the preview ends, so a drag
-- is one step of history however long the player paused in the middle of it.
const function __local_setter(self: Object, Reference: Types.PropertyReference, Value: any?, ClientSided: boolean?): boolean
    const Prop = Shared.GetProperty(self, Reference)
    if not Prop then
        return false
    end

    const Holdable, Val = Shared.Accept(self, Prop, Value, Find)
    if not Holdable then
        return false
    end

    if ClientSided then
        return Preview(Prop, Val)
    end

    const Held = Previewing[Prop]
    Previewing[Prop] = nil

    const Before = if Held then Held.Before else Prop.Value
    const Accepted = Prop:Set(Val)

    -- Against where the preview started rather than the last frame, for the
    -- same reason as the replicated setter: let go where it began is no edit.
    if Accepted and Prop.Value ~= Before then
        Listeners.Notify(Edited, self, Prop.Parent, Before, Prop.Value)
    end

    return Accepted
end

const function __local_destroy(self: Object): boolean
    if self.Destroyed then
        return false
    end

    Objects.Retire(self)
    return true
end

-- What every object here shares, filed into the tables the workspace is read
-- through. Set and Destroy are the caller's: a replicated object asks the
-- server for both, a local one does neither.
const function File(Obj: any, Order: {PropertyTypes.PropertyIdentifier})
    Obj.Names = Shared.BuildNameMap(Order, Obj.Properties)
    Obj.Get = __getter
    Obj.GetProperty = Shared.GetProperty
    Obj.OnChange = Shared.OnChange

    Workspace[Obj.RuntimeId] = Obj
    Index(Obj)

    if Obj.Instance then
        ByPart[Obj.Instance] = Obj.RuntimeId
        ByRuntimeId[Obj.RuntimeId] = Obj.Instance
    end
end

-- Everything being in a copy this client owns means: a part cloned from the
-- template, links wired to it, a place in the copy and in the workspace, and
-- the signal saying so. The inverse of Withdraw, and written once because an
-- object coming back from a suspend has to arrive exactly as one just built
-- does -- anything this did that reviving forgot would show up only as an
-- undone destroy behaving unlike the object it restored.
--
-- The template came with the registry, and is nil if it lives somewhere that
-- never replicates here. The type still builds objects then; they simply have
-- no instance, which is what a server side object registered without one does.
const function Enter(Obj: any, Ref: ObjectRegistry, Live: any, Restored: boolean?)
    -- Already holding one means this object was withdrawn rather than
    -- destroyed, and its part was parented out of the world and kept. It goes
    -- back rather than being cloned again: a clone would only look like the
    -- part that left.
    local Inst: Instance? = Obj.Instance

    if Inst then
        Inst.Parent = Live.Folder
    else
        const Template = TemplateOf(Ref)
        if Template then
            const Clone = Template:Clone()
            Clone:SetAttribute(Shared.RuntimeAttribute, Obj.RuntimeId)
            CollectionService:AddTag(Clone, Shared.ObjectTag)

            -- Into the copy holding it, exactly as on the server: two copies of
            -- one room have to be able to sit in two places, and the copy's
            -- folder is what moves them.
            Clone.Parent = Live.Folder

            Inst = Clone
        end
    end

    Obj.Instance = Inst

    -- Wired after the values are in place, so a link starts at the object's own
    -- value rather than at the registry default and then being corrected.
    Obj.Links = Shared.BuildLinks(Inst, Ref.Links, Obj.Properties)
    Obj.Set = __local_setter
    Obj.Destroy = __local_destroy

    Obj.Release = function()
        Live.Objects[Obj.RuntimeId] = nil

        if Live.ByLocal[Obj.LocalId] == Obj then
            Live.ByLocal[Obj.LocalId] = nil
        end
    end

    File(Obj, Ref.Properties)
    Live.Objects[Obj.RuntimeId] = Obj
    Live.ByLocal[Obj.LocalId] = Obj
    LocalCopy[Obj] = Live

    Listeners.Notify(Added, Obj, Restored == true)
end

-- The client's own constructor, and deliberately not the server's: no
-- announcement, no permission pass, no round trip, because nothing outside this
-- client has a claim on the object.
--
-- LocalId is the object's id within its scene. Creating mints the next one;
-- restoring from a pack passes the id the object was saved under, which is what
-- makes a reference survive a reload here exactly as it does on the server.
const function Construct(
    Reference: ObjectRegistry | ObjectIdentifier,
    InitialValues: {[PropertyTypes.PropertyIdentifier]: any}?,
    Live: any,
    LocalId: number?
): Object
    const TypeOf = typeof(Reference)
    local Ref: ObjectRegistry

    if TypeOf == "number" then
        Ref = Registered[Reference :: ObjectIdentifier]
        if not Ref then
            Logger:Error(`Invalid object reference. No object registered with id {Reference}.`)
        end
    elseif TypeOf == "table" then
        Ref = Reference :: ObjectRegistry
    else
        Logger:Error(`Invalid object reference. Expected a registry or an id, got {TypeOf}.`)
    end

    if not Ref or not Ref.Id or not Registered[Ref.Id] then
        Logger:Error("Invalid object reference. The registry it points at is not registered.")
    end

    -- A copy of a scene this client owns, and nothing else. A scene the server
    -- owns is edited by asking it to, which is what a transaction is for; there
    -- is no such thing as creating into one from here.
    if not Live or not Live.ByLocal then
        Logger:Error("Objects.new on the client needs a copy of a scene this client owns. Load one with Scenes.new, or edit a server scene through a transaction.")
    end

    const Owner = Live.Owner
    local Local = LocalId

    if Local then
        if Live.ByLocal[Local] then
            Logger:Error(`Scene {Owner.Name} already holds an object with local id {Local} in this copy.`)
        end

        Owner.LastId = math.max(Owner.LastId, Local)
    else
        if Owner.LastId >= Handles.MAX_LOCAL then
            Logger:Error(`Scene {Owner.Name} has exhausted its object id space.`)
        end

        Owner.LastId += 1
        Local = Owner.LastId
    end

    if LocalRuntime <= 0 then
        Logger:Error("Local runtime id space exhausted.")
    end

    const RuntimeId = LocalRuntime
    LocalRuntime -= 1

    const Props = Shared.BuildProperties(Ref.Properties)
    if InitialValues then
        for PropertyId, Value in InitialValues do
            const Prop = Props[PropertyId]
            if not Prop then
                continue
            end

            -- Against the copy the object is going into, as on the server: a
            -- reference is read against a copy, and the object carrying it does
            -- not exist yet.
            if Prop.Type == "Object" then
                const Target, Why = Shared.Reference(Live.Id, Prop, Value, Find)
                if Target == nil then
                    Logger:Warn(`Dropped the initial value of {Prop.Name} on {Ref.Name}: {Why}.`)
                    continue
                end

                Prop:Set(Target)
                continue
            end

            Prop:Set(Value)
        end
    end

    const Obj = {}
    Obj.RuntimeId = RuntimeId
    Obj.PersistentId = Handles.Join(Live.Scene, Local :: number)
    Obj.Scene = Live.Scene
    Obj.LocalId = Local
    Obj.InstanceId = Live.Id
    Obj.Registry = Ref.Id
    Obj.Name = Ref.Name
    Obj.Local = true
    Obj.Destroyed = false
    Obj.Properties = Props

    -- Restored when it was given the id it was saved under, which is a copy
    -- reading its pack rather than anybody creating anything. A history that
    -- did not know the difference would record a step for every object in a
    -- level the moment it loaded.
    Enter(Obj, Ref, Live, LocalId ~= nil)
    return Obj :: any
end

-- Creates an object in a copy of a scene this client owns. Target is that copy
-- and is not optional: the implicit Default scene is the server's, and this
-- side has no equivalent to fall back on.
function Objects.new(
    Reference: ObjectRegistry | ObjectIdentifier,
    InitialValues: {[PropertyTypes.PropertyIdentifier]: any}?,
    Target: any
): Object
    return Construct(Reference, InitialValues, Target, nil)
end

-- Rebuilds an object under the id it was saved with, for a local scene reading
-- its own pack back.
function Objects.restore(Target: any, Decompressed: any): Object?
    if not Registered[Decompressed.Registry] then
        Logger:Warn(`Failed to restore object. Object type {Decompressed.Registry} is not registered.`)
        return nil
    end

    const Obj = Construct(Decompressed.Registry, Decompressed.Properties, Target, Decompressed.LocalId)
    Obj.Unknown = Shared.Leftovers(Obj, Decompressed)
    return Obj
end

-- A new object of the same type holding the same values, in the same copy of a
-- scene this client owns. An object the server holds is duplicated by asking
-- it to, which is a transaction's Duplicate: this module cannot build one,
-- because Transactions is built on it.
function Objects:Duplicate(Obj: Object): Object?
    if Obj.Destroyed then
        return nil
    end

    const Live = LocalCopy[Obj]
    if not Obj.Local or not Live then
        Logger:Warn(`{Obj.Name} is the server's to duplicate. Use Transactions.new():Duplicate(object):Commit().`)
        return nil
    end

    const New = Construct(Obj.Registry, Shared.Snapshot(Obj), Live, nil)
    New.Unknown = if Obj.Unknown then table.clone(Obj.Unknown) else nil
    return New
end

-- The group form, for scenes this client owns. References that point inside the
-- group follow the copies; references that point outside it are left as they
-- are. See the server's DuplicateGroup, which this mirrors -- with no
-- announcement to batch, because nothing here is replicated.
function Objects:DuplicateGroup(List: {Object}): {Object}
    const Sources: {Object} = {}
    const Made: {Object} = {}
    const Counterpart: {[Object]: Object} = {}

    for _, Obj in List do
        if Obj.Destroyed then
            continue
        end

        const Live = LocalCopy[Obj]
        if not Obj.Local or not Live then
            Logger:Warn(`{Obj.Name} is the server's to duplicate. Use Transactions.new():DuplicateGroup(objects):Commit().`)
            continue
        end

        const New = Construct(Obj.Registry, Shared.Snapshot(Obj), Live, nil)
        New.Unknown = if Obj.Unknown then table.clone(Obj.Unknown) else nil

        table.insert(Sources, Obj)
        table.insert(Made, New)
        Counterpart[Obj] = New
    end

    for Index, New in Made do
        const Source = Sources[Index]

        for PropertyId, Prop in New.Properties do
            if Prop.Type ~= "Object" then
                continue
            end

            const Was = Source.Properties[PropertyId]
            const Pointed = if Was then Shared.ResolveReference(Source.InstanceId, Was.Value, Find) else nil
            if not Pointed then
                continue
            end

            const Instead = Counterpart[Pointed]
            if Instead then
                Prop:Set(Instead.LocalId)
            end
        end
    end

    return Made
end

--=============================================================================
-- Retiring
--=============================================================================

-- The client's half of deferred destruction, and only for scenes it owns: an
-- object the server holds is destroyed where it lives, and what arrives here is
-- the packet saying so. See Objects/Server, which this mirrors -- with no
-- announcement and no permission pass, because a local object is nobody else's.

const Keepers: {(Obj: Object) -> boolean} = {}

-- Synchronous, and answers, for the reason the server's does: the object is
-- disposed the moment nothing claims it.
function Objects.OnRetired(Callback: (Obj: Object) -> boolean): () -> ()
    return Listeners.Watch(Keepers, Callback, "retired objects")
end

function Objects.Suspend(Obj: Object): boolean
    if Obj.Destroyed then
        return false
    end

    Obj.Destroyed = true
    Obj.Suspended = true
    Withdraw(Obj)
    return true
end

-- Back into the copy it left, as itself. False when that copy has been
-- unloaded: its objects are gone, its ids mean nothing, and there is nowhere
-- for this one to return to.
function Objects.Revive(Obj: Object): boolean
    if not Obj.Suspended then
        return false
    end

    const Live = LocalCopy[Obj]
    const Ref = Registered[Obj.Registry]
    if not Live or not Ref or Live.Owner.Instances[Live.Id] ~= Live then
        return false
    end

    if Live.ByLocal[Obj.LocalId] then
        return false
    end

    Obj.Suspended = nil
    Obj.Destroyed = false
    Enter(Obj, Ref, Live)
    return true
end

function Objects.Dispose(Obj: Object)
    if not Obj.Suspended then
        return
    end

    Dispose(Obj)
end

-- Suspend, offer, and dispose if nobody wanted it back. What Object:Destroy on
-- a local object comes down to, so a game that never requires History destroys
-- exactly as immediately as it always did.
function Objects.Retire(Obj: Object)
    if not Objects.Suspend(Obj) then
        return
    end

    for _, Keeper in Keepers do
        if Keeper(Obj) then
            return
        end
    end

    Dispose(Obj)
end

-- Links on a part the server built, so this client's own view of the object
-- reaches the part it sees. Without them a ClientSided drag on an object of a
-- loaded copy moved nothing on the dragging client: the value changed and the
-- part stayed where it was until the closing set came back from the server.
--
-- Writing a replicated part from a client changes it on this client alone, and
-- the server's write replicates over it the next time the server changes it --
-- to the same value, since the server's write is what Confirmed holds. A
-- refusal rolls the property back, and the link puts the part back with it.
--
-- A local or drawn part is wired where it is built and never comes through here.
-- Safe to repeat, because Track runs again on a part that streams back in.
const function WireServerPart(Obj: any)
    if Obj.Local or Obj.Drawn then
        return
    end

    Shared.ReleaseLinks(Obj.Links)
    Obj.Links = nil

    const Registry = Registered[Obj.Registry]
    if Obj.Instance and Registry then
        Obj.Links = Shared.BuildLinks(Obj.Instance, Registry.Links, Obj.Properties)
    end
end

-- A tagged part has arrived: file it, and hand it to its object if that object
-- is already here. The two halves reach a client in either order -- the object
-- travels over the remote, the part over ordinary replication -- so whichever
-- lands second completes the pair. Track runs again on a part that streams back
-- in, which is why it must be safe to repeat.
const function Track(Inst: Instance)
    const RuntimeId = Inst:GetAttribute(Shared.RuntimeAttribute)
    if type(RuntimeId) ~= "number" then
        return
    end

    ByPart[Inst] = RuntimeId
    ByRuntimeId[RuntimeId] = Inst

    const Obj = Workspace[RuntimeId]
    if Obj and not Obj.Destroyed then
        Obj.Instance = Inst
        WireServerPart(Obj)
    end
end

-- Destroyed, or streamed out. Either way the reference is no longer a part of
-- the world, and an object holding it would hand callers something detached
-- from everything. The pairing is rebuilt by Track if it streams back in.
const function Untrack(Inst: Instance)
    const RuntimeId = ByPart[Inst]
    ByPart[Inst] = nil

    if RuntimeId == nil then
        return
    end

    if ByRuntimeId[RuntimeId] == Inst then
        ByRuntimeId[RuntimeId] = nil
    end

    const Obj = Workspace[RuntimeId]
    if Obj and Obj.Instance == Inst then
        Obj.Instance = nil

        -- Nothing left to drive; Track wires it again if the part comes back.
        WireServerPart(Obj)
    end
end

function Objects:GetWorkspace(): {[RuntimeId]: Object}
    return Workspace
end

function Objects:Get(RuntimeId: RuntimeId): Object?
    return Workspace[RuntimeId]
end

-- The object a stored reference names, for a caller holding the raw local id
-- rather than reading it off a property. Scoped to a copy, because that is the
-- only scope a local id answers in.
function Objects:Resolve(Copy: Types.SceneInstanceId, Local: number): Object?
    return Find(Copy, Local)
end

-- What may be written into an Object property of an object in this copy, as a
-- local id, or nil and the reason it may not. The server's twin, so a
-- transaction built here refuses what the server would refuse -- before the
-- packet rather than after the round trip.
function Objects.Reference(
    Copy: Types.SceneInstanceId,
    Prop: PropertyTypes.Property<any>,
    Value: any
): (number?, string?)
    return Shared.Reference(Copy, Prop, Value, Find)
end

-- The two halves of a persistent id, for a caller holding one that did not come
-- off an object. Objects carry Scene and LocalId already.
function Objects:Split(Persistent: Types.PersistentId): (Types.SceneIdentifier, number)
    return Handles.Split(Persistent)
end

function Objects:GetInstance(Live: Types.SceneInstanceId): {Object}
    const Out = {}
    for _, Obj in ByInstance[Live] or {} do
        table.insert(Out, Obj)
    end

    return Out
end

function Objects:GetInstanceScene(Live: Types.SceneInstanceId): Types.SceneIdentifier?
    return InstanceScene[Live]
end

-- Told by Scenes/Client as the server announces copies appearing, with the
-- folder to draw into when the server opened the copy rather than loading it.
function Objects.TrackInstance(
    Live: Types.SceneInstanceId,
    Scene: Types.SceneIdentifier,
    Folder: Folder?,
    Local: boolean?
)
    InstanceScene[Live] = Scene
    DrawInto[Live] = Folder

    if Local then
        LocalCopies[Live] = true
    end
end

-- Whether a copy belongs to a scene this client owns, which is what decides
-- whether editing it is a thing this side may simply do. The server's answer is
-- always false: nothing there is anybody's local.
function Objects:IsLocalCopy(Live: Types.SceneInstanceId): boolean
    return LocalCopies[Live] == true
end

-- Told by Scenes/Client as it registers and destroys them. Objects cannot ask
-- Scenes -- that is the cycle every module here is arranged to avoid -- so it
-- is told instead, the way it is told which copy belongs to which scene.
function Objects.TrackLocalScene(Scene: Types.SceneIdentifier, Owned: boolean)
    LocalScenes[Scene] = if Owned then true else nil
end

function Objects:IsLocalScene(Scene: Types.SceneIdentifier): boolean
    return LocalScenes[Scene] == true
end

-- Tears down every object of one live copy. Called by Scenes/Client when the
-- server says the copy is gone, which arrives as a single packet: the objects
-- are already gone there and no ObjectRemoved is coming for any of them.
-- Every object of one copy this client owns withdrawn at once, and kept. The
-- server's twin; see Objects/Server. Nothing here is announced either way,
-- because nothing in a scene this client owns ever was.
function Objects.SuspendInstance(Live: Types.SceneInstanceId): {Object}
    const Held = {}
    for _, Obj in table.clone(ByInstance[Live] or {}) do
        if Objects.Suspend(Obj) then
            table.insert(Held, Obj)
        end
    end

    return Held
end

function Objects.ReviveInstance(Held: {Object}): {Object}
    const Back = {}
    for _, Obj in Held do
        if Objects.Revive(Obj) then
            table.insert(Back, Obj)
        end
    end

    return Back
end

function Objects.DisposeInstance(Held: {Object})
    for _, Obj in Held do
        Objects.Dispose(Obj)
    end
end

function Objects.DropInstance(Live: Types.SceneInstanceId)
    InstanceScene[Live] = nil
    DrawInto[Live] = nil
    LocalCopies[Live] = nil

    const Held = ByInstance[Live]
    if not Held then
        return
    end

    for _, Obj in table.clone(Held) do
        Teardown(Obj)
    end

    ByInstance[Live] = nil

    -- Emptied by the tearing down above, which unindexes each object, and
    -- cleared here for the same reason the line above it is: the copy is gone,
    -- so nothing about it is worth keeping on a maybe.
    LocalIds[Live] = nil
end

function Objects:GetRegistered(): {[ObjectIdentifier]: ObjectRegistry}
    return Registered
end

function Objects:GetRegistry(Identifier: ObjectIdentifier): ObjectRegistry?
    return Registered[Identifier]
end

-- Editor convenience: turn a clicked part back into the object that owns it.
function Objects:FromInstance(Inst: Instance): Object?
    local Current: Instance? = Inst
    while Current do
        const RuntimeId = ByPart[Current]
        if RuntimeId then
            return Workspace[RuntimeId]
        end

        Current = Current.Parent
    end

    return nil
end

-- Shared by the live ObjectAdded broadcast and the batched join replay, which
-- carry the same three values and differ only in how many arrive at once.
const function AddObject(
    RuntimeId: RuntimeId,
    Live: Types.SceneInstanceId,
    Compressed: buffer,
    Inst: Instance?
)
    const Ok, Data = pcall(function()
        return Compressor:DecompressObject(Compressed)
    end)

    if not Ok or not Data then
        Logger:Warn(`Failed to decompress object {RuntimeId}.`)
        return
    end

    const Registry = Registered[Data.Registry]
    if not Registry then
        Logger:Warn(`Received object {RuntimeId} for unregistered type {Data.Registry}.`)
        return
    end

    -- A copy the server opened has no part anywhere: this client draws one,
    -- from the template that came with the registry, into the folder it keeps
    -- for the copy. Anything else has a part the server built, and the
    -- reference that came with the object is the fast path to it. When that did
    -- not survive, the part may already be here and tracked under its runtime
    -- id.
    const Into = DrawInto[Live]
    local Resolved: Instance? = nil

    if Into then
        const Template = TemplateOf(Registry)
        if Template then
            const Clone = Template:Clone()
            Clone:SetAttribute(Shared.RuntimeAttribute, RuntimeId)
            CollectionService:AddTag(Clone, Shared.ObjectTag)
            Clone.Parent = Into
            Resolved = Clone
        end
    else
        Resolved = Inst or ByRuntimeId[RuntimeId]
    end

    -- The persistent half is assembled here rather than sent: the local id
    -- rides inside the buffer already, and the scene is whichever one the copy
    -- came from. Unknown only if an object outran the packet announcing its
    -- copy, which the server orders against.
    const Scene = InstanceScene[Live]
    if not Scene then
        Logger:Warn(`Object {RuntimeId} arrived for unknown scene instance {Live}.`)
    end

    const Obj = {}
    Obj.RuntimeId = RuntimeId
    Obj.InstanceId = Live
    Obj.Scene = Scene or 0
    Obj.LocalId = Data.LocalId
    Obj.PersistentId = Handles.Join(Scene or 0, Data.LocalId)
    Obj.Registry = Data.Registry
    Obj.Name = Registry.Name
    Obj.Destroyed = false
    Obj.Instance = Resolved
    Obj.Links = nil
    Obj.Properties = {}

    for _, PropId in Registry.Properties do
        const Prop = Properties.new(PropId)
        if Data.Properties[PropId] ~= nil then
            Prop:Set(Data.Properties[PropId])
        end

        -- Whatever the object arrived holding is what the server holds.
        Confirmed[Prop] = Prop.Value
        Obj.Properties[PropId] = Prop
    end

    -- A drawn part is driven from here, through the links that came with the
    -- registry. Wired after the values land, as on the server, so the part
    -- starts at the object's value rather than the template's. A part the
    -- server built is wired too, for what this client shows ahead of the
    -- server: an optimistic set, or a ClientSided preview.
    if Into then
        Obj.Drawn = true
        Obj.Links = Shared.BuildLinks(Resolved, Registry.Links, Obj.Properties)
    else
        WireServerPart(Obj)
    end

    Obj.Set = __setter
    Obj.Destroy = __destroy

    File(Obj, Registry.Properties)

    -- Never restored: an object arriving from the server is the server's to
    -- have loaded or created, and either way nothing on this side did it.
    Listeners.Notify(Added, Obj, false)
end

-- GetTagged first: parts that replicated before this module loaded never fire
-- the added signal, and on a join that is most of them.
for _, Inst in CollectionService:GetTagged(Shared.ObjectTag) do
    Track(Inst)
end

CollectionService:GetInstanceAddedSignal(Shared.ObjectTag):Connect(Track)
CollectionService:GetInstanceRemovedSignal(Shared.ObjectTag):Connect(Untrack)

Network.ObjectRegistered:Connect(function(Registry: ObjectRegistry)
    Registered[Registry.Id] = Registry
end)

Network.RegistriesReplayed:Connect(function(Registries: {ObjectRegistry})
    for _, Registry in Registries do
        Registered[Registry.Id] = Registry
    end
end)

-- Gone on the server, which refuses while any object of it is live there.
-- Objects of it in scenes this client owns keep what they were built from;
-- nothing new can be made of it.
Network.ObjectUnregistered:Connect(function(Identifier: ObjectIdentifier)
    Registered[Identifier] = nil
end)

-- Kept by runtime id rather than on the object, so a lock that arrives ahead of
-- its object -- the reveal sends locks before it streams objects -- is still
-- there when the object lands.
Network.LocksChanged:Connect(function(Ids: {RuntimeId}, Who: {number}, Held: {boolean})
    for Index, Identifier in Ids do
        const IsHeld = Held[Index] == true
        const UserId = Who[Index]

        -- Zero is nobody rather than free: Held is what says free.
        Record(Identifier, IsHeld, if UserId ~= 0 then UserId else nil)
    end
end)

Network.ObjectAdded:Connect(AddObject)

-- The instance list carries false where an object has no instance: a nil entry
-- would leave a hole in the array and shift every later index against the ids.
Network.ObjectsReplayed:Connect(function(
    RuntimeIds: {number},
    Live: {number},
    Buffers: {buffer},
    Instances: {any}
)
    for Index, RuntimeId in RuntimeIds do
        const Inst = Instances[Index]
        const Resolved = if Inst == false then nil else Inst

        -- One bad entry must not cost the rest of the batch.
        const Ok, Err = pcall(AddObject, RuntimeId, Live[Index], Buffers[Index], Resolved)
        if not Ok then
            Logger:Warn(`Failed to add replayed object {RuntimeId}: {Err}`)
        end
    end
end)

-- Shared by the single broadcast and the batched one a transaction answers
-- with, which carry the same thing and differ only in how many arrive at once.
const function RemoveObject(RuntimeId: RuntimeId)
    const Obj = Workspace[RuntimeId]
    if not Obj then
        return
    end

    Teardown(Obj)
end

const function ApplyChange(RuntimeId: RuntimeId, PropId: PropertyTypes.PropertyIdentifier, Compressed: buffer)
    const Obj = Workspace[RuntimeId]
    if not Obj then
        return
    end

    const Prop = Obj.Properties[PropId]
    if not Prop then
        return
    end

    const Ok, Value, Type = pcall(function()
        const Decoded, _, DecodedType = Compressor:DecompressValue(Compressed, 0)
        return Decoded, DecodedType
    end)

    if Ok and Type == Prop.Type then
        -- The server has spoken, so no in-flight set may roll back over this,
        -- and this is now the value a later refusal should return to.
        Pending[Prop] = nil

        -- Somebody else's edit landing under a drag. It is what a refusal or a
        -- cancel returns to from now on, but it does not pull the value out
        -- from under the player's hand; the set that ends the drag decides.
        if Previewing[Prop] then
            const Fixed = PropertyTypes:FixValue(Prop.Type, Value, Prop.Constraints)
            if Fixed ~= nil then
                Confirmed[Prop] = Fixed
            end

            return
        end

        Prop:Set(Value)
        Confirmed[Prop] = Prop.Value
    end
end

Network.ObjectRemoved:Connect(RemoveObject)

Network.ObjectsRemoved:Connect(function(RuntimeIds: {RuntimeId})
    for _, RuntimeId in RuntimeIds do
        RemoveObject(RuntimeId)
    end
end)

Network.PropertyChanged:Connect(ApplyChange)

-- Three parallel lists, like the object replay, and for the same reason: a
-- codec is per element, so one array of records cannot be declared.
Network.PropertiesChanged:Connect(function(
    RuntimeIds: {RuntimeId},
    PropIds: {PropertyTypes.PropertyIdentifier},
    Values: {buffer}
)
    for Index, RuntimeId in RuntimeIds do
        -- One bad entry must not cost the rest of the batch.
        const Ok, Err = pcall(ApplyChange, RuntimeId, PropIds[Index], Values[Index])
        if not Ok then
            Logger:Warn(`Failed to apply a batched change to object {RuntimeId}: {Err}`)
        end
    end
end)

return Objects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX21">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")
return {
    ObjectRegistered = Networking:Get("Objects.ObjectRegistered"),
    RegistriesReplayed = Networking:Get("Objects.RegistriesReplayed"),
    ObjectUnregistered = Networking:Get("Objects.ObjectUnregistered"),

    Lock = Networking:Get("Objects.Lock"),
    Unlock = Networking:Get("Objects.Unlock"),
    LocksChanged = Networking:Get("Objects.LocksChanged"),
    ObjectsReplayed = Networking:Get("Objects.ObjectsReplayed"),

    ObjectAdded = Networking:Get("Objects.ObjectAdded"),
    ObjectRemoved = Networking:Get("Objects.ObjectRemoved"),
    PropertyChanged = Networking:Get("Objects.PropertyChanged"),

    -- The bulk forms, for a transaction. One packet per operation is what the
    -- chunked paths exist to avoid.
    ObjectsRemoved = Networking:Get("Objects.ObjectsRemoved"),
    PropertiesChanged = Networking:Get("Objects.PropertiesChanged"),

    SetProperty = Networking:Get("Objects.SetProperty"),
    Destroy = Networking:Get("Objects.Destroy"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX22">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const CollectionService = game:GetService("CollectionService")
const Players = game:GetService("Players")

const Properties = require("../Properties/Server")
const Permissions = require("../Permissions/Server")
const PropertyTypes = require("../Properties/Types")
const Compressor = require("../Compressor")
const SceneRegistry = require("../Scenes/Registry")
const Audience = require("../Scenes/Audience")
const Network = require("./Network")
const Shared = require("./Shared")
const Handles = require("../Handles")
const IdPool = require("../IdPool")
const Listeners = require("../Listeners")
const Logger = require("../Logger")
const Types = require("./Types")

export type ObjectIdentifier = Types.ObjectIdentifier
export type InstanceLinkRegistry = Types.InstanceLinkRegistry
export type InstanceLink = Types.InstanceLink
export type ObjectRegistry = Types.ObjectRegistry
export type ObjectConfig = Types.ObjectConfig
export type RuntimeId = Types.RuntimeId
export type Object = Types.Object

const MAX_RUNTIME_ID = 4294967295

const Objects = {}
local RuntimeCounter = 0

const Registered: {[ObjectIdentifier]: ObjectRegistry} = {}

-- Every live object on the server. Keyed by runtime id rather than by the
-- persistent one, because the persistent one is not unique here: instancing a
-- scene twice puts two objects carrying the same persistent id in this table.
const Workspace: {[RuntimeId]: Object} = {}

-- Who holds each locked object: the holder's user id, and the connection the
-- lock was taken on, which is what lets it go with the player who took it.
-- Who holds each locked object. The holder is whatever was handed in -- a
-- Player, a table standing in for one, a module, a string naming a tool -- and
-- UserId is filled in only where that resolves to a person, which is the part a
-- client can be told about.
--
-- A hold used to require a player, so the server holding an object meant
-- inventing a fake one. Nothing about a hold needs a person: it says this is
-- being worked on, leave it alone.
const Locks: {[RuntimeId]: {UserId: number?, Holder: any}} = {}
-- Never recycled, for the same reason property ids are not: a registry id is
-- written into every saved object as its Registry, so handing the same id to a
-- different object type later makes every stored object of the old type decode
-- as the new one.
const Ids = IdPool.new(nil, false)

-- Every object appearing here and going, however it came and however it went:
-- created, restored by a scene load, revived from a suspend, destroyed,
-- suspended, or taken away with the copy that held it. Server scripts that
-- drive objects -- a spinner reading its speed -- used to poll GetWorkspace to
-- notice any of it.
--
-- The client's twin, down to the argument: Restored says the object came back
-- from a pack under the id it was saved with, which is a copy reading itself in
-- rather than anything anyone did. It is the difference between an editor
-- listing a new object and an editor listing a level.
--
-- Deliberately not the same thing as the packet that announces an object. A
-- scene load builds its objects silently and sends them in bulk afterwards;
-- these fire either way, because they are about the object existing rather than
-- about anybody being told.
const Added: {(Obj: Object, Restored: boolean) -> ()} = {}
const Removed: {(Obj: Object) -> ()} = {}

-- Fired once the object is filed in the workspace and in its copy, so a
-- listener can look it up either way straight off.
function Objects:OnAdded(Callback: (Obj: Object, Restored: boolean) -> ()): () -> ()
    return Listeners.Watch(Added, Callback, "objects appearing")
end

-- Fired once the object has left both, so it already reports Destroyed and is
-- nowhere to be found. It still carries its ids, which is what a listener needs
-- to drop whatever it was keeping for it.
function Objects:OnRemoved(Callback: (Obj: Object) -> ()): () -> ()
    return Listeners.Watch(Removed, Callback, "objects going")
end

-- Whether an object's data goes to every player or only to the ones its scene
-- admits. A type that is somehow not registered answers Admitted, which sends
-- nothing to anybody not already owed everything.
--
-- An object in an opened copy is kept for the admitted whatever its type says.
-- Replicate only means anything for a copy the server built: a player who is
-- not admitted has no part of an opened copy to attach data to, so sending it
-- would buy nothing.
const function ReachOf(Obj: Object): Types.Reach
    const Copy = SceneRegistry.Instances[Obj.InstanceId]
    if Copy and Copy.Opened then
        return "Admitted"
    end

    const Registry = Registered[Obj.Registry]
    return if Registry then Registry.Replicate else "Admitted"
end

-- One object in one copy, by the id a reference stores. The crossing between
-- the two identities, and scoped to a copy for the reason Find is.
const function Find(Copy: Types.SceneInstanceId, Local: number): Object?
    const Live = SceneRegistry.Instances[Copy]
    return if Live then Live.ByLocal[Local] else nil
end

const function __getter(self: Object, Reference: Types.PropertyReference): any?
    const Prop = Shared.GetProperty(self, Reference)
    if not Prop then
        return nil
    end

    const Value = if Prop.Value == nil then Prop.DefaultValue else Prop.Value

    -- A reference reads as the object it names rather than as the id it
    -- stores, because the id is the storage and the object is the answer.
    -- Nothing is hidden by this: the raw id is still there on the property
    -- itself, through GetProperty, which is where everything Get and Set do
    -- not cover lives.
    if Prop.Type == "Object" then
        return Shared.ResolveReference(self.InstanceId, Value, Find)
    end

    return Value
end

const function __setter(self: Object, Reference: Types.PropertyReference, Value: any?): boolean
    const Prop = Shared.GetProperty(self, Reference)
    if not Prop then
        return false
    end

    -- Takes the target object as readily as its id, which is the counterpart
    -- to Get handing one back.
    const Allowed, Val = Shared.Accept(self, Prop, Value, Find)
    if not Allowed then
        return false
    end

    const Accepted, Changed = Prop:Set(Val)
    if not Accepted then
        return false
    end

    if Changed then
        const Compressed = Compressor:CompressValue(Prop.Type, Prop.Value)
        if Compressed then
            Audience.Fire(Network.PropertyChanged, self.Scene, ReachOf(self), self.RuntimeId, Prop.Parent, Compressed)
        end
    end

    return true
end

-- Leaving the world, which is not the same as ceasing to exist. Everything
-- here is undoable: the object is unfiled, its part goes, its lock goes and
-- every client is told it is gone -- but the table, its property values and
-- both its ids survive, which is what lets a destroy be taken back as the same
-- object rather than replaced by a lookalike holding the same numbers.
--
-- The local id matters most. A reference stores one, and a scene never hands a
-- local id out twice, so an object that comes back under its own is pointed at
-- again by everything that was pointing at it.
const function Withdraw(self: Object, Announce: boolean)
    Shared.ReleaseLinks(self.Links)
    self.Links = nil

    -- Gone with its object. The packet saying the object went is all a client
    -- needs to drop the lock it knew about.
    Locks[self.RuntimeId] = nil

    -- Out of the world rather than destroyed, and kept. To every client the two
    -- are the same thing -- a part with no parent is not in the DataModel, so
    -- it replicates away exactly as a destroyed one does -- but coming back
    -- means coming back as the same part, with whatever the game hung on it
    -- still hanging there. A fresh clone from the template would lose all of
    -- it. Destroying is Dispose's, once nothing can bring the object back.
    if self.Instance then
        self.Instance.Parent = nil
    end

    -- Out of the scene before out of the workspace, so a scene walking its own
    -- objects while they are being destroyed never sees one that is already
    -- gone from the world but still listed as its own.
    if self.Release then
        self.Release()
        self.Release = nil
    end

    if Workspace[self.RuntimeId] then
        Workspace[self.RuntimeId] = nil

        -- A scene unloading announces itself once, by name, instead of once per
        -- object it held.
        if Announce then
            Audience.Fire(Network.ObjectRemoved, self.Scene, ReachOf(self), self.RuntimeId)
        end
    end

    self.Get = Shared.Destroyed.Get
    self.Set = Shared.Destroyed.Set
    self.GetProperty = Shared.Destroyed.GetProperty
    self.OnChange = Shared.Destroyed.OnChange
    self.Destroy = Shared.Destroyed.Destroy

    -- Last, so a listener is handed an object that is already gone from
    -- everywhere it can be looked up rather than one halfway out.
    Listeners.Notify(Removed, self)
end

-- The part that cannot be taken back: the values go, the part goes, and with
-- them any chance of this object being itself again.
const function Dispose(self: Object)
    self.Suspended = nil

    if self.Instance then
        self.Instance:Destroy()
        self.Instance = nil
    end

    for _, Prop in self.Properties do
        Prop:Destroy()
    end
end

const function Teardown(self: Object, Announce: boolean)
    if self.Destroyed then
        return
    end

    self.Destroyed = true
    Withdraw(self, Announce)
    Dispose(self)
end

const function __destroy(self: Object)
    Teardown(self, true)
end

-- The whole registry, template and links included, because a client drawing a
-- copy or owning a scene builds instances from exactly what the server does.
-- The template is a plain reference: it resolves on a client exactly when that
-- instance replicates to them, and arrives as nil otherwise. The links are
-- plain data and were validated against the template at registration.
const function ToRegistryPayload(Registry: ObjectRegistry)
    return {
        Id = Registry.Id,
        Name = Registry.Name,
        Properties = Registry.Properties,
        Instance = Registry.Instance,
        Links = Registry.Links,
        Replicate = Registry.Replicate,

        -- Whether there is a template at all, so a client whose reference came
        -- back nil can tell "none" from "one I cannot see" and say so.
        HasTemplate = Registry.Instance ~= nil,
    }
end

function Objects:Register(Config: ObjectConfig): ObjectIdentifier?
    const Identifier = Ids:Claim()
    if not Identifier then
        Logger:Warn("The object type id pool is exhausted.")
        return
    end

    const Valid = {}
    for _, PropId in Config.Properties do
        if Properties:GetRegistry(PropId) then
            table.insert(Valid, PropId)
        else
            Logger:Warn(`Object {Config.Name} references unregistered property {PropId}. Will be skipped.`)
        end
    end

    -- Everyone unless told otherwise, so a type registered before this field
    -- existed behaves exactly as it did. A value that is neither is kept to the
    -- admitted: a typo meant to keep something back should keep it back rather
    -- than send it to every player.
    local Replicate: Types.Reach = "Everyone"
    if Config.Replicate == "Admitted" then
        Replicate = "Admitted"
    elseif Config.Replicate ~= nil and Config.Replicate ~= "Everyone" then
        Logger:Warn(`Object {Config.Name} has Replicate = {tostring(Config.Replicate)}, which is neither "Everyone" nor "Admitted". Kept to the admitted.`)
        Replicate = "Admitted"
    end

    const Obj: ObjectRegistry = {
        Id = Identifier,
        Name = Config.Name,
        Properties = Valid,
        Instance = Config.Instance,
        Links = Shared.ValidateLinks(Config.Name, Config.Instance, Config.Links, Valid),
        Replicate = Replicate,
    }

    -- Its properties cannot be unregistered from under it while it stands.
    for _, PropId in Valid do
        Properties.Retain(PropId)
    end

    Registered[Identifier] = Obj
    Network.ObjectRegistered:FireAll(ToRegistryPayload(Obj))
    return Identifier
end

-- Refused while any object of the type is live: each was built from this
-- registry and names it as its Registry, and a client rebuilding one would find
-- nothing to build it from. Destroy them, or unload what holds them, first.
--
-- The id is never handed out again. Packs name it, and a later type under the
-- same id would decode every saved object of this one as the new one. A pack
-- that still names it restores its other objects and warns about these.
function Objects:Unregister(Identifier: ObjectIdentifier): boolean
    const Registry = Registered[Identifier]
    if not Registry then
        return false
    end

    for _, Obj in Workspace do
        if Obj.Registry == Identifier and not Obj.Destroyed then
            Logger:Warn(`Cannot unregister object type {Registry.Name}: objects of it are still live.`)
            return false
        end
    end

    Registered[Identifier] = nil
    Ids:Release(Identifier)

    for _, PropId in Registry.Properties do
        Properties.Unretain(PropId)
    end

    Network.ObjectUnregistered:FireAll(Identifier)
    return true
end

-- Entries per packet, matching the join replay: one packet per object is what
-- made a large workspace flood the remote queue in a single frame.
const ANNOUNCE_CHUNK = 50

-- Splits a batch by the scene each entry's object belongs to and by how far
-- that object reaches. A scene has an audience per reach, and one transaction
-- is free to touch several scenes.
const function Group<T>(List: {T}, ObjectOf: (T) -> Object): {[Types.SceneIdentifier]: {[string]: {T}}}
    const Groups: {[Types.SceneIdentifier]: {[string]: {T}}} = {}
    for _, Entry in List do
        const Obj = ObjectOf(Entry)

        local ByReach = Groups[Obj.Scene]
        if not ByReach then
            ByReach = {}
            Groups[Obj.Scene] = ByReach
        end

        const Reach = ReachOf(Obj)
        local Entries = ByReach[Reach]
        if not Entries then
            Entries = {}
            ByReach[Reach] = Entries
        end

        table.insert(Entries, Entry)
    end

    return Groups
end

const function Itself(Obj: Object): Object
    return Obj
end

-- The chunked path every batch of whole objects goes down: a scene loading, a
-- transaction's creates, a player being told about a scene. Send is handed one
-- chunk at a time and answers whether to go on; Keep, where given, drops an
-- object at the moment it would have been packed.
const function SendObjects(
    List: {Object},
    Send: (RuntimeIds: {RuntimeId}, InstanceIds: {number}, Buffers: {buffer}, Instances: {any}) -> boolean,
    Keep: ((Object) -> boolean)?
)
    local RuntimeIds = {}
    local InstanceIds = {}
    local Buffers = {}
    local Instances = {}
    local Count = 0

    const function Flush(): boolean
        if Count == 0 then
            return true
        end

        const Continue = Send(RuntimeIds, InstanceIds, Buffers, Instances)
        RuntimeIds = {}
        InstanceIds = {}
        Buffers = {}
        Instances = {}
        Count = 0
        task.wait()
        return Continue
    end

    for _, Obj in List do
        if Obj.Destroyed or (Keep and not Keep(Obj)) then
            continue
        end

        Count += 1
        RuntimeIds[Count] = Obj.RuntimeId
        InstanceIds[Count] = Obj.InstanceId
        Buffers[Count] = Compressor:CompressObject(Obj :: any)
        Instances[Count] = Obj.Instance or false

        if Count >= ANNOUNCE_CHUNK and not Flush() then
            return
        end
    end

    Flush()
end

-- Announces a batch of objects to whoever has been told about the scene each
-- belongs to, down the same chunked path a joining player receives. A scene
-- loading uses this rather than letting each object announce itself as it is
-- built.
--
-- The audience is taken once, before the first chunk. Someone told about the
-- scene while this is still sending was handed these objects by that telling,
-- and sending them here as well would send them twice.
function Objects.AnnounceAll(List: {Object})
    for Scene, ByReach in Group(List, Itself) do
        for Key, Entries in ByReach do
            const Reach = Key :: Types.Reach
            const Hearing = Audience.Hearing(Scene, Reach)
            if next(Hearing) == nil then
                continue
            end

            SendObjects(Entries, function(RuntimeIds, InstanceIds, Buffers, Instances): boolean
                Audience.FireHearing(Network.ObjectsReplayed, Scene, Reach, Hearing, RuntimeIds, InstanceIds, Buffers, Instances)
                return true
            end)
        end
    end
end

-- One player's half of the same path, for a scene being revealed to them. Keep
-- is asked per object, so a scene withdrawn part way stops being sent.
function Objects.Stream(Plr: Player, List: {Object}, Keep: (Object) -> boolean)
    SendObjects(List, function(RuntimeIds, InstanceIds, Buffers, Instances): boolean
        if not Plr.Parent then
            return false
        end

        Network.ObjectsReplayed:Fire(Plr, RuntimeIds, InstanceIds, Buffers, Instances)
        return true
    end, Keep)
end

-- The reverse of Stream: one player losing objects they were sent, a chunk at a
-- time, for as long as Going says the loss still stands.
function Objects.Unsend(Plr: Player, RuntimeIds: {RuntimeId}, Going: () -> boolean)
    for Start = 1, #RuntimeIds, ANNOUNCE_CHUNK do
        if not Plr.Parent or not Going() then
            return
        end

        const Stop = math.min(Start + ANNOUNCE_CHUNK - 1, #RuntimeIds)
        Network.ObjectsRemoved:Fire(Plr, table.move(RuntimeIds, Start, Stop, 1, {}))
        task.wait()
    end
end

Objects.ReachOf = ReachOf

-- Destroys everything a scene instance holds without a packet per object. The
-- caller sends one naming the instance instead.
-- Every object of one copy withdrawn at once, and kept. The copy itself is
-- withdrawn around them -- see Scenes/Server -- so nothing here announces:
-- one packet says the copy is gone, which is all a client needs, and a removal
-- per object would be the flood the chunked paths exist to avoid.
--
-- The list comes back because the copy tables empty as this runs: each object
-- unfiles itself on the way out, which is what makes them findable nowhere
-- while they are away. Whatever holds the copy holds this beside it.
function Objects.SuspendInstance(Instance_: any): {Object}
    const Held = {}
    for _, Obj in table.clone(Instance_.Objects) do
        if Objects.Suspend(Obj, false) then
            table.insert(Held, Obj)
        end
    end

    table.clear(Instance_.Objects)
    table.clear(Instance_.ByLocal)
    return Held
end

-- The other direction, once the copy is back in place: silent again, and the
-- caller announces the lot in one go.
function Objects.ReviveInstance(Held: {Object}): {Object}
    const Back = {}
    for _, Obj in Held do
        if Objects.Revive(Obj, false) then
            table.insert(Back, Obj)
        end
    end

    return Back
end

function Objects.DisposeInstance(Held: {Object})
    for _, Obj in Held do
        Objects.Dispose(Obj)
    end
end

function Objects.DropInstance(Instance_: any)
    for _, Obj in table.clone(Instance_.Objects) do
        Teardown(Obj, false)
    end

    table.clear(Instance_.Objects)
    table.clear(Instance_.ByLocal)
end

-- The bulk counterpart to the PropertyChanged a single Set fires, chunked on
-- the same terms as the object replay. A transaction is one packet on the way
-- up; answering it with one packet per operation on the way down would put the
-- flood back where it was taken out.
--
-- Each change carries its object, because the object's scene and type are who
-- hears about it.
function Objects.AnnounceChanged(Changes: {{Object: Object, Property: PropertyTypes.PropertyIdentifier, Value: buffer}})
    for Scene, ByReach in Group(Changes, function(Change): Object
        return Change.Object
    end) do
        for Key, Entries in ByReach do
            const Reach = Key :: Types.Reach
            const Hearing = Audience.Hearing(Scene, Reach)
            if next(Hearing) == nil then
                continue
            end

            local RuntimeIds = {}
            local PropertyIds = {}
            local Values = {}
            local Count = 0

            const function Flush()
                if Count == 0 then
                    return
                end

                Audience.FireHearing(Network.PropertiesChanged, Scene, Reach, Hearing, RuntimeIds, PropertyIds, Values)
                RuntimeIds = {}
                PropertyIds = {}
                Values = {}
                Count = 0
            end

            for _, Change in Entries do
                Count += 1
                RuntimeIds[Count] = Change.Object.RuntimeId
                PropertyIds[Count] = Change.Property
                Values[Count] = Change.Value

                if Count >= ANNOUNCE_CHUNK then
                    Flush()
                    task.wait()
                end
            end

            Flush()
        end
    end
end

-- Objects going away together. A whole copy unloading is still one packet
-- naming the copy rather than a list naming its objects -- this is for a
-- transaction, which destroys some of a copy rather than all of it.
--
-- Handed the objects rather than their ids: they are already torn down, and
-- the scene each belonged to is the only way left to know who to tell.
function Objects.AnnounceRemoved(Removed: {Object})
    for Scene, ByReach in Group(Removed, Itself) do
        for Key, Entries in ByReach do
            const Reach = Key :: Types.Reach
            const Hearing = Audience.Hearing(Scene, Reach)
            if next(Hearing) == nil then
                continue
            end

            local Chunk = {}
            local Count = 0

            const function Flush()
                if Count == 0 then
                    return
                end

                Audience.FireHearing(Network.ObjectsRemoved, Scene, Reach, Hearing, Chunk)
                Chunk = {}
                Count = 0
            end

            for _, Obj in Entries do
                Count += 1
                Chunk[Count] = Obj.RuntimeId

                if Count >= ANNOUNCE_CHUNK then
                    Flush()
                    task.wait()
                end
            end

            Flush()
        end
    end
end

-- Destroys one object without a packet naming it, for a caller that will send
-- one covering the whole batch. Objects.DropInstance is the same idea for
-- everything a scene copy holds.
function Objects.Drop(Obj: Object)
    Teardown(Obj, false)
end


-- The client's twin, and always false here: a copy the server holds is the
-- server's, and there is no such thing as a scene this side owns privately.
-- Asked by the shared transaction builder, which decides what committing means
-- from the answer and must be able to ask either side.
function Objects:IsLocalCopy(_Live: Types.SceneInstanceId): boolean
    return false
end

function Objects:IsLocalScene(_Scene: Types.SceneIdentifier): boolean
    return false
end

function Objects:GetWorkspace(): {[RuntimeId]: Object}
    return Workspace
end

function Objects:Get(Identifier: RuntimeId): Object?
    return Workspace[Identifier]
end

-- The two halves of a persistent id, for a caller holding one that did not come
-- off an object. Objects carry Scene and LocalId already.
function Objects:Split(Persistent: Types.PersistentId): (Types.SceneIdentifier, number)
    return Handles.Split(Persistent)
end

-- The object a stored reference names, for a caller holding the raw local id
-- rather than reading it off a property. Scoped to a copy, because that is the
-- only scope a local id answers in.
function Objects:Resolve(Copy: Types.SceneInstanceId, Local: number): Object?
    return Find(Copy, Local)
end

-- What may be written into an Object property of an object in this copy, as a
-- local id, or nil and the reason it may not. Exported so a transaction makes
-- exactly the check Object:Set makes: a reference that means one thing through
-- a set and another through a transaction is worse than either rule alone.
function Objects.Reference(
    Copy: Types.SceneInstanceId,
    Prop: PropertyTypes.Property<any>,
    Value: any
): (number?, string?)
    return Shared.Reference(Copy, Prop, Value, Find)
end

function Objects:GetRegistered(): {[ObjectIdentifier]: ObjectRegistry}
    return Registered
end

function Objects:GetRegistry(Identifier: ObjectIdentifier): ObjectRegistry?
    return Registered[Identifier]
end

function Objects:GetRegistryPayload(Identifier: ObjectIdentifier)
    const Registry = Registered[Identifier]
    return if Registry then ToRegistryPayload(Registry) else nil
end

-- Everything being in the world means: a part of its own, links wired to it, a
-- place in the copy and in the workspace, and the packet saying so. The inverse
-- of Withdraw, and written once rather than twice because an object that comes
-- back from a suspend has to arrive exactly as one that was just built does --
-- anything this did that reviving forgot would be a difference nobody would
-- find until an undone destroy behaved unlike the object it restored.
--
-- The registry instance is a template. Handing the same one to every object
-- meant they all drove the same part, and destroying any one of them took the
-- part away from the rest.
--
-- Stamped and tagged before it is parented, so the handle and the tag replicate
-- together with the instance and a client that only ever sees the part -- never
-- the reference sent beside the object -- can still find its owner. None at all
-- in an opened copy, whose parts each admitted client draws.
const function Enter(Obj: any, Ref: ObjectRegistry, Instance_: any, Announce: boolean, Restored: boolean?)
    -- Already holding one means this object has been here before and was
    -- withdrawn rather than destroyed: its part was parented out of the world
    -- and kept, so it goes back rather than being cloned again. Cloning would
    -- hand back a part that only looks like the one that left.
    local Inst: Instance? = Obj.Instance

    if Inst then
        Inst.Parent = Instance_.Folder
    elseif Ref.Instance and not Instance_.Opened then
        const Clone = Ref.Instance:Clone()
        Clone:SetAttribute(Shared.RuntimeAttribute, Obj.RuntimeId)
        CollectionService:AddTag(Clone, Shared.ObjectTag)

        -- Into the copy holding it, and nowhere else. Which copy rather than
        -- which scene, because two copies of one room have to be able to sit
        -- in two places -- and where that is, is the copy's folder's business
        -- rather than this object's.
        Clone.Parent = Instance_.Folder

        Inst = Clone
    end

    Obj.Instance = Inst

    -- Wired after the values are in place, so a link starts at the object's own
    -- value rather than at the registry default and then being corrected.
    Obj.Links = Shared.BuildLinks(Inst, Ref.Links, Obj.Properties)

    Obj.Get = __getter
    Obj.Set = __setter
    Obj.GetProperty = Shared.GetProperty
    Obj.OnChange = Shared.OnChange
    Obj.Destroy = __destroy

    Obj.Release = function()
        Instance_.Objects[Obj.RuntimeId] = nil

        -- Only if it is still the one filed there. Restoring refuses a
        -- duplicate, so it always is, but a scene tearing down while another
        -- rebuilds must not have the loser clear the winner's entry.
        if Instance_.ByLocal[Obj.LocalId] == Obj then
            Instance_.ByLocal[Obj.LocalId] = nil
        end
    end

    Workspace[Obj.RuntimeId] = Obj
    Instance_.Objects[Obj.RuntimeId] = Obj
    Instance_.ByLocal[Obj.LocalId] = Obj

    -- Only the compressed values go out. Firing the live object sent Property
    -- tables carrying Set/SetDefault functions and links carrying connections,
    -- neither of which a remote can serialize, so this threw every time.
    --
    -- A scene being loaded announces nothing here: its objects go out together
    -- through the chunked replay path instead of one packet each.
    --
    -- ReachOf rather than the type's Replicate, as every other packet about an
    -- object: an object in an opened copy is for the admitted whatever its type
    -- says. Reading Replicate here sent every object created in a private
    -- opened copy, values and all, to every player in the server.
    if Announce then
        Audience.Fire(
            Network.ObjectAdded,
            Obj.Scene,
            ReachOf(Obj),
            Obj.RuntimeId,
            Instance_.Id,
            Compressor:CompressObject(Obj),
            Inst
        )
    end

    -- After the packet, and fired whether or not there was one.
    Listeners.Notify(Added, Obj, Restored == true)
end

-- InitialValues are applied before the links are wired and before the broadcast.
-- Restoring a saved object used to call Objects.new and then Set once per
-- property, which broadcast the defaults and then one PropertyChanged for each
-- property -- a 500 object level at ten properties each cost several thousand
-- packets, and every object's first packet carried state that was already wrong.
--
-- LocalId is the object's id within its scene. Creating mints the next one;
-- restoring from a pack passes the id the object was saved under, which is the
-- whole reason a saved reference still names the same object after a reload.
const function Construct(
    Reference: ObjectRegistry | ObjectIdentifier,
    InitialValues: {[PropertyTypes.PropertyIdentifier]: any}?,
    Instance_: any,
    LocalId: number?,
    Announce: boolean
): Object
    const TypeOf = typeof(Reference)
    local Ref: ObjectRegistry

    if TypeOf == "number" then
        Ref = Registered[Reference :: ObjectIdentifier]
        if not Ref then
            Logger:Error(`Invalid object reference. No object registered with id {Reference}.`)
        end
    elseif TypeOf == "table" then
        Ref = Reference :: ObjectRegistry
    else
        Logger:Error(`Invalid object reference. Expected a registry or an id, got {TypeOf}.`)
    end

    if not Ref or not Ref.Id or not Registered[Ref.Id] then
        Logger:Error("Invalid object reference. The registry it points at is not registered.")
    end

    if not Instance_ then
        Logger:Error("Tried creating an object with no live scene. Either Prism.Scenes was never required -- it registers the default one -- or the scene named is unloaded.")
    end

    const Owner = Instance_.Owner

    local Local = LocalId
    if Local then
        -- Restored under the id it was saved with. Refused rather than allowed
        -- to overwrite, because within one instance a persistent id still has
        -- to name exactly one object -- that is what makes Find answerable.
        if Instance_.ByLocal[Local] then
            Logger:Error(`Scene {Owner.Name} already holds an object with local id {Local} in this instance.`)
        end

        -- The counter only ever climbs, so a pack whose ids came from a longer
        -- lived scene cannot make the next created object reuse one.
        Owner.LastId = math.max(Owner.LastId, Local)
    else
        if Owner.LastId >= Handles.MAX_LOCAL then
            Logger:Error(`Scene {Owner.Name} has exhausted its object id space.`)
        end

        Owner.LastId += 1
        Local = Owner.LastId
    end

    if RuntimeCounter >= MAX_RUNTIME_ID then
        Logger:Error("Runtime id space exhausted.")
    end

    RuntimeCounter += 1
    const RuntimeId = RuntimeCounter
    const Persistent = Handles.Join(Instance_.Scene, Local :: number)

    -- The registry instance is a template. Handing the same one to every object
    -- meant they all drove the same part, and destroying any one of them took
    -- the part away from the rest.
    --
    -- Stamped and tagged before it is parented, so the handle and the tag
    -- replicate together with the instance and a client that only ever sees the
    -- part -- never the reference sent beside the object -- can still find its
    -- owner.
    --
    const Props = Shared.BuildProperties(Ref.Properties)
    if InitialValues then
        for PropertyId, Value in InitialValues do
            const Prop = Props[PropertyId]
            if not Prop then
                continue
            end

            -- Against the copy the object is going into, which is the only
            -- copy its references will ever mean anything in. The object
            -- itself does not exist yet, and does not need to: a reference is
            -- read against the copy, not against whoever holds it.
            if Prop.Type == "Object" then
                const Target, Why = Shared.Reference(Instance_.Id, Prop, Value, Find)
                if Target == nil then
                    Logger:Warn(`Dropped the initial value of {Prop.Name} on {Ref.Name}: {Why}.`)
                    continue
                end

                Prop:Set(Target)
                continue
            end

            Prop:Set(Value)
        end
    end

    const Obj = {}
    Obj.RuntimeId = RuntimeId
    Obj.PersistentId = Persistent
    Obj.Scene = Instance_.Scene
    Obj.LocalId = Local
    Obj.InstanceId = Instance_.Id
    Obj.Registry = Ref.Id
    Obj.Name = Ref.Name
    Obj.Destroyed = false
    Obj.Properties = Props
    Obj.Names = Shared.BuildNameMap(Ref.Properties, Props)

    -- Restored when it was given the id it was saved under, which is a copy
    -- reading its pack rather than anybody creating anything.
    Enter(Obj, Ref, Instance_, Announce, LocalId ~= nil)
    return Obj :: any
end

--=============================================================================
-- Retiring
--=============================================================================

-- A destroy is not always final. One a player asked for is withdrawn from the
-- world and then offered to whatever might want it back: History keeps it on
-- that player's stack, so an undo restores that object, under its own local id,
-- and everything that pointed at it is pointing at it again. Only when nothing
-- wants it -- a game that never requires History, a step that has fallen off
-- the end of the stack -- is it disposed, and that is the only point at which
-- the values are gone.
--
-- A destroy the world imposes is still final and immediate: a scene unloading,
-- a type unregistering, a server script calling Object:Destroy. Nobody asked
-- for those and there is nothing to take back.

const Keepers: {(Plr: Player?, Obj: Object) -> boolean} = {}

-- A property a player changed through the single set channel, with the value
-- either side. What a transaction does is told through Transactions.OnApplied
-- instead, whole rather than one property at a time. Synchronous, like the
-- keepers below: a history recording these has to see them in the order they
-- happened, and a spawned callback only mostly does.
const Edited: {(Plr: Player, Obj: Object, Property: PropertyTypes.PropertyIdentifier, Before: any, After: any) -> ()} = {}

-- This player's own edits, for a history to record. Not the server's, which
-- belong to nobody and are nobody's to undo.
function Objects.OnPlayerEdited(
    Callback: (Plr: Player, Obj: Object, Property: PropertyTypes.PropertyIdentifier, Before: any, After: any) -> ()
): () -> ()
    return Listeners.Watch(Edited, Callback, "player edits")
end

-- Deliberately not Listeners.Notify: a keeper answers, and it answers before
-- the caller moves on. A callback spawned on a thread of its own could do
-- neither, and the object would be disposed while the answer was still coming.
function Objects.OnRetired(Callback: (Plr: Player?, Obj: Object) -> boolean): () -> ()
    return Listeners.Watch(Keepers, Callback, "retired objects")
end

-- Out of the world, still itself. True if it went; false if it was already
-- gone, which makes suspending idempotent the way destroying is.
function Objects.Suspend(Obj: Object, Announce: boolean?): boolean
    if Obj.Destroyed then
        return false
    end

    Obj.Destroyed = true
    Obj.Suspended = true
    Withdraw(Obj, Announce ~= false)
    return true
end

-- Back where it was, as itself: the same table, the same runtime id, the same
-- local id. False when the copy it belonged to has gone, which is the one thing
-- no undo can work around -- there is nowhere to put it, and its local id means
-- nothing outside the copy that issued it.
function Objects.Revive(Obj: Object, Announce: boolean?): boolean
    if not Obj.Suspended then
        return false
    end

    const Instance_ = SceneRegistry.Instances[Obj.InstanceId]
    const Ref = Registered[Obj.Registry]
    if not Instance_ or not Ref then
        return false
    end

    -- Its id is still its own: a scene's counter only ever climbs, so nothing
    -- was ever given this id to hold in the meantime.
    if Instance_.ByLocal[Obj.LocalId] then
        return false
    end

    Obj.Suspended = nil
    Obj.Destroyed = false

    -- Announced unless the caller knows nobody was told it went: a transaction
    -- that rolls its own destroys back suspended them silently, and an added
    -- packet for an object no client ever stopped drawing would draw a second.
    Enter(Obj, Ref, Instance_, Announce ~= false)
    return true
end

-- The end of a suspended object. Everything else about it was already done
-- when it was withdrawn; this is only the values letting go.
function Objects.Dispose(Obj: Object)
    if not Obj.Suspended then
        return
    end

    Dispose(Obj)
end

-- Suspend, offer, and dispose if nobody wanted it. The single destroy channel's
-- path; a transaction suspends its destroys itself, because what claims them is
-- the record of the whole transaction rather than each object on its own.
function Objects.Retire(Plr: Player?, Obj: Object, Announce: boolean?)
    if not Objects.Suspend(Obj, Announce) then
        return
    end

    for _, Keeper in Keepers do
        if Keeper(Plr, Obj) then
            return
        end
    end

    Dispose(Obj)
end

-- Loaded the first time anything needs it rather than when it registers, so a
-- game that puts everything in scenes of its own never pays for this one.
const function DefaultInstance(): any
    const Scene = SceneRegistry.Default
    if not Scene then
        return nil
    end

    const _, Existing = next(Scene.Instances)
    return Existing or Scene:Load()
end

-- A live copy is what an object goes into, but callers reach for the scene, so
-- both are taken. A Scene is the one carrying Instances; a SceneInstance
-- carries Owner.
const function ResolveInstance(Target: any): any
    if not Target then
        return DefaultInstance()
    end

    if not Target.Instances then
        return Target
    end

    const First, Instance_ = next(Target.Instances)
    if not First then
        Logger:Error(`Scene {Target.Name} has no live copy to put an object in. Load it first.`)
    end

    -- Resolved only while there is one obvious answer. A scene loaded twice
    -- names two equally good copies, and quietly picking one would put the
    -- object somewhere the caller did not choose.
    if next(Target.Instances, First) then
        Logger:Error(`Scene {Target.Name} is loaded more than once, so which copy this object belongs in is ambiguous. Name the copy.`)
    end

    return Instance_
end

-- Announce defaults to true and is the caller's only where it has a batch to
-- send instead: a transaction builds its objects silently and announces them
-- together, down the same chunked path a scene load uses.
function Objects.new(
    Reference: ObjectRegistry | ObjectIdentifier,
    InitialValues: {[PropertyTypes.PropertyIdentifier]: any}?,
    Target: any?,
    Announce: boolean?
): Object
    return Construct(Reference, InitialValues, ResolveInstance(Target), nil, Announce ~= false)
end

-- Rebuilds an object under the id it was saved with. Used by a scene loading its
-- pack; Announce is the caller's, because a load sends its objects in bulk.
function Objects.restore(Target: any, Decompressed: any, Announce: boolean?): Object?
    if not Registered[Decompressed.Registry] then
        Logger:Warn(`Failed to restore object. Object type {Decompressed.Registry} is not registered.`)
        return nil
    end

    const Obj = Construct(
        Decompressed.Registry,
        Decompressed.Properties,
        ResolveInstance(Target),
        Decompressed.LocalId,
        Announce == true
    )

    Obj.Unknown = Shared.Leftovers(Obj, Decompressed)
    return Obj
end

-- A new object of the same type holding the same values: in the copy the
-- original sits in, or in Target when one is named. A new local id and a new
-- part; nothing is shared with the original from here on.
function Objects:Duplicate(Obj: Object, Target: any?): Object?
    if Obj.Destroyed then
        return nil
    end

    const New = Objects.new(Obj.Registry, Shared.Snapshot(Obj), Target or SceneRegistry.Instances[Obj.InstanceId])

    -- Kept values travel with the rest, or duplicating a room and deleting the
    -- original would lose them as surely as the save used to.
    New.Unknown = if Obj.Unknown then table.clone(Obj.Unknown) else nil
    return New
end

-- Several objects duplicated as one thing, which is not the same as duplicating
-- each of them. A reference is copied verbatim by Duplicate, so a duplicated
-- button still points at the original door -- right for one object, wrong for a
-- room copied whole, where the new button should point at the new door.
--
-- So: references that point inside the group are remapped onto the new objects,
-- and references that point outside it are left alone. A path node duplicated
-- with the node it points at follows its copy; a lever duplicated on its own
-- still works the door it always worked.
--
-- Silent creates and one announcement at the end, down the chunked path a scene
-- load uses. Announcing each object as it is made would send every reference
-- twice: once pointing at the original, once corrected a moment later.
function Objects:DuplicateGroup(List: {Object}, Target: any?): {Object}
    const Sources: {Object} = {}
    const Made: {Object} = {}

    -- Which new object stands for which original. Keyed by the object rather
    -- than by its local id, because a group can span copies and two copies
    -- hand out the same ids.
    const Counterpart: {[Object]: Object} = {}

    for _, Obj in List do
        if Obj.Destroyed then
            continue
        end

        const New = Objects.new(
            Obj.Registry,
            Shared.Snapshot(Obj),
            Target or SceneRegistry.Instances[Obj.InstanceId],
            false
        )

        New.Unknown = if Obj.Unknown then table.clone(Obj.Unknown) else nil

        table.insert(Sources, Obj)
        table.insert(Made, New)
        Counterpart[Obj] = New
    end

    for Index, New in Made do
        const Source = Sources[Index]

        for PropertyId, Prop in New.Properties do
            if Prop.Type ~= "Object" then
                continue
            end

            -- Read from the original, against the original's copy: that is
            -- where the id it was written with means what it meant. The
            -- duplicate holds the same id, but nothing says it names the same
            -- object there.
            const Was = Source.Properties[PropertyId]
            const Pointed = if Was then Shared.ResolveReference(Source.InstanceId, Was.Value, Find) else nil
            if not Pointed then
                continue
            end

            const Instead = Counterpart[Pointed]
            if Instead then
                Prop:Set(Instead.LocalId)
            end
        end
    end

    if #Made > 0 then
        Objects.AnnounceAll(Made)
    end

    return Made
end

-- A copy, not a restore. The buffer carries the id its original was saved
-- under, and handing that to the new object would alias the two while both are
-- live -- so this mints a fresh one. Loading a scene wants the saved id and
-- calls restore instead, on a scene where the original is gone.
function Objects.fromCompression(CompressedObj: buffer, Target: any?): Object?
    const Ok, Decompressed = pcall(function()
        return Compressor:DecompressObject(CompressedObj)
    end)

    if not Ok or not Decompressed then
        Logger:Warn("Failed to create object from compression.")
        return nil
    end

    if not Registered[Decompressed.Registry] then
        Logger:Warn(`Failed to create object from compression. Object type {Decompressed.Registry} is not registered.`)
        return nil
    end

    return Construct(
        Decompressed.Registry,
        Decompressed.Properties,
        ResolveInstance(Target),
        nil,
        true
    )
end

--=============================================================================
-- Locks
--=============================================================================

-- A lock is explicit: a client takes one when it starts on an object, and while
-- it holds it nobody else may edit or destroy that object. Presence comes with
-- it -- who holds what is told to the players the object's scene admits, and
-- nobody else, because who is editing a private level is part of the level.

-- The most one request may name, for the same reason a transaction has a cap.
const MAX_LOCKS = 1024

-- The person a holder stands for, or nil where it stands for nobody. A bare
-- number is a user id, the way it is everywhere else a person is named -- Admit,
-- Evict and Grant all take a Player or a user id -- so releasing what somebody
-- holds works from either.
const function UserIdOf(Who: any): number?
    if typeof(Who) == "Instance" and Who:IsA("Player") then
        return (Who :: Player).UserId
    end

    if type(Who) == "number" then
        return Who
    end

    if type(Who) == "table" and type(Who.UserId) == "number" then
        return Who.UserId
    end

    return nil
end

-- Who holds what, to the players each object's scene admits. Zero means free.
const function AnnounceLocks(Changed: {Object})
    const ByScene: {[Types.SceneIdentifier]: {Ids: {RuntimeId}, Holders: {number}, Held: {boolean}}} = {}

    for _, Obj in Changed do
        local Batch = ByScene[Obj.Scene]
        if not Batch then
            Batch = {Ids = {}, Holders = {}, Held = {}}
            ByScene[Obj.Scene] = Batch
        end

        const Held = Locks[Obj.RuntimeId]
        table.insert(Batch.Ids, Obj.RuntimeId)

        -- Zero where the holder is not a person. Held is what says whether
        -- there is a hold, so zero is a user id nobody has rather than a way of
        -- saying free.
        table.insert(Batch.Holders, if Held then Held.UserId or 0 else 0)
        table.insert(Batch.Held, Held ~= nil)
    end

    for Scene, Batch in ByScene do
        Audience.Fire(Network.LocksChanged, Scene, "Admitted", Batch.Ids, Batch.Holders, Batch.Held)
    end
end

-- Takes every object named for Who, or none of them: an object someone else
-- holds refuses the lot, so a multi-object drag never ends up half held.
-- Taking one Who already holds is not a refusal.
-- Whether two holders are the same one. By user id where both resolve to a
-- person, so a Player and a table standing in for the same player are one
-- holder; by identity otherwise, which is what lets anything at all hold an
-- object.
const function SameHolder(Held: {UserId: number?, Holder: any}, Who: any): boolean
    const UserId = UserIdOf(Who)
    if UserId and Held.UserId then
        return Held.UserId == UserId
    end

    return Held.Holder == Who
end

function Objects:Lock(List: {Object}, Who: any): boolean
    if Who == nil then
        return false
    end

    for _, Obj in List do
        const Held = Locks[Obj.RuntimeId]
        if Obj.Destroyed or (Held and not SameHolder(Held, Who)) then
            return false
        end
    end

    const UserId = UserIdOf(Who)
    for _, Obj in List do
        Locks[Obj.RuntimeId] = {UserId = UserId, Holder = Who}
    end

    AnnounceLocks(List)
    return true
end

-- Releases what Who holds among the objects named. With no Who it is the
-- server releasing anyone's. Answers false if any named object is held by
-- someone else, which stays theirs; the rest are released regardless.
function Objects:Unlock(List: {Object}, Who: any?): boolean
    const Released = {}
    local All = true

    for _, Obj in List do
        const Held = Locks[Obj.RuntimeId]
        if not Held then
            continue
        end

        if Who ~= nil and not SameHolder(Held, Who) then
            All = false
            continue
        end

        Locks[Obj.RuntimeId] = nil
        table.insert(Released, Obj)
    end

    if #Released > 0 then
        AnnounceLocks(Released)
    end

    return All
end

-- The user id holding an object, or nil when it is free.
-- The user id holding an object, nil when it is free or held by something that
-- is not a person. GetHolder is the whole answer; this is the part a client can
-- be told and the part a game usually wants.
function Objects:GetLock(Obj: Object): number?
    const Held = Locks[Obj.RuntimeId]
    return if Held then Held.UserId else nil
end

function Objects:GetHolder(Obj: Object): any?
    const Held = Locks[Obj.RuntimeId]
    return if Held then Held.Holder else nil
end

function Objects:IsLocked(Obj: Object): boolean
    return Locks[Obj.RuntimeId] ~= nil
end

-- Everything one holder has, let go at once. What a player being evicted from a
-- scene comes down to, and what losing the right to edit one comes down to:
-- both leave somebody holding objects they may no longer touch, and nobody else
-- able to touch them either.
--
-- Scoped to a scene when one is named, because being shut out of one room is
-- not being shut out of the others.
function Objects.ReleaseFor(Who: any, Scene: Types.SceneIdentifier?)
    const Released = {}

    for Identifier, Held in Locks do
        if not SameHolder(Held, Who) then
            continue
        end

        const Obj = Workspace[Identifier]
        if Obj and (Scene == nil or Obj.Scene == Scene) then
            table.insert(Released, Obj)
        end
    end

    if #Released > 0 then
        Objects:Unlock(Released)
    end
end

-- Whether someone other than Plr holds the object, which is what every edit
-- path asks before it lets one through.
function Objects.LockedAgainst(Obj: Object, Who: any): boolean
    const Held = Locks[Obj.RuntimeId]
    return Held ~= nil and not SameHolder(Held, Who)
end

-- The locks among some objects, for a player a scene is being revealed to:
-- they are owed who holds what as well as the objects themselves.
function Objects.SendLocks(Plr: Player, List: {Object})
    const Ids = {}
    const Holders = {}
    const Flags = {}

    for _, Obj in List do
        const Held = Locks[Obj.RuntimeId]
        if Held and not Obj.Destroyed then
            table.insert(Ids, Obj.RuntimeId)

            -- Zero where the holder is not a person, exactly as AnnounceLocks
            -- sends it. UserId is nil for a holder that is a module or a
            -- string, and table.insert of a nil leaves a hole that shifts
            -- every later holder against its id.
            table.insert(Holders, Held.UserId or 0)
            table.insert(Flags, true)
        end
    end

    if #Ids > 0 then
        Network.LocksChanged:Fire(Plr, Ids, Holders, Flags)
    end
end

-- Resolves what a client named, refusing the whole request over one it may not
-- have: an object that is gone, in a scene it was never admitted to, or one it
-- may not edit. A lock on something you cannot change would only be a way to
-- stop others changing it.
const function Claimable(Plr: Player, Ids: {RuntimeId}): {Object}?
    if #Ids > MAX_LOCKS or not Permissions:Consume(Plr, #Ids) then
        return nil
    end

    const List = {}
    for _, Identifier in Ids do
        const Obj = Workspace[Identifier]
        if not Obj or Obj.Destroyed or not Audience.Sees(Plr, Obj.Scene) or not Permissions:Can(Plr, "Edit", Obj) then
            return nil
        end

        table.insert(List, Obj)
    end

    return List
end

Network.Lock.OnInvoke = function(Plr: Player, Ids: {RuntimeId}): boolean
    const List = Claimable(Plr, Ids)
    return List ~= nil and Objects:Lock(List, Plr)
end

-- Releasing needs no rights: a player who lost them since should still be able
-- to let go. Objects that are gone are simply skipped.
Network.Unlock.OnInvoke = function(Plr: Player, Ids: {RuntimeId}): boolean
    if #Ids > MAX_LOCKS or not Permissions:Consume(Plr) then
        return false
    end

    const List = {}
    for _, Identifier in Ids do
        const Obj = Workspace[Identifier]
        if Obj and not Obj.Destroyed then
            table.insert(List, Obj)
        end
    end

    return Objects:Unlock(List, Plr)
end

-- A lock goes with the connection it was taken on.
-- A hold goes with whoever had it. Leaving is the obvious way to lose one;
-- Permissions below is the other, and Scenes calls ReleaseFor when it evicts
-- somebody.
Players.PlayerRemoving:Connect(function(Plr: Player)
    Objects.ReleaseFor(Plr)
end)

-- Rights over a scene changed for somebody. A hold is worth having only where
-- an edit would be allowed, so one held by a player who may no longer edit
-- there is a hold nobody benefits from and nobody else can take: they keep the
-- object to themselves without being able to do anything with it.
Permissions.OnSceneRights(function(UserId: number, Scene: Types.SceneIdentifier)
    -- By user id throughout. Asking Players for the person would answer nil for
    -- anybody not connected, and rights are granted to people who have not
    -- arrived yet -- Scenes.new takes a whole collaborator list.
    const Rights = Permissions:GetOn(Scene, UserId)
    if Rights and Rights.CanEdit then
        return
    end

    Objects.ReleaseFor(UserId, Scene)
end)

Network.SetProperty.OnInvoke = function(Plr: Player, Identifier: RuntimeId, PropId: PropertyTypes.PropertyIdentifier, Compressed: buffer): boolean
    -- Budget first. Check used to run after the workspace lookup, so a client
    -- spamming runtime ids that do not exist returned early and never spent any
    -- of its allowance -- the one flood the limiter most needed to catch.
    if not Permissions:Consume(Plr) then
        return false
    end

    const Obj = Workspace[Identifier]
    if not Obj or Obj.Destroyed then
        return false
    end

    -- A scene this player was never admitted to is one they have not been told
    -- exists, so its objects are answered for exactly as missing ones are.
    -- Holding rights over such a scene is inert rather than clever, and this is
    -- what makes it so.
    if not Audience.Sees(Plr, Obj.Scene) then
        return false
    end

    if Objects.LockedAgainst(Obj, Plr) then
        return false
    end

    if not Permissions:Can(Plr, "Edit", Obj, PropId) then
        return false
    end

    const Prop = Obj.Properties[PropId]
    if not Prop then
        return false
    end

    -- The payload is self describing, so this also confirms the client sent the
    -- type the property actually expects rather than trusting it to.
    const Ok, Value, Type = pcall(function()
        const Decoded, _, DecodedType = Compressor:DecompressValue(Compressed, 0)
        return Decoded, DecodedType
    end)

    if not Ok or Type ~= Prop.Type then
        return false
    end

    -- Read before the write and compared after, because a set that changed
    -- nothing is not a step: a drag issuing one per frame would otherwise fill
    -- a player's history with entries that undo to themselves.
    const Before = Prop.Value
    if not Obj:Set(PropId, Value) then
        return false
    end

    if Prop.Value ~= Before then
        for _, Callback in Edited do
            Callback(Plr, Obj, PropId, Before, Prop.Value)
        end
    end

    return true
end

Network.Destroy.OnInvoke = function(Plr: Player, Identifier: RuntimeId): boolean
    if not Permissions:Consume(Plr) then
        return false
    end

    const Obj = Workspace[Identifier]
    if not Obj or Obj.Destroyed or not Audience.Sees(Plr, Obj.Scene) then
        return false
    end

    if Objects.LockedAgainst(Obj, Plr) then
        return false
    end

    if not Permissions:Can(Plr, "Destroy", Obj) then
        return false
    end

    -- Retired rather than destroyed: a player's own destroy is theirs to take
    -- back, and this is the channel a lone Object:Destroy on the client comes
    -- down. Nothing keeping it means it is gone as immediately as it used to
    -- be.
    Objects.Retire(Plr, Obj, true)
    return true
end

return Objects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX23">
					<Properties>
						<string name="Name">Shared</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The parts of an object that are the same on both sides.
--
-- Property lookup and name resolution have always been here. The link machinery
-- joined them when the client learned to own scenes of its own: a local object
-- has to drive its instance exactly as a replicated one does, and a prefab
-- preview whose Color never reaches the part is not a preview. None of it is
-- side specific -- it needs the property registry and nothing else -- so the
-- side is resolved here the way the compressor resolves it, rather than the
-- code being written twice and drifting.

const RunService = game:GetService("RunService")

-- Typed as the server half. The two halves share every member this file uses,
-- but the default solver cannot call through a union of two module types even
-- when their signatures match.
const Properties: typeof(require("../Properties/Server")) = if RunService:IsClient()
    then require("../Properties/Client") :: any
    else require("../Properties/Server")

const PropertyTypes = require("../Properties/Types")
const Compressor = require("../Compressor")
const Logger = require("../Logger")
const Types = require("./Types")

const function NoDisconnect() end

-- Name -> id, built once when the object is. Get, Set and OnChange all take a
-- name as readily as an id, and resolving one used to scan every property on
-- the object -- over a hash keyed table, so two properties sharing a name
-- resolved to whichever one iteration happened to reach first. Built from the
-- registry's ordered property list instead: the lookup is constant, and the
-- name declared first wins every time.
const function BuildNameMap(
    Order: {PropertyTypes.PropertyIdentifier},
    Props: {[PropertyTypes.PropertyIdentifier]: PropertyTypes.Property<any>}
): {[string]: PropertyTypes.PropertyIdentifier}
    const Map = {}
    for _, Identifier in Order do
        const Prop = Props[Identifier]
        if Prop and Map[Prop.Name] == nil then
            Map[Prop.Name] = Identifier
        end
    end

    return Map
end

const function GetProperty(
    self: Types.Object,
    Reference: Types.PropertyReference
): PropertyTypes.Property<any>?
    if type(Reference) == "number" then
        return self.Properties[Reference]
    end

    const Identifier = self.Names[Reference]
    return if Identifier then self.Properties[Identifier] else nil
end

-- The object level counterpart to Set and Get: the same reference, resolved the
-- same way. Watching a property used to mean reaching into Properties by id,
-- which forced the caller to hold the id even though every other method on the
-- object accepts a name.
const function OnChange(
    self: Types.Object,
    Reference: Types.PropertyReference,
    Callback: (Value: any) -> ()
): () -> ()
    const Prop = GetProperty(self, Reference)
    if not Prop then
        -- Not an error, to match Get answering nil and Set answering false for
        -- a reference the object does not carry. But a listener that silently
        -- never fires is far harder to spot than either of those, so it warns.
        Logger:Warn(`Cannot watch {Reference} on {self.Name}: the object has no such property.`)
        return NoDisconnect
    end

    return Prop:OnChange(Callback)
end

const function BuildProperties(
    Order: {PropertyTypes.PropertyIdentifier}
): {[PropertyTypes.PropertyIdentifier]: PropertyTypes.Property<any>}
    const Map = {}
    for _, Identifier in Order do
        Map[Identifier] = Properties.new(Identifier)
    end

    return Map
end

--=============================================================================
-- Links
--=============================================================================

-- ReflectionService is plugin security, so a live game cannot call it. Reading
-- the property is enough to learn both whether it exists and what type it is.
--
-- A member that exists but currently holds nil reports as unknown rather than
-- as the string "nil", which is truthy and used to sail past the caller's guard
-- and then fail the type comparison with a misleading message.
const function GetInstancePropertyType(Inst: Instance, Name: string): string?
    const Ok, Value = pcall(function()
        return (Inst :: any)[Name]
    end)

    if not Ok or Value == nil then
        return nil
    end

    return typeof(Value)
end

-- Reading proves a member exists; only writing proves it can be set. Assigning
-- the value it already holds settles that without changing anything, so a link
-- to a read-only member like AbsoluteSize is refused at registration instead of
-- throwing inside Objects.new and then again from every change listener, where
-- the spawned thread swallows it.
const function IsWritable(Inst: Instance, Name: string): boolean
    const Ok, Current = pcall(function()
        return (Inst :: any)[Name]
    end)

    if not Ok then
        return false
    end

    return (pcall(function()
        (Inst :: any)[Name] = Current
    end))
end

-- Roblox attributes hold only these. EnumItem is not among them, and neither is
-- the table a CustomEnum option is, so SetAttribute throws on both rather than
-- failing quietly. Property links have always been type checked; this is the
-- equivalent for attribute links, which were not checked at all.
const ATTRIBUTE_TYPES: {[string]: true} = {
    string = true,
    boolean = true,
    number = true,
    UDim = true,
    UDim2 = true,
    BrickColor = true,
    Color3 = true,
    Vector2 = true,
    Vector3 = true,
    CFrame = true,
    NumberSequence = true,
    ColorSequence = true,
    NumberRange = true,
    Rect = true,
    Font = true,
}

-- Links are checked once, against the template, when the type is registered on
-- the server. A client receives them already checked, beside the template they
-- were checked against. Every clone has the same class and the same members, so the answer never
-- differs between them, and these checks used to run inside Objects.new, which
-- meant one malformed link warned once for every object ever created from that
-- registry.
const function ValidateLinks(
    Name: string,
    Target: Instance?,
    Links: {Types.InstanceLinkRegistry}?,
    PropertyIds: {PropertyTypes.PropertyIdentifier}
): {Types.InstanceLinkRegistry}?
    if not Links or #Links == 0 then
        return nil
    end

    if not Target then
        Logger:Warn(`Object {Name} declares links but has no Instance for them to drive. Links dropped.`)
        return nil
    end

    const Owned = {}
    for _, Id in PropertyIds do
        Owned[Id] = true
    end

    const Valid = {}
    const Seen = {}

    for _, Link in Links do
        const Registry = Properties:GetRegistry(Link.Property)
        if not Registry or not Owned[Link.Property] then
            Logger:Warn(`Object {Name} links property {Link.Property}, which it does not carry. Link dropped.`)
            continue
        end

        -- One link per property. The map holding them is keyed by property id,
        -- so a second link overwrote the first, leaving the first's change
        -- listener connected with nothing holding its disconnect -- still
        -- writing to its target for the whole life of the object.
        if Seen[Link.Property] then
            Logger:Warn(`Object {Name} links property {Registry.Name} more than once. The duplicate is dropped.`)
            continue
        end

        -- Said here rather than left to the type check below, which an Object
        -- would sail past: a reference is a local id, so Luau calls it a
        -- number and a link would happily drive an IntValue with it. What the
        -- instance would get is an id that means nothing outside the copy it
        -- came from, updated whenever the reference changes and pointing at a
        -- different object the moment the scene is loaded twice.
        if Registry.Type == "Object" then
            Logger:Warn(`Object {Name} links {Registry.Name}, which is an Object reference. A reference cannot drive an instance member. Link dropped.`)
            continue
        end

        const Inst = if Link.Descendant
            then Target:FindFirstChild(Link.Descendant, true)
            else Target

        if not Inst then
            Logger:Warn(`Object {Name} links to a descendant named {Link.Descendant}, which {Target.Name} does not have. Link dropped.`)
            continue
        end

        const Expected = PropertyTypes.Map[Registry.Type]

        if Link.Type == "Property" then
            const Actual = GetInstancePropertyType(Inst, Link.Name)
            if not Actual then
                Logger:Warn(`Object {Name} links to {Inst.ClassName}.{Link.Name}, which is not readable or holds nil. Link dropped.`)
                continue
            end

            if Actual ~= Expected then
                Logger:Warn(`Object {Name} links {Registry.Name} ({Expected}) to {Inst.ClassName}.{Link.Name} ({Actual}). Link dropped.`)
                continue
            end

            if not IsWritable(Inst, Link.Name) then
                Logger:Warn(`Object {Name} links to {Inst.ClassName}.{Link.Name}, which is read only. Link dropped.`)
                continue
            end
        elseif Link.Type == "Attribute" then
            if not ATTRIBUTE_TYPES[Expected] then
                Logger:Warn(`Object {Name} links {Registry.Name} to an attribute, but a Roblox attribute cannot hold {Expected}. Link dropped.`)
                continue
            end
        else
            Logger:Warn(`Object {Name} has a link of type {Link.Type}, which is neither Property nor Attribute. Link dropped.`)
            continue
        end

        Seen[Link.Property] = true
        table.insert(Valid, Link)
    end

    return if #Valid > 0 then Valid else nil
end

-- Wiring only. ValidateLinks has already rejected anything that cannot work and
-- every clone shares the template's shape, so this no longer warns about link
-- shape -- it would repeat the same message once per object. The pcall stays
-- because the clone is not literally the instance that was validated.
const function BuildLinks(
    Target: Instance?,
    Links: {Types.InstanceLinkRegistry}?,
    Props: {[PropertyTypes.PropertyIdentifier]: PropertyTypes.Property<any>}
): {[PropertyTypes.PropertyIdentifier]: Types.InstanceLink}?
    if not Links or not Target then
        return nil
    end

    const Map = {}
    local Count = 0

    for _, Registry in Links do
        const Link: Types.InstanceLink = table.clone(Registry) :: any
        const Prop = Props[Link.Property]
        if not Prop then
            continue
        end

        const Inst = if Link.Descendant
            then Target:FindFirstChild(Link.Descendant, true)
            else Target

        if not Inst then
            continue
        end

        const Apply = if Link.Type == "Attribute"
            then function(Value: any)
                Inst:SetAttribute(Link.Name, Value)
            end
            else function(Value: any)
                (Inst :: any)[Link.Name] = Value
            end

        if Prop.Value ~= nil and not pcall(Apply, Prop.Value) then
            Logger:Warn(`Failed to apply link {Link.Name} on {Inst.ClassName}. Link dropped.`)
            continue
        end

        Link.Disconnect = Prop:OnChange(Apply)
        Map[Link.Property] = Link
        Count += 1
    end

    return if Count > 0 then Map else nil
end

--=============================================================================
-- References
--=============================================================================

-- An Object property holds the target's local id -- the low half of its
-- persistent id -- and nothing else. That is what makes a reference survive a
-- save: it is written exactly as the pack's own ids are, and the scene stamps
-- its own id on at load, so every reference inside a pack moves by the same
-- amount and still names what it named.
--
-- A local id only means something inside one copy. Ask a scene loaded twice for
-- local id 4 and there are two answers, which is the whole point: two loaded
-- copies of one room each point at their own door. So resolution always goes
-- through the copy holding the object doing the referring, never through a
-- scene and never through the workspace.
--
-- Each side hands in its own Find, because Shared cannot require the module
-- that requires it: the server reads the copy's ByLocal, the client its index
-- of the same thing.

export type Find = (Instance_: Types.SceneInstanceId, Local: number) -> Types.Object?

-- No target. Zero rather than nil, because a property with no value reads as
-- its default and the format has to write something either way.
const NO_TARGET = 0

const function AllowedType(Constraints: any, Target: Types.Object): boolean
    if not Constraints or not Constraints.Types then
        return true
    end

    return table.find(Constraints.Types, Target.Registry) ~= nil
        or table.find(Constraints.Types, Target.Name) ~= nil
end

-- The live object an Object property points at, or nil. Nil covers three cases
-- that are deliberately not told apart: the property holds no target, the
-- target was destroyed, and the target has not been built yet -- a pack
-- restores its objects one at a time, so a button is read back before the door
-- it points at exists. The stored id is untouched in all three, so a target
-- that comes back under the local id it had -- a copy loaded again from the
-- same pack -- is pointed at again by everything that pointed at it.
const function ResolveReference(Copy: Types.SceneInstanceId, Value: any, Find: Find): Types.Object?
    if type(Value) ~= "number" or Value == NO_TARGET then
        return nil
    end

    const Target = Find(Copy, Value)
    if not Target or Target.Destroyed then
        return nil
    end

    return Target
end

-- What to store for a value someone wants to put in an Object property: a live
-- object, a local id, or nil to clear it. Returns nil and a reason when the
-- value cannot be held, so each caller can refuse the way its layer refuses --
-- a setter returns false, a transaction refuses the whole list.
--
-- The type constraint is checked here rather than in Properties:IsValid because
-- this is the first layer that can: a property knows its own value, not which
-- object carries it, and what a local id names depends on which copy is asking.
-- It is checked only when the target actually resolves. A dangling id is always
-- allowed -- refusing one would make a pack unrestorable in any order but the
-- one it happened to be written in.
--
-- Takes the copy rather than the object doing the referring, because the object
-- is not always there to take: Construct applies a create's initial values
-- before the object they belong to has been assembled, and the copy is what the
-- ids are read against in either case.
const function Reference(
    Copy: Types.SceneInstanceId,
    Prop: PropertyTypes.Property<any>,
    Value: any,
    Find: Find
): (number?, string?)
    if Value == nil then
        return NO_TARGET
    end

    local Target: number

    if type(Value) == "number" then
        Target = Value
    elseif type(Value) == "table" and type((Value :: any).RuntimeId) == "number" then
        const Other = Value :: Types.Object
        if Other.Destroyed then
            return nil, `{Other.Name} has been destroyed`
        end

        -- The one hard constraint on a reference. A local id from another copy
        -- would name whatever happens to hold that id here, and after either
        -- scene is saved and loaded somewhere else it would name nothing at
        -- all. Cross-copy and cross-scene references are out of scope for the
        -- same reason.
        if Other.InstanceId ~= Copy then
            return nil, `{Other.Name} is in another copy, and a reference only names objects in the copy holding it`
        end

        Target = Other.LocalId
    else
        return nil, `a {typeof(Value)} is neither an object nor a local id`
    end

    if Target == NO_TARGET then
        return NO_TARGET
    end

    const Found = Find(Copy, Target)
    if Found and not Found.Destroyed and not AllowedType(Prop.Constraints, Found) then
        return nil, `{Prop.Name} may not point at a {Found.Name}`
    end

    return Target
end

-- A saved object's values split in two: the ones that can be applied as they
-- are, and the references, which cannot.
--
-- A reference holds a local id, and a pack being *placed* -- read into a copy
-- that already exists, rather than into a copy of its own -- is read under new
-- ids that its scene mints as it goes. The saved id means nothing there: at
-- best it names nothing, at worst it names whatever else in that copy happens
-- to answer to it, which would wire a pasted button to a door it has never met.
--
-- So they are held back, and written afterwards against a map of what the
-- placement actually made. Loading a pack as a whole new copy has no such
-- problem -- every object keeps the id it was saved with -- which is why this
-- is the placing path's alone.
const function SplitReferences(
    Values: {[PropertyTypes.PropertyIdentifier]: any}
): ({[PropertyTypes.PropertyIdentifier]: any}, {[PropertyTypes.PropertyIdentifier]: any}?)
    const Plain = {}
    local References: {[PropertyTypes.PropertyIdentifier]: any}? = nil

    for Id, Value in Values do
        const Registry = Properties:GetRegistry(Id)
        if Registry and Registry.Type == "Object" then
            if not References then
                References = {}
            end

            (References :: any)[Id] = Value
            continue
        end

        Plain[Id] = Value
    end

    return Plain, References
end

-- What a setter hands to Prop:Set, for any property type. Everything but an
-- Object passes straight through, so a caller does not have to know which kind
-- it is holding -- there are four setters across the two sides and each one
-- forgetting this individually is how a reference would come to mean one thing
-- through a transaction and another through Object:Set.
const function Accept(
    Obj: Types.Object,
    Prop: PropertyTypes.Property<any>,
    Value: any,
    Find: Find
): (boolean, any)
    if Prop.Type ~= "Object" then
        return true, Value
    end

    const Target, Why = Reference(Obj.InstanceId, Prop, Value, Find)
    if Target == nil then
        Logger:Warn(`Cannot point {Obj.Name}.{Prop.Name} at that value: {Why}.`)
        return false, nil
    end

    return true, Target
end

-- An object's values as initial values for another of its type, which is what
-- duplicating one is. The value held, not the default: a property left at its
-- default has nothing to copy, and the new object starts at that default anyway.
const function Snapshot(Obj: Types.Object): {[PropertyTypes.PropertyIdentifier]: any}
    const Values = {}
    for PropertyId, Prop in Obj.Properties do
        if Prop.Value ~= nil then
            Values[PropertyId] = Prop.Value
        end
    end

    return Values
end

-- What a restored object keeps of its save without understanding it: records
-- the pack could not place at all, and values for properties its type no
-- longer lists. Construct skips the second kind -- rightly, an object carries
-- only its type's properties -- which used to mean removing a property from a
-- type and saving erased every value it held, silently. Kept as tagged bytes,
-- written back by a save and by nothing else. Nil when there is nothing.
const function Leftovers(Obj: Types.Object, Decompressed: any): {[PropertyTypes.PropertyIdentifier]: buffer}?
    local Kept: {[PropertyTypes.PropertyIdentifier]: buffer}? = nil

    if Decompressed.Unknown then
        Kept = table.clone(Decompressed.Unknown)
    end

    for PropertyId, Value in Decompressed.Properties do
        if Obj.Properties[PropertyId] then
            continue
        end

        -- Read against its registry, so the type is the one it was saved as.
        const Registry = Properties:GetRegistry(PropertyId)
        const Tagged = if Registry then Compressor:CompressValue(Registry.Type, Value) else nil
        if not Tagged then
            continue
        end

        if not Kept then
            Kept = {}
        end

        (Kept :: {[PropertyTypes.PropertyIdentifier]: buffer})[PropertyId] = Tagged
    end

    return Kept
end

-- Releases every link an object holds. Links belong to the object rather than
-- to the instance they drive: hanging them off an AncestryChanged handler kept
-- every instance alive in a strongly keyed pool and never fired at all for an
-- object destroyed directly.
const function ReleaseLinks(Links: {[PropertyTypes.PropertyIdentifier]: Types.InstanceLink}?)
    if not Links then
        return
    end

    for _, Link in Links do
        if Link.Disconnect then
            Link.Disconnect()
        end
    end
end

return {
    -- Stamped on every clone an object owns, before it is parented, so the tag
    -- and the id replicate as part of the instance itself. The runtime id, not
    -- the persistent one: this pairs a part with one live object, and a
    -- persistent id names every copy of it at once.
    --
    -- The instance reference that rides alongside ObjectAdded and the join
    -- replay is a fast path, not a guarantee: a client that has not replicated
    -- the part yet -- because it announced itself mid-join, or because streaming
    -- has not brought that region in -- decodes the reference as nil, and
    -- nothing ever sends it again. Carrying the runtime id on the instance lets
    -- the client rebuild the link whenever the part does arrive.
    RuntimeAttribute = "PrismRuntimeId",
    ObjectTag = "PrismObject",

    BuildNameMap = BuildNameMap,
    GetProperty = GetProperty,
    OnChange = OnChange,

    BuildProperties = BuildProperties,
    ValidateLinks = ValidateLinks,
    BuildLinks = BuildLinks,
    ReleaseLinks = ReleaseLinks,
    Snapshot = Snapshot,
    Leftovers = Leftovers,

    NO_TARGET = NO_TARGET,
    ResolveReference = ResolveReference,
    Reference = Reference,
    Accept = Accept,
    SplitReferences = SplitReferences,

    -- Reading or destroying an already destroyed object answers instead of
    -- throwing. The previous noop raised an error, which meant a stale
    -- reference could not even be checked and Destroy was not idempotent.
    Destroyed = {
        Get = function(): any?
            return nil
        end,

        Set = function(): boolean
            return false
        end,

        GetProperty = function(): PropertyTypes.Property<any>?
            return nil
        end,

        -- Still a disconnect function, so a caller that watches a stale object
        -- and later releases the listener does not fail on the release.
        OnChange = function(): () -> ()
            return NoDisconnect
        end,

        Destroy = function() end,
    },
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX24">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const PropertyTypes = require("../Properties/Types")
const Handles = require("../Handles")

export type ObjectIdentifier = number

-- Names one live object for this session only, and the only identity that ever
-- crosses the wire. Unique across the server while it exists; never saved.
export type RuntimeId = number

-- Names an object inside a pack, and survives the session. Deliberately not
-- unique among live objects: instancing a scene twice gives every copy the ids
-- its pack was written with. See Handles.
export type PersistentId = Handles.PersistentId
export type SceneIdentifier = Handles.SceneIdentifier

-- One live copy of a scene, for this session only.
export type SceneInstanceId = number

-- Every lookup on an object takes either the property's id or its name.
export type PropertyReference = PropertyTypes.PropertyIdentifier | string

-- How far an object's data goes, named for the two audiences a scene has:
-- every player, all of whom are shown the copies of every scene the server
-- built, and the players the scene admits.
export type Reach = "Everyone" | "Admitted"

export type InstanceLinkRegistry = {
    Property: PropertyTypes.PropertyIdentifier,
    Type: "Property" | "Attribute",
    Descendant: string?,
    Name: string,
}

export type InstanceLink = InstanceLinkRegistry & {
    -- The disconnect function returned by Property:OnChange, not an
    -- RBXScriptConnection. The old code called :Destroy() on this, which is not
    -- a member of RBXScriptConnection and threw during cleanup.
    Disconnect: (() -> ())?,
}

export type ObjectRegistry = {
    Id: ObjectIdentifier,
    Name: string,
    Properties: {PropertyTypes.PropertyIdentifier},

    -- Template only. Objects.new clones it and parents the clone into the copy
    -- the object belongs to, so put it somewhere that does not render on its
    -- own. ReplicatedStorage if a client will ever build these objects itself
    -- -- the registry replicates with this reference, and it resolves only on
    -- a client the instance replicates to -- or ServerStorage if only the
    -- server ever will.
    Instance: Instance?,
    Links: {InstanceLinkRegistry}?,

    -- Who is sent the data of this type's objects: every player, or only the
    -- ones the scene holding the object admits. Whole objects either way --
    -- nothing withholds some of an object's properties and sends the rest.
    -- The part is another matter: one the server built replicates to everybody
    -- whatever this says.
    Replicate: Reach,

    -- Client side only: whether the server's registry has a template, which
    -- tells a nil Instance above apart from one that did not replicate here.
    HasTemplate: boolean?,
}

export type ObjectConfig = {
    Name: string,
    Properties: {PropertyTypes.PropertyIdentifier},

    Instance: Instance?,
    Links: {InstanceLinkRegistry}?,

    -- Everyone when left out.
    Replicate: Reach?,
}

export type Object = {
    -- What to hold, look up and send. Two objects are the same object when
    -- their runtime ids match.
    RuntimeId: RuntimeId,

    -- What to write down. Scene and LocalId are the halves PersistentId is made
    -- of, kept alongside so reading one does not mean unpacking it, and so a
    -- printed persistent id -- a large opaque number -- can be made sense of.
    PersistentId: PersistentId,
    Scene: SceneIdentifier,
    LocalId: number,

    -- The live copy of the scene this object belongs to. Two objects can share
    -- a persistent id and differ here; that is what instancing a scene means.
    InstanceId: SceneInstanceId,

    Registry: ObjectIdentifier,
    Name: string,

    -- Destroyed, but kept whole so the destroy can be taken back. Set while
    -- something -- a history step, on either side -- is holding the object
    -- against an undo. It is out of the world by every measure a caller can
    -- see: Destroyed is true, it is gone from the workspace and from its copy,
    -- its part is gone and every client has been told. What survives is the
    -- table, the property values and both ids, which is what lets it come back
    -- as itself rather than as a new object holding the same numbers.
    Suspended: boolean?,

    -- Client side only. True when the object belongs to a scene this client
    -- owns, which is what makes its edits apply on the spot: there is nobody to
    -- ask and nothing to roll back to. An editor reads it to know whether an
    -- edit it just made can still be refused.
    Local: boolean?,

    -- Client side only. True when this client built the object's instance
    -- itself because the server opened the copy holding it rather than loading
    -- it. The instance is this client's, then, and goes when the object does.
    Drawn: boolean?,

    Properties: {[PropertyTypes.PropertyIdentifier]: PropertyTypes.Property<any>},

    -- Values the object was saved with that its type no longer lists, or that
    -- this build cannot read, as their tagged bytes by property id. Never read
    -- or replicated; written back when the object is saved, so taking a
    -- property off a type and saving does not erase every value it held. See
    -- Compressor's DecompressedObject.
    Unknown: {[PropertyTypes.PropertyIdentifier]: buffer}?,

    -- Property name -> id, so a lookup by name costs what a lookup by id does.
    -- Built once from the registry's ordered property list.
    Names: {[string]: PropertyTypes.PropertyIdentifier},
    Destroyed: boolean,

    Instance: Instance?,

    -- Called by Destroy to drop the object from the scene copy holding it. A
    -- plain callback rather than a reference to the copy, because naming that
    -- type here would put Objects and Scenes in a require cycle.
    Release: (() -> ())?,

    -- Keyed by property id, not an array: a link is looked up by the property
    -- it mirrors.
    Links: {[PropertyTypes.PropertyIdentifier]: InstanceLink}?,

    -- ClientSided is the client's, and ignored on the server: shown here, sent
    -- nowhere, until a set without it ends the preview. See Objects/Client.
    Set: (self: Object, Property: PropertyReference, Value: any?, ClientSided: boolean?) -> boolean,
    Get: (self: Object, Property: PropertyReference) -> any?,

    -- The property instance itself, for the parts of it Get and Set do not
    -- cover: SetDefault, Constraints, DefaultValue. Indexing Properties by hand
    -- works too, but only by id.
    GetProperty: (self: Object, Property: PropertyReference) -> PropertyTypes.Property<any>?,

    -- Returns the disconnect function from Property:OnChange. An unknown
    -- reference warns and returns a disconnect that does nothing.
    OnChange: (self: Object, Property: PropertyReference, Callback: (Value: any) -> ()) -> () -> (),
    Destroy: (self: Object) -> (),
}

return true
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBX25">
				<Properties>
					<string name="Name">Permissions</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX26">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The client's view of its own rights, so an editor can grey out tools instead
-- of firing requests the server will refuse. The server re-checks everything.
--
-- Global rights arrive as one set; rights over a scene arrive one scene at a
-- time, and only for scenes that have granted this player something.

const Network = require("./Network")
const Shared = require("./Shared")
const Types = require("./Types")

export type Action = Types.Action
export type Target = Types.Target
export type SceneRights = Types.SceneRights
export type GlobalRights = Types.GlobalRights

const Permissions = {}

-- Nil for a change to the global rights, or the scene whose rights changed.
const Listeners: {(Scene: number?) -> ()} = {}

-- Until the server says otherwise: the default budget, and nothing else.
local Global: GlobalRights = Shared.GlobalRights(nil, nil)
const ByScene: {[number]: SceneRights} = {}

function Permissions:Get(): GlobalRights
    return Global
end

function Permissions:GetOn(Scene: number): SceneRights?
    return ByScene[Scene]
end

-- Mirrors the server: Target is the object, or for a create a table naming the
-- scene and the type; Property is the one being written.
function Permissions:Can(Action: Action, Target: Target, Property: number?): boolean
    const Rights = ByScene[Target.Scene]
    if not Rights then
        return false
    end

    return Shared.Allows(Rights, Action, Target.Registry, Property)
end

function Permissions:Has(Capability: string, Scene: number?): boolean
    if Scene == nil then
        return Global.Capabilities[Capability] == true
    end

    const Rights = ByScene[Scene]
    return Rights ~= nil and Rights.Capabilities[Capability] == true
end

function Permissions:OnChange(Callback: (Scene: number?) -> ()): () -> ()
    table.insert(Listeners, Callback)
    return function()
        const Position = table.find(Listeners, Callback)
        if Position then
            table.remove(Listeners, Position)
        end
    end
end

const function Notify(Scene: number?)
    for _, Callback in table.clone(Listeners) do
        task.spawn(Callback, Scene)
    end
end

-- Every set arrives as a sequential array and is rebuilt into a map here:
-- non-sequential numeric keys are not guaranteed to survive a remote, and a map
-- sent as one used to arrive with blacklist entries missing.
Network.Assigned:Connect(function(Payload: Types.GlobalRightsPayload)
    Global = Shared.DecodeGlobal(Payload)
    Notify(nil)
end)

Network.SceneAssigned:Connect(function(Scene: number, Payload: Types.SceneRightsPayload?)
    ByScene[Scene] = if Payload then Shared.DecodeScene(Payload) else nil
    Notify(Scene)
end)

return Permissions
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX27">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")
return {
    Assigned = Networking:Get("Permissions.Assigned"),
    SceneAssigned = Networking:Get("Permissions.SceneAssigned"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX28">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Server side authorization.
--
-- Before this existed, Objects.SetProperty and Objects.Destroy accepted the
-- calling Player and ignored it, and runtime ids are sequential from 1, so any
-- client could walk the whole workspace and edit or delete all of it.
--
-- Rights come in two kinds. Global rights are about the session rather than any
-- document: the action budget, whether a client may push a scene of its own,
-- and whatever capabilities a game hangs off them. Scene rights are about one
-- scene: Prism's three verbs, the object and property lists they reach, and the
-- scene's own capabilities. "May edit" has to mean "may edit this scene", or
-- two groups building two levels in one server can each touch the other's.
-- Nobody holds anything on a scene until it is granted to them.
--
-- A role is a template, not a live link. Granting one clears what the player
-- held and copies the role in, and from then on the player's own set is the
-- whole truth. Editing a role later would not reach anyone who already holds
-- it: the price, taken knowingly, of having no inheritance rules to get wrong.
--
-- Every grant is keyed by user id -- a Player is only a way of naming theirs --
-- so a grant can name someone who is not here yet and still holds when they
-- come back. Nothing is saved. Scene rights last as long as their scene and
-- global rights as long as the server; who owns a level is the game's own
-- record, and the game hands it over when the scene is made.

const Players = game:GetService("Players")

const SceneRegistry = require("../Scenes/Registry")
const Network = require("./Network")
const Shared = require("./Shared")
const Listeners = require("../Listeners")
const Logger = require("../Logger")
const Types = require("./Types")

export type Action = Types.Action
export type ObjectType = Types.ObjectType
export type Target = Types.Target
export type RoleConfig = Types.RoleConfig
export type Role = Types.Role
export type SceneRights = Types.SceneRights
export type GlobalRights = Types.GlobalRights

const RATE_WINDOW = 1

const Permissions = {}
const Roles: {[string]: Role} = {}

-- By user id, for the life of the server.
const Global: {[number]: GlobalRights} = {}

-- Spending is not a right, it is what a connection has done lately, so it is
-- keyed by the connection and goes with it.
const Budget: {[any]: {Count: number, Window: number}} = {}

-- Every capability something grants, so asking for one nothing grants can say
-- so -- once -- instead of quietly answering false forever.
const Known: {[string]: true} = {}
const Warned: {[string]: true} = {}

-- What a player with no global grant holds.
const Default: GlobalRights = Shared.GlobalRights(nil, nil)

-- A Player, a user id, or anything carrying a numeric UserId, which is what the
-- test suite passes for a player who is not connected.
const function UserIdOf(Who: any): number?
    if typeof(Who) == "Instance" and Who:IsA("Player") then
        return (Who :: Player).UserId
    end

    if type(Who) == "number" and Who % 1 == 0 then
        return Who
    end

    if type(Who) == "table" and type(Who.UserId) == "number" then
        return Who.UserId
    end

    return nil
end

-- A scene or its id, as the live scene. Nil once it has been destroyed.
const function SceneOf(Scene: any): any
    const Identifier = if type(Scene) == "table" then Scene.Id else Scene
    return SceneRegistry.ById[Identifier]
end

const function Learn(Capabilities: {[string]: true})
    for Name in Capabilities do
        Known[Name] = true
    end
end

--=============================================================================
-- Telling the client
--=============================================================================

const function SendGlobal(UserId: number)
    const Plr = Players:GetPlayerByUserId(UserId)
    if Plr then
        Network.Assigned:Fire(Plr, Shared.EncodeGlobal(Global[UserId] or Default))
    end
end

-- Anything that changes one player's rights over one scene. Objects listens,
-- because a hold is worth having only where an edit would be allowed: a player
-- stripped of the right to edit a scene would otherwise go on holding objects
-- there that nobody, themselves included, could do anything with.
--
-- Synchronous, so the release happens before whatever changed the rights
-- carries on. Permissions cannot ask Objects itself -- Objects requires
-- Permissions, and the pair would be a cycle -- so it says, and Objects listens.
const RightsChanged: {(UserId: number, Scene: number) -> ()} = {}

function Permissions.OnSceneRights(Callback: (UserId: number, Scene: number) -> ()): () -> ()
    return Listeners.Watch(RightsChanged, Callback, "scene rights")
end

-- Nil rights say the player holds nothing on the scene any more.
const function SendScene(Scene: any, UserId: number)
    for _, Callback in RightsChanged do
        Callback(UserId, Scene.Id)
    end

    const Plr = Players:GetPlayerByUserId(UserId)
    if not Plr then
        return
    end

    const Rights = Scene.Rights[UserId]
    Network.SceneAssigned:Fire(Plr, Scene.Id, if Rights then Shared.EncodeScene(Rights) else nil)
end

--=============================================================================
-- Roles
--=============================================================================

function Permissions:Register(Name: string, Config: RoleConfig): Role?
    if Roles[Name] then
        Logger:Warn(`Role {Name} is already registered.`)
        return nil
    end

    const Role: Role = {
        Name = Name,
        Global = Shared.GlobalRights(Config.Global, Name),
        Scene = Shared.SceneRights(Config.Scene, Name),
    }

    Learn(Role.Global.Capabilities)
    Learn(Role.Scene.Capabilities)

    Roles[Name] = Role
    return Role
end

function Permissions:GetRegistered(): {[string]: Role}
    return Roles
end

const function Resolve(Who: any, RoleName: string?): (number?, Role?)
    const UserId = UserIdOf(Who)
    if not UserId then
        Logger:Warn(`Rights are granted to a Player or a user id, not a {typeof(Who)}.`)
        return nil, nil
    end

    if RoleName == nil then
        return UserId, nil
    end

    const Role = Roles[RoleName]
    if not Role then
        Logger:Warn(`Cannot grant unregistered role {RoleName}.`)
        return nil, nil
    end

    return UserId, Role
end

--=============================================================================
-- Global rights
--=============================================================================

-- Clears what the player held globally and copies the role's global half in.
function Permissions:Grant(Who: Player | number, RoleName: string): boolean
    const UserId, Role = Resolve(Who, RoleName)
    if not UserId or not Role then
        return false
    end

    Global[UserId] = Shared.CopyGlobal(Role.Global)
    SendGlobal(UserId)
    return true
end

-- Back to what a player with no global grant holds.
function Permissions:Revoke(Who: Player | number)
    const UserId = Resolve(Who, nil)
    if not UserId then
        return
    end

    Global[UserId] = nil
    SendGlobal(UserId)
end

function Permissions:GrantCapability(Who: Player | number, Capability: string)
    const UserId = Resolve(Who, nil)
    if not UserId then
        return
    end

    local Rights = Global[UserId]
    if not Rights then
        Rights = Shared.CopyGlobal(Default)
        Global[UserId] = Rights
    end

    Rights.Capabilities[Capability] = true
    Known[Capability] = true
    SendGlobal(UserId)
end

function Permissions:RevokeCapability(Who: Player | number, Capability: string)
    const UserId = Resolve(Who, nil)
    const Rights = if UserId then Global[UserId] else nil
    if not UserId or not Rights then
        return
    end

    Rights.Capabilities[Capability] = nil
    SendGlobal(UserId)
end

function Permissions:Get(Who: Player | number): GlobalRights
    const UserId = UserIdOf(Who)
    return if UserId then Global[UserId] or Default else Default
end

function Permissions:CanPush(Plr: Player): boolean
    return Permissions:Get(Plr).CanPush
end

--=============================================================================
-- Scene rights
--=============================================================================

-- Clears what the player held on the scene and copies the role's scene half
-- in. Scene:Grant is this.
function Permissions:GrantOn(Scene: any, Who: Player | number, RoleName: string): boolean
    const Owner = SceneOf(Scene)
    if not Owner then
        Logger:Warn(`Cannot grant rights on a scene that does not exist.`)
        return false
    end

    const UserId, Role = Resolve(Who, RoleName)
    if not UserId or not Role then
        return false
    end

    Owner.Rights[UserId] = Shared.CopyScene(Role.Scene)
    SendScene(Owner, UserId)
    return true
end

function Permissions:RevokeOn(Scene: any, Who: Player | number)
    const Owner = SceneOf(Scene)
    const UserId = Resolve(Who, nil)
    if not Owner or not UserId or not Owner.Rights[UserId] then
        return
    end

    Owner.Rights[UserId] = nil
    SendScene(Owner, UserId)
end

-- On its own, without a role. A player who held nothing on the scene holds the
-- capability and no verbs.
function Permissions:GrantCapabilityOn(Scene: any, Who: Player | number, Capability: string)
    const Owner = SceneOf(Scene)
    const UserId = Resolve(Who, nil)
    if not Owner or not UserId then
        return
    end

    local Rights = Owner.Rights[UserId]
    if not Rights then
        Rights = Shared.SceneRights(nil, nil)
        Owner.Rights[UserId] = Rights
    end

    Rights.Capabilities[Capability] = true
    Known[Capability] = true
    SendScene(Owner, UserId)
end

function Permissions:RevokeCapabilityOn(Scene: any, Who: Player | number, Capability: string)
    const Owner = SceneOf(Scene)
    const UserId = Resolve(Who, nil)
    const Rights = if Owner and UserId then Owner.Rights[UserId] else nil
    if not Rights or not UserId then
        return
    end

    Rights.Capabilities[Capability] = nil
    SendScene(Owner, UserId)
end

function Permissions:GetOn(Scene: any, Who: Player | number): SceneRights?
    const Owner = SceneOf(Scene)
    const UserId = UserIdOf(Who)
    return if Owner and UserId then Owner.Rights[UserId] else nil
end

-- The wire form of one player's rights on one scene, as the client receives it.
function Permissions:GetPayloadOn(Scene: any, Who: Player | number): Types.SceneRightsPayload?
    const Rights = Permissions:GetOn(Scene, Who)
    return if Rights then Shared.EncodeScene(Rights) else nil
end

-- A scene going away takes its rights with it. Called by the scene as it is
-- destroyed, while it can still be found, so everyone present who held rights
-- on it is told they hold none.
function Permissions.DropScene(Scene: any)
    for UserId in table.clone(Scene.Rights) do
        Scene.Rights[UserId] = nil
        SendScene(Scene, UserId)
    end
end

--=============================================================================
-- Checks
--=============================================================================

-- Whether a player may do something to an object. Target is the object -- it
-- carries its scene and its type -- or, for a create, a table naming the scene
-- and the type it would make. Property is the one being written, for an edit
-- or a create's initial value.
function Permissions:Can(Plr: Player, Action: Action, Target: Target, Property: number?): boolean
    if Action ~= "Create" and Action ~= "Edit" and Action ~= "Destroy" then
        Logger:Warn(`Unknown permission action {Action}. Denying.`)
        return false
    end

    const UserId = UserIdOf(Plr)
    const Owner = SceneRegistry.ById[Target.Scene]
    if not UserId or not Owner then
        return false
    end

    const Rights = Owner.Rights[UserId]
    if not Rights then
        return false
    end

    return Shared.Allows(Rights, Action, Target.Registry, Property)
end

-- Whether a player holds a capability: globally with no scene named, or on
-- that scene. Prism answers for capabilities and enforces none of them.
function Permissions:Has(Plr: Player, Capability: string, Scene: number?): boolean
    if not Known[Capability] and not Warned[Capability] then
        Warned[Capability] = true
        Logger:Warn(`Nothing grants the capability {Capability}, so asking for it answers false until a role or a grant names it.`)
    end

    const UserId = UserIdOf(Plr)
    if not UserId then
        return false
    end

    if Scene == nil then
        return (Global[UserId] or Default).Capabilities[Capability] == true
    end

    const Owner = SceneRegistry.ById[Scene]
    const Rights = if Owner then Owner.Rights[UserId] else nil
    return Rights ~= nil and Rights.Capabilities[Capability] == true
end

-- Sliding one second window, budgeted by the player's global rights so a
-- trusted player is not held to the same ceiling as an untrusted one.
--
-- Cost is what the request asks the server to do, not how many packets it
-- arrived in. A transaction charges one per operation: charging per call would
-- let a single packet carrying ten thousand operations spend one unit of a
-- sixty unit budget and walk straight past the limiter, which is the one flood
-- the limiter most needs to catch.
--
-- Clamped to at least one so no request is ever free, whatever it claims to
-- cost.
function Permissions:Consume(Plr: Player, Cost: number?): boolean
    const Charge = math.max(Cost or 1, 1)
    const Rate = Permissions:Get(Plr).Rate
    if Rate <= 0 then
        return false
    end

    const Now = os.clock()
    const Entry = Budget[Plr]

    -- A fresh window is not a free one. The old form returned true here without
    -- comparing, which was harmless while every call cost one and a rate below
    -- one denies anyway, and is not once a call can cost a thousand.
    if not Entry or Now - Entry.Window >= RATE_WINDOW then
        Budget[Plr] = {Count = Charge, Window = Now}
        return Charge <= Rate
    end

    Entry.Count += Charge
    return Entry.Count <= Rate
end

-- Called by Replication once the client has announced it is listening, rather
-- than on PlayerAdded. Firing at join meant the rights went out before the
-- client had finished requiring Prism and connecting its handlers. Global
-- rights, then the player's rights on every scene that has granted them any.
function Permissions:SendTo(Plr: Player)
    Network.Assigned:Fire(Plr, Shared.EncodeGlobal(Permissions:Get(Plr)))

    for _, Scene in SceneRegistry.ById do
        const Rights = Scene.Rights[Plr.UserId]
        if Rights then
            Network.SceneAssigned:Fire(Plr, Scene.Id, Shared.EncodeScene(Rights))
        end
    end
end

-- The budget goes with the connection. Rights do not: they are keyed by user
-- id and hold again when the player comes back.
Players.PlayerRemoving:Connect(function(Plr: Player)
    Budget[Plr] = nil
end)

return Permissions
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX29">
					<Properties>
						<string name="Name">Shared</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The parts of a permission check that are the same on both sides.
--
-- The server decides and the client only asks, to grey out a tool before a
-- request is refused. Both have to reach the same answer from the same rights,
-- or an editor shows a tool the server will not honour -- so the lists a role
-- is written with become sets here, the check is written once here, and so is
-- the wire form.

const Types = require("./Types")

const Shared = {}

-- Actions per second for anyone with no global grant. Scene rights fail closed
-- without a grant; the budget does not, because it is a ceiling on requests
-- rather than a right, and every request it lets through still meets a scene
-- that has granted nothing.
Shared.DEFAULT_RATE = 60

const function IdSet(List: {any}?): {[number]: true}
    const Set = {}
    for _, Id in List or {} do
        if type(Id) == "number" then
            Set[Id] = true
        end
    end

    return Set
end

-- Both forms of a property list can sit in one list: a number value is a
-- property id, and a numeric key holding true or a list of types is a property
-- limited to those types.
const function PropertySet(List: {[any]: any}?): {[number]: Types.PropertyEntry}
    const Set: {[number]: Types.PropertyEntry} = {}
    for Key, Value in List or {} do
        if type(Value) == "number" then
            Set[Value] = true
        elseif Value == true and type(Key) == "number" then
            Set[Key] = true
        elseif type(Value) == "table" and type(Key) == "number" then
            Set[Key] = IdSet(Value)
        end
    end

    return Set
end

const function CapabilitySet(List: {any}?): {[string]: true}
    const Set = {}
    for _, Name in List or {} do
        if type(Name) == "string" then
            Set[Name] = true
        end
    end

    return Set
end

function Shared.SceneRights(Config: Types.SceneRoleConfig?, Role: string?): Types.SceneRights
    const Given: Types.SceneRoleConfig = Config or {}
    const Objects = Given.Objects
    const Properties = Given.Properties

    return {
        Role = Role,
        CanCreate = Given.CanCreate == true,
        CanEdit = Given.CanEdit == true,
        CanDestroy = Given.CanDestroy == true,
        ObjectWhitelist = if Objects and Objects.Whitelist then IdSet(Objects.Whitelist) else nil,
        ObjectBlacklist = IdSet(if Objects then Objects.Blacklist else nil),
        PropertyWhitelist = if Properties and Properties.Whitelist then PropertySet(Properties.Whitelist) else nil,
        PropertyBlacklist = PropertySet(if Properties then Properties.Blacklist else nil),
        Capabilities = CapabilitySet(Given.Capabilities),
    }
end

function Shared.GlobalRights(Config: Types.GlobalRoleConfig?, Role: string?): Types.GlobalRights
    const Given: Types.GlobalRoleConfig = Config or {}

    return {
        Role = Role,
        Rate = Given.Rate or Shared.DEFAULT_RATE,
        CanPush = Given.CanPush == true,
        Capabilities = CapabilitySet(Given.Capabilities),
    }
end

-- A player's own set, taken from a role. The capabilities are copied because a
-- player's are granted and revoked one at a time; the lists are shared because
-- nothing ever changes them after the role is registered.
function Shared.CopyScene(Rights: Types.SceneRights): Types.SceneRights
    const Copy = table.clone(Rights)
    Copy.Capabilities = table.clone(Rights.Capabilities)
    return Copy
end

function Shared.CopyGlobal(Rights: Types.GlobalRights): Types.GlobalRights
    const Copy = table.clone(Rights)
    Copy.Capabilities = table.clone(Rights.Capabilities)
    return Copy
end

const function Listed(Set: {[number]: Types.PropertyEntry}, Property: number, ObjectType: number): boolean
    const Entry = Set[Property]
    if Entry == true then
        return true
    end

    return type(Entry) == "table" and Entry[ObjectType] == true
end

-- Verb, then the object lists, then -- for anything that writes a property --
-- the property lists. An unrecognised verb denies rather than falling through
-- to the allow path.
function Shared.Allows(Rights: Types.SceneRights, Action: string, ObjectType: number, Property: number?): boolean
    local Verb: boolean
    if Action == "Create" then
        Verb = Rights.CanCreate
    elseif Action == "Edit" then
        Verb = Rights.CanEdit
    elseif Action == "Destroy" then
        Verb = Rights.CanDestroy
    else
        return false
    end

    if not Verb then
        return false
    end

    if Rights.ObjectWhitelist and not Rights.ObjectWhitelist[ObjectType] then
        return false
    end

    if Rights.ObjectBlacklist[ObjectType] then
        return false
    end

    -- A destroy writes no property, so the property lists have nothing to say
    -- about one.
    if Property ~= nil and Action ~= "Destroy" then
        const Whitelist = Rights.PropertyWhitelist
        if Whitelist and not Listed(Whitelist, Property, ObjectType) then
            return false
        end

        if Listed(Rights.PropertyBlacklist, Property, ObjectType) then
            return false
        end
    end

    return true
end

--=============================================================================
-- The wire form
--=============================================================================

const function IdList(Set: {[number]: true}): {number}
    const List = {}
    for Id in Set do
        table.insert(List, Id)
    end

    table.sort(List)
    return List
end

const function PropertyList(Set: {[number]: Types.PropertyEntry}): {Types.PropertyEntryPayload}
    const List: {Types.PropertyEntryPayload} = {}
    for Property, Entry in Set do
        table.insert(List, {
            Property = Property,
            Types = if Entry == true then nil else IdList(Entry :: any),
        })
    end

    table.sort(List, function(A, B)
        return A.Property < B.Property
    end)

    return List
end

const function PropertyFromList(List: {Types.PropertyEntryPayload}?): {[number]: Types.PropertyEntry}
    const Set: {[number]: Types.PropertyEntry} = {}
    for _, Entry in List or {} do
        Set[Entry.Property] = if Entry.Types then IdSet(Entry.Types) else true
    end

    return Set
end

const function CapabilityList(Set: {[string]: true}): {string}
    const List = {}
    for Name in Set do
        table.insert(List, Name)
    end

    table.sort(List)
    return List
end

function Shared.EncodeScene(Rights: Types.SceneRights): Types.SceneRightsPayload
    return {
        Role = Rights.Role,
        CanCreate = Rights.CanCreate,
        CanEdit = Rights.CanEdit,
        CanDestroy = Rights.CanDestroy,
        ObjectWhitelist = if Rights.ObjectWhitelist then IdList(Rights.ObjectWhitelist) else nil,
        ObjectBlacklist = IdList(Rights.ObjectBlacklist),
        PropertyWhitelist = if Rights.PropertyWhitelist then PropertyList(Rights.PropertyWhitelist) else nil,
        PropertyBlacklist = PropertyList(Rights.PropertyBlacklist),
        Capabilities = CapabilityList(Rights.Capabilities),
    }
end

function Shared.DecodeScene(Payload: Types.SceneRightsPayload): Types.SceneRights
    return {
        Role = Payload.Role,
        CanCreate = Payload.CanCreate == true,
        CanEdit = Payload.CanEdit == true,
        CanDestroy = Payload.CanDestroy == true,
        ObjectWhitelist = if Payload.ObjectWhitelist then IdSet(Payload.ObjectWhitelist) else nil,
        ObjectBlacklist = IdSet(Payload.ObjectBlacklist),
        PropertyWhitelist = if Payload.PropertyWhitelist then PropertyFromList(Payload.PropertyWhitelist) else nil,
        PropertyBlacklist = PropertyFromList(Payload.PropertyBlacklist),
        Capabilities = CapabilitySet(Payload.Capabilities),
    }
end

function Shared.EncodeGlobal(Rights: Types.GlobalRights): Types.GlobalRightsPayload
    return {
        Role = Rights.Role,
        Rate = Rights.Rate,
        CanPush = Rights.CanPush,
        Capabilities = CapabilityList(Rights.Capabilities),
    }
end

function Shared.DecodeGlobal(Payload: Types.GlobalRightsPayload): Types.GlobalRights
    return {
        Role = Payload.Role,
        Rate = Payload.Rate or Shared.DEFAULT_RATE,
        CanPush = Payload.CanPush == true,
        Capabilities = CapabilitySet(Payload.Capabilities),
    }
end

return Shared
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX30">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Rights come in two kinds, and a role is written with both halves.
--
-- Global rights are about the session: the action budget, whether a client may
-- push a scene of its own, and capabilities that belong to no document. Scene
-- rights are about one scene: the three verbs, the object and property lists
-- they reach, and capabilities of that scene. Granting a role globally copies
-- its global half in; granting it on a scene copies its scene half.

export type Action = "Create" | "Edit" | "Destroy"

-- Registry ids. Plain numbers so this module does not have to depend on Objects
-- or Properties.
export type ObjectType = number
export type PropertyId = number

-- What a check is asked about. An object already carries both fields; a create
-- has no object yet, so it names the scene and the type it would make.
export type Target = {
    Scene: number,
    Registry: ObjectType,
}

-- A whitelist that is present is exhaustive, and one that is absent constrains
-- nothing -- the same thing the two words mean in enum constraints, and the
-- direction that fails closed when a list is built wrong.
export type ObjectLists = {
    Whitelist: {ObjectType}?,
    Blacklist: {ObjectType}?,
}

-- Property ids, as the object lists take object types, or [Property] =
-- {ObjectType} to limit an entry to those types. Kept apart from the object
-- lists so the field says which kind its keys are, and an id that is both a
-- property and an object type means one thing.
export type PropertyLists = {
    Whitelist: {[any]: any}?,
    Blacklist: {[any]: any}?,
}

export type SceneRoleConfig = {
    CanCreate: boolean?,
    CanEdit: boolean?,
    CanDestroy: boolean?,

    Objects: ObjectLists?,

    -- Writing only. Nothing in these is a reason to withhold data: what a
    -- client is sent is admission's business.
    Properties: PropertyLists?,

    -- Plain strings that exist by appearing here. Prism enforces its three
    -- verbs and only answers for these.
    Capabilities: {string}?,
}

export type GlobalRoleConfig = {
    -- Actions per second on the object remotes. A transaction spends one per
    -- operation it carries, so this bounds the work asked for rather than the
    -- number of times it is asked. Defaults to 60.
    Rate: number?,

    -- Whether a client may hand the server a scene it built.
    CanPush: boolean?,

    Capabilities: {string}?,
}

export type RoleConfig = {
    Global: GlobalRoleConfig?,
    Scene: SceneRoleConfig?,
}

-- One property's entry in a list: every type, or only these.
export type PropertyEntry = true | {[ObjectType]: true}

export type SceneRights = {
    -- The role most recently granted, for display. Informational only: the
    -- sets below are the whole truth, and a capability granted since may have
    -- moved them away from the role.
    Role: string?,

    CanCreate: boolean,
    CanEdit: boolean,
    CanDestroy: boolean,

    ObjectWhitelist: {[ObjectType]: true}?,
    ObjectBlacklist: {[ObjectType]: true},
    PropertyWhitelist: {[PropertyId]: PropertyEntry}?,
    PropertyBlacklist: {[PropertyId]: PropertyEntry},

    Capabilities: {[string]: true},
}

export type GlobalRights = {
    Role: string?,
    Rate: number,
    CanPush: boolean,
    Capabilities: {[string]: true},
}

export type Role = {
    Name: string,
    Global: GlobalRights,
    Scene: SceneRights,
}

-- What crosses the wire. Every set is a sequential array here: remotes do not
-- guarantee that non-sequential numeric keys survive serialization, and a map
-- sent as one used to arrive with entries missing, which made the client's Can
-- answer true for blacklisted types.
export type PropertyEntryPayload = {
    Property: PropertyId,
    Types: {ObjectType}?,
}

export type SceneRightsPayload = {
    Role: string?,
    CanCreate: boolean,
    CanEdit: boolean,
    CanDestroy: boolean,
    ObjectWhitelist: {ObjectType}?,
    ObjectBlacklist: {ObjectType},
    PropertyWhitelist: {PropertyEntryPayload}?,
    PropertyBlacklist: {PropertyEntryPayload},
    Capabilities: {string},
}

export type GlobalRightsPayload = {
    Role: string?,
    Rate: number,
    CanPush: boolean,
    Capabilities: {string},
}

return true
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBX31">
				<Properties>
					<string name="Name">Properties</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX32">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const CustomEnum = require("../CustomEnum")
const Network = require("./Network")
const Shared = require("./Shared")
const Logger = require("../Logger")
const Types = require("./Types")

export type PropertyType = Types.PropertyType
export type PropertyIdentifier = Types.PropertyIdentifier
export type PropertyRegistry<T> = Types.PropertyRegistry<T>
export type Property<T> = Types.Property<T>

const Properties = {}
const Registered: {[PropertyIdentifier]: PropertyRegistry<any>} = {}

function Properties:GetRegistered(): {[PropertyIdentifier]: PropertyRegistry<any>}
    return Registered
end

function Properties:GetRegistry(Identifier: PropertyIdentifier): PropertyRegistry<any>?
    return Registered[Identifier]
end

-- The client builds property instances too: the compressor needs them when it
-- decompresses metadata, and Objects/Client needs them to rebuild an object
-- from the buffer the server sends.
function Properties.new(Reference: PropertyRegistry<any> | PropertyIdentifier): Property<any>
    return Shared.new(Registered, Reference)
end

-- Some properties as a panel lays them out, from the Display that came with
-- each registry. Usually an object type's list:
-- Properties:Layout(Objects:GetRegistry(object.Registry).Properties).
function Properties:Layout(Ids: {PropertyIdentifier}, IncludeHidden: boolean?): {Types.Section}
    return Shared.Layout(Registered, Ids, IncludeHidden)
end

-- The server sends a CustomEnum constraint as the enum's name, because the enum
-- table carries methods and a remote cannot serialize a function. Resolve it
-- back into the local registry so IsValid can compare against it.
--
-- An enum this client has not registered yet is waited for rather than given
-- up on: a game may register its enums after requiring Prism, and the
-- registries can arrive first. Until then the constraint is nil, which refuses
-- every value. Property instances share their registry's Constraints table, so
-- resolving it later reaches every object already holding the property.
const Waiting: {[string]: {any}} = {}

const function Register(Payload: any)
    const Constraints = Payload.Constraints
    if Payload.Type == "CustomEnum" and Constraints and type(Constraints.CustomEnum) == "string" then
        const Name = Constraints.CustomEnum
        const Resolved = CustomEnum:GetEnum(Name)
        if not Resolved then
            Logger:Warn(`Property {Payload.Id} constrains to custom enum {Name}, which is not registered on this client yet. Its values are refused until it is.`)

            local List = Waiting[Name]
            if not List then
                List = {}
                Waiting[Name] = List
            end

            table.insert(List, Constraints)
        end

        Constraints.CustomEnum = Resolved
    end

    Registered[Payload.Id] = Payload
end

CustomEnum:OnRegistered(function(Enum)
    const List = Waiting[Enum.Name]
    if not List then
        return
    end

    Waiting[Enum.Name] = nil
    for _, Constraints in List do
        Constraints.CustomEnum = Enum
    end
end)

Network.PropertyRegistered:Connect(Register)

Network.RegistriesReplayed:Connect(function(Payloads: {any})
    for _, Payload in Payloads do
        Register(Payload)
    end
end)

-- Gone on the server, which refuses while anything is built on it. Nothing
-- replicated here carries it, so dropping the registry is all there is to do.
Network.PropertyUnregistered:Connect(function(Identifier: PropertyIdentifier)
    Registered[Identifier] = nil
end)

return Properties
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX33">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")
return {
    PropertyRegistered = Networking:Get("Properties.PropertyRegistered"),
    RegistriesReplayed = Networking:Get("Properties.RegistriesReplayed"),
    PropertyUnregistered = Networking:Get("Properties.PropertyUnregistered"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX34">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Network = require("./Network")
const Shared = require("./Shared")
const IdPool = require("../IdPool")
const Logger = require("../Logger")
const Types = require("./Types")

export type PropertyType = Types.PropertyType
export type PropertyIdentifier = Types.PropertyIdentifier
export type PropertyRegistry<T> = Types.PropertyRegistry<T>
export type PropertyConfig<T> = Types.PropertyConfig<T>
export type Property<T> = Types.Property<T>

-- Text lengths are varints now, so there is no format ceiling worth naming.
-- What actually binds is the DataStore value limit, and a single 1MB string
-- would swallow a third of a shard, so this caps it well below that.
const MAX_TEXT_LENGTH = 1048576

const Properties = {}
const Registered: {[PropertyIdentifier]: PropertyRegistry<any>} = {}

-- A CustomEnum constraint holds the enum table itself, and that table carries
-- GetById and GetByValue as function fields. A remote cannot serialize a
-- function, so firing the registry raw threw for every CustomEnum property and
-- no client ever received it. Only the enum's name crosses the wire; the client
-- resolves it against its own registry, which is why custom enums have to be
-- registered from shared code rather than server-only code.
const function ToRegistryPayload(Registry: PropertyRegistry<any>): any
    const Constraints = (Registry :: any).Constraints
    if Registry.Type ~= "CustomEnum" or not Constraints then
        return Registry
    end

    const Copy = table.clone(Constraints)
    Copy.CustomEnum = if Constraints.CustomEnum then Constraints.CustomEnum.Name else nil

    return {
        __type = "PropertyRegistry",
        Id = Registry.Id,
        Name = Registry.Name,
        Type = Registry.Type,
        Constraints = Copy,
        DefaultValue = Registry.DefaultValue,
        Display = Registry.Display,
    }
end

-- Never recycled: property ids are written into saved metadata, and reusing one
-- for a different property silently reinterprets every record still holding it.
const Ids = IdPool.new(nil, false)

-- How many things are built on each property: object types that carry it and
-- databases whose metadata holds it. Counted here rather than asked of them,
-- because Properties cannot require either without a cycle.
const Holders: {[PropertyIdentifier]: number} = {}

function Properties.Retain(Identifier: PropertyIdentifier)
    Holders[Identifier] = (Holders[Identifier] or 0) + 1
end

function Properties.Unretain(Identifier: PropertyIdentifier)
    const Count = (Holders[Identifier] or 0) - 1
    Holders[Identifier] = if Count > 0 then Count else nil
end

function Properties:Register<T>(Config: PropertyConfig<T>): PropertyIdentifier?
    const Identifier = Ids:Claim()
    if not Identifier then
        Logger:Warn("The property id pool is exhausted.")
        return
    end

    const Constraints = Config.Constraints
    if Constraints then
        if Config.Type == "Number" and Constraints.Precision then
            local Scale = 1
            while math.abs(Constraints.Precision * Scale - math.round(Constraints.Precision * Scale)) > 1e-9 do
                Scale *= 10
            end

            Constraints.Scale = Scale
        end

        if Config.Type == "Text" and Constraints.MaxLength then
            Constraints.MaxLength = math.min(Constraints.MaxLength, MAX_TEXT_LENGTH)
        end
    end

    const Prop = {}
    Prop.__type = "PropertyRegistry"
    Prop.Id = Identifier
    Prop.Name = Config.Name
    Prop.Type = Config.Type
    Prop.Constraints = Constraints
    Prop.DefaultValue = Config.DefaultValue

    -- On the registry, which already replicates, so a client builds the same
    -- panel from the same metadata without being told anything extra.
    Prop.Display = Shared.Display(Config.Display, Config.Name)

    Registered[Identifier] = Prop :: any
    Network.PropertyRegistered:FireAll(ToRegistryPayload(Prop :: any))
    return Identifier
end

-- Refused while anything is built on the property. An object type carrying it
-- would name a property nobody could build, on the server or on the client
-- rebuilding one of its objects; a database would fail to read its own records.
-- Unregister those first.
function Properties:Unregister(Identifier: PropertyIdentifier): boolean
    const Registry = Registered[Identifier]
    if not Registry then
        return false
    end

    const Held = Holders[Identifier]
    if Held then
        Logger:Warn(`Cannot unregister property {Registry.Name}: {Held} object type(s) or database(s) are built on it.`)
        return false
    end

    Registered[Identifier] = nil
    Ids:Release(Identifier)

    -- Told to every client, which used to keep serving the registry it had for
    -- the rest of the session.
    Network.PropertyUnregistered:FireAll(Identifier)
    return true
end

function Properties:GetRegistered(): {[PropertyIdentifier]: PropertyRegistry<any>}
    return Registered
end

function Properties:GetRegistry(Identifier: PropertyIdentifier): PropertyRegistry<any>?
    return Registered[Identifier]
end

-- What Replication sends to a joining player. Same shape Register broadcasts.
function Properties:GetRegistryPayload(Identifier: PropertyIdentifier): any
    const Registry = Registered[Identifier]
    return if Registry then ToRegistryPayload(Registry) else nil
end

function Properties.new(Reference: PropertyRegistry<any> | PropertyIdentifier): Property<any>
    return Shared.new(Registered, Reference)
end

-- Some properties as a panel lays them out. See Shared.Layout.
function Properties:Layout(Ids: {PropertyIdentifier}, IncludeHidden: boolean?): {Types.Section}
    return Shared.Layout(Registered, Ids, IncludeHidden)
end

return Properties
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX35">
					<Properties>
						<string name="Name">Shared</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Property instances, shared by the server and the client.
--
-- This used to live in Server.luau, which meant the client had no Properties.new
-- at all -- and the compressor calls it while decompressing metadata, so any
-- client side decompression died on a nil call.
--
-- Change notification is deliberately not a signal object. Most properties in an
-- editor are never watched, and allocating a signal table plus a handler list for
-- every property on every object costs more than the feature is worth. Instead a
-- property carries a nil Listeners field until something actually calls OnChange,
-- and drops it again when the last listener disconnects.

const Logger = require("../Logger")
const Types = require("./Types")

export type PropertyIdentifier = Types.PropertyIdentifier
export type PropertyRegistry<T> = Types.PropertyRegistry<T>
export type Property<T> = Types.Property<T>

const Shared = {}

const function __setter<T>(self: Property<T>, Value: Types.ValueFor<T>?): (boolean, boolean)
    const Val = Types:FixValue(self.Type, Value, self.Constraints)
    if Val == nil then
        return false, false
    end

    if Val == self.Value then
        return true, false
    end

    self.Value = Val

    const Listeners = self.Listeners
    if Listeners then
        for _, Callback in table.clone(Listeners) do
            task.spawn(Callback, Val)
        end
    end

    return true, true
end

const function __default_setter<T>(self: Property<T>, Value: Types.ValueFor<T>?): (boolean, boolean)
    const Val = Types:FixValue(self.Type, Value, self.Constraints)
    if Val == nil then
        return false, false
    end

    if Val == self.DefaultValue then
        return true, false
    end

    self.DefaultValue = Val
    return true, true
end

const function __on_change<T>(self: Property<T>, Callback: (Value: Types.ValueFor<T>) -> ()): () -> ()
    if typeof(Callback) ~= "function" then
        Logger:Error(`Invalid callback. Tried watching {self.Name} with a {typeof(Callback)}.`)
    end

    local Listeners = self.Listeners
    if not Listeners then
        Listeners = {}
        self.Listeners = Listeners
    end

    table.insert(Listeners :: {any}, Callback)

    local Disconnected = false
    return function()
        if Disconnected then
            return
        end

        Disconnected = true

        const Current = self.Listeners
        if not Current then
            return
        end

        const Position = table.find(Current, Callback)
        if Position then
            table.remove(Current, Position)
        end

        if #Current == 0 then
            self.Listeners = nil
        end
    end
end

const function __destroy<T>(self: Property<T>)
    self.Listeners = nil
end

--=============================================================================
-- Display
--=============================================================================

const DEFAULT_DISPLAY: Types.Display = {
    Category = "General",
    Order = 0,
    Description = nil,
    Hidden = false,
    ReadOnly = false,
}

-- Every field filled in, and a field of the wrong type dropped to its default
-- with a warning rather than handed to a panel that would draw it wrong.
function Shared.Display(Config: any, Name: string): Types.Display
    if Config ~= nil and type(Config) ~= "table" then
        Logger:Warn(`Property {Name} has a Display that is a {type(Config)}, not a table. Ignored.`)
        Config = nil
    end

    const Given = Config or {}

    const function Field(Key: string, Kind: string, Default: any): any
        const Value = Given[Key]
        if Value == nil then
            return Default
        end

        if type(Value) ~= Kind then
            Logger:Warn(`Property {Name} has Display.{Key} of type {type(Value)}, expected {Kind}. Ignored.`)
            return Default
        end

        return Value
    end

    return {
        Category = Field("Category", "string", DEFAULT_DISPLAY.Category),
        Order = Field("Order", "number", DEFAULT_DISPLAY.Order),
        Description = Field("Description", "string", nil),
        Hidden = Field("Hidden", "boolean", DEFAULT_DISPLAY.Hidden),
        ReadOnly = Field("ReadOnly", "boolean", DEFAULT_DISPLAY.ReadOnly),
    }
end

-- Some properties -- usually an object type's list -- as a panel lays them
-- out: grouped by category, each group sorted by Order, ties kept in the order
-- they were named. Categories come in the order their first property does, so
-- the lowest Order anywhere in a category puts it first. Hidden properties are
-- left out unless asked for, and ids nothing is registered under are skipped.
function Shared.Layout(
    Registry: {[PropertyIdentifier]: PropertyRegistry<any>},
    Ids: {PropertyIdentifier},
    IncludeHidden: boolean?
): {Types.Section}
    const Entries: {{Ref: PropertyRegistry<any>, Display: Types.Display, Index: number}} = {}

    for Index, Id in Ids do
        const Ref = Registry[Id]
        if not Ref then
            continue
        end

        const Display = Ref.Display or DEFAULT_DISPLAY
        if Display.Hidden and not IncludeHidden then
            continue
        end

        table.insert(Entries, {Ref = Ref, Display = Display, Index = Index})
    end

    table.sort(Entries, function(A, B)
        if A.Display.Order ~= B.Display.Order then
            return A.Display.Order < B.Display.Order
        end

        return A.Index < B.Index
    end)

    const Sections: {Types.Section} = {}
    const ByCategory: {[string]: Types.Section} = {}

    for _, Entry in Entries do
        const Category = Entry.Display.Category
        local Section = ByCategory[Category]
        if not Section then
            Section = {Category = Category, Properties = {}}
            ByCategory[Category] = Section
            table.insert(Sections, Section)
        end

        table.insert(Section.Properties, Entry.Ref)
    end

    return Sections
end

function Shared.new(
    Registry: {[PropertyIdentifier]: PropertyRegistry<any>},
    Reference: PropertyRegistry<any> | PropertyIdentifier
): Property<any>
    const TypeOf = typeof(Reference)
    local Ref: PropertyRegistry<any>

    if TypeOf == "number" then
        Ref = Registry[Reference :: PropertyIdentifier]
        if not Ref then
            Logger:Error(`Invalid property reference. No property registered with id {Reference}.`)
        end
    elseif TypeOf == "table" then
        Ref = Reference :: PropertyRegistry<any>
    else
        Logger:Error(`Invalid property reference. Expected a registry or an id, got {TypeOf}.`)
    end

    if not Ref or not Ref.Id or not Registry[Ref.Id] then
        Logger:Error("Invalid property reference. The registry it points at is not registered.")
    end

    const Prop = {}
    Prop.__type = "Property"
    Prop.Parent = Ref.Id
    Prop.Name = Ref.Name
    Prop.Type = Ref.Type
    Prop.Constraints = Ref.Constraints
    Prop.DefaultValue = Ref.DefaultValue
    Prop.Value = Ref.DefaultValue

    Prop.Set = __setter
    Prop.SetDefault = __default_setter
    Prop.OnChange = __on_change
    Prop.Destroy = __destroy
    return Prop :: any
end

return Shared
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX36">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[const CustomEnum = require("../CustomEnum")
const Handles = require("../Handles")

export type PropertyType = "Text" | "Number" | "Bool" | "Color" | "Vector" | "CFrame" | "Enum" | "CustomEnum" | "Object"
export type PropertyIdentifier = number

export type TextConstraints = {
    MinLength: number?,
    MaxLength: number?
}

export type NumberConstraints = {
    MinValue: number?,
    MaxValue: number?,
    Precision: number?,
    Scale: number?,
    AllowDecimals: boolean?,
}

export type ColorConstraints = {
    R: NumberConstraints?,
    G: NumberConstraints?,
    B: NumberConstraints?
}

export type VectorConstraints = {
    X: NumberConstraints?,
    Y: NumberConstraints?,
    Z: NumberConstraints?
}

-- The list is optional, not its entries. Declaring {EnumItem? | string?} made
-- the list itself mandatory, so constraining an enum to nothing more than its
-- type did not typecheck -- and supplying an empty list to satisfy that rejects
-- every value, because IsValid treats a present whitelist as exhaustive.
export type EnumConstraints = {
    Enum: Enum,
    Whitelist: {EnumItem | string}?,
    Blacklist: {EnumItem | string}?,
}

export type CustomEnumConstraints = {
    CustomEnum: CustomEnum.CustomEnum<any>,
    Whitelist: {CustomEnum.RegisteredOption<any> | CustomEnum.OptionId}?,
    Blacklist: {CustomEnum.RegisteredOption<any> | CustomEnum.OptionId}?,
}

-- What an Object property may point at, by object type id or registered name.
-- Unlike every other constraint here, this one cannot be checked from the value
-- alone: the value is a local id, and what it names depends on which copy is
-- asking. Objects/Shared.Reference is where it is enforced, against the copy
-- holding the object being written. IsValid checks the number and nothing more.
export type ObjectConstraints = {
    Types: {number | string}?,
}

type PropertyValues = {
    Text: string,
    Number: number,
    Bool: boolean,
    Color: Color3,
    Vector: Vector3,
    CFrame: CFrame,
    Enum: EnumItem,
    CustomEnum: CustomEnum.RegisteredOption<any>,

    -- The target's local id, not the object. See Objects/Shared.
    Object: number,
}

type PropertyConstraints = {
    Text: TextConstraints,
    Number: NumberConstraints,
    Bool: nil,
    Color: ColorConstraints,
    Vector: VectorConstraints,
    CFrame: nil,
    Enum: EnumConstraints,
    CustomEnum: CustomEnumConstraints,
    Object: ObjectConstraints,
}

type function GetFromMap(Map, Key)
    if not Map:is("table") or not Key:is("singleton") then
        return types.never
    end

    local Property = Map:readproperty(Key)
    if Property then
        return Property
    end

    return types.never
end

export type ValueFor<T> = GetFromMap<PropertyValues, T>
export type ConstraintsFor<T> = GetFromMap<PropertyConstraints, T>

-- How a property presents itself in an editor: enough for a property panel to
-- be generated from the registry rather than written per property. Presentation
-- only. ReadOnly greys a field out; it does not stop a write, which is what a
-- property blacklist in Permissions is for.
export type DisplayConfig = {
    Category: string?,
    Order: number?,
    Description: string?,
    Hidden: boolean?,
    ReadOnly: boolean?,
}

-- The same, with every default filled in at registration.
export type Display = {
    -- "General" when left out.
    Category: string,

    -- Lower comes first; ties keep the order the object type lists them in.
    Order: number,

    Description: string?,
    Hidden: boolean,
    ReadOnly: boolean,
}

export type PropertyRegistry<T = PropertyType> = {
    Id: PropertyIdentifier,
    Name: string,
    Type: T,
    Constraints: ConstraintsFor<T>,
    DefaultValue: ValueFor<T>,
    Display: Display,
}

export type PropertyConfig<T = PropertyType> = {
    Name: string,
    Type: T,
    Constraints: ConstraintsFor<T>?,
    DefaultValue: ValueFor<T>,
    Display: DisplayConfig?,
}

-- One category of a laid out panel, its properties in display order.
export type Section = {
    Category: string,
    Properties: {PropertyRegistry<any>},
}

export type Property<T = PropertyType> = {
    Parent: PropertyIdentifier,
    Name: string,
    Type: T,
    Constraints: ConstraintsFor<T>,
    DefaultValue: ValueFor<T>,
    Value: ValueFor<T>,

    -- Allocated on the first OnChange call and dropped again when the last
    -- listener disconnects, so a property nobody watches costs one nil field.
    Listeners: {(Value: ValueFor<T>) -> ()}?,

    -- Returns (Accepted, Changed). Accepted is false when the value failed
    -- validation; Changed is false when it was accepted but equal to the
    -- current one, which lets callers skip a pointless replication broadcast.
    Set: (self: Property<T>, Value: ValueFor<T>?) -> (boolean, boolean),
    SetDefault: (self: Property<T>, Value: ValueFor<T>?) -> (boolean, boolean),
    OnChange: (self: Property<T>, Callback: (Value: ValueFor<T>) -> ()) -> () -> (),
    Destroy: (self: Property<T>) -> (),
}

const Types = {}
Types.Map = {
    Text = "string",
    Number = "number",
    Bool = "boolean",
    Color = "Color3",
    Vector = "Vector3",
    CFrame = "CFrame",
    Enum = "EnumItem",
    CustomEnum = "table",
    Object = "number",
}

Types.Ids = {
    Text = 0,
    Number = 1,
    Bool = 2,
    Color = 3,
    Vector = 4,
    CFrame = 5,
    Enum = 6,
    CustomEnum = 7,
    Object = 8,
}

const F32_MAX = 3.4028235e+38

const function FixNumber(Value: ValueFor<"Number">, Constraints: ConstraintsFor<"Number">)
    if Constraints.Precision and Constraints.Scale then
        const IntMin = math.round((Constraints.MinValue or 0) * Constraints.Scale)
        const IntPrecision = math.round(Constraints.Precision * Constraints.Scale)
        const IntValue = math.round(Value * Constraints.Scale)
        const Steps = math.round((IntValue - IntMin) / IntPrecision)
        Value = (IntMin + Steps * IntPrecision) / Constraints.Scale
    end

    if Constraints.AllowDecimals == false then
        Value = math.round(Value)
    end

    if Constraints.MinValue then
        Value = math.max(Value, Constraints.MinValue)
    end

    if Constraints.MaxValue then
        Value = math.min(Value, Constraints.MaxValue)
    end

    return Value
end

function Types:IsValid<T>(Type: T, Value: ValueFor<T>?, Constraints: ConstraintsFor<T>?): boolean
    const TypeOf = typeof(Value)
    if TypeOf ~= Types.Map[Type] then
        return false
    end

    if Type == "CustomEnum" and (Value :: any).__type ~= "CustomEnumOption" then
        return false
    end

    -- A reference is a local id, so the same bounds a local id has. Whole,
    -- because it indexes a scene's object table; zero, because a reference
    -- pointing at nothing still has to be a number the format can write.
    --
    -- Whether the id names anything, and whether what it names is an allowed
    -- type, is not decided here: both need the copy holding the object, and a
    -- property does not know which object carries it. An id naming nothing is
    -- valid in any case -- a pack restores its objects one at a time, so a
    -- button is read back before the door it points at exists.
    if Type == "Object" then
        const TypedValue = (Value :: any) :: number
        return TypedValue >= 0
            and TypedValue <= Handles.MAX_LOCAL
            and TypedValue % 1 == 0
    end

    if Constraints then
        if Type == "Text" then
            const TypedValue = (Value :: any) :: string
            return #TypedValue >= (Constraints.MinLength or 0)
        elseif Type == "Enum" then
            const TypedValue = (Value :: any) :: EnumItem
            if TypedValue.EnumType ~= Constraints.Enum then
                return false
            end

            if Constraints.Whitelist and not (table.find(Constraints.Whitelist, TypedValue) or table.find(Constraints.Whitelist, TypedValue.Name)) then
                return false
            end

            if Constraints.Blacklist and (table.find(Constraints.Blacklist, TypedValue) or table.find(Constraints.Blacklist, TypedValue.Name)) then
                return false
            end
        elseif Type == "CustomEnum" then
            const TypedValue = (Value :: any) :: CustomEnum.RegisteredOption<any>

            -- The client resolves this constraint from the enum name the server
            -- sent, and gets nil when that enum was never registered locally.
            -- Nothing can be validated against an enum this peer does not know,
            -- so reject rather than indexing nil.
            if not Constraints.CustomEnum then
                return false
            end

            if TypedValue.Parent ~= Constraints.CustomEnum.Name then
                return false
            end

            if Constraints.Whitelist and not (table.find(Constraints.Whitelist, TypedValue) or table.find(Constraints.Whitelist, TypedValue.Id)) then
                return false
            end

            if Constraints.Blacklist and (table.find(Constraints.Blacklist, TypedValue) or table.find(Constraints.Blacklist, TypedValue.Id)) then
                return false
            end
        end
    end

    return true
end

function Types:FixValue<T>(Type: T, Value: ValueFor<T>?, Constraints: ConstraintsFor<T>?): ValueFor<T>?
    if not Types:IsValid(Type, Value, Constraints) then
        return nil
    end

    if not Constraints then
        return Value
    end
    
    if Type == "Text" then
        const TypedValue = (Value :: any) :: string
        return Constraints.MaxLength and string.sub(TypedValue, 1, Constraints.MaxLength) or TypedValue
    elseif Type == "Number" then
        return FixNumber(Value, Constraints)
    elseif Type == "Color" then
        local TypedValue = (Value :: any) :: Color3
        TypedValue = Color3.fromRGB(
            Types:FixValue("Number", math.floor(TypedValue.R * 255), {
                MinValue = Constraints.R and Constraints.R.MinValue and math.clamp(Constraints.R.MinValue, 0, 255) or 0,
                MaxValue = Constraints.R and Constraints.R.MaxValue and math.clamp(Constraints.R.MaxValue, 0, 255) or 255,
                AllowDecimals = if Constraints.R then Constraints.R.AllowDecimals else true,
                Precision = if Constraints.R then Constraints.R.Precision else nil,
            }),

            Types:FixValue("Number", math.floor(TypedValue.G * 255), {
                MinValue = Constraints.G and Constraints.G.MinValue and math.clamp(Constraints.G.MinValue, 0, 255) or 0,
                MaxValue = Constraints.G and Constraints.G.MaxValue and math.clamp(Constraints.G.MaxValue, 0, 255) or 255,
                AllowDecimals = if Constraints.G then Constraints.G.AllowDecimals else true,
                Precision = if Constraints.G then Constraints.G.Precision else nil,
            }),
            
            Types:FixValue("Number", math.floor(TypedValue.B * 255), {
                MinValue = Constraints.B and Constraints.B.MinValue and math.clamp(Constraints.B.MinValue, 0, 255) or 0,
                MaxValue = Constraints.B and Constraints.B.MaxValue and math.clamp(Constraints.B.MaxValue, 0, 255) or 255,
                AllowDecimals = if Constraints.B then Constraints.B.AllowDecimals else true,
                Precision = if Constraints.B then Constraints.B.Precision else nil,
            })
        )

        return TypedValue
    elseif Type == "Vector" then
        local TypedValue = (Value :: any) :: Vector3
        TypedValue = Vector3.new(
            Types:FixValue("Number", TypedValue.X, {
                MinValue = Constraints.X and Constraints.X.MinValue and math.clamp(Constraints.X.MinValue, -F32_MAX, F32_MAX) or -F32_MAX,
                MaxValue = Constraints.X and Constraints.X.MaxValue and math.clamp(Constraints.X.MaxValue, -F32_MAX, F32_MAX) or F32_MAX,
                AllowDecimals = if Constraints.X then Constraints.X.AllowDecimals else true,
                Precision = if Constraints.X then Constraints.X.Precision else nil,
            }),

            Types:FixValue("Number", TypedValue.Y, {
                MinValue = Constraints.Y and Constraints.Y.MinValue and math.clamp(Constraints.Y.MinValue, -F32_MAX, F32_MAX) or -F32_MAX,
                MaxValue = Constraints.Y and Constraints.Y.MaxValue and math.clamp(Constraints.Y.MaxValue, -F32_MAX, F32_MAX) or F32_MAX,
                AllowDecimals = if Constraints.Y then Constraints.Y.AllowDecimals else true,
                Precision = if Constraints.Y then Constraints.Y.Precision else nil,
            }),
            
            Types:FixValue("Number", TypedValue.Z, {
                MinValue = Constraints.Z and Constraints.Z.MinValue and math.clamp(Constraints.Z.MinValue, -F32_MAX, F32_MAX) or -F32_MAX,
                MaxValue = Constraints.Z and Constraints.Z.MaxValue and math.clamp(Constraints.Z.MaxValue, -F32_MAX, F32_MAX) or F32_MAX,
                AllowDecimals = if Constraints.Z then Constraints.Z.AllowDecimals else true,
                Precision = if Constraints.Z then Constraints.Z.Precision else nil,
            })
        )

        return TypedValue
    end

    return Value
end

local ReverseIds;
function Types:GetTypeFromId(Id: number): PropertyType?
    if not ReverseIds then
        const Ids = {}
        for i, v in Types.Ids do
            Ids[v] = i
        end
        ReverseIds = Ids
    end

    return ReverseIds[Id]
end

function Types:GetTypeId(Type: PropertyType): number?
    return Types.Ids[Type]
end

-- Lossy, and more so since Object joined: a reference is a Luau number exactly
-- as a Number is, so this cannot tell them apart and never could -- the
-- difference is what the registry says the property is, not what the value
-- looks like. Ordered by type id so the ambiguity resolves the same way every
-- run, to the older and broader of the two. Iterating Types.Map directly left
-- it to hash order, which meant a plain 5 answered Number or Object depending
-- on nothing at all.
local ReverseMap;
function Types:GetTypeFromValue(Value: any): PropertyType?
    const TypeOf = typeof(Value)
    if not ReverseMap then
        const Names = {}
        for Name in Types.Map do
            table.insert(Names, Name)
        end

        table.sort(Names, function(Left: string, Right: string): boolean
            return Types.Ids[Left] < Types.Ids[Right]
        end)

        const Map = {}
        for _, Name in Names do
            const Luau = Types.Map[Name]
            if Map[Luau] == nil then
                Map[Luau] = Name
            end
        end

        ReverseMap = Map
    end

    return ReverseMap[TypeOf]
end

return Types]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX37">
				<Properties>
					<string name="Name">Replication</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Sends current state to joining players.
--
-- Registration used to broadcast with FireAll and nothing else, so anyone who
-- joined after startup received an empty registry and an empty workspace and
-- stayed that way. Requiring this module on the server closes that hole.
--
-- The replay is driven by the client announcing it is ready, not by PlayerAdded.
-- At PlayerAdded the client has not finished requiring Prism, so nothing is
-- listening yet; Roblox queues unhandled remote events but the queue is bounded,
-- and a registry of any size can overflow it and silently drop entries.
--
-- Order matters and is why this lives in one place rather than as a handler
-- inside each module: property registries have to land before object
-- registries, which have to land before any object. Types go first of all
-- because they are nobody's secret -- every player receives every one -- while
-- scenes are revealed only to the players they admit, and a scene's objects
-- need their types on arrival.

const Players = game:GetService("Players")

const PropertiesNetwork = require("./Properties/Network")
const ObjectsNetwork = require("./Objects/Network")
const Scenes = require("./Scenes/Server")
const Permissions = require("./Permissions/Server")
const Properties = require("./Properties/Server")
const Networking = require("./Networking")
const Objects = require("./Objects/Server")

const Ready = Networking:Get("Prism.Ready")

const Replication = {}
const Replayed: {[Player]: true} = {}

-- Entries per packet. The replay used to send one remote fire per registered
-- property, per registered object type, and per live object, all inside the
-- Ready handler with no yield anywhere -- so a large workspace both flooded the
-- remote queue in a single frame and held the server thread while every object
-- was compressed.
const CHUNK_SIZE = 50

const function SendChunks<T>(Plr: Player, Send: ({T}) -> (), Items: {T}): boolean
    const Total = #Items
    local Start = 1

    while Start <= Total do
        if not Plr.Parent then
            return false
        end

        const Stop = math.min(Start + CHUNK_SIZE - 1, Total)
        Send(table.move(Items, Start, Stop, 1, {}))
        Start = Stop + 1

        if Start <= Total then
            task.wait()
        end
    end

    return true
end

function Replication.Replay(Plr: Player)
    const PropertyRegistries = {}
    for Identifier in Properties:GetRegistered() do
        table.insert(PropertyRegistries, Properties:GetRegistryPayload(Identifier))
    end

    const SentProperties = SendChunks(Plr, function(Chunk)
        PropertiesNetwork.RegistriesReplayed:Fire(Plr, Chunk)
    end, PropertyRegistries)

    if not SentProperties then
        return
    end

    const ObjectRegistries = {}
    for Identifier in Objects:GetRegistered() do
        table.insert(ObjectRegistries, Objects:GetRegistryPayload(Identifier))
    end

    const SentObjects = SendChunks(Plr, function(Chunk)
        ObjectsNetwork.RegistriesReplayed:Fire(Plr, Chunk)
    end, ObjectRegistries)

    if not SentObjects then
        return
    end

    -- Every scene this player is admitted to, with its copies and objects, and
    -- nothing about any other. From here on the player hears about scenes as
    -- they change.
    Scenes.Catchup(Plr)
end

-- Answering at all is the signal the client is waiting for, so this must be set
-- by the module that actually performs the replay. Returning true only after
-- Replay finishes means the client knows its state is on the way.
--
-- Guarded per player: without it a client could invoke repeatedly and make the
-- server re-serialize the entire workspace on demand.
Ready.OnInvoke = function(Plr: Player): boolean
    if Replayed[Plr] then
        return true
    end

    Replayed[Plr] = true
    Permissions:SendTo(Plr)
    Replication.Replay(Plr)
    return true
end

Players.PlayerRemoving:Connect(function(Plr: Player)
    Replayed[Plr] = nil
end)

return Replication
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX38">
				<Properties>
					<string name="Name">Scenes</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX39">
					<Properties>
						<string name="Name">Audience</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Who hears about a scene.
--
-- Every packet about a scene used to go out with FireAll, so every player heard
-- about every scene. That is fine for a game with one level and wrong for a
-- place several people build in at once. A scene now admits players by user id,
-- and one that has admitted nobody is public -- which is what every scene that
-- existed before this already was.
--
-- A player holds a scene at one of two reaches, named for the Replicate field
-- on an object type. Everyone is what every player is owed of every scene the
-- server built: its copies, which say only that a copy of some scene exists,
-- and the objects whose types replicate to everyone. Admitted is the rest --
-- the scene's name and the objects kept for the players it admits -- and only
-- an admitted player holds it. Admitted is only ever held on top of Everyone.
--
-- Two questions, kept apart. Sees is admission: whether a player may hold a
-- scene at the Admitted reach. Holds is what a player has actually been sent,
-- and it is what every packet about the scene is addressed by. The two differ
-- while a player is joining and for the moment between an admission changing
-- and the scene being revealed or withdrawn to match. Addressing by what was
-- sent rather than what is allowed is what means a client is never sent an
-- object for a copy it has not been introduced to.

const Players = game:GetService("Players")

const Networking = require("../Networking")
const ObjectTypes = require("../Objects/Types")
const Registry = require("./Registry")

type Entry = Networking.Entry
type Reach = ObjectTypes.Reach

-- Who holds a scene at one reach, and the token each holds it under. Taken once
-- by anything that sends a scene's objects over several frames.
export type Hearing = {[Player]: number}

const Audience = {}

-- Per player, per scene, per reach, the token of the reveal that sent it.
-- Anything still streaming a scene to someone checks the token between chunks,
-- so a scene withdrawn part way -- or withdrawn and revealed again -- stops the
-- stale stream rather than sending objects the client has just dropped.
const Told: {[Player]: {[number]: {[string]: number}}} = {}
local Counter = 0

-- Players whose join replay has finished. An admission changing before then is
-- left for the end of their replay to settle: a scene revealed mid-replay could
-- reach them ahead of the object types its objects need.
const Synced: {[Player]: true} = {}

-- A Player or a user id, as a user id. Admission is keyed by user id so that it
-- can name someone who is not here yet, and so that it outlives someone who
-- has left.
function Audience.Resolve(Who: any): number?
    if typeof(Who) == "Instance" and Who:IsA("Player") then
        return (Who :: Player).UserId
    end

    if type(Who) == "number" and Who % 1 == 0 then
        return Who
    end

    return nil
end

function Audience.Sees(Plr: Player, Scene: number): boolean
    const Owner = Registry.ById[Scene]
    if not Owner then
        return false
    end

    return next(Owner.Admitted) == nil or Owner.Admitted[Plr.UserId] == true
end

-- Whether a player holds a scene at a reach, and, given a token, whether they
-- still hold it under that one.
function Audience.Holds(Plr: Player, Scene: number, Reach: Reach, Token: number?): boolean
    const Held = Told[Plr]
    const Reaches = if Held then Held[Scene] else nil
    const Current = if Reaches then Reaches[Reach] else nil

    if Current == nil then
        return false
    end

    return Token == nil or Current == Token
end

function Audience.Remember(Plr: Player, Scene: number, Reach: Reach): number
    local Held = Told[Plr]
    if not Held then
        Held = {}
        Told[Plr] = Held
    end

    local Reaches = Held[Scene]
    if not Reaches then
        Reaches = {}
        Held[Scene] = Reaches
    end

    Counter += 1
    Reaches[Reach] = Counter
    return Counter
end

-- Forgetting the Everyone reach forgets the scene outright, because Admitted
-- is only ever held on top of it.
function Audience.Forget(Plr: Player, Scene: number, Reach: Reach)
    const Held = Told[Plr]
    const Reaches = if Held then Held[Scene] else nil
    if not Held or not Reaches then
        return
    end

    if Reach == "Everyone" then
        Held[Scene] = nil
    else
        Reaches[Reach] = nil
    end
end

-- A scene that no longer exists is held by nobody.
function Audience.ForgetScene(Scene: number)
    for _, Held in Told do
        Held[Scene] = nil
    end
end

function Audience.Hearing(Scene: number, Reach: Reach): Hearing
    const Taken = {}
    for Plr, Held in Told do
        const Reaches = Held[Scene]
        const Token = if Reaches then Reaches[Reach] else nil
        if Token then
            Taken[Plr] = Token
        end
    end

    return Taken
end

-- To everyone in a hearing taken earlier who still holds the scene at the same
-- reach under the same token. Someone sent the scene since then was handed its
-- state by that sending, and someone withdrawn from it has dropped what it held.
function Audience.FireHearing(Channel: Entry, Scene: number, Reach: Reach, Taken: Hearing, ...: any)
    const Recipients = {}
    for Plr, Token in Taken do
        if Audience.Holds(Plr, Scene, Reach, Token) then
            table.insert(Recipients, Plr)
        end
    end

    if #Recipients > 0 then
        Channel:Fire(Recipients, ...)
    end
end

-- One packet about a scene, to whoever holds it at that reach.
function Audience.Fire(Channel: Entry, Scene: number, Reach: Reach, ...: any)
    Audience.FireHearing(Channel, Scene, Reach, Audience.Hearing(Scene, Reach), ...)
end

function Audience.MarkSynced(Plr: Player)
    Synced[Plr] = true
end

function Audience.GetSynced(): {Player}
    const List = {}
    for Plr in Synced do
        if Plr.Parent then
            table.insert(List, Plr)
        end
    end

    return List
end

-- What a player was sent goes with them. What they were admitted to does not:
-- that belongs to the scene.
Players.PlayerRemoving:Connect(function(Plr: Player)
    Told[Plr] = nil
    Synced[Plr] = nil
end)

return Audience
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX40">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Two things live here, and they are not the same thing.
--
-- The client's view of the server's scenes is read only, and stays that way: it
-- is told which scenes exist, which copies of them are live, and which objects
-- belong to each copy. It cannot create one, load one or edit one -- editing a
-- server scene means asking, which is what a transaction is for.
--
-- A scene the client owns is the other half. It is the same document a server
-- scene is -- copies, packs, persistent ids, Commit -- except that nothing in
-- it replicates and nothing in it needs asking for. Its objects apply their own
-- edits on the spot, because there is nobody to ask and nothing to roll back
-- to. A prefab preview, a sandbox, a room being built before anyone else sees
-- it.
--
-- The two never collide. Server scene ids count up from one and local ones
-- count down from the top of the sixteen bit scene space, and the same for copy
-- ids, so a local scene can be filed beside a server one without either
-- shadowing the other. It costs nothing to keep them apart: a scene id is never
-- written into a pack -- only local ids are -- so a local id cannot leak into
-- anything durable even when a scene is handed to the server.
--
-- Objects are filed under their copy rather than their scene, because a scene
-- can be live more than once and an editor showing five identical rooms has to
-- be able to tell them apart.

const Compressor = require("../Compressor")
const Objects = require("../Objects/Client")
const ObjectShared = require("../Objects/Shared")
const World = require("../World")
const Network = require("./Network")
const Handles = require("../Handles")
const Logger = require("../Logger")
const Listeners = require("../Listeners")
const Types = require("./Types")

export type SceneIdentifier = Types.SceneIdentifier
export type SceneRegistry = Types.SceneRegistry
export type SceneConfig = Types.SceneConfig
export type SceneInstance = Types.SceneInstance
export type LocalScene = Types.LocalScene
export type SceneInstanceId = number

const Scenes = {}

--=============================================================================
-- The server's scenes
--=============================================================================

const Registered: {[SceneIdentifier]: SceneRegistry} = {}

-- Which copies are live. The scene each belongs to is Objects' to hold, because
-- an object arriving needs it before this module could hand it over.
const Known: {[SceneInstanceId]: SceneInstanceId} = {}

-- The folder this client draws each opened copy into. A loaded copy has none:
-- its parts are the server's, in the server's folder.
const Folders: {[SceneInstanceId]: Folder} = {}

-- Plain listener lists, the way Properties and Selection keep theirs.
const CopyAdded: {(Copy: SceneInstanceId, Scene: SceneIdentifier, Folder: Folder?) -> ()} = {}
const CopyRemoved: {(Copy: SceneInstanceId, Scene: SceneIdentifier) -> ()} = {}

const Watch = Listeners.Watch
const Notify = Listeners.Notify

-- A copy of one of the server's scenes appearing here. Folder is where this
-- client draws the copy when the server opened it, and nil when the server
-- loaded it and the parts are its own. Reparent the folder to put the copy
-- somewhere else -- into PlayerGui, for a scene made of interfaces -- and
-- everything drawn in it goes along. Copies already here when this connects
-- are not replayed to it.
function Scenes:OnCopyAdded(Callback: (Copy: SceneInstanceId, Scene: SceneIdentifier, Folder: Folder?) -> ()): () -> ()
    return Watch(CopyAdded, Callback, "copies appearing")
end

function Scenes:OnCopyRemoved(Callback: (Copy: SceneInstanceId, Scene: SceneIdentifier) -> ()): () -> ()
    return Watch(CopyRemoved, Callback, "copies going")
end

-- The folder this client draws an opened copy into, or nil for a copy the
-- server loaded.
function Scenes:GetFolder(Copy: SceneInstanceId): Folder?
    return Folders[Copy]
end

function Scenes:GetRegistered(): {[SceneIdentifier]: SceneRegistry}
    return Registered
end

function Scenes:GetById(Identifier: SceneIdentifier): SceneRegistry?
    return Registered[Identifier]
end

function Scenes:Get(Name: string): SceneRegistry?
    for _, Scene in Registered do
        if Scene.Name == Name then
            return Scene
        end
    end

    return nil
end

-- Which scene a live copy came from. Answers for a local copy too, which is
-- filed the same way.
function Scenes:GetInstanceScene(Instance_: SceneInstanceId): SceneIdentifier?
    return Objects:GetInstanceScene(Instance_)
end

-- The live copies of one of the server's scenes, in no particular order. A
-- local scene answers for its own through its GetInstances, because it holds
-- them itself.
function Scenes:GetInstances(Identifier: SceneIdentifier): {SceneInstanceId}
    const List = {}
    for _, Instance_ in Known do
        if Objects:GetInstanceScene(Instance_) == Identifier then
            table.insert(List, Instance_)
        end
    end

    return List
end

-- The objects the client holds for one live copy, local or not.
function Scenes:GetObjects(Instance_: SceneInstanceId): {any}
    return Objects:GetInstance(Instance_)
end

const function Register(Payload: SceneRegistry)
    Registered[Payload.Id] = Payload
end

-- Gone on the server. Its copies were dropped by their own packets first, so
-- there is nothing here but the registry entry -- which an editor listing the
-- scenes would otherwise keep drawing.
Network.SceneUnregistered:Connect(function(Identifier: SceneIdentifier)
    Registered[Identifier] = nil

    -- Who holds what is told to the admitted, and this player no longer is:
    -- whatever they still have of the scene, they stop being told its locks.
    Objects.ForgetLocks(Identifier)
end)

Network.SceneRegistered:Connect(Register)

Network.RegistriesReplayed:Connect(function(Payloads: {SceneRegistry})
    for _, Payload in Payloads do
        Register(Payload)
    end
end)

const function AddInstance(Instance_: SceneInstanceId, Scene: SceneIdentifier, Opened: boolean)
    Known[Instance_] = Instance_

    -- An opened copy has no parts on the server, so this client draws it, into
    -- a folder of its own built where the server builds one for a copy it
    -- loads. Built before the copy is filed, because its objects are drawn
    -- into it the moment they arrive.
    local Folder = Folders[Instance_]
    if Opened and not Folder then
        Folder = World.Copy(Scene, Instance_, nil)
        Folders[Instance_] = Folder
    end

    Objects.TrackInstance(Instance_, Scene, if Opened then Folder else nil, false)
    Notify(CopyAdded, Instance_, Scene, if Opened then Folder else nil)
end

Network.InstanceAdded:Connect(AddInstance)

Network.InstancesReplayed:Connect(function(Instances: {SceneInstanceId}, Scenes_: {SceneIdentifier}, Opened: {boolean})
    for Index, Instance_ in Instances do
        AddInstance(Instance_, Scenes_[Index], Opened[Index] == true)
    end
end)

-- One packet for a whole copy going away. Its objects are already gone on the
-- server and no ObjectRemoved is coming for any of them, so the client tears
-- down what it holds itself -- and, for a copy it was drawing, the folder it
-- drew into.
Network.InstanceRemoved:Connect(function(Instance_: SceneInstanceId)
    const Scene = Objects:GetInstanceScene(Instance_)

    Known[Instance_] = nil
    Objects.DropInstance(Instance_)

    const Folder = Folders[Instance_]
    if Folder then
        Folders[Instance_] = nil
        World.DropCopy(Scene or 0, Folder)
    end

    if Scene then
        Notify(CopyRemoved, Instance_, Scene)
    end
end)

--=============================================================================
-- Scenes this client owns
--=============================================================================

const Owned: {[SceneIdentifier]: any} = {}
const OwnedByName: {[string]: any} = {}

-- Counted down from the top, where the server counts up from one. They meet
-- only if the two together exhaust the scene space, and a scene id is never
-- written into a pack in any case: only local ids are packed, and the scene
-- half is stamped on by whichever scene reads it. That is the same property
-- that makes one prefab loadable under two scenes, and it is what lets a local
-- pack be handed to the server and become a scene there with no remapping.
local NextSceneId = Handles.MAX_SCENE
local NextInstanceId = 4294967295

const function __create(self: SceneInstance, Reference: any, InitialValues: {[number]: any}?): any
    return Objects.new(Reference, InitialValues, self)
end

-- A pack read into this copy rather than into a copy of its own. The server's
-- twin -- see Scenes/Server, which explains why the references cannot simply be
-- carried across -- with nothing to announce, because a scene this client owns
-- replicates to nobody.
const function __place(self: SceneInstance, Pack: buffer): any
    const Ok, _, Decompressed = pcall(function()
        return Compressor:DecompressScene(Pack)
    end)

    if not Ok or not Decompressed then
        Logger:Warn(`Failed to read a pack being placed into a copy of {self.Owner.Name}.`)
        return nil
    end

    const Made = {}
    const Placed: {[number]: any} = {}
    const Pending: {{Object: any, References: {[number]: any}}} = {}

    for _, Saved in Decompressed :: {any} do
        if not Objects:GetRegistry(Saved.Registry) then
            Logger:Warn(`Skipped an object while placing a pack: object type {Saved.Registry} is not registered.`)
            continue
        end

        const Values, References = ObjectShared.SplitReferences(Saved.Properties)
        const Obj = Objects.new(Saved.Registry, Values, self)

        table.insert(Made, Obj)
        Placed[Saved.LocalId] = Obj

        if References then
            table.insert(Pending, {Object = Obj, References = References})
        end
    end

    for _, Entry in Pending do
        for PropertyId, Saved in Entry.References do
            const Prop = Entry.Object.Properties[PropertyId]
            const Target = Placed[Saved]

            if Prop and Target then
                Prop:Set(Target.LocalId)
            end
        end
    end

    return Made
end

const function __find(self: SceneInstance, Local_: number): any
    return self.ByLocal[Local_]
end

const function __instance_objects(self: SceneInstance): {any}
    const List = {}
    for _, Obj in self.Objects do
        if not Obj.Destroyed then
            table.insert(List, Obj)
        end
    end

    return List
end

const function __instance_serialize(self: SceneInstance): buffer
    const List: {any} = __instance_objects(self)

    -- Objects of a type this build does not have, back in beside the rest.
    for _, Kept in (self :: any).Unknown do
        table.insert(List, Kept)
    end

    -- Sorted by local id so the same copy always produces the same bytes, for
    -- the same reason the server sorts: hash order would make two identical
    -- copies serialize differently, which rules out diffing, merging or
    -- deduplicating anything.
    table.sort(List, function(A, B)
        return A.LocalId < B.LocalId
    end)

    -- Each kept record as the bytes it was read from, untouched.
    for Index, Entry in List do
        if Entry.__type == "DecompressedObject" then
            List[Index] = Entry.Source
        end
    end

    return Compressor:CompressScene(self.Owner.LastId, List :: any)
end

const function __commit(self: SceneInstance)
    self.Owner.Data = __instance_serialize(self)
end

-- A copy withdrawn from the world rather than unloaded, and kept whole. The
-- server's twin; see Scenes/Server for why a player asking for a copy to go
-- gets this rather than the real thing. Nothing is announced, because nothing
-- in a scene this client owns ever is.
const function __instance_suspend(self: any): boolean
    if self.Suspended then
        return false
    end

    const Owner = self.Owner
    if not Owner or Owner.Instances[self.Id] ~= self then
        return false
    end

    self.Suspended = Objects.SuspendInstance(self.Id)
    Owner.Instances[self.Id] = nil

    if self.Folder then
        self.Parent = self.Folder.Parent
        self.Folder.Parent = nil
    end

    Notify(CopyRemoved, self.Id, self.Scene)
    return true
end

const function __instance_revive(self: any): boolean
    const Held = self.Suspended
    if not Held then
        return false
    end

    const Owner = self.Owner
    if not Owner or not Owned[self.Scene] then
        -- Its scene has been destroyed while it was away.
        return false
    end

    self.Suspended = nil
    Owner.Instances[self.Id] = self

    if self.Folder then
        World.Place(self.Folder, self.Scene, self.Parent)
        self.Parent = nil
    end

    -- Filed before its objects, which file themselves back into it, and told
    -- before them for the reason a load tells of its copy first.
    Notify(CopyAdded, self.Id, self.Scene, nil)
    Objects.ReviveInstance(Held)
    return true
end

const function __instance_dispose(self: any)
    const Held = self.Suspended
    if not Held then
        return
    end

    self.Suspended = nil
    Objects.DisposeInstance(Held)

    if self.Folder then
        self.Folder:Destroy()
        self.Folder = nil
    end
end

const function __instance_unload(self: SceneInstance)
    const Owner = self.Owner
    if Owner then
        Owner.Instances[self.Id] = nil
    end

    -- Every object it held, torn down here rather than announced: nothing
    -- outside this client ever knew about them.
    Objects.DropInstance(self.Id)
    World.DropCopy(self.Scene, self.Folder)
    table.clear(self.Objects)
    table.clear(self.ByLocal)
end

const function NewInstance(Owner: any, Parent: Instance?): SceneInstance
    if NextInstanceId <= 0 then
        Logger:Error("Local scene copy id space exhausted.")
    end

    const Instance_ = {}
    Instance_.Id = NextInstanceId
    NextInstanceId -= 1

    Instance_.Scene = Owner.Id
    Instance_.Owner = Owner
    Instance_.Opened = false

    -- The same tree the server's copies default into, built locally. A local
    -- scene's ids count down from the top of the space while the server's count
    -- up, so a folder of this client's cannot be mistaken for one of the
    -- server's -- and a client editing interfaces hands PlayerGui to Load and
    -- never touches the workspace at all.
    Instance_.Folder = World.Copy(Owner.Id, Instance_.Id, Parent)
    Instance_.Objects = {}
    Instance_.ByLocal = {}

    -- Decoded records of objects whose type is not registered. See __load.
    Instance_.Unknown = {}

    Instance_.Create = __create
    Instance_.Place = __place
    Instance_.Find = __find
    Instance_.GetObjects = __instance_objects
    Instance_.Serialize = __instance_serialize
    Instance_.Commit = __commit
    Instance_.Unload = __instance_unload
    Instance_.Suspend = __instance_suspend
    Instance_.Revive = __instance_revive
    Instance_.Dispose = __instance_dispose

    Owner.Instances[Instance_.Id] = Instance_

    -- Filed the same way a replicated copy is, so an object of this copy can
    -- work out its own persistent identity and Objects:GetInstance answers for
    -- it like any other.
    Objects.TrackInstance(Instance_.Id, Owner.Id, nil, true)
    return Instance_ :: any
end

const function __load(self: any, Parent: Instance?): any
    const Instance_ = NewInstance(self, Parent)

    const Data = self.Data
    if not Data then
        -- A scene that has never been committed. An empty copy is the right
        -- answer: it is the one you can now put objects in.
        return Instance_
    end

    const Ok, LastId, Decompressed = pcall(function()
        return Compressor:DecompressScene(Data)
    end)

    if not Ok then
        Logger:Warn(`Failed to read the pack for local scene {self.Name}: {LastId}`)
        Instance_:Unload()
        return nil
    end

    -- Moved before anything is built, so a freshly created object cannot be
    -- handed an id one of the restored ones already answers to.
    self.LastId = math.max(self.LastId, LastId :: number)

    for _, Object in Decompressed :: {any} do
        -- Kept rather than dropped, exactly as on the server; see its Read.
        if not Objects:GetRegistry(Object.Registry) then
            Logger:Warn(`Local scene {self.Name} holds an object of type {Object.Registry}, which is not registered. Kept as saved, and written back unchanged.`)
            table.insert(Instance_.Unknown, Object)
            continue
        end

        Objects.restore(Instance_, Object)
    end

    return Instance_
end

const function __unload(self: any)
    for _, Instance_ in table.clone(self.Instances) do
        Instance_:Unload()
    end
end

const function __serialize(self: any): buffer
    -- What the scene says it is, not what any copy currently holds. A copy that
    -- has drifted answers for itself through its own Serialize.
    return self.Data or Compressor:CompressScene(self.LastId, {})
end

const function __get_instances(self: any): {any}
    const List = {}
    for _, Instance_ in self.Instances do
        table.insert(List, Instance_)
    end

    return List
end

-- Hands the committed pack to the server, which registers a scene of its own
-- from it and answers with its id.
--
-- What it sends is what the scene says it is, so commit the copy you mean
-- first: a copy that has drifted is not the document. Nothing here becomes the
-- server's -- the local scene stays local and the two are separate documents
-- from that moment, which is also why pushing twice registers two scenes rather
-- than updating one.
--
-- Yields, and can be refused: the server checks that it may create every object
-- type in the pack before it takes any of it.
const function __push(self: any, Name: string): (boolean, SceneIdentifier?)
    const Data = __serialize(self)

    const Ok, Accepted, Identifier = pcall(function()
        return Network.Commit:Invoke(Name, Data)
    end)

    if not Ok then
        Logger:Warn(`A local scene was not committed to the server: {Accepted}`)
        return false, nil
    end

    if not Accepted then
        return false, nil
    end

    return true, Identifier
end

const function __destroy(self: any)
    -- Unloaded first, so the copies go as copies rather than being orphaned by
    -- a scene that has already stopped existing.
    __unload(self)

    Owned[self.Id] = nil
    Objects.TrackLocalScene(self.Id, false)
    OwnedByName[self.Name] = nil
    self.Data = nil
end

-- Registers a scene this client owns. Nothing about it reaches the server until
-- Push, and nothing about it reaches the rest of the world at all.
function Scenes.new(Config: SceneConfig): LocalScene?
    if OwnedByName[Config.Name] then
        Logger:Warn(`This client already owns a scene named {Config.Name}.`)
        return nil
    end

    if NextSceneId <= 0 then
        Logger:Error("Local scene id space exhausted.")
    end

    const Identifier = NextSceneId
    NextSceneId -= 1

    const Scene = {}
    Scene.Id = Identifier
    Scene.Name = Config.Name
    Scene.LastId = 0
    Scene.Data = nil
    Scene.Instances = {}

    Scene.Load = __load
    Scene.Unload = __unload
    Scene.Serialize = __serialize
    Scene.GetInstances = __get_instances
    Scene.Push = __push
    Scene.Destroy = __destroy

    Owned[Identifier] = Scene
    Objects.TrackLocalScene(Identifier, true)
    OwnedByName[Config.Name] = Scene

    return Scene :: any
end

-- Registers a local scene around a pack, which is how a prefab the server sent
-- down becomes something this client can load, look at and edit without anyone
-- else seeing it.
function Scenes.fromBuffer(Config: SceneConfig, Data: buffer): LocalScene?
    const Scene = Scenes.new(Config)
    if not Scene then
        return nil
    end

    const Document: any = Scene
    Document.Data = Data
    return Scene
end

function Scenes:GetLocal(Name: string): LocalScene?
    return OwnedByName[Name]
end

function Scenes:GetLocalById(Identifier: SceneIdentifier): LocalScene?
    return Owned[Identifier]
end

function Scenes:GetOwned(): {[SceneIdentifier]: LocalScene}
    return Owned
end

-- One live copy of a scene this client owns, by its id, or nil for anything
-- else -- a copy of the server's, or one that has been unloaded. What a
-- transaction asks before applying itself here: an operation naming a copy this
-- side does not own is one it has no business doing on its own.
function Scenes:GetLocalCopy(Copy: SceneInstanceId): SceneInstance?
    for _, Scene in Owned do
        const Instance_ = (Scene :: any).Instances[Copy]
        if Instance_ then
            return Instance_
        end
    end

    return nil
end

return Scenes
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX41">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")

return {
    SceneRegistered = Networking:Get("Scenes.SceneRegistered"),
    SceneUnregistered = Networking:Get("Scenes.SceneUnregistered"),
    RegistriesReplayed = Networking:Get("Scenes.RegistriesReplayed"),

    InstanceAdded = Networking:Get("Scenes.InstanceAdded"),
    InstanceRemoved = Networking:Get("Scenes.InstanceRemoved"),
    InstancesReplayed = Networking:Get("Scenes.InstancesReplayed"),

    Commit = Networking:Get("Scenes.Commit"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX42">
					<Properties>
						<string name="Name">Registry</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Where the live scenes are kept, and nothing else.
--
-- Objects has to find a scene to place a new object in, and to resolve a handle
-- back to the scene holding it. Scenes has to build objects. Each requiring the
-- other is a cycle, so the table they share sits on its own and requires
-- nothing -- which is also why the scene type is loose here: naming it would
-- pull Scenes/Types back in and rebuild the cycle one level up.

return {
    ById = {} :: {[number]: any},
    ByName = {} :: {[string]: any},

    -- Every live copy across every scene, keyed by its own id. Kept flat rather
    -- than reached through the scene holding it because a caller naming a copy
    -- -- a transaction says which copy each object it creates belongs in --
    -- resolves one per operation, and walking every scene's copies to answer
    -- would make that cost the size of the world.
    Instances = {} :: {[number]: any},

    -- Set by Scenes/Server as it registers the implicit scene. Objects.new with
    -- no scene of its own lands here, which is what keeps plain object creation
    -- working exactly as it did before scenes existed.
    Default = (nil :: any) :: any,
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX43">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Named sets of objects, and the unit a level is saved and loaded as.
--
-- Before this there was one global workspace: every object the server had ever
-- made, alive for the session, with no way to put a level away without
-- destroying it object by object and no way to hand one to a DataStore.
--
-- A scene is a document. Registering one creates data and nothing else; Load
-- reads it into a live copy. Load twice and you get two copies, equals in every
-- way, which is what lets one saved room stand in the world five times. There
-- is no canonical copy and no loaded flag, because a scene is not a thing that
-- is either in the world or not -- it is a thing the world can hold copies of.
--
-- Objects therefore live on the copy, not on the scene. Asking a scene loaded
-- twice for "the object with local id 4" has no answer; asking a copy does.

const Permissions = require("../Permissions/Server")
const Compressor = require("../Compressor")
const Objects = require("../Objects/Server")
const ObjectShared = require("../Objects/Shared")
const Registry = require("./Registry")
const Audience = require("./Audience")
const World = require("../World")
const Network = require("./Network")
const Handles = require("../Handles")
const IdPool = require("../IdPool")
const Logger = require("../Logger")
const ObjectTypes = require("../Objects/Types")
const Types = require("./Types")

export type SceneIdentifier = Types.SceneIdentifier
export type SceneConfig = Types.SceneConfig
export type SceneRegistry = Types.SceneRegistry
export type SceneInstance = Types.SceneInstance
export type Scene = Types.ServerScene

const Scenes = {}

-- Never recycled, and the reason is the persistent identity itself: an object's
-- saved id carries its scene, so handing id 3 to a different scene later makes
-- every pack that names scene 3 decode as the wrong thing.
const Ids = IdPool.new(Handles.MAX_SCENE, false)

-- Instance ids are the opposite: they name a live copy, never leave the
-- session, and there is no saved data for a reused one to confuse.
local InstanceCounter = 0

const function ToPayload(Scene: Scene): SceneRegistry
    return {
        Id = Scene.Id,
        Name = Scene.Name,
    }
end

--=============================================================================
-- Who hears about a scene
--=============================================================================

-- Scene registries per packet when several are revealed at once, as at a join.
const REGISTRY_CHUNK = 50

-- Sends one player whatever they are owed of some scenes and do not yet hold.
-- Every player is owed a scene's copies and the objects that replicate to
-- everyone; an admitted player is owed its name and the rest of its objects as
-- well. The names and copies go out before anything yields, so from the moment
-- the player holds a scene at a reach there is nothing a broadcast at that
-- reach could name that they have not already been handed. The objects stream
-- after, and stop for any scene withdrawn from the player part way through.
const function Reveal(Plr: Player, List: {Scene})
    const Tokens: {[SceneIdentifier]: {[string]: number}} = {}
    const Payloads: {SceneRegistry} = {}
    const CopyIds: {number} = {}
    const CopyScenes: {SceneIdentifier} = {}
    const CopyOpened: {boolean} = {}
    const Held: {any} = {}

    -- Every object in a scene revealed whole, for its locks: who holds what is
    -- told to the admitted, whatever each object's own reach.
    const Watched: {any} = {}

    for _, Scene in List do
        if Registry.ById[Scene.Id] ~= Scene then
            continue
        end

        const Glimpse = not Audience.Holds(Plr, Scene.Id, "Everyone")
        const Whole = Audience.Sees(Plr, Scene.Id) and not Audience.Holds(Plr, Scene.Id, "Admitted")

        if not Glimpse and not Whole then
            continue
        end

        -- Everyone before Admitted, which is only ever held on top of it.
        const Taken: {[string]: number} = {}
        Tokens[Scene.Id] = Taken

        if Glimpse then
            Taken.Everyone = Audience.Remember(Plr, Scene.Id, "Everyone")
        end

        if Whole then
            Taken.Admitted = Audience.Remember(Plr, Scene.Id, "Admitted")
            table.insert(Payloads, ToPayload(Scene))
        end

        for _, Copy in Scene.Instances do
            -- A loaded copy is every player's to know of. An opened one is kept
            -- for the admitted: a player who is not admitted has no part of it
            -- to attach anything to, so telling them would buy nothing.
            if (Glimpse and not Copy.Opened) or (Whole and Copy.Opened) then
                table.insert(CopyIds, Copy.Id)
                table.insert(CopyScenes, Scene.Id)
                table.insert(CopyOpened, Copy.Opened)
            end

            for _, Obj in Copy.Objects do
                if Taken[Objects.ReachOf(Obj)] then
                    table.insert(Held, Obj)
                end

                if Whole then
                    table.insert(Watched, Obj)
                end
            end
        end
    end

    if #Payloads == 1 then
        Network.SceneRegistered:Fire(Plr, Payloads[1])
    else
        for Start = 1, #Payloads, REGISTRY_CHUNK do
            const Stop = math.min(Start + REGISTRY_CHUNK - 1, #Payloads)
            Network.RegistriesReplayed:Fire(Plr, table.move(Payloads, Start, Stop, 1, {}))
        end
    end

    if #CopyIds > 0 then
        Network.InstancesReplayed:Fire(Plr, CopyIds, CopyScenes, CopyOpened)
    end

    -- Before anything yields, like the copies: a lock taken from here on is
    -- announced to this player, so the one they were owed has to be out first.
    Objects.SendLocks(Plr, Watched)

    Objects.Stream(Plr, Held, function(Obj: any): boolean
        const Reach = Objects.ReachOf(Obj)
        return Audience.Holds(Plr, Obj.Scene, Reach, Tokens[Obj.Scene][Reach])
    end)
end

-- Admission taken away. The scene's name goes, and so does every object kept
-- for the admitted; its copies and the objects that replicate to everyone stay,
-- because every player is owed those. The removals stream, and stop if the
-- player is admitted again before they are through: the reveal that follows is
-- sending those objects back, and a late removal would take one of them away.
const function Withdraw(Plr: Player, Scene: Scene)
    if not Audience.Holds(Plr, Scene.Id, "Admitted") then
        return
    end

    Audience.Forget(Plr, Scene.Id, "Admitted")
    Network.SceneUnregistered:Fire(Plr, Scene.Id)

    const Kept = {}
    for _, Copy in Scene.Instances do
        -- An opened copy goes whole: everything in it was kept for the
        -- admitted, and the client drops what it drew along with the copy.
        if Copy.Opened then
            Network.InstanceRemoved:Fire(Plr, Copy.Id)
            continue
        end

        for _, Obj in Copy.Objects do
            if not Obj.Destroyed and Objects.ReachOf(Obj) == "Admitted" then
                table.insert(Kept, Obj.RuntimeId)
            end
        end
    end

    Objects.Unsend(Plr, Kept, function(): boolean
        return not Audience.Holds(Plr, Scene.Id, "Admitted")
    end)
end

-- Brings what one player holds of one scene into line with whether they are
-- admitted to it. Both directions yield as they stream, so each gets a thread
-- of its own -- which task.spawn only hands back after the part that must land
-- first is out, because nothing before it yields.
const function Settle(Plr: Player, Scene: Scene)
    const Sees = Audience.Sees(Plr, Scene.Id)
    const Admitted = Audience.Holds(Plr, Scene.Id, "Admitted")

    if not Audience.Holds(Plr, Scene.Id, "Everyone") or (Sees and not Admitted) then
        task.spawn(Reveal, Plr, {Scene})
    elseif Admitted and not Sees then
        task.spawn(Withdraw, Plr, Scene)
    end
end

-- Every player past their join, after a scene appears or its admission list
-- changes. A player still joining is left alone: their replay settles every
-- scene once it is through, and a scene revealed to them now could reach them
-- ahead of the object types its objects need.
const function Reconcile(Scene: Scene)
    for _, Plr in Audience.GetSynced() do
        Settle(Plr, Scene)
    end
end

--=============================================================================
-- Live copies
--=============================================================================

const function __create(self: SceneInstance, Reference: any, InitialValues: {[number]: any}?): any
    return Objects.new(Reference, InitialValues, self)
end

const function __find(self: SceneInstance, Local: number): any
    return self.ByLocal[Local]
end

const function __instance_objects(self: SceneInstance): {any}
    const List = {}
    for _, Obj in self.Objects do
        if not Obj.Destroyed then
            table.insert(List, Obj)
        end
    end

    return List
end

-- A pack read into this copy rather than into a copy of its own: pasting a
-- saved group of objects into a level somebody is editing.
--
-- The opposite of loading in the one way that matters. A load restores every
-- object under the id it was saved with, which is what keeps a pack meaning the
-- same thing every time it is read. A placement cannot: the copy it is going
-- into already has objects, and their ids are already spoken for. So every
-- object is created afresh, the scene mints the ids, and the pack's own LastId
-- is ignored -- it belongs to the scene the pack came from and says nothing
-- about this one.
--
-- Which leaves the references. They are held back while the objects are built
-- and written afterwards against what was actually made: a reference to another
-- object in the pack follows it to its new id, and a reference to anything else
-- is dropped rather than carried over. Carrying it would be worse than losing
-- it -- the id would name whatever in this copy happens to answer to it, and a
-- pasted button would come up wired to a door it has never met.
const function __place(self: SceneInstance, Pack: buffer): {ObjectTypes.Object}?
    const Ok, _, Decompressed = pcall(function()
        return Compressor:DecompressScene(Pack)
    end)

    if not Ok or not Decompressed then
        Logger:Warn(`Failed to read a pack being placed into a copy of {self.Owner.Name}.`)
        return nil
    end

    const Made: {ObjectTypes.Object} = {}

    -- What the placement made, by the id the pack knew each object as.
    const Placed: {[number]: ObjectTypes.Object} = {}
    const Pending: {{Object: ObjectTypes.Object, References: {[number]: any}}} = {}

    for _, Saved in Decompressed :: {any} do
        if not Objects:GetRegistry(Saved.Registry) then
            -- Skipped rather than refused, like restoring a saved object of a
            -- type this build no longer has: the rest of the pack is still a
            -- thing worth placing.
            Logger:Warn(`Skipped an object while placing a pack: object type {Saved.Registry} is not registered.`)
            continue
        end

        const Values, References = ObjectShared.SplitReferences(Saved.Properties)
        const Obj = Objects.new(Saved.Registry, Values, self, false)

        table.insert(Made, Obj)
        Placed[Saved.LocalId] = Obj

        if References then
            table.insert(Pending, {Object = Obj, References = References})
        end
    end

    for _, Entry in Pending do
        for PropertyId, Saved in Entry.References do
            const Prop = Entry.Object.Properties[PropertyId]
            const Target = Placed[Saved]

            -- Left at nothing when the pack did not carry what it pointed at,
            -- which is what a property never written reads as.
            if Prop and Target then
                Prop:Set(Target.LocalId)
            end
        end
    end

    -- One announcement for the lot, down the chunked path a load uses. Building
    -- them silently is also what keeps a reference from going out twice: once
    -- holding an id from another scene, once corrected.
    if #Made > 0 then
        Objects.AnnounceAll(Made)
    end

    return Made
end

const function __instance_serialize(self: SceneInstance): buffer
    const List: {any} = __instance_objects(self)

    -- Objects of a type this build does not have go back in beside the rest,
    -- in their place by local id.
    for _, Kept in (self :: any).Unknown do
        table.insert(List, Kept)
    end

    -- Sorted by local id so the same copy always produces the same bytes. Hash
    -- order would make two identical copies serialize differently, which rules
    -- out diffing, merging or deduplicating saves -- the same reason a single
    -- object's properties are written in id order.
    table.sort(List, function(A, B)
        return A.LocalId < B.LocalId
    end)

    -- Each kept record as the bytes it was read from, untouched.
    for Index, Entry in List do
        if Entry.__type == "DecompressedObject" then
            List[Index] = Entry.Source
        end
    end

    return Compressor:CompressScene(self.Owner.LastId, List :: any)
end

const function __commit(self: SceneInstance)
    self.Owner.Data = __instance_serialize(self)
end

-- A copy withdrawn from the world rather than unloaded, and kept whole: the
-- same thing suspending does to an object, one level up.
--
-- Unloading is final. It exists because a game decides a room is done with, and
-- nothing about that needs taking back. But a player asking for a copy to go is
-- a player who may want it back a second later, and a copy cannot be rebuilt
-- from its scene the way it was: loading reads what the scene last committed,
-- which is not what was on screen unless somebody had just saved. So the copy
-- is set aside instead -- out of the registries, its folder out of the world,
-- every object in it suspended -- and put back exactly as it was.
--
-- What it costs while it is away is what the objects cost, which is what they
-- cost anyway: they are the same tables, out of sight.
const function __instance_suspend(self: SceneInstance): boolean
    if self.Suspended then
        return false
    end

    const Owner = self.Owner
    if not Owner or Owner.Instances[self.Id] ~= self then
        return false
    end

    -- The objects first, while the copy is still filed: each unfiles itself
    -- from the tables below on the way out.
    self.Suspended = Objects.SuspendInstance(self)

    Owner.Instances[self.Id] = nil
    Registry.Instances[self.Id] = nil

    -- Out of the world, not destroyed -- the same distinction an object's part
    -- gets, and for the same reason: what comes back has to be what left,
    -- including anything the game hung on the folder.
    if self.Folder then
        -- Remembered rather than recomputed: a game that loaded this copy into
        -- PlayerGui or into a Model of its own gets it back there.
        self.Parent = self.Folder.Parent
        self.Folder.Parent = nil
    end

    Audience.Fire(Network.InstanceRemoved, self.Scene, if self.Opened then "Admitted" else "Everyone", self.Id)
    return true
end

const function __instance_revive(self: SceneInstance): boolean
    const Held = self.Suspended
    if not Held then
        return false
    end

    const Owner = self.Owner
    if not Owner or not Registry.ById[self.Scene] then
        -- Its scene has been unregistered while it was away. There is nothing
        -- to put it back into.
        return false
    end

    self.Suspended = nil

    -- Filed before its objects, which file themselves into it as they come
    -- back, and announced before them for the reason a load announces its copy
    -- first: a client must never be handed an object of a copy it has not been
    -- told about.
    Owner.Instances[self.Id] = self :: any
    Registry.Instances[self.Id] = self

    if self.Folder then
        World.Place(self.Folder, self.Scene, self.Parent)
    end

    Audience.Fire(
        Network.InstanceAdded,
        self.Scene,
        if self.Opened then "Admitted" else "Everyone",
        self.Id,
        self.Scene,
        self.Opened
    )

    Objects.AnnounceAll(Objects.ReviveInstance(Held))
    return true
end

-- The end of a suspended copy: its objects for good, and the folder they were
-- in. Everything else about it was already done when it was withdrawn.
const function __instance_dispose(self: SceneInstance)
    const Held = self.Suspended
    if not Held then
        return
    end

    self.Suspended = nil
    Objects.DisposeInstance(Held)

    if self.Folder then
        self.Folder:Destroy()
        self.Folder = nil
    end
end

const function __instance_unload(self: SceneInstance)
    const Owner = self.Owner
    if Owner then
        Owner.Instances[self.Id] = nil
    end

    Registry.Instances[self.Id] = nil

    Objects.DropInstance(self)

    -- The folder goes after its objects, so nothing is left holding a
    -- reference to an instance that is already gone.
    World.DropCopy(self.Scene, self.Folder)
    Audience.Fire(Network.InstanceRemoved, self.Scene, if self.Opened then "Admitted" else "Everyone", self.Id)
end

const function NewInstance(Owner: Scene, Parent: Instance?, Opened: boolean): SceneInstance
    InstanceCounter += 1

    const Instance_ = {}
    Instance_.Id = InstanceCounter
    Instance_.Scene = Owner.Id
    Instance_.Owner = Owner
    Instance_.Opened = Opened

    -- None for an opened copy. It would hold nothing, and an empty folder named
    -- for the scene, in a workspace every player can see, is exactly the
    -- announcement opening exists to avoid.
    Instance_.Folder = if Opened then nil else World.Copy(Owner.Id, Instance_.Id, Parent)
    Instance_.Objects = {}
    Instance_.ByLocal = {}

    -- Decoded records of objects whose type is not registered. See Read.
    Instance_.Unknown = {}

    Instance_.Create = __create
    Instance_.Place = __place
    Instance_.Find = __find
    Instance_.GetObjects = __instance_objects
    Instance_.Serialize = __instance_serialize
    Instance_.Commit = __commit
    Instance_.Unload = __instance_unload
    Instance_.Suspend = __instance_suspend
    Instance_.Revive = __instance_revive
    Instance_.Dispose = __instance_dispose

    Owner.Instances[Instance_.Id] = Instance_ :: any
    Registry.Instances[Instance_.Id] = Instance_

    -- Announced before its objects, so a client is never handed an object
    -- belonging to a copy it has not been told about.
    -- A loaded copy to every player, not only the admitted: an object that
    -- replicates to everyone has to be filed under its copy, and this is the
    -- copy. It says a copy of some scene exists, and nothing more. An opened
    -- copy only to the admitted, who are the only ones it sends anything to.
    Audience.Fire(Network.InstanceAdded, Owner.Id, if Opened then "Admitted" else "Everyone", Instance_.Id, Owner.Id, Opened)
    return Instance_ :: any
end

--=============================================================================
-- Scenes
--=============================================================================

-- Load and Open are one reading of the pack, and differ only in whether the
-- server builds the parts.
const function Read(self: Scene, Parent: Instance?, Opened: boolean): any
    const Instance_ = NewInstance(self, Parent, Opened)

    const Data = self.Data
    if not Data then
        -- A scene that has never been committed. An empty copy is the right
        -- answer: it is the one you can now put objects in.
        return Instance_
    end

    const Ok, LastId, Decompressed = pcall(function()
        return Compressor:DecompressScene(Data)
    end)

    if not Ok then
        Logger:Warn(`Failed to read the pack for scene {self.Name}: {LastId}`)
        Instance_:Unload()
        return nil
    end

    -- Moved before anything is built, so a freshly created object cannot be
    -- handed an id one of the restored ones already answers to.
    self.LastId = math.max(self.LastId, LastId :: number)

    const Restored = {}
    for _, Object in Decompressed :: {any} do
        -- A type this build does not have: kept as the bytes it was read from,
        -- and written back where it was by the next commit. Restoring used to
        -- warn and leave it out, and committing the copy afterwards then wrote
        -- it out of the pack for good.
        if not Objects:GetRegistry(Object.Registry) then
            Logger:Warn(`Scene {self.Name} holds an object of type {Object.Registry}, which is not registered. Kept as saved, and written back unchanged.`)
            table.insert(Instance_.Unknown, Object)
            continue
        end

        const Obj = Objects.restore(Instance_, Object, false)
        if Obj then
            table.insert(Restored, Obj)
        end
    end

    Objects.AnnounceAll(Restored)
    return Instance_
end

const function __load(self: Scene, Parent: Instance?): any
    return Read(self, Parent, false)
end

const function __open(self: Scene): any
    return Read(self, nil, true)
end

-- Every copy at once. Nothing is written back: with more than one copy live,
-- saving on unload would have to pick one and cannot, so committing is the
-- copy's own call and always explicit.
const function __unload(self: Scene)
    for _, Instance_ in table.clone(self.Instances) do
        Instance_:Unload()
    end
end

const function __serialize(self: Scene): buffer
    -- What the scene says it is, not what any copy currently holds. A copy that
    -- has drifted answers for itself through its own Serialize.
    return self.Data or Compressor:CompressScene(self.LastId, {})
end

const function __get_instances(self: Scene): {any}
    const List = {}
    for _, Instance_ in self.Instances do
        table.insert(List, Instance_)
    end

    return List
end

const function __destroy(self: Scene)
    -- Unloaded first, so the copies go as copies rather than being orphaned by
    -- a scene that has already stopped existing.
    __unload(self)

    -- Its rights go with it, told to whoever held them while the scene can
    -- still be found.
    Permissions.DropScene(self)

    Registry.ById[self.Id] = nil
    Registry.ByName[self.Name] = nil
    self.Data = nil

    -- To whoever was told its name, after which nobody holds it at all. Its
    -- copies went to everyone already, one packet each, as they unloaded.
    Audience.Fire(Network.SceneUnregistered, self.Id, "Admitted", self.Id)
    Audience.ForgetScene(self.Id)

    -- The id is not released: see the pool above.
end

-- Admitting and evicting change who is told about a private scene. On a public
-- one they change nothing that anybody can see: everyone is already owed all of
-- it, and the list sits there until the scene is closed.
const function __admit(self: Scene, Who: Player | number)
    const UserId = Audience.Resolve(Who)
    if not UserId then
        Logger:Warn(`Scene {self.Name} admits a Player or a user id, not a {typeof(Who)}.`)
        return
    end

    if self.Admitted[UserId] then
        return
    end

    self.Admitted[UserId] = true
    Reconcile(self)
end

const function __evict(self: Scene, Who: Player | number)
    const UserId = Audience.Resolve(Who)
    if not UserId then
        Logger:Warn(`Scene {self.Name} evicts a Player or a user id, not a {typeof(Who)}.`)
        return
    end

    if not self.Admitted[UserId] then
        return
    end

    self.Admitted[UserId] = nil

    -- What they were holding in this scene goes with their admission. Shut out
    -- of a room, still holding three things in it, is a way to stop everybody
    -- else working without being able to work yourself.
    Objects.ReleaseFor(UserId, self.Id)
    Reconcile(self)
end

const function __admits(self: Scene, Who: Player | number): boolean
    if not self.Private then
        return true
    end

    const UserId = Audience.Resolve(Who)
    return UserId ~= nil and self.Admitted[UserId] == true
end

const function __get_admitted(self: Scene): {number}
    const List = {}
    for UserId in self.Admitted do
        table.insert(List, UserId)
    end

    return List
end

const function __is_public(self: Scene): boolean
    return not self.Private
end

-- Closing a scene takes it away from everyone it does not admit; opening it
-- hands it to everybody. Either way the reconcile below is what actually moves
-- it, the same as admitting or evicting somebody.
const function __set_private(self: Scene, Private: boolean)
    const Wanted = Private == true
    if self.Private == Wanted then
        return
    end

    self.Private = Wanted
    Reconcile(self)
end

-- Rights live in Permissions, which keeps them on the scene; these are the
-- scene's own handles on them.
const function __grant(self: Scene, Who: Player | number, Role: string): boolean
    return Permissions:GrantOn(self, Who, Role)
end

const function __revoke(self: Scene, Who: Player | number)
    Permissions:RevokeOn(self, Who)
end

const function __grant_capability(self: Scene, Who: Player | number, Capability: string)
    Permissions:GrantCapabilityOn(self, Who, Capability)
end

const function __revoke_capability(self: Scene, Who: Player | number, Capability: string)
    Permissions:RevokeCapabilityOn(self, Who, Capability)
end

const function __get_rights(self: Scene, Who: Player | number): any
    return Permissions:GetOn(self, Who)
end

-- Names have to be unique as well as ids. A name is how a caller asks for a
-- scene back, and two scenes answering to "Lobby" means one of them is
-- unreachable and which one depends on registration order.
function Scenes.new(Config: SceneConfig): Scene?
    if Registry.ByName[Config.Name] then
        Logger:Warn(`There's already a scene named {Config.Name}.`)
        return nil
    end

    const Identifier = Ids:Claim()
    if not Identifier then
        Logger:Warn("The scene id pool is exhausted.")
        return nil
    end

    const Scene = {}
    Scene.Id = Identifier
    Scene.Name = Config.Name
    Scene.LastId = 0
    Scene.Data = nil
    Scene.Instances = {}

    -- Set before the scene is announced, so a scene that should never be public
    -- never is, not even for the packet that registers it.
    Scene.Private = Config.Private == true

    Scene.Admitted = {}
    for _, Who in Config.Admitted or {} do
        const UserId = Audience.Resolve(Who)
        if UserId then
            Scene.Admitted[UserId] = true
        else
            Logger:Warn(`Scene {Config.Name} admits a Player or a user id, not a {typeof(Who)}.`)
        end
    end

    -- Said rather than silently ignored: a list on a public scene is inert, and
    -- somebody writing one has almost certainly meant to close the scene.
    if not Scene.Private and next(Scene.Admitted) ~= nil then
        Logger:Warn(`Scene {Config.Name} admits people but is not private, so the list does nothing. Pass Private = true to close it.`)
    end

    Scene.Rights = {}

    Scene.Load = __load
    Scene.Open = __open
    Scene.Unload = __unload
    Scene.Serialize = __serialize
    Scene.GetInstances = __get_instances
    Scene.Destroy = __destroy
    Scene.Admit = __admit
    Scene.Evict = __evict
    Scene.Admits = __admits
    Scene.SetPrivate = __set_private
    Scene.GetAdmitted = __get_admitted
    Scene.IsPublic = __is_public
    Scene.Grant = __grant
    Scene.Revoke = __revoke
    Scene.GrantCapability = __grant_capability
    Scene.RevokeCapability = __revoke_capability
    Scene.GetRights = __get_rights

    Registry.ById[Identifier] = Scene
    Registry.ByName[Config.Name] = Scene

    -- Told to whoever it admits, which for a scene with no list is everyone.
    Reconcile(Scene :: any)

    for Who, Role in Config.Rights or {} do
        Permissions:GrantOn(Scene, Who, Role)
    end

    return Scene :: any
end

-- Registers a scene around a pack someone stored earlier. Nothing goes live
-- until Load, which is what makes a menu of saved levels cheap: register them
-- all, load the one that gets picked.
function Scenes.fromBuffer(Config: SceneConfig, Data: buffer): Scene?
    const Scene = Scenes.new(Config)
    if not Scene then
        return nil
    end

    Scene.Data = Data
    return Scene
end

function Scenes:Get(Name: string): Scene?
    return Registry.ByName[Name]
end

function Scenes:GetById(Identifier: SceneIdentifier): Scene?
    return Registry.ById[Identifier]
end

function Scenes:GetRegistered(): {[SceneIdentifier]: Scene}
    return Registry.ById
end

function Scenes:GetRegistryPayload(Identifier: SceneIdentifier): SceneRegistry?
    const Scene = Registry.ById[Identifier]
    return if Scene then ToPayload(Scene) else nil
end

-- Every live copy across every scene, which is what a joining player has to be
-- told about before any object reaches them.
function Scenes:GetInstances(): {SceneInstance}
    const List = {}
    for _, Instance_ in Registry.Instances do
        table.insert(List, Instance_)
    end

    return List
end

-- One live copy by its own id. The id names a copy rather than a scene, so this
-- answers for a caller holding one off an object or off the wire without having
-- to know which scene it belongs to first.
function Scenes:GetInstance(Identifier: ObjectTypes.SceneInstanceId): SceneInstance?
    return Registry.Instances[Identifier]
end

-- The scene half of a join, called by Replication once the player has every
-- property and object type. Every scene is revealed at once, each as far as
-- the player is owed, so the names and copies share packets. Then the player
-- counts as synced, and whatever changed while this streamed -- a scene
-- registered, an admission granted or taken -- is settled against what they
-- were actually sent.
function Scenes.Catchup(Plr: Player)
    const All = {}
    for _, Scene in Registry.ById do
        table.insert(All, Scene)
    end

    Reveal(Plr, All)

    if not Plr.Parent then
        return
    end

    Audience.MarkSynced(Plr)

    for _, Scene in Registry.ById do
        Settle(Plr, Scene)
    end
end

--=============================================================================
-- Commits from a client
--=============================================================================

-- What one commit may carry. The byte cap is what actually bounds the work --
-- decoding walks the buffer and does nothing else until it is through -- and
-- the object cap is what stops a well formed pack of a hundred thousand
-- objects becoming a scene nobody asked for. The name cap is only there so a
-- registry key cannot be a novel.
const MAX_COMMIT_BYTES = 524288
const MAX_COMMIT_OBJECTS = 4096
const MAX_NAME_LENGTH = 64

-- The role a player is granted on a scene they push, or nil for none. A pushed
-- scene admits only its author either way: it was built where nobody else could
-- see it, and registering it should not change that.
local PushRole: string? = nil

function Scenes:SetPushRole(Role: string?)
    if Role and not Permissions:GetRegistered()[Role] then
        Logger:Warn(`Cannot grant unregistered role {Role} on pushed scenes.`)
        return
    end

    PushRole = Role
end

-- A client handing over a scene it built locally. Refusals are silent and say
-- nothing but false, like every other client facing handler here: a refusal
-- that logs is a refusal a client can spam to fill the server's output.
Network.Commit.OnInvoke = function(Plr: Player, Name: string, Data: buffer): (boolean, SceneIdentifier)
    -- One action for the packet rather than one per object in it. A transaction
    -- charges per operation because every operation reaches into the world as
    -- it stands; this arrives whole, and what bounds it is its size, which is
    -- known before a byte of it is read.
    if not Permissions:Consume(Plr) then
        return false, 0
    end

    -- A global right rather than a check against the pack's types. The scene
    -- does not exist yet, so there are no rights over it to consult, and
    -- registering a scene at all is exactly the kind of thing that is about the
    -- session rather than a document.
    if not Permissions:CanPush(Plr) then
        return false, 0
    end

    if buffer.len(Data) > MAX_COMMIT_BYTES then
        return false, 0
    end

    if #Name == 0 or #Name > MAX_NAME_LENGTH then
        return false, 0
    end

    -- Names are how a scene is asked for, so the first one to take a name keeps
    -- it. Refused here as well as in Scenes.new so the pack is not decoded for
    -- a commit that cannot land anyway.
    if Registry.ByName[Name] then
        return false, 0
    end

    const Ok, _, Decompressed = pcall(function()
        return Compressor:DecompressScene(Data)
    end)

    if not Ok or not Decompressed then
        return false, 0
    end

    const Packed = Decompressed :: {any}
    if #Packed > MAX_COMMIT_OBJECTS then
        return false, 0
    end

    -- Every object type in the pack has to be one the server knows, and the
    -- whole commit is refused if any is not. A scene arriving with half its
    -- objects dropped is not the scene that was sent, and the client would
    -- have no way to tell.
    local Highest = 0

    for _, Object in Packed do
        if not Objects:GetRegistry(Object.Registry) then
            return false, 0
        end

        -- A client's pack keeps no bytes the server cannot read. A save of the
        -- server's own keeps what an older build wrote; a packet from a client
        -- is untrusted, and this is the server writing its own pack.
        Object.Unknown = nil

        Highest = math.max(Highest, Object.LocalId)
    end

    -- Re-encoded rather than kept as it arrived, so the pack the server holds
    -- is the one the server wrote. Its LastId is the highest id actually in it
    -- rather than whatever the client claimed -- a pack declaring an id space
    -- already spent would otherwise give the scene room for nothing.
    -- Private to its author from the packet that registers it, and theirs to
    -- edit if the game has said what a pusher holds.
    const Scene = Scenes.fromBuffer({
        Name = Name,
        Private = true,
        Admitted = {Plr.UserId},
        Rights = if PushRole then {[Plr.UserId] = PushRole} else nil,
    }, Compressor:CompressScene(Highest, Packed))
    if not Scene then
        return false, 0
    end

    return true, Scene.Id
end

-- The scene an object lands in when the caller names none, so Objects.new keeps
-- working exactly as it did before scenes existed. Registered here, but not
-- loaded: Objects loads it the first time something actually needs it, so a
-- game that puts everything in its own scenes never pays for this one.
Registry.Default = Scenes.new({Name = "Default"})

function Scenes:GetDefault(): Scene
    return Registry.Default
end

return Scenes
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX44">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const ObjectTypes = require("../Objects/Types")
const PermissionTypes = require("../Permissions/Types")
const Handles = require("../Handles")

export type SceneIdentifier = Handles.SceneIdentifier
export type PersistentId = Handles.PersistentId

export type SceneConfig = {
    Name: string,

    -- Server only. Whether the scene is anybody's to see. Public unless this
    -- says otherwise, and it has to be said here rather than after the fact:
    -- registering a scene has already told everyone present its name.
    Private: boolean?,

    -- Server only. Who the scene admits from the moment it exists, by Player or
    -- user id. Only means anything on a private scene -- a public one is
    -- everybody's, and a list on it is inert.
    Admitted: {Player | number}?,

    -- Server only. Rights over the scene from the moment it exists: Player or
    -- user id to the name of the role to grant. The collaborator list a game
    -- already keeps, handed over once, so an owner holds their rights the
    -- moment they arrive rather than after a PlayerAdded hook remembers them.
    Rights: {[any]: string}?,
}

export type SceneRegistry = {
    Id: SceneIdentifier,
    Name: string,
}

-- One live copy of a scene. Load makes them and every one is equal: there is no
-- canonical copy, because a scene is the document and a copy is a reading of
-- it. Objects live here rather than on the scene, which is also the only place
-- they could live -- ask a scene loaded twice for "the object with local id 4"
-- and there is no answer.
export type SceneInstance = {
    Id: ObjectTypes.SceneInstanceId,
    Scene: SceneIdentifier,

    -- The scene this reads. Loose for the same reason Registry is: naming Scene
    -- here would be circular with the field below.
    Owner: any,

    -- Where this copy's objects live. A folder Prism makes and names for the
    -- copy, parented wherever Load was told to put it -- or under
    -- workspace.__prism.__scene_N when it was told nothing. Parent it into a
    -- Model of your own to pivot a whole copy, into PlayerGui for a scene made
    -- of interfaces, anywhere a Folder can go.
    --
    -- Nil for a copy the server opened: it builds no parts, so there is nothing
    -- for a folder of its to hold. Each client drawing the copy keeps its own.
    Folder: Folder?,

    -- True for a copy the server opened rather than loaded. The server owns
    -- its data exactly as it owns a loaded copy's, but clones no templates;
    -- every admitted client draws the copy itself.
    Opened: boolean,

    Objects: {[ObjectTypes.RuntimeId]: ObjectTypes.Object},

    -- Withdrawn from the world but kept whole, and holding the objects it took
    -- with it: out of the registries, folder out of the tree, every object in
    -- it suspended. What a player asking for a copy to go gets, as against
    -- Unload, which is final -- a copy cannot be rebuilt from its scene the way
    -- it was, because loading reads what the scene last committed rather than
    -- what was on screen.
    Suspended: {ObjectTypes.Object}?,

    -- Where the folder was parented while it was live, so a copy a game loaded
    -- into PlayerGui or into a Model of its own goes back there.
    Parent: Instance?,

    -- The one crossing between the two identities, and deliberately scoped to a
    -- copy: a persistent id names an object here, but names one in every other
    -- live copy of the same scene too.
    ByLocal: {[Handles.LocalId]: ObjectTypes.Object},

    -- Objects in the pack whose type this build does not have, as decoded
    -- records. Not objects: nothing finds, draws or replicates them. They are
    -- here so Serialize and Commit write them back where they were rather than
    -- deleting them from the level.
    Unknown: {any},

    Create: (
        self: SceneInstance,
        Reference: ObjectTypes.ObjectRegistry | ObjectTypes.ObjectIdentifier,
        InitialValues: {[number]: any}?
    ) -> ObjectTypes.Object?,

    -- A pack read into this copy rather than into a copy of its own: pasting a
    -- prefab into a level being edited. Every object is made afresh under an id
    -- this copy's scene mints, and the references inside the pack are remapped
    -- onto them; a reference pointing at anything the pack did not carry is
    -- dropped, because the id it holds means nothing here. Returns what it made,
    -- or nil if the pack could not be read.
    Place: (self: SceneInstance, Pack: buffer) -> {ObjectTypes.Object}?,

    Find: (self: SceneInstance, Local: Handles.LocalId) -> ObjectTypes.Object?,
    GetObjects: (self: SceneInstance) -> {ObjectTypes.Object},

    -- What this copy holds right now, as a pack.
    Serialize: (self: SceneInstance) -> buffer,

    -- Writes that pack back into the scene, making this copy what the scene
    -- says it is. Explicit rather than a side effect of unloading, because with
    -- more than one copy live, "save on unload" has to pick one and cannot.
    Commit: (self: SceneInstance) -> (),

    Unload: (self: SceneInstance) -> (),

    -- Out of the world, kept, and back again. True when it went; false when it
    -- was already away, or when its scene has been unregistered since and there
    -- is nothing to come back to. Dispose is the end of a suspended copy: its
    -- objects for good, and the folder they were in.
    Suspend: (self: SceneInstance) -> boolean,
    Revive: (self: SceneInstance) -> boolean,
    Dispose: (self: SceneInstance) -> (),
}

export type Scene = {
    Id: SceneIdentifier,
    Name: string,

    -- Only ever climbs, and is written into the pack. Handing a local id back
    -- out after its object is gone would make any reference still holding it --
    -- an undo entry, another object pointing here -- silently name a different
    -- object, which is the same reason property ids are never recycled.
    --
    -- It belongs to the scene rather than to a copy: two copies both creating
    -- an object have to get different ids, or committing either one would be
    -- undefined.
    LastId: Handles.LocalId,

    -- The committed state. A scene is this and nothing else until it is loaded.
    Data: buffer?,

    Instances: {[ObjectTypes.SceneInstanceId]: SceneInstance},

    -- A new live copy. Called twice, it gives two, and they are equals -- which
    -- is what makes one saved room able to stand in the world five times. Nil
    -- only where the scene's pack could not be read.
    Load: (self: Scene, Parent: Instance?) -> SceneInstance?,

    -- Every copy at once. A single copy unloads itself.
    Unload: (self: Scene) -> (),

    -- The committed pack, for the caller to store however it likes. This is
    -- what the scene says it is, not what any copy currently holds.
    Serialize: (self: Scene) -> buffer,

    GetInstances: (self: Scene) -> {SceneInstance},
    Destroy: (self: Scene) -> (),
}

-- A scene on the server also decides who hears about it. One that has admitted
-- nobody is public, which is what every scene was before admission existed;
-- one that has admitted anybody is told to them and to nobody else -- its name,
-- its copies and its objects alike.
export type ServerScene = Scene & {
    -- Whether the scene is anybody's to see. A private scene is told to the
    -- players it admits and to nobody else; a public one is everybody's, and
    -- its admitted list is inert.
    --
    -- A flag rather than something read off the list. Privacy used to mean "has
    -- admitted somebody", which made evicting the last player throw the scene
    -- open -- to everyone, including the player just evicted -- at exactly the
    -- moment somebody was locking it down. It also left no way to say the one
    -- thing a level editor most wants at the start: closed, and nobody in it
    -- yet.
    Private: boolean,

    -- User ids. The scene's rather than anyone's session, so it outlives
    -- whoever is connected.
    Admitted: {[number]: true},

    -- A live copy the server holds the data of and builds no parts for. Every
    -- admitted client draws it, and nobody else is told it exists: Roblox has
    -- no per-player workspace, so a part in the world is a part for everybody,
    -- and this is the only way to keep a scene out of sight.
    Open: (self: ServerScene) -> SceneInstance?,

    Admit: (self: ServerScene, Who: Player | number) -> (),
    Evict: (self: ServerScene, Who: Player | number) -> (),

    -- True for anyone at all while the scene is public.
    Admits: (self: ServerScene, Who: Player | number) -> boolean,
    GetAdmitted: (self: ServerScene) -> {number},
    IsPublic: (self: ServerScene) -> boolean,

    -- Closing a scene or opening it, after it has been registered. Closing
    -- takes it away from everyone it does not admit; opening hands it to
    -- everybody.
    SetPrivate: (self: ServerScene, Private: boolean) -> (),

    -- Rights over this scene, by user id. Not admission: admission decides
    -- what a player is sent, and these decide what they may change. Session
    -- state that goes with the scene; nothing writes them into a pack.
    Rights: {[number]: PermissionTypes.SceneRights},

    -- Clears what the player held here and copies the role's scene half in.
    Grant: (self: ServerScene, Who: Player | number, Role: string) -> boolean,
    Revoke: (self: ServerScene, Who: Player | number) -> (),
    GrantCapability: (self: ServerScene, Who: Player | number, Capability: string) -> (),
    RevokeCapability: (self: ServerScene, Who: Player | number, Capability: string) -> (),
    GetRights: (self: ServerScene, Who: Player | number) -> PermissionTypes.SceneRights?,
}

-- A scene the client owns outright: a prefab preview, a local sandbox, a room
-- being built before anyone else is shown it. The same document a server scene
-- is -- copies, packs, persistent ids, all of it -- except that nothing in it
-- replicates and nothing in it needs asking for. Its objects apply their own
-- edits, because there is nobody to ask.
--
-- Push is the one thing a server scene has no equivalent of: it hands the
-- committed pack to the server, which registers a scene of its own from it.
-- What comes back is that scene's id, and it is a different document from this
-- one -- pushing twice registers two.
export type LocalScene = Scene & {
    Push: (self: LocalScene, Name: string) -> (boolean, SceneIdentifier?),
}

return true
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX45">
				<Properties>
					<string name="Name">Selection</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Client side selection.
--
-- Editor state, not replicated state: the server never hears about it and no
-- other client sees it. Which is also why it lives here rather than inside
-- Objects/Client -- nothing in the object pipeline depends on it.
--
-- Change notification follows Properties: a plain listener list allocated on
-- the first OnChange call and dropped again when the last listener leaves,
-- rather than a signal object standing there for the many games that never
-- watch the selection at all.

const ObjectTypes = require("./Objects/Types")
const Objects = require("./Objects/Client")
const Logger = require("./Logger")

export type RuntimeId = ObjectTypes.RuntimeId
export type Object = ObjectTypes.Object

-- Everything here takes an object or its runtime id, the way Objects takes a
-- property by id or by name.
export type Reference = Object | RuntimeId

const Selection = {}
const Selected: {RuntimeId} = {}
local Listeners: {(Selected: {Object}) -> ()}? = nil

-- Only a reference the workspace still holds is accepted. Selecting an id that
-- never arrived, or one already gone, used to sit in the list until something
-- happened to walk past it.
const function Resolve(Reference: Reference): RuntimeId?
    const Identifier = if type(Reference) == "number"
        then Reference
        else Reference.RuntimeId

    const Obj = Objects:Get(Identifier)
    return if Obj and not Obj.Destroyed then Identifier else nil
end

-- Prunes as it collects. An object can leave at any moment -- destroyed by
-- another client, or removed with the scene it belonged to -- and nothing tells
-- the selection, so every read is also the cleanup pass. Order is preserved:
-- editors treat the most recently added entry as the active one.
const function Collect(): ({Object}, boolean)
    const Live = {}
    const Kept = {}

    for _, Identifier in Selected do
        const Obj = Objects:Get(Identifier)
        if Obj and not Obj.Destroyed then
            table.insert(Kept, Identifier)
            table.insert(Live, Obj)
        end
    end

    const Pruned = #Kept ~= #Selected
    if Pruned then
        table.clear(Selected)
        table.move(Kept, 1, #Kept, 1, Selected)
    end

    return Live, Pruned
end

const function Notify(Live: {Object})
    const Current = Listeners
    if not Current then
        return
    end

    for _, Callback in table.clone(Current) do
        task.spawn(Callback, Live)
    end
end

function Selection:Add(Reference: Reference): boolean
    const Identifier = Resolve(Reference)
    if not Identifier or table.find(Selected, Identifier) then
        return false
    end

    table.insert(Selected, Identifier)
    Notify(Collect())
    return true
end

function Selection:Remove(Reference: Reference): boolean
    -- Not Resolve: an object that has already left still has to be removable
    -- from the list, and Resolve refuses exactly those.
    const Identifier = if type(Reference) == "number"
        then Reference
        else Reference.RuntimeId

    const Position = table.find(Selected, Identifier)
    if not Position then
        return false
    end

    table.remove(Selected, Position)
    Notify(Collect())
    return true
end

-- Answers whether the reference is selected, without building the object list.
function Selection:Contains(Reference: Reference): boolean
    const Identifier = if type(Reference) == "number"
        then Reference
        else Reference.RuntimeId

    return table.find(Selected, Identifier) ~= nil
end

function Selection:Clear()
    if #Selected == 0 then
        return
    end

    table.clear(Selected)
    Notify({})
end

-- Replaces the selection wholesale and notifies once, rather than firing a
-- change per entry the way a Clear followed by N calls to Add would. Answers
-- how many references were accepted, which a boolean could not say.
function Selection:Set(References: {Reference}): number
    table.clear(Selected)

    for _, Reference in References do
        const Identifier = Resolve(Reference)
        if Identifier and not table.find(Selected, Identifier) then
            table.insert(Selected, Identifier)
        end
    end

    const Live = Collect()
    Notify(Live)
    return #Live
end

function Selection:Get(): {Object}
    const Live, Pruned = Collect()
    if Pruned then
        Notify(Live)
    end

    return Live
end

function Selection:Query(Comparator: (Obj: Object) -> boolean): {Object}
    const Matched = {}
    for _, Obj in Selection:Get() do
        if Comparator(Obj) then
            table.insert(Matched, Obj)
        end
    end

    return Matched
end

-- Fires with the whole selection rather than a delta: every use of this is a
-- panel or a handle that redraws from the current list anyway.
function Selection:OnChange(Callback: (Selected: {Object}) -> ()): () -> ()
    if typeof(Callback) ~= "function" then
        Logger:Error(`Invalid callback. Tried watching the selection with a {typeof(Callback)}.`)
    end

    local Current = Listeners
    if not Current then
        Current = {}
        Listeners = Current
    end

    table.insert(Current :: {any}, Callback)

    local Disconnected = false
    return function()
        if Disconnected then
            return
        end

        Disconnected = true

        const Live = Listeners
        if not Live then
            return
        end

        const Position = table.find(Live, Callback)
        if Position then
            table.remove(Live, Position)
        end

        if #Live == 0 then
            Listeners = nil
        end
    end
end

return Selection
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX46">
				<Properties>
					<string name="Name">Transactions</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX47">
					<Properties>
						<string name="Name">Client</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The client's half: build the list, send it as one packet, wait for the
-- answer.
--
-- Deliberately not optimistic, which a single Set is. A set has a local object
-- to write to and a value to roll back to if the server says no. A create has
-- neither: the object does not exist on this side, and its runtime id is the
-- server's to mint, so there is nothing to apply on the spot and nothing to
-- hand back until the answer comes. Applying the sets optimistically and
-- leaving the creates until later would also break the one property the whole
-- feature is for -- that the edit lands as a unit.
--
-- Commit therefore yields until the server answers, and a caller that wants to
-- keep painting frames while it flies should spawn it.

const Compressor = require("../Compressor")
const Objects = require("../Objects/Client")
const ObjectShared = require("../Objects/Shared")
const Scenes = require("../Scenes/Client")
const Network = require("./Network")
const Shared = require("./Shared")
const Listeners = require("../Listeners")
const Logger = require("../Logger")
const Types = require("./Types")

export type Operation = Types.Operation
export type Transaction = Types.Transaction
export type CommitRecord = Types.CommitRecord

const Transactions = {}
const Committed: {(Record: CommitRecord) -> ()} = {}

-- What reversing the transaction later needs and only now can be read: the
-- value each set is about to overwrite, and everything each destroy is about to
-- take away. Once the answer comes, the old values are gone.
const function Capture(Transaction: Transaction): ({[number]: any}, {[number]: any})
    const Before = {}
    const Removed = {}

    for Index, Operation in Transaction.Operations do
        const Op = Operation :: any

        if Op.Kind == "Set" then
            const Obj = Objects:Get(Op.Target)
            const Prop = if Obj then Obj.Properties[Op.Property] else nil
            Before[Index] = if Prop then Prop.Value else nil
        elseif Op.Kind == "Destroy" then
            const Obj = Objects:Get(Op.Target)
            if Obj then
                Removed[Index] = {
                    Registry = Obj.Registry,
                    Values = ObjectShared.Snapshot(Obj),
                    Instance = Obj.InstanceId,
                }
            end
        end
    end

    return Before, Removed
end

--=============================================================================
-- Scenes this client owns
--=============================================================================

-- A transaction whose objects are all in scenes this client owns applies here
-- rather than being sent: there is nobody to ask, nothing to refuse it, and
-- nothing to roll back to but itself. It is the same list of operations, built
-- by the same builder and applied in the same three phases the server uses, so
-- an editor writes one kind of edit whichever kind of scene it is working in.
--
-- What it is for is what a transaction has always been for: the edit lands
-- whole or not at all, and it is one thing to take back. Before this a local
-- scene had no batching at all -- every set, create and destroy was its own
-- apply and its own undo step, so undoing a pasted prefab took it apart one
-- object at a time.

export type ApplyRecord = {
    Operations: {Operation},
    Created: {any},
    Removed: {any},
    Before: {[number]: any},
    Targets: {[number]: any},

    -- The copies it put in the world and the ones it withdrew, suspended rather
    -- than unloaded, so whatever takes this record takes them too.
    Loaded: {any},
    Withdrew: {any},
}

-- Fired before a local apply begins and after it lands. History listens to
-- both: the first tells it to stop recording object by object, the second hands
-- it the whole edit as one step. Synchronous and in that order, because the
-- signals a local object fires as it is built or withdrawn would otherwise
-- reach the history before the record does.
--
-- Answering true to the second means taking the record, and with it the objects
-- its destroys suspended; nothing answering means they are disposed here.
const Starting: {() -> ()} = {}
-- Nil where the apply came apart and was rolled back. Every Applying is
-- followed by exactly one of these, whichever way it went, so a listener that
-- turned something off on the first can turn it back on here without having to
-- wonder.
const Recorders: {(Record: ApplyRecord?) -> boolean} = {}

function Transactions.OnApplying(Callback: () -> ()): () -> ()
    return Listeners.Watch(Starting, Callback, "local applies beginning")
end

function Transactions.OnApplied(Callback: (Record: ApplyRecord?) -> boolean): () -> ()
    return Listeners.Watch(Recorders, Callback, "local applies")
end

type PlannedCreate = {
    Object: number,
    Live: any,
    Properties: {[number]: any},

    -- By position in this plan's own create list, not by the operation index
    -- the builder wrote.
    References: {[number]: number}?,
}

type LocalPlan = {
    Creates: {PlannedCreate},
    Sets: {{Index: number, Property: any, Value: any}},
    Destroys: {any},
    Targets: {[number]: any},
    Loads: {any},
    Unloads: {any},
}

-- Resolve and check everything, touching nothing. A transaction that cannot be
-- applied whole is not applied at all, and this is where that is settled.
const function Plan(Transaction: Transaction): LocalPlan?
    const Planned: LocalPlan = {Creates = {}, Sets = {}, Destroys = {}, Targets = {}, Loads = {}, Unloads = {}}
    const Doomed: {[number]: true} = {}
    const Withdrawn: {[number]: true} = {}
    const CreateAt: {[number]: number} = {}
    const Pending: {{At: number, References: {[number]: number}}} = {}

    for Index, Operation in Transaction.Operations do
        const Op = Operation :: any

        if Op.Kind == "Create" then
            const Live = Scenes:GetLocalCopy(Op.Instance)
            if not Live then
                Logger:Warn(`A local transaction names copy {Op.Instance}, which is not a copy of a scene this client owns.`)
                return nil
            end

            table.insert(Planned.Creates, {
                Object = Op.Object,
                Live = Live,
                Properties = Op.Properties,
            })

            CreateAt[Index] = #Planned.Creates

            if Op.References then
                table.insert(Pending, {At = #Planned.Creates, References = Op.References})
            end
        elseif Op.Kind == "Set" then
            const Obj = Objects:Get(Op.Target)
            if not Obj or Obj.Destroyed then
                Logger:Warn("A local transaction names an object that is not here.")
                return nil
            end

            const Prop = Obj.Properties[Op.Property]
            if not Prop then
                Logger:Warn(`A local transaction sets property {Op.Property}, which {Obj.Name} does not carry.`)
                return nil
            end

            Planned.Targets[Index] = Obj
            table.insert(Planned.Sets, {Index = Index, Property = Prop, Value = Op.Value})
        elseif Op.Kind == "Destroy" then
            const Obj = Objects:Get(Op.Target)
            if not Obj or Obj.Destroyed then
                Logger:Warn("A local transaction names an object that is not here.")
                return nil
            end

            Planned.Targets[Index] = Obj

            if not Doomed[Obj.RuntimeId] then
                Doomed[Obj.RuntimeId] = true
                table.insert(Planned.Destroys, Obj)
            end
        elseif Op.Kind == "Load" then
            const Scene = Scenes:GetLocalById(Op.Scene)
            if not Scene then
                Logger:Warn(`A local transaction names scene {Op.Scene}, which is not one this client owns.`)
                return nil
            end

            table.insert(Planned.Loads, Scene)
        elseif Op.Kind == "Unload" then
            const Live = Scenes:GetLocalCopy(Op.Instance)
            if not Live then
                Logger:Warn(`A local transaction names copy {Op.Instance}, which is not a copy of a scene this client owns.`)
                return nil
            end

            if not Withdrawn[Op.Instance] then
                Withdrawn[Op.Instance] = true
                table.insert(Planned.Unloads, Live)
            end
        elseif Op.Kind == "Lock" or Op.Kind == "Unlock" then
            -- Cannot happen through the builder, which refuses a hold on a
            -- local object. Said plainly rather than left to the branch below,
            -- because the reason is a rule rather than a mistake: nothing in a
            -- scene this client owns is anybody else's to touch.
            Logger:Warn("A local transaction cannot hold objects: nothing in a scene this client owns is held.")
            return nil
        else
            Logger:Warn(`A local transaction carries an operation of unknown kind {tostring(Op.Kind)}.`)
            return nil
        end
    end

    -- A reference names the operation that makes its target, because the id it
    -- will hold is minted as the creates run. Answered here, against the whole
    -- list, since the create it names may be further down it.
    for _, Entry in Pending do
        const Resolved: {[number]: number} = {}

        for PropertyId, Names in Entry.References do
            const At = CreateAt[Names]
            if not At then
                Logger:Warn(`A local transaction has a reference naming operation {Names}, which is not a create in it.`)
                return nil
            end

            Resolved[PropertyId] = At
        end

        Planned.Creates[Entry.At].References = Resolved
    end

    return Planned
end

const function ApplyLocal(Transaction: Transaction): (boolean, {number})
    const Planned = Plan(Transaction)
    if not Planned then
        return false, {}
    end

    Listeners.Notify(Starting)

    const Created: {any} = {}
    const Removed: {any} = {}
    const Before: {[number]: any} = {}
    const Loaded: {any} = {}
    const Withdrew: {any} = {}

    -- What to write back if the apply throws partway. A list as well as a map,
    -- because a property whose value was nil leaves no entry in the map to
    -- iterate and would never be restored.
    const Touched: {any} = {}
    const Captured: {[any]: true} = {}
    const Previous: {[any]: any} = {}

    const Ok, Err = pcall(function()
        -- Copies first, before anything that might name one: a create can land
        -- in a copy this same transaction loaded.
        for _, Scene in Planned.Loads do
            const Live = Scene:Load()
            if not Live then
                error(`could not load {Scene.Name}`)
            end

            table.insert(Loaded, Live)
        end

        for _, Create in Planned.Creates do
            table.insert(Created, Objects.new(Create.Object, Create.Properties, Create.Live))
        end

        -- Every create has run, so every id a reference was waiting on exists.
        for Index, Create in Planned.Creates do
            if not Create.References then
                continue
            end

            const Obj = Created[Index]
            for PropertyId, Names in Create.References do
                const Prop = Obj.Properties[PropertyId]
                const Points = Created[Names]
                if Prop and Points then
                    Prop:Set(Points.LocalId)
                end
            end
        end

        for _, Set in Planned.Sets do
            const Prop = Set.Property

            if not Captured[Prop] then
                Captured[Prop] = true
                Previous[Prop] = Prop.Value
                table.insert(Touched, Prop)
            end

            Before[Set.Index] = Previous[Prop]

            -- The property rather than the object's Set, which would record an
            -- edit of its own: the whole transaction is one step, and this is
            -- inside it. Links are property listeners, so they still run.
            Prop:Set(Set.Value)
        end

        for _, Obj in Planned.Destroys do
            -- Suspended, not ended: what becomes of it is decided below, once
            -- it is known whether anything is keeping this edit.
            Objects.Suspend(Obj)
            table.insert(Removed, Obj)
        end

        -- Copies out after the objects, so an edit to something in a copy this
        -- transaction also withdraws lands before the copy goes.
        for _, Live in Planned.Unloads do
            if Live:Suspend() then
                table.insert(Withdrew, Live)
            end
        end
    end)

    if not Ok then
        Logger:Warn(`A local transaction failed partway through and was rolled back: {Err}`)

        for _, Live in Withdrew do
            Live:Revive()
        end

        for _, Obj in Removed do
            Objects.Revive(Obj)
        end

        for _, Prop in Touched do
            Prop:Set(Previous[Prop])
        end

        for _, Obj in Created do
            Objects.Retire(Obj)
        end

        -- A copy it made and is now taking back is not anybody's work being
        -- withdrawn: nothing has had a chance to touch it, so it goes outright.
        for _, Live in Loaded do
            Live:Unload()
        end

        -- Said even though there is nothing to record, because something is
        -- waiting to hear that the apply is over.
        for _, Callback in Recorders do
            Callback(nil)
        end

        return false, {}
    end

    -- Offered whole, and taken or not: a listener answering true has the record
    -- and the objects suspended above, to revive on an undo and to dispose of
    -- when the step holding them falls off the stack. Nothing answering means
    -- nothing is keeping them, and the destroys were as final as they looked.
    local Kept = false
    if not Transaction.Untracked then
        const Record: ApplyRecord = {
            Operations = Transaction.Operations,
            Created = Created,
            Removed = Removed,
            Before = Before,
            Targets = Planned.Targets,
            Loaded = Loaded,
            Withdrew = Withdrew,
        }

        for _, Callback in Recorders do
            if Callback(Record) then
                Kept = true
                break
            end
        end
    end

    if not Kept then
        for _, Obj in Removed do
            Objects.Dispose(Obj)
        end

        for _, Live in Withdrew do
            Live:Dispose()
        end
    end

    const Ids = table.create(#Created)
    for Index, Obj in Created do
        Ids[Index] = Obj.RuntimeId
    end

    return true, Ids
end

-- The holds an applied transaction took and let go of, recorded from its answer
-- rather than left to the broadcast, which travels on the other remote and can
-- land after Commit has returned. Releases run last, so an object both locked
-- and unlocked ends free. A destroyed object's hold went with it, and recording
-- one would leave an entry for an id the removal may already have cleared.
const function RecordHolds(Operations: {any})
    const Gone: {[number]: true} = {}
    const Final: {[number]: boolean} = {}

    for _, Op in Operations do
        if Op.Kind == "Destroy" then
            Gone[Op.Target] = true
        elseif Op.Kind == "Lock" and Final[Op.Target] == nil then
            Final[Op.Target] = true
        elseif Op.Kind == "Unlock" then
            Final[Op.Target] = false
        end
    end

    const Taken, Released = {}, {}
    for Target, IsHeld in Final do
        if not Gone[Target] then
            table.insert(if IsHeld then Taken else Released, Target)
        end
    end

    Objects.RecordHolds(Taken, true)
    Objects.RecordHolds(Released, false)
end

const New = Shared.factory(Objects, function(Transaction: Transaction)
    -- A scene this client owns is this client's to edit, so there is nothing
    -- to send and nothing to wait for: this returns having already done it.
    if Transaction.Local then
        return ApplyLocal(Transaction)
    end

    const Before, Removed = Capture(Transaction)

    -- Writing the packet is inside the pcall as well as sending it. An
    -- operation that cannot be encoded throws rather than being dropped, and
    -- the whole point is that a transaction is never sent four fifths written.
    const Ok, Applied, Created = pcall(function()
        return Network.Apply:Invoke(
            Compressor:CompressTransaction(Transaction.Operations),
            Transaction.Untracked == true
        )
    end)

    if not Ok then
        Logger:Warn(`A transaction was not applied: {Applied}`)
        return false, {}
    end

    -- The objects themselves arrive on their own, through the same broadcast
    -- every other client receives. These are their ids, in the order the
    -- creates were declared, so the caller can find them once they land.
    const Ids = Created or {}

    if Applied == true then
        RecordHolds(Transaction.Operations)

        Listeners.Notify(Committed, {
            Transaction = Transaction,
            Created = Ids,
            Before = Before,
            Removed = Removed,
        })
    end

    return Applied == true, Ids
end)

function Transactions.new(): Transaction
    return New()
end

-- Every transaction this client commits that the server applied, with what it
-- overwrote and took away. History is built on this.
function Transactions:OnCommitted(Callback: (Record: CommitRecord) -> ()): () -> ()
    return Listeners.Watch(Committed, Callback, "commits")
end

return Transactions
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX48">
					<Properties>
						<string name="Name">Network</string>
						<ProtectedString name="Source"><![CDATA[--!strict
const Networking = require("../Networking")

return {
    Apply = Networking:Get("Transactions.Apply"),
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX49">
					<Properties>
						<string name="Name">Server</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Applying a transaction: the whole list or none of it.
--
-- This is also the only path by which a client can create an object. Before it
-- there was no channel that asked for one, so Permissions:Can(_, "Create", _)
-- was reachable by nothing and a client editor could edit and delete but never
-- build.
--
-- Three phases, in this order and for these reasons.
--
-- Budget first, by the size of the list rather than by the packet. A limiter
-- that charges per call lets one packet carrying ten thousand operations spend
-- a single unit and walk past it, and a flood of transactions that all get
-- refused still has to cost the flooder something.
--
-- Then plan: resolve every operation and check every one of them, touching
-- nothing. A single refusal ends the transaction here, where the world has not
-- moved yet.
--
-- Then apply, creates before sets before destroys. That order was originally
-- what made the thing atomic rather than merely batched: a create could be
-- taken back by destroying what it made and a set by writing back what it
-- overwrote, while a destroy could not be taken back at all, so nothing
-- irreversible happened until everything reversible had already succeeded.
--
-- A destroy withdraws its object now rather than ending it -- that is what lets
-- a history hold it against an undo -- so the roll back reaches the destroys
-- too and the order is no longer load bearing. It is kept because it is still
-- the order the operations mean: a transaction that creates an object and sets
-- a property on it reads that way round, and one that edits an object and then
-- destroys it should not have the edit land after the removal.

const PropertyTypes = require("../Properties/Types")
const Permissions = require("../Permissions/Server")
const Properties = require("../Properties/Server")
const ObjectTypes = require("../Objects/Types")
const Compressor = require("../Compressor")
const Objects = require("../Objects/Server")
const Scenes = require("../Scenes/Server")
const Audience = require("../Scenes/Audience")
const Network = require("./Network")
const Shared = require("./Shared")
const Listeners = require("../Listeners")
const Logger = require("../Logger")
const Types = require("./Types")

export type Operation = Types.Operation
export type Transaction = Types.Transaction

-- A transaction that landed, as the thing that has to be able to reverse it
-- needs to see it: the list as the author wrote it, the objects it made, the
-- objects it took away -- suspended rather than destroyed, so they can be put
-- back -- and what each set overwrote, by operation.
export type ApplyRecord = {
    Operations: {Operation},
    Created: {ObjectTypes.Object},
    Removed: {ObjectTypes.Object},
    Before: {[number]: any},

    -- The object each set and destroy resolved to, by operation. Resolving them
    -- again afterwards would not work: an object this transaction destroyed is
    -- out of the workspace by the time anyone reads the record, and a set on an
    -- object the same transaction went on to destroy would find nothing.
    Targets: {[number]: ObjectTypes.Object},

    -- The copies it put in the world, and the ones it withdrew -- suspended
    -- rather than unloaded, so whatever takes this record takes them too.
    Loaded: {any},
    Withdrew: {any},
}

const Transactions = {}

-- Synchronous, and answers: taking the record means taking the suspended
-- objects in it, so the answer has to arrive before Apply decides whether to
-- dispose of them. A spawned listener could not say in time.
const Recorders: {(Plr: Player, Record: ApplyRecord) -> boolean} = {}

-- What a player's transaction did, offered to whatever records it -- History,
-- normally. Return true to take it; see ApplyRecord.
function Transactions.OnApplied(Callback: (Plr: Player, Record: ApplyRecord) -> boolean): () -> ()
    return Listeners.Watch(Recorders, Callback, "applied transactions")
end

-- A ceiling on one packet, not on how much work a role may do: the rate budget
-- is what actually bounds that, and at any sane rate it binds long before this
-- does. This is here so a decode loop cannot be handed a length that costs more
-- to walk than the packet cost to send.
const MAX_OPERATIONS = 1024

type PlannedCreate = {
    Object: ObjectTypes.ObjectIdentifier,

    -- The live scene copy the object goes in, or nil for the one Objects.new
    -- would have picked on its own.
    Instance: any,
    Properties: {[PropertyTypes.PropertyIdentifier]: any},

    -- Object properties pointing at something else this transaction creates,
    -- by the position of that object in the plan's own create list rather than
    -- by the operation index the packet named. Resolved to ids once the creates
    -- have run and the copy has minted them.
    References: {[PropertyTypes.PropertyIdentifier]: number}?,
}

type PlannedSet = {
    Object: ObjectTypes.Object,
    Property: PropertyTypes.Property<any>,
    Value: any,

    -- Which operation asked for it, so what the set overwrote can be reported
    -- back against the list the author wrote rather than against the plan.
    Index: number,
}

-- One create's reference to another, while the plan is still being built. It
-- cannot be answered where it is read -- the create it names may be further
-- down the list, which is how a button is created before its door -- so it is
-- held with everything needed to check it once the whole list is known.
type PendingReference = {
    -- Where in Creates the object doing the pointing is.
    Create: number,

    Property: PropertyTypes.PropertyIdentifier,

    -- The operation the author named, and the copy the create carrying this
    -- reference is going into, as the packet wrote it.
    Operation: number,
    Instance: number,
}

type Plan = {
    Creates: {PlannedCreate},
    Sets: {PlannedSet},
    Destroys: {ObjectTypes.Object},
    Locks: {ObjectTypes.Object},
    Unlocks: {ObjectTypes.Object},
    Loads: {any},
    Unloads: {any},

    -- What each set and destroy operation resolved to, kept by operation so the
    -- record handed out afterwards can name them without looking them up in a
    -- world they may no longer be in.
    Targets: {[number]: ObjectTypes.Object},
}

-- A client is told nothing but false, and is told it silently: a refusal that
-- logs is a refusal a client can spam to fill the server's output. A
-- transaction the server itself built is the opposite -- there is no one to
-- return false to but the caller, and a silent one is a bug with no thread to
-- pull.
const function Refuse(Plr: Player?, Message: string): nil
    if not Plr then
        Logger:Warn(`Transaction refused: {Message}`)
    end

    return nil
end

const function BuildPlan(Plr: Player?, Operations: {Operation}): Plan?
    const Creates: {PlannedCreate} = {}
    const Sets: {PlannedSet} = {}
    const Destroys: {ObjectTypes.Object} = {}

    -- Holds taken and released, and copies coming and going. Gathered rather
    -- than applied one at a time: a lock is all or none, so every Lock in the
    -- list is one claim.
    const Locks: {ObjectTypes.Object} = {}
    const Unlocks: {ObjectTypes.Object} = {}
    const Loads: {any} = {}
    const Unloads: {any} = {}
    const Withdrawn: {[number]: true} = {}

    -- Objects already listed for destruction. Naming one twice is a redundant
    -- operation rather than an invalid one, and dropping the repeat here keeps
    -- it out of the packet that announces the removals.
    const Doomed: {[ObjectTypes.RuntimeId]: true} = {}
    const Targets: {[number]: ObjectTypes.Object} = {}

    -- Where each create operation ended up in Creates. A reference names an
    -- operation, because that is what the author could name; everything after
    -- the plan works in creates, because that is what the apply has in hand.
    const CreateAt: {[number]: number} = {}

    -- References cannot be checked as they are read: one may name a create
    -- further down the list, which is how a button is created before the door
    -- it points at. Held until the whole list is known, then checked together.
    const Pending: {PendingReference} = {}

    for OperationIndex, Operation in Operations do
        if Operation.Kind == "Create" then
            const Registry = Objects:GetRegistry(Operation.Object)
            if not Registry then
                return Refuse(Plr, `object type {Operation.Object} is not registered.`)
            end

            -- Zero is "wherever Objects.new would have put it", which is the
            -- implicit default scene. Anything else has to name a copy that is
            -- actually live: a scene loaded twice has two, and guessing between
            -- them puts the object in a room the caller did not choose.
            local Live: any = nil
            if Operation.Instance ~= 0 then
                Live = Scenes:GetInstance(Operation.Instance)
                if not Live then
                    return Refuse(Plr, `scene copy {Operation.Instance} is not live.`)
                end
            end

            -- What the create is checked against: the scene it lands in and
            -- the type it makes, which is what an object carries once it
            -- exists.
            const Target = {
                Scene = if Live then Live.Scene else Scenes:GetDefault().Id,
                Registry = Operation.Object,
            }

            -- A copy of a scene the player was never admitted to is one they
            -- have not been told exists, and is refused as if it were not live.
            if Plr and not Audience.Sees(Plr, Target.Scene) then
                return Refuse(Plr, `scene copy {Operation.Instance} is not live.`)
            end

            if Plr and not Permissions:Can(Plr, "Create", Target) then
                return Refuse(Plr, `not allowed to create {Registry.Name}.`)
            end

            const Carried: {[PropertyTypes.PropertyIdentifier]: true} = {}
            for _, PropertyId in Registry.Properties do
                Carried[PropertyId] = true
            end

            const Initial = {}
            for PropertyId, Value in Operation.Properties do
                -- Dropped rather than refused, which is what restoring a saved
                -- object does with a value for a property the type no longer
                -- carries.
                if not Carried[PropertyId] then
                    continue
                end

                const PropertyRegistry = Properties:GetRegistry(PropertyId)
                if not PropertyRegistry then
                    continue
                end

                -- Refused rather than dropped. The property is one the object
                -- will have, so quietly creating it holding something else is
                -- handing back an object that is not the one that was asked
                -- for. Clamping is not this: a value outside MinValue is valid
                -- and lands clamped, exactly as it would through Set.
                if not PropertyTypes:IsValid(PropertyRegistry.Type, Value, PropertyRegistry.Constraints) then
                    return Refuse(Plr, `{PropertyRegistry.Name} cannot hold the value the create carried.`)
                end

                -- An initial value is a write, so the property lists get their
                -- say over it exactly as they do over an edit.
                if Plr and not Permissions:Can(Plr, "Create", Target, PropertyId) then
                    return Refuse(Plr, `not allowed to write {PropertyRegistry.Name}.`)
                end

                Initial[PropertyId] = Value
            end

            table.insert(Creates, {
                Object = Operation.Object,
                Instance = Live,
                Properties = Initial,
            })

            CreateAt[OperationIndex] = #Creates

            if Operation.References then
                for PropertyId, Names in Operation.References do
                    -- Refused rather than dropped, unlike a value for a
                    -- property the type does not carry. A value can be left out
                    -- and leave a coherent object behind; a reference left out
                    -- leaves an object whose whole reason for being created
                    -- alongside the others is missing, and nothing downstream
                    -- can tell.
                    if not Carried[PropertyId] then
                        return Refuse(Plr, `{Registry.Name} does not carry property {PropertyId}.`)
                    end

                    const PropertyRegistry = Properties:GetRegistry(PropertyId)
                    if not PropertyRegistry then
                        return Refuse(Plr, `property {PropertyId} is not registered.`)
                    end

                    if PropertyRegistry.Type ~= "Object" then
                        return Refuse(Plr, `{PropertyRegistry.Name} is a {PropertyRegistry.Type}, which cannot hold a reference.`)
                    end

                    -- A reference is a write of that property, so it asks for
                    -- what writing it through a value would ask for.
                    if Plr and not Permissions:Can(Plr, "Create", Target, PropertyId) then
                        return Refuse(Plr, `not allowed to write {PropertyRegistry.Name}.`)
                    end

                    table.insert(Pending, {
                        Create = #Creates,
                        Property = PropertyId,
                        Operation = Names,
                        Instance = Operation.Instance,
                    })
                end
            end
        elseif Operation.Kind == "Set" then
            -- An object in a scene the player was never admitted to is not
            -- here, as far as they are concerned. The same goes for destroys.
            const Obj = Objects:Get(Operation.Target)
            if not Obj or Obj.Destroyed or (Plr and not Audience.Sees(Plr, Obj.Scene)) then
                return Refuse(Plr, `object {Operation.Target} is not here.`)
            end

            -- Held by someone else. The server's own transactions pass: a lock
            -- is between players, and the server is the one enforcing it.
            if Plr and Objects.LockedAgainst(Obj, Plr) then
                return Refuse(Plr, `{Obj.Name} is locked by someone else.`)
            end

            if Plr and not Permissions:Can(Plr, "Edit", Obj, Operation.Property) then
                return Refuse(Plr, `not allowed to edit {Obj.Name}.`)
            end

            const Prop = Obj.Properties[Operation.Property]
            if not Prop then
                return Refuse(Plr, `{Obj.Name} has no property {Operation.Property}.`)
            end

            -- The payload describes itself, so this is the author's own claim
            -- about what it wrote being checked against what the property
            -- holds, not the registry being asked twice.
            if Operation.Type ~= Prop.Type then
                return Refuse(Plr, `{Prop.Name} is a {Prop.Type} and the operation carried a {tostring(Operation.Type)}.`)
            end

            if not PropertyTypes:IsValid(Prop.Type, Operation.Value, Prop.Constraints) then
                return Refuse(Plr, `{Prop.Name} cannot hold {tostring(Operation.Value)}.`)
            end

            -- The rest of what an Object property will take, which IsValid
            -- cannot answer: it sees a number, and whether that number names
            -- something this property may point at depends on the copy holding
            -- the object being written. Refused here, where the world has not
            -- moved, rather than dropped inside the apply.
            local Value = Operation.Value
            if Prop.Type == "Object" then
                const Reference, Why = Objects.Reference(Obj.InstanceId, Prop, Value)
                if Reference == nil then
                    return Refuse(Plr, `{Obj.Name}.{Prop.Name} cannot point there: {Why}.`)
                end

                Value = Reference
            end

            Targets[OperationIndex] = Obj
            table.insert(Sets, {
                Object = Obj,
                Property = Prop,
                Value = Value,
                Index = OperationIndex,
            })
        elseif Operation.Kind == "Destroy" then
            const Obj = Objects:Get(Operation.Target)
            if not Obj or Obj.Destroyed or (Plr and not Audience.Sees(Plr, Obj.Scene)) then
                return Refuse(Plr, `object {Operation.Target} is not here.`)
            end

            if Plr and Objects.LockedAgainst(Obj, Plr) then
                return Refuse(Plr, `{Obj.Name} is locked by someone else.`)
            end

            if Plr and not Permissions:Can(Plr, "Destroy", Obj) then
                return Refuse(Plr, `not allowed to destroy {Obj.Name}.`)
            end

            Targets[OperationIndex] = Obj

            if not Doomed[Obj.RuntimeId] then
                Doomed[Obj.RuntimeId] = true
                table.insert(Destroys, Obj)
            end
        elseif Operation.Kind == "Lock" or Operation.Kind == "Unlock" then
            const Obj = Objects:Get(Operation.Target)
            if not Obj or Obj.Destroyed or (Plr and not Audience.Sees(Plr, Obj.Scene)) then
                return Refuse(Plr, `object {Operation.Target} is not here.`)
            end

            Targets[OperationIndex] = Obj

            if Operation.Kind == "Lock" then
                -- The same right taking one through Objects:Lock needs: a hold
                -- is worth having only where an edit would be allowed, and
                -- holding what you may not change is a way to stop other people
                -- working rather than a way to work.
                if Plr and not Permissions:Can(Plr, "Edit", Obj) then
                    return Refuse(Plr, `not allowed to hold {Obj.Name}.`)
                end

                -- Held by somebody else, which Objects:Lock would refuse. Caught
                -- here so the whole transaction stops before the world moves
                -- rather than after the creates have run.
                if Plr and Objects.LockedAgainst(Obj, Plr) then
                    return Refuse(Plr, `{Obj.Name} is held by someone else.`)
                end

                table.insert(Locks, Obj)
            else
                -- Releasing needs no right, but releasing what is not yours does
                -- not happen: Objects:Unlock refuses the lot if any of them is
                -- somebody else's.
                if Plr and Objects.LockedAgainst(Obj, Plr) then
                    return Refuse(Plr, `{Obj.Name} is held by someone else.`)
                end

                table.insert(Unlocks, Obj)
            end
        elseif Operation.Kind == "Load" then
            const Scene = Scenes:GetById(Operation.Scene)
            if not Scene or (Plr and not Audience.Sees(Plr, Scene.Id)) then
                return Refuse(Plr, `scene {Operation.Scene} is not registered.`)
            end

            -- Loading a scene is making every object in it, so it asks for what
            -- making one asks for: the create verb on that scene.
            --
            -- The verb alone, and deliberately. A pack holds whatever it holds,
            -- so there is no type here to check the object lists against
            -- without reading the whole thing first -- which is why those lists
            -- govern what a role builds by hand and say nothing about this. A
            -- role that may create in a scene may put copies of it in the world.
            const Allowed = if Plr then Scene:GetRights(Plr) else nil
            if Plr and not (Allowed and Allowed.CanCreate) then
                return Refuse(Plr, `not allowed to load {Scene.Name}.`)
            end

            table.insert(Loads, Scene)
        elseif Operation.Kind == "Unload" then
            const Live = Scenes:GetInstance(Operation.Instance)
            if not Live or (Plr and not Audience.Sees(Plr, Live.Scene)) then
                return Refuse(Plr, `scene copy {Operation.Instance} is not live.`)
            end

            -- And taking a copy away is destroying every object in it, read the
            -- same way and for the same reason.
            const Owner = Scenes:GetById(Live.Scene)
            const Allowed = if Plr and Owner then Owner:GetRights(Plr) else nil
            if Plr and not (Allowed and Allowed.CanDestroy) then
                return Refuse(Plr, "not allowed to unload that copy.")
            end

            -- Named twice is one unload, like a destroy.
            if not Withdrawn[Live.Id] then
                Withdrawn[Live.Id] = true
                table.insert(Unloads, Live)
            end
        else
            return Refuse(Plr, `unknown operation kind {tostring((Operation :: any).Kind)}.`)
        end
    end

    -- Now that every operation has been read, the references can be answered.
    for _, Reference in Pending do
        const Names = CreateAt[Reference.Operation]
        if not Names then
            return Refuse(Plr, `a reference names operation {Reference.Operation}, which is not a create in this transaction.`)
        end

        -- Both creates have to land in the same copy, because a local id means
        -- nothing outside one. Compared as the packet wrote them: two creates
        -- of one group carry the same copy, and a caller mixing "this copy" and
        -- "wherever creates go" is told so rather than guessed at.
        const Other = Operations[Reference.Operation] :: Types.CreateOperation
        if Other.Instance ~= Reference.Instance then
            return Refuse(Plr, "a reference names a create going into another copy.")
        end

        const Create = Creates[Reference.Create]
        if not Create.References then
            Create.References = {}
        end

        (Create.References :: any)[Reference.Property] = Names
    end

    return {
        Creates = Creates,
        Sets = Sets,
        Destroys = Destroys,
        Targets = Targets,
        Locks = Locks,
        Unlocks = Unlocks,
        Loads = Loads,
        Unloads = Unloads,
    }
end

-- Plr is who to check against, and nil means the server itself: it authored the
-- list, so there is no role to consult and no budget to spend.
--
-- Tracked is false for a transaction that must not become a step in the
-- author's history -- what History itself applies when it reverses one, and
-- what a client asks for by committing an Untracked transaction. It is not a
-- permission: an untracked edit is checked and charged exactly like any other.
function Transactions.Apply(
    Plr: Player?,
    Operations: {Operation},
    Tracked: boolean?
): (boolean, {ObjectTypes.RuntimeId})
    if #Operations > MAX_OPERATIONS then
        Refuse(Plr, `{#Operations} operations is past the {MAX_OPERATIONS} a single transaction may carry.`)
        return false, {}
    end

    if Plr and not Permissions:Consume(Plr, #Operations) then
        return false, {}
    end

    const Planned = BuildPlan(Plr, Operations)
    if not Planned then
        return false, {}
    end

    const Created: {ObjectTypes.Object} = {}
    const Removed: {ObjectTypes.Object} = {}

    -- Copies this transaction put in the world and took out of it. Taken out
    -- means suspended: a copy a player asked to go is set aside whole, so an
    -- undo brings back what was in it rather than what its scene last saved.
    const Loaded: {any} = {}
    const Withdrew: {any} = {}

    -- Whether the holds were taken, so a roll back knows to let them go again.
    local Held = false

    -- What to broadcast, and at most one entry per property: two sets on the
    -- same property in one transaction are one change by the time it lands, and
    -- sending both would replay the transaction's history rather than its
    -- result. Keyed by the property instance, which is already unique per
    -- object and property.
    const Changes: {{Object: ObjectTypes.Object, Property: PropertyTypes.PropertyIdentifier, Value: buffer}} = {}
    const At: {[any]: number} = {}

    -- What to write back if the apply throws partway, captured before the first
    -- set touches it. A list as well as a map, because a property whose value
    -- was nil leaves no entry in the map to iterate and would never be
    -- restored.
    const Touched: {PropertyTypes.Property<any>} = {}
    const Captured: {[any]: true} = {}
    const Previous: {[any]: any} = {}

    -- The same values again, but by operation rather than by property, which is
    -- what reversing the list later reads. Two sets on one property both report
    -- what the property held before the transaction began, because that is what
    -- undoing the transaction has to put back.
    const Before: {[number]: any} = {}

    const Ok, Err = pcall(function()
        -- Holds first, because that is what they are for: everything below
        -- happens with them already taken. All or none, like Objects:Lock --
        -- and the plan has already refused any that somebody else is holding,
        -- so this failing is a race rather than the ordinary case.
        if #Planned.Locks > 0 then
            if not Objects:Lock(Planned.Locks, Plr) then
                error("could not take the holds it asked for")
            end

            Held = true
        end

        -- Then the copies it asks to appear, before anything that might name
        -- one: a create can land in a copy this same transaction loaded.
        for _, Scene in Planned.Loads do
            const Live = Scene:Load()
            if not Live then
                error(`could not load {Scene.Name}`)
            end

            table.insert(Loaded, Live)
        end

        for _, Create in Planned.Creates do
            -- Silent: the objects go out together at the end, down the chunked
            -- path a scene load uses, rather than one packet each.
            table.insert(Created, Objects.new(Create.Object, Create.Properties, Create.Instance, false))
        end

        -- Every create has run, so every id a reference was waiting on exists.
        -- Before the announcement rather than after, which is what makes an
        -- object go out already pointing where it should: a client never sees
        -- the moment where a duplicated button still names the original door.
        for Index, Create in Planned.Creates do
            if not Create.References then
                continue
            end

            const Obj = Created[Index]
            for PropertyId, Names in Create.References do
                const Prop = Obj.Properties[PropertyId]
                const Points = Created[Names]
                if not Prop or not Points then
                    continue
                end

                -- Through the same check a set makes, against the objects now
                -- that they are real. The plan compared what the packet said;
                -- this compares what was built, and a failure here throws into
                -- the rollback below rather than leaving half a wiring.
                const Target, Why = Objects.Reference(Obj.InstanceId, Prop, Points)
                if Target == nil then
                    error(`{Obj.Name}.{Prop.Name} cannot point at {Points.Name}: {Why}.`)
                end

                Prop:Set(Target)
            end
        end

        for _, Set in Planned.Sets do
            const Prop = Set.Property

            if not Captured[Prop] then
                Captured[Prop] = true
                Previous[Prop] = Prop.Value
                table.insert(Touched, Prop)
            end

            Before[Set.Index] = Previous[Prop]

            -- The property itself rather than the object's Set, which would
            -- fire a packet per operation. Links are property listeners, so
            -- they still run.
            const _, Changed = Prop:Set(Set.Value)
            if not Changed then
                continue
            end

            const Compressed = Compressor:CompressValue(Prop.Type, Prop.Value)
            if not Compressed then
                continue
            end

            const Entry = {
                Object = Set.Object,
                Property = Prop.Parent,
                Value = Compressed,
            }

            const Position = At[Prop]
            if Position then
                Changes[Position] = Entry
            else
                table.insert(Changes, Entry)
                At[Prop] = #Changes
            end
        end

        for _, Obj in Planned.Destroys do
            -- Suspended, not destroyed. What becomes of it is decided below,
            -- once it is known whether anything is keeping this transaction:
            -- a player's history keeps the objects its destroys took away, so
            -- that an undo restores them rather than replacing them.
            Objects.Suspend(Obj, false)
            table.insert(Removed, Obj)
        end

        -- Copies out after the objects, for the same reason destroys come after
        -- sets: an edit to something in a copy this transaction also withdraws
        -- should land before the copy goes.
        for _, Live in Planned.Unloads do
            if Live:Suspend() then
                table.insert(Withdrew, Live)
            end
        end

        -- And the holds let go last, which is the order the words are in: hold
        -- these, do this, let go.
        if #Planned.Unlocks > 0 then
            Objects:Unlock(Planned.Unlocks)
        end
    end)

    if not Ok then
        Logger:Warn(`A transaction failed partway through and was rolled back: {Err}`)

        -- None of this was announced, so undoing it needs no packet either.
        for _, Obj in Created do
            Objects.Drop(Obj)
        end

        for _, Prop in Touched do
            Prop:Set(Previous[Prop])
        end

        -- Including the destroys that had already run, which is new: a destroy
        -- withdraws an object rather than ending it, so the one operation that
        -- used to be beyond recall is recoverable too. They were never
        -- announced -- the removals go out in bulk below, and this path does
        -- not reach that -- so no client ever knew they had gone.
        for _, Obj in Removed do
            Objects.Revive(Obj, false)
        end

        -- Copies likewise, and the ones it loaded go again. A copy it made and
        -- is now taking back is not a withdrawal of anybody's work: nothing has
        -- had a chance to touch it, so it is unloaded outright.
        for _, Live in Withdrew do
            Live:Revive()
        end

        for _, Live in Loaded do
            Live:Unload()
        end

        if Held then
            Objects:Unlock(Planned.Locks)
        end

        return false, {}
    end

    if #Created > 0 then
        Objects.AnnounceAll(Created)
    end

    if #Changes > 0 then
        const Announce = {}
        for _, Change in Changes do
            -- A property changed on an object the same transaction went on to
            -- destroy is not worth a packet: its removal is already in the one
            -- below.
            if not Change.Object.Destroyed then
                table.insert(Announce, Change)
            end
        end

        Objects.AnnounceChanged(Announce)
    end

    if #Removed > 0 then
        Objects.AnnounceRemoved(Removed)
    end

    -- Offered whole, and only for a player's own tracked transactions: the
    -- server's belong to nobody and are nobody's to undo. A listener that
    -- answers true has taken the step, and with it every object suspended
    -- above -- they are its to revive on an undo and its to dispose of when the
    -- step falls off the stack.
    --
    -- Nothing answering means nothing is holding them, and a destroy that
    -- nobody can undo is a destroy: they end here, which is what they used to
    -- do the moment the loop above reached them.
    local Kept = false
    if Plr and Tracked ~= false then
        const Record: ApplyRecord = {
            Operations = Operations,
            Created = Created,
            Removed = Removed,
            Before = Before,
            Targets = Planned.Targets,
            Loaded = Loaded,
            Withdrew = Withdrew,
        }

        for _, Callback in Recorders do
            if Callback(Plr, Record) then
                Kept = true
                break
            end
        end
    end

    if not Kept then
        for _, Obj in Removed do
            Objects.Dispose(Obj)
        end

        for _, Live in Withdrew do
            Live:Dispose()
        end
    end

    const Identifiers = table.create(#Created)
    for Index, Obj in Created do
        Identifiers[Index] = Obj.RuntimeId
    end

    return true, Identifiers
end

-- The server's own half of Commit. It authored the list, so it applies straight
-- away: no packet, no permission pass, and the same batched broadcast a
-- client's transaction gets.
const New = Shared.factory(Objects, function(Transaction: Transaction)
    return Transactions.Apply(nil, Transaction.Operations)
end)

function Transactions.new(): Transaction
    return New()
end

Network.Apply.OnInvoke = function(Plr: Player, Compressed: buffer, Untracked: boolean): (boolean, {ObjectTypes.RuntimeId})
    -- Bytes a client authored: a malformed list is a dropped packet, not an
    -- error thrown out of the remote handler.
    const Ok, Operations = pcall(function()
        return Compressor:DecompressTransaction(Compressed)
    end)

    if not Ok or not Operations then
        return false, {}
    end

    return Transactions.Apply(Plr, Operations, not Untracked)
end

return Transactions
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX50">
					<Properties>
						<string name="Name">Shared</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Building a transaction, shared by the server and the client.
--
-- Only committing differs between the two: the client's sends a packet and
-- waits, the server's applies on the spot. Everything before that -- resolving
-- what the caller named, refusing what cannot be built -- is the same work
-- against the same registries, so it is written once and handed the side's own
-- Objects module.
--
-- An operation that cannot be built is not silently dropped. It counts against
-- the transaction and Commit refuses while that count is above zero: applying
-- four of the five things the caller asked for is the one behaviour a
-- transaction must not have, and it is far worse than refusing all five,
-- because nothing downstream can tell it happened.

const PropertyTypes = require("../Properties/Types")
const ObjectTypes = require("../Objects/Types")
const ObjectShared = require("../Objects/Shared")
const Compressor = require("../Compressor")
const Logger = require("../Logger")
const Types = require("./Types")

export type Transaction = Types.Transaction
export type Operation = Types.Operation

const Shared = {}

const function Reject(Transaction: Transaction, Message: string)
    Transaction.Rejected += 1
    Logger:Warn(`{Message} The transaction will refuse to commit.`)
end

-- The side's Objects module, which is the one thing that differs and cannot be
-- named here: requiring either half would put this module on one side of the
-- wire. Both expose Get and GetRegistry with the same shape, which is all this
-- asks of it.
--
-- Built once per side rather than per transaction, so a transaction stays a
-- plain table with shared function fields, like an object.
function Shared.factory(
    Objects: any,
    Commit: (Transaction) -> (boolean, {ObjectTypes.RuntimeId})
): () -> Transaction
    const function Resolve(Target: Types.ObjectReference): ObjectTypes.Object?
        if type(Target) == "number" then
            return Objects:Get(Target)
        end

        if type(Target) == "table" and (Target :: any).RuntimeId then
            -- Looked up rather than trusted. A stale reference to an object
            -- destroyed since is still a table with a runtime id on it, and an
            -- operation naming one would be refused by the server anyway.
            return Objects:Get((Target :: any).RuntimeId)
        end

        return nil
    end

    -- Which side a transaction belongs to, decided by the first thing it
    -- touches and held to for the rest of it.
    --
    -- A transaction is all of one or all of the other. Half of a mixed one
    -- would need a round trip that can come back refused, and by the time it
    -- did the local half would already have applied -- there is no atomicity to
    -- be had across that line, and a transaction that is not atomic is not a
    -- transaction. So the second kind to arrive is refused, by name, rather
    -- than quietly splitting the edit in two.
    const function Claim(self: Transaction, Local: boolean, What: string): boolean
        if self.Local == nil then
            self.Local = Local
            return true
        end

        if self.Local == Local then
            return true
        end

        Reject(self, `{What} belongs to {if Local then "a scene this client owns" else "the server"}, and this transaction is already about {if Local then "the server" else "a scene this client owns"}.`)
        return false
    end

    const function __create(
        self: Transaction,
        Reference: Types.TypeReference,
        Values: {[PropertyTypes.PropertyIdentifier]: any}?,
        Live: ObjectTypes.SceneInstanceId?
    ): Transaction
        const Identifier = if type(Reference) == "table"
            then (Reference :: ObjectTypes.ObjectRegistry).Id
            else Reference

        const Registry = if type(Identifier) == "number" then Objects:GetRegistry(Identifier) else nil
        if not Registry or type(Identifier) ~= "number" then
            Reject(self, `Cannot create {tostring(Identifier)}: no object type is registered here with that id.`)
            return self
        end

        -- Zero is the implicit default scene, which is the server's.
        if not Claim(self, Live ~= nil and Objects:IsLocalCopy(Live), Registry.Name) then
            return self
        end

        -- Only what the type actually carries. Objects.new ignores a value for
        -- a property the object does not have, and a transaction that carried
        -- one would spend bytes on the wire to have it ignored at the far end.
        const Carried = {}
        for _, PropertyId in Registry.Properties do
            Carried[PropertyId] = true
        end

        const Initial = {}
        if Values then
            for PropertyId, Value in Values do
                if not Carried[PropertyId] then
                    Logger:Warn(`{Registry.Name} does not carry property {PropertyId}, so that initial value was dropped.`)
                    continue
                end

                Initial[PropertyId] = Value
            end
        end

        table.insert(self.Operations, {
            Kind = "Create" :: "Create",
            Object = Identifier,
            Instance = Live or 0,
            Properties = Initial,
        })

        return self
    end

    -- A create of the object's type holding the object's values, read now --
    -- when the builder is called, not when the transaction lands -- into the
    -- copy the original sits in unless another is named. Checked on the far
    -- end exactly as a create is, rights included.
    const function __duplicate(
        self: Transaction,
        Target: Types.ObjectReference,
        Live: ObjectTypes.SceneInstanceId?
    ): Transaction
        const Obj = Resolve(Target)
        if not Obj or Obj.Destroyed then
            Reject(self, "Cannot duplicate an object that is not here.")
            return self
        end

        return __create(self, Obj.Registry, ObjectShared.Snapshot(Obj), Live or Obj.InstanceId)
    end

    -- Several objects duplicated as one thing. Each is a create, exactly as a
    -- single duplicate is, so the same rights are asked for -- and then the
    -- references between them are rewritten to name the creates rather than the
    -- originals, because the ids of the new objects do not exist yet on this
    -- side and will not until the far end has minted them.
    --
    -- A reference that points outside the group keeps its id: duplicating a
    -- lever without the door it works should leave it working that same door.
    const function __duplicate_group(
        self: Transaction,
        Targets: {Types.ObjectReference},
        Live: ObjectTypes.SceneInstanceId?
    ): Transaction
        const Sources: {ObjectTypes.Object} = {}

        for _, Target in Targets do
            const Obj = Resolve(Target)
            if not Obj or Obj.Destroyed then
                Reject(self, "Cannot duplicate an object that is not here.")
                continue
            end

            table.insert(Sources, Obj)
        end

        -- Which operation makes the duplicate of each original. Read back from
        -- the list rather than counted, because a create the builder refused
        -- adds nothing to it and every index after would be wrong.
        const MadeBy: {[ObjectTypes.Object]: number} = {}

        for _, Obj in Sources do
            const Before = #self.Operations
            __create(self, Obj.Registry, ObjectShared.Snapshot(Obj), Live or Obj.InstanceId)

            if #self.Operations > Before then
                MadeBy[Obj] = #self.Operations
            end
        end

        for Source, Index in MadeBy do
            const Operation = self.Operations[Index] :: Types.CreateOperation

            for PropertyId, Value in Operation.Properties do
                const Prop = Source:GetProperty(PropertyId)
                if not Prop or Prop.Type ~= "Object" then
                    continue
                end

                -- Read against the original's copy, which is where the id it
                -- holds means what it was written to mean.
                const Pointed = Objects:Resolve(Source.InstanceId, Value)
                if not Pointed then
                    continue
                end

                const Instead = MadeBy[Pointed]
                if not Instead then
                    continue
                end

                if not Operation.References then
                    Operation.References = {}
                end

                (Operation.References :: any)[PropertyId] = Instead

                -- And not as a value as well. The id is the original target's,
                -- so sending it would put the wrong object in the property for
                -- as long as it took the fixup to overwrite it, and would cost
                -- the bytes to say something already being said.
                Operation.Properties[PropertyId] = nil
            end
        end

        return self
    end

    -- A pack placed into a copy the server owns, as a list of creates: one per
    -- object in it, each asking for exactly what a create asks for, so placing a
    -- prefab is checked against create rights rather than needing a right of its
    -- own. One transaction, so it lands whole or not at all and undoes as one
    -- step.
    --
    -- The references are why this is not a loop over Create. A saved reference
    -- holds a local id from the scene the pack was written in, and the ids these
    -- objects will answer to are minted at the far end, after the packet is
    -- written -- so each one names the operation that makes its target instead,
    -- and the far end fills in the id once the creates have run. A reference to
    -- something the pack did not carry is dropped: the id would mean nothing
    -- there, or worse, would mean something.
    const function __place(
        self: Transaction,
        Pack: buffer,
        Live: ObjectTypes.SceneInstanceId?
    ): Transaction
        const Ok, _, Decompressed = pcall(function()
            return Compressor:DecompressScene(Pack)
        end)

        if not Ok or not Decompressed then
            Reject(self, "Cannot place a pack that could not be read.")
            return self
        end

        -- Which operation makes each object, by the id the pack knew it as.
        const Placed: {[number]: number} = {}
        const Pending: {{Index: number, References: {[number]: any}}} = {}

        for _, Saved in Decompressed :: {any} do
            const Values, References = ObjectShared.SplitReferences(Saved.Properties)

            const Before = #self.Operations
            __create(self, Saved.Registry, Values, Live)

            -- Rejected, and the transaction will refuse to commit; there is
            -- nothing to record an operation index against.
            if #self.Operations == Before then
                continue
            end

            Placed[Saved.LocalId] = #self.Operations
            if References then
                table.insert(Pending, {Index = #self.Operations, References = References})
            end
        end

        for _, Entry in Pending do
            const Operation = self.Operations[Entry.Index] :: Types.CreateOperation

            for PropertyId, Saved in Entry.References do
                const Names = Placed[Saved]
                if not Names then
                    continue
                end

                if not Operation.References then
                    Operation.References = {}
                end

                (Operation.References :: any)[PropertyId] = Names
            end
        end

        return self
    end

    const function __set(
        self: Transaction,
        Target: Types.ObjectReference,
        Property: ObjectTypes.PropertyReference,
        Value: any
    ): Transaction
        const Obj = Resolve(Target)
        if not Obj or Obj.Destroyed then
            Reject(self, "Cannot set a property on an object that is not here.")
            return self
        end

        if not Claim(self, Obj.Local == true, Obj.Name) then
            return self
        end

        const Prop = Obj:GetProperty(Property)
        if not Prop then
            Reject(self, `{Obj.Name} has no property {Property}.`)
            return self
        end

        -- A reference is stored as the target's local id, and a caller holding
        -- the target holds the object. Resolved here so Set takes the same
        -- thing Object:Set takes, and so pointing at an object in another copy
        -- is refused where the objects are still both in hand to be named.
        local Held = Value
        if Prop.Type == "Object" then
            const Target, Why = Objects.Reference(Obj.InstanceId, Prop, Value)
            if Target == nil then
                Reject(self, `{Obj.Name}.{Prop.Name} cannot point there: {Why}.`)
                return self
            end

            Held = Target
        end

        -- Checked here as well as at the far end, and not because the far end
        -- might not: a value the receiver will refuse costs a round trip and
        -- comes back as a bare false, while this names the property and the
        -- value that could not be held.
        if not PropertyTypes:IsValid(Prop.Type, Held, Prop.Constraints) then
            Reject(self, `{Prop.Name} cannot hold {tostring(Value)}.`)
            return self
        end

        table.insert(self.Operations, {
            Kind = "Set" :: "Set",
            Target = Obj.RuntimeId,
            Property = Prop.Parent,
            Value = Held,
            Type = Prop.Type,
        })

        return self
    end

    const function __destroy(self: Transaction, Target: Types.ObjectReference): Transaction
        const Obj = Resolve(Target)
        if not Obj or Obj.Destroyed then
            Reject(self, "Cannot destroy an object that is not here.")
            return self
        end

        if not Claim(self, Obj.Local == true, Obj.Name) then
            return self
        end

        table.insert(self.Operations, {
            Kind = "Destroy" :: "Destroy",
            Target = Obj.RuntimeId,
        })

        return self
    end

    -- Taking and releasing a hold, in the list with the edit that needs it.
    -- One object or several, and several is the point: a lock is all or none,
    -- so naming three of them in one transaction is the only way to be sure of
    -- getting all three before anything moves.
    --
    -- Refused for objects in scenes this client owns. Nothing there is anybody
    -- else's to touch, so there is no hold to take -- and a transaction that
    -- carried one would be asking the server about an object it has never
    -- heard of.
    const function Holding(
        self: Transaction,
        Targets: Types.ObjectReference | {Types.ObjectReference},
        Kind: "Lock" | "Unlock"
    ): Transaction
        const List = if type(Targets) == "table" and (Targets :: any).RuntimeId == nil
            then Targets :: {Types.ObjectReference}
            else {Targets :: Types.ObjectReference}

        for _, Target in List do
            const Obj = Resolve(Target)
            if not Obj or Obj.Destroyed then
                Reject(self, `Cannot {string.lower(Kind)} an object that is not here.`)
                continue
            end

            if Obj.Local then
                Reject(self, `{Obj.Name} belongs to a scene this client owns, which nobody else can touch and nothing can hold.`)
                continue
            end

            if not Claim(self, false, Obj.Name) then
                return self
            end

            table.insert(self.Operations, {
                Kind = Kind :: any,
                Target = Obj.RuntimeId,
            })
        end

        return self
    end

    const function __lock(self: Transaction, Targets: any): Transaction
        return Holding(self, Targets, "Lock")
    end

    const function __unlock(self: Transaction, Targets: any): Transaction
        return Holding(self, Targets, "Unlock")
    end

    -- A copy of a scene into the world. The scene is named, not the copy: the
    -- copy does not exist yet, and which one it turns out to be is the far
    -- end's to decide -- it arrives through the packet announcing it, the way
    -- a created object does.
    const function __load(self: Transaction, Scene: ObjectTypes.SceneIdentifier): Transaction
        if type(Scene) ~= "number" then
            Reject(self, `Cannot load {tostring(Scene)}: a scene is named by its id.`)
            return self
        end

        if not Claim(self, Objects:IsLocalScene(Scene), `scene {Scene}`) then
            return self
        end

        table.insert(self.Operations, {
            Kind = "Load" :: "Load",
            Scene = Scene,
        })

        return self
    end

    -- A live copy out of the world. Withdrawn rather than unloaded, so an undo
    -- brings back what was in it rather than what its scene last saved.
    const function __unload(self: Transaction, Instance_: ObjectTypes.SceneInstanceId): Transaction
        if type(Instance_) ~= "number" then
            Reject(self, `Cannot unload {tostring(Instance_)}: a copy is named by its id.`)
            return self
        end

        if not Claim(self, Objects:IsLocalCopy(Instance_), `copy {Instance_}`) then
            return self
        end

        table.insert(self.Operations, {
            Kind = "Unload" :: "Unload",
            Instance = Instance_,
        })

        return self
    end

    const function __commit(self: Transaction): (boolean, {ObjectTypes.RuntimeId})
        if self.Rejected > 0 then
            Logger:Warn(`Refusing to commit a transaction: {self.Rejected} of its operations could not be built.`)
            return false, {}
        end

        -- Nothing to do is not a failure, and it is not a packet either.
        if #self.Operations == 0 then
            return true, {}
        end

        return Commit(self)
    end

    return function(): Transaction
        const Transaction = {}
        Transaction.Operations = {}
        Transaction.Rejected = 0
        Transaction.Local = nil

        Transaction.Create = __create
        Transaction.Duplicate = __duplicate
        Transaction.DuplicateGroup = __duplicate_group
        Transaction.Place = __place
        Transaction.Lock = __lock
        Transaction.Unlock = __unlock
        Transaction.Load = __load
        Transaction.Unload = __unload
        Transaction.Set = __set
        Transaction.Destroy = __destroy
        Transaction.Commit = __commit

        return Transaction :: any
    end
end

return Shared
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX51">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- A transaction is a list of operations applied as a unit: one packet, one
-- permission pass, one entry in whatever history an editor keeps.
--
-- The unit matters more than the batching. A multi object edit sent as separate
-- packets is a sequence a client can be interrupted halfway through -- by a
-- refusal, by a disconnect, by another player's edit landing between two of its
-- own -- and there is no point at which the world holds either all of it or
-- none of it. Undo has the same problem from the other side: a history made of
-- individual sets cannot record "this was one action" without guessing.
--
-- Operations name their targets by runtime id, never by persistent id. A
-- persistent id names an object in every live copy of its scene at once, and a
-- transaction that names its target ambiguously is a transaction that edits the
-- wrong room.

const PropertyTypes = require("../Properties/Types")
const ObjectTypes = require("../Objects/Types")

-- What the wire calls each kind. The decoded form carries the name instead, so
-- reading an operation does not mean remembering that 2 means Set.
const Kinds = {
    Create = 1,
    Set = 2,
    Destroy = 3,
    Lock = 4,
    Unlock = 5,
    Load = 6,
    Unload = 7,
}

export type CreateOperation = {
    Kind: "Create",
    Object: ObjectTypes.ObjectIdentifier,

    -- Which live copy of a scene the object lands in. Zero means the one
    -- Objects.new would have picked on its own, which is the implicit default
    -- scene -- a copy has to be named explicitly because a scene loaded twice
    -- has two equally good ones.
    Instance: ObjectTypes.SceneInstanceId,

    -- Keyed by property id, like Objects.new takes them. A value for a property
    -- the object type does not carry is dropped rather than refused, matching
    -- what restoring a saved object does with one.
    Properties: {[PropertyTypes.PropertyIdentifier]: any},

    -- Object properties whose target is made by this same transaction, as the
    -- index of the create operation that makes it. They cannot be ordinary
    -- values: a reference stores the target's local id, and the id an object
    -- created here will answer to is minted by the copy at the far end -- after
    -- the packet was written. So the author names the operation instead and the
    -- receiver fills the id in once every create has run.
    --
    -- This is what lets a group of objects be duplicated together with the
    -- references between them following the copies, and it is also the only way
    -- to create two objects and wire them to each other in one transaction.
    References: {[PropertyTypes.PropertyIdentifier]: number}?,
}

export type SetOperation = {
    Kind: "Set",
    Target: ObjectTypes.RuntimeId,
    Property: PropertyTypes.PropertyIdentifier,
    Value: any,

    -- The semantic type the author wrote the value as, read back off the value's
    -- own tag rather than trusted from the registry. The receiver compares it
    -- against the property it is being set on, which is what stops a client
    -- sending a CFrame to a Number and having it applied.
    --
    -- Nil where this build has no name for the type the author used, which is
    -- itself a mismatch and refused as one.
    Type: PropertyTypes.PropertyType?,
}

export type DestroyOperation = {
    Kind: "Destroy",
    Target: ObjectTypes.RuntimeId,
}

-- Taking and releasing a hold on one object. In the list rather than on a
-- channel of their own so that claiming what an edit needs and making the edit
-- are one thing: locking three objects and moving them used to be two round
-- trips, with the lock able to come back refused after the edit was built.
--
-- Locks are taken before anything else in the transaction and released after,
-- which is the order the words are in: hold these, do this, let go.
export type LockOperation = {
    Kind: "Lock",
    Target: ObjectTypes.RuntimeId,
}

export type UnlockOperation = {
    Kind: "Unlock",
    Target: ObjectTypes.RuntimeId,
}

-- A copy of a scene appearing and going. Load names the scene to read, Unload
-- the live copy to withdraw -- and withdraw is the word: a copy a player asked
-- to go is set aside whole rather than unloaded, because loading it again would
-- read what the scene last committed rather than what was on screen.
--
-- The copy that a load makes is not in what Commit hands back. It arrives the
-- way created objects do, through the packet that announces it, which is what
-- Scenes:OnCopyAdded is for.
export type LoadOperation = {
    Kind: "Load",
    Scene: ObjectTypes.SceneIdentifier,
}

export type UnloadOperation = {
    Kind: "Unload",
    Instance: ObjectTypes.SceneInstanceId,
}

export type Operation =
    CreateOperation
    | SetOperation
    | DestroyOperation
    | LockOperation
    | UnlockOperation
    | LoadOperation
    | UnloadOperation

export type ObjectReference = ObjectTypes.Object | ObjectTypes.RuntimeId
export type TypeReference = ObjectTypes.ObjectRegistry | ObjectTypes.ObjectIdentifier

export type Transaction = {
    Operations: {Operation},

    -- Operations that could not be built at all -- an unknown property, a
    -- target that is not an object. Commit refuses while this is above zero
    -- rather than sending what is left: applying four of the five things the
    -- caller asked for is the one behaviour a transaction must not have.
    Rejected: number,

    -- Which side this transaction is about, decided by the first object or copy
    -- it touches: true for scenes the client owns, false for the server's, nil
    -- while it is still empty. Committing reads it to know whether that means
    -- sending a packet or doing the work here.
    --
    -- One or the other, never both. A mixed transaction would have to send half
    -- of itself and wait, with the other half already applied if the answer came
    -- back no, and a transaction that cannot be atomic is not one.
    Local: boolean?,

    -- Set by whoever commits it to keep it out of the author's undo history.
    -- It rides to the server, because for a scene the server owns that is where
    -- the history lives. Not a permission: an untracked edit is checked and
    -- charged exactly like any other.
    Untracked: boolean?,

    -- Every builder call returns the transaction, so a whole edit reads as one
    -- expression.
    Create: (
        self: Transaction,
        Reference: TypeReference,
        Values: {[PropertyTypes.PropertyIdentifier]: any}?,
        Instance: ObjectTypes.SceneInstanceId?
    ) -> Transaction,

    Set: (
        self: Transaction,
        Target: ObjectReference,
        Property: ObjectTypes.PropertyReference,
        Value: any
    ) -> Transaction,

    Destroy: (self: Transaction, Target: ObjectReference) -> Transaction,

    -- A Create of the target's type holding the target's values as they are
    -- when this is called, in the target's own copy unless another is named.
    Duplicate: (
        self: Transaction,
        Target: ObjectReference,
        Instance: ObjectTypes.SceneInstanceId?
    ) -> Transaction,

    -- The same, for several objects duplicated as one thing: references that
    -- point at another member of the group follow the copies, and references
    -- that point outside it are kept as they are. Duplicating the same objects
    -- one call at a time does not do this -- nothing there knows the calls
    -- belong together.
    DuplicateGroup: (
        self: Transaction,
        Targets: {ObjectReference},
        Instance: ObjectTypes.SceneInstanceId?
    ) -> Transaction,

    -- A saved pack placed into a live copy: one create per object in it, with
    -- the references inside the pack rewritten to name those creates. Checked
    -- as creates are, so placing a prefab needs create rights and nothing more,
    -- and undone as one step because it is one transaction.
    Place: (
        self: Transaction,
        Pack: buffer,
        Instance: ObjectTypes.SceneInstanceId?
    ) -> Transaction,

    -- Whether the whole list applied, and the runtime ids of what it created, in
    -- the order the creates were declared. On the client this yields until the
    -- server has answered: a created object has no local identity to hand back
    -- before the server has minted one.
    -- One object or a list, all or none, like Objects:Lock. Refused for objects
    -- in scenes the client owns, which are never locked -- nobody else can
    -- touch them.
    Lock: (self: Transaction, Targets: ObjectReference | {ObjectReference}) -> Transaction,
    Unlock: (self: Transaction, Targets: ObjectReference | {ObjectReference}) -> Transaction,

    -- A copy of a scene into the world, and a live copy out of it. Loading
    -- needs create rights on that scene and unloading needs destroy rights,
    -- because that is what they amount to: every object in it made, or every
    -- object in it taken away.
    Load: (self: Transaction, Scene: ObjectTypes.SceneIdentifier) -> Transaction,
    Unload: (self: Transaction, Instance: ObjectTypes.SceneInstanceId) -> Transaction,

    Commit: (self: Transaction) -> (boolean, {ObjectTypes.RuntimeId}),
}

-- A committed transaction as the client saw it go: what it created, the value
-- each set overwrote and what each destroy took away, by operation index. Read
-- before the packet went, because after the answer the old values are gone.
export type CommitRecord = {
    Transaction: Transaction,
    Created: {ObjectTypes.RuntimeId},
    Before: {[number]: any},
    Removed: {[number]: {
        Registry: ObjectTypes.ObjectIdentifier,
        Values: {[PropertyTypes.PropertyIdentifier]: any},
        Instance: ObjectTypes.SceneInstanceId,
    }},
}

return {
    Kinds = Kinds,
}
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX52">
				<Properties>
					<string name="Name">Try</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Retry with exponential backoff. Errors are swallowed by design: callers branch
-- on the boolean, they do not handle the failure.
return function<A..., B...>(Attempts: number, fn: (A...) -> B..., ...: A...): (boolean, B...)
    local Result = table.pack(false)
    local Delay = 0.125
    const Total = math.max(1, Attempts)

    for Attempt = 1, Total do
        -- No `:: any` here. A type assertion on a call truncates it to one
        -- value exactly as parentheses would, so `table.pack(pcall(fn, ...) ::
        -- any)` packed pcall's boolean alone and threw away everything the
        -- wrapped call returned -- every `const Success, Stored = Try(...)` got
        -- nil for Stored. It was not buying anything either: the one diagnostic
        -- this file has is the same with it and without it.
        Result = table.pack(pcall(fn, ...))
        if Result[1] then
            break
        end

        -- The old loop waited after the final attempt too, so a run that was
        -- always going to fail still slept for the last (and longest) backoff.
        if Attempt < Total then
            task.wait(Delay)
            Delay *= 2
        end
    end

    -- table.pack/unpack rather than {pcall(...)} plus unpack, which drops
    -- trailing nils when the wrapped call returns them.
    return table.unpack(Result, 1, Result.n)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX53">
				<Properties>
					<string name="Name">Varint</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- LEB128 variable length integers.
--
-- Ids, lengths and counts are overwhelmingly small, and paying a fixed u16 or
-- u32 for every one of them is most of the overhead in a record. A varint costs
-- one byte below 128, two below 16384, and grows only as the value does.
--
-- Everything here is bounded by 2^53, the largest integer a Lua number holds
-- exactly. Past that a double starts skipping values, so a wider encoding would
-- store bytes that cannot be read back into a usable number.

const Logger = require("./Logger")

const Varint = {}

const MAX_BYTES = 8
const MAX_SAFE = 9007199254740991 -- 2^53 - 1

-- Zigzag doubles the magnitude to make room for the sign bit, so signed values
-- are bounded by half the unsigned range.
const MAX_SIGNED = 4503599627370495 -- 2^52 - 1

Varint.MAX_SAFE = MAX_SAFE
Varint.MAX_SIGNED = MAX_SIGNED

-- Validated on the same terms as Write. Without this a negative measured as one
-- byte and only blew up later, inside Write, after the buffer had been sized.
function Varint.Measure(Value: number): number
    if Value < 0 or Value > MAX_SAFE or Value % 1 ~= 0 then
        Logger:Error(`Varint expects a whole number between 0 and {MAX_SAFE}, got {Value}.`)
    end

    local Remaining = Value
    local Count = 1

    while Remaining >= 128 do
        Remaining = math.floor(Remaining / 128)
        Count += 1
    end

    return Count
end

function Varint.Write(Buf: buffer, Offset: number, Value: number): number
    if Value < 0 or Value > MAX_SAFE or Value % 1 ~= 0 then
        Logger:Error(`Varint expects a whole number between 0 and {MAX_SAFE}, got {Value}.`)
    end

    local Remaining = Value
    local Written = 0

    while Remaining >= 128 do
        buffer.writeu8(Buf, Offset + Written, (Remaining % 128) + 128)
        Remaining = math.floor(Remaining / 128)
        Written += 1
    end

    buffer.writeu8(Buf, Offset + Written, Remaining)
    return Written + 1
end

function Varint.Read(Buf: buffer, Offset: number): (number, number)
    local Value = 0
    local Scale = 1
    local Read = 0

    while true do
        const Byte = buffer.readu8(Buf, Offset + Read)
        Read += 1

        Value += (Byte % 128) * Scale
        if Byte < 128 then
            break
        end

        Scale *= 128
        if Read >= MAX_BYTES then
            Logger:Error(`Malformed varint at offset {Offset}: no terminator within {MAX_BYTES} bytes.`)
        end
    end

    return Value, Read
end

-- Maps signed to unsigned so that small negatives stay small: 0, -1, 1, -2, 2
-- become 0, 1, 2, 3, 4. Without this, -1 would encode as the maximum value and
-- cost the full eight bytes.
function Varint.Zigzag(Value: number): number
    return if Value < 0 then -2 * Value - 1 else 2 * Value
end

function Varint.Unzigzag(Value: number): number
    return if Value % 2 == 1 then -(Value + 1) / 2 else Value / 2
end

function Varint.MeasureSigned(Value: number): number
    return Varint.Measure(Varint.Zigzag(Value))
end

function Varint.WriteSigned(Buf: buffer, Offset: number, Value: number): number
    if Value < -MAX_SIGNED - 1 or Value > MAX_SIGNED then
        Logger:Error(`Signed varint expects a value within +/-{MAX_SIGNED}, got {Value}.`)
    end

    return Varint.Write(Buf, Offset, Varint.Zigzag(Value))
end

function Varint.ReadSigned(Buf: buffer, Offset: number): (number, number)
    const Value, Read = Varint.Read(Buf, Offset)
    return Varint.Unzigzag(Value), Read
end

return Varint
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX54">
				<Properties>
					<string name="Name">World</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The tree Prism owns in the workspace.
--
-- An object's instance used to be parented wherever a Container field named:
-- one on the object registry, one on the scene, one on the copy, resolved in
-- that order. Three places to set it, three chances for them to disagree, and
-- nothing in the explorer to say which room a part belonged to. There is one
-- place instead, and the framework owns it:
--
--     workspace.__prism.__scene_{SceneId}.__copy_{CopyId}
--
-- Keyed by the copy rather than by the scene, because a scene loaded five times
-- is five copies and they cannot share a folder -- the same reason objects are
-- filed by copy everywhere else.
--
-- That tree is only where a copy goes when nobody says otherwise. Load takes a
-- parent, and a copy's folder is parented wherever it is handed -- PlayerGui
-- for a scene made of interfaces, a Model of your own if you want to pivot it,
-- Lighting for a scene of atmospheres. A Folder can be parented anywhere, which
-- is the whole reason it is a Folder: the framework has no business knowing
-- what class your objects are or where that class belongs.

const RunService = game:GetService("RunService")
const Logger = require("./Logger")

const IS_SERVER = RunService:IsServer()
const ROOT_NAME = "__prism"
const WAIT_TIMEOUT = 10

const World = {}

World.RootName = ROOT_NAME

local Root: Instance? = nil

-- Scene folders this side built, by scene. Kept by reference rather than found
-- by name: a client builds folders of its own for the copies it draws, and the
-- server may have replicated one by the same name for its own copies of that
-- scene. Found by name, a client could file its drawing into the server's
-- folder -- and then, emptying it, destroy the server's folder on its own side.
const Built: {[number]: Instance} = {}

const function SceneName(Scene: number): string
    return `__scene_{Scene}`
end

const function CopyName(Copy: number): string
    return `__copy_{Copy}`
end

-- The server builds the root and it replicates from there. A client waits for
-- it rather than building one of its own: two folders named __prism under the
-- workspace would make every lookup here ambiguous, and which one a client got
-- would depend on replication timing.
--
-- Resolved on first use rather than at require, so a client that never draws
-- anything never waits for it.
const function GetRoot(): Instance
    const Current = Root
    if Current and Current.Parent then
        return Current
    end

    if IS_SERVER then
        local Found = workspace:FindFirstChild(ROOT_NAME)
        if not Found then
            const Folder = Instance.new("Folder")
            Folder.Name = ROOT_NAME
            Folder.Parent = workspace
            Found = Folder
        end

        Root = Found
        return Found
    end

    const Found = workspace:WaitForChild(ROOT_NAME, WAIT_TIMEOUT)
    if not Found then
        Logger:Error(`Waited {WAIT_TIMEOUT}s for workspace.{ROOT_NAME}, which the server creates. Is Prism required on the server?`)
    end

    Root = Found
    return Found
end

World.GetRoot = GetRoot

-- Built as the server starts rather than on first use, so it is there to
-- replicate before any client goes looking. A server whose copies are all
-- opened rather than loaded never parents anything here itself, and its
-- clients -- who draw those copies -- would otherwise wait for a root that
-- nothing was ever going to make.
if IS_SERVER then
    GetRoot()
end

-- Where a copy goes when its loader named no parent of its own. Built on the
-- way down, and shared by every copy of that scene that also named none.
const function DefaultParent(Scene: number): Instance
    const Existing = Built[Scene]
    if Existing and Existing.Parent then
        return Existing
    end

    const Folder = Instance.new("Folder")
    Folder.Name = SceneName(Scene)
    Folder.Parent = GetRoot()
    Built[Scene] = Folder
    return Folder
end

-- The folder a copy's objects are parented into. Named for the copy rather than
-- the scene, because a scene loaded five times is five copies and they cannot
-- share one -- the same reason objects are filed by copy everywhere else.
--
-- Never yields. A client whose root has not replicated yet gets its folder back
-- unparented and parented once the root arrives: the caller is often a network
-- handler, and a handler that waited here would let the next packet -- the
-- copy's objects -- be handled before the copy it belongs to was set up. What
-- is drawn into the folder meanwhile appears with it. A folder the caller has
-- placed somewhere of its own by then is left where it was put.
-- Puts a copy's folder where it belongs, which is wherever the caller said or
-- the scene's own place in the tree. Separate from making one because a copy
-- withdrawn from the world keeps its folder and needs putting back: what comes
-- back has to be the folder that left, with whatever the game had parented to
-- it, and a fresh one would not be.
function World.Place(Folder: Folder, Scene: number, Parent: Instance?)
    if Parent and Parent.Parent ~= nil then
        Folder.Parent = Parent
        return
    end

    -- The parent it was under has been destroyed since, or there never was one.
    -- Either way the scene's own place in the tree is the answer.
    if IS_SERVER or (Root and Root.Parent) or workspace:FindFirstChild(ROOT_NAME) then
        Folder.Parent = DefaultParent(Scene)
        return
    end

    task.spawn(function()
        const Resolved = DefaultParent(Scene)
        if Folder.Parent == nil then
            pcall(function()
                Folder.Parent = Resolved
            end)
        end
    end)
end

function World.Copy(Scene: number, Copy: number, Parent: Instance?): Folder
    const Folder = Instance.new("Folder")
    Folder.Name = CopyName(Copy)

    if Parent then
        Folder.Parent = Parent
    elseif IS_SERVER or (Root and Root.Parent) or workspace:FindFirstChild(ROOT_NAME) then
        Folder.Parent = DefaultParent(Scene)
    else
        task.spawn(function()
            const Resolved = DefaultParent(Scene)
            if Folder.Parent == nil then
                pcall(function()
                    Folder.Parent = Resolved
                end)
            end
        end)
    end

    return Folder
end

-- Takes the copy's folder and everything parented to it. A default scene folder
-- goes with the last of its copies, so an unloaded scene leaves nothing behind;
-- a parent the caller supplied is the caller's and is left alone.
function World.DropCopy(Scene: number, Folder: Instance?)
    if Folder then
        Folder:Destroy()
    end

    const SceneFolder = Built[Scene]
    if SceneFolder and #SceneFolder:GetChildren() == 0 then
        SceneFolder:Destroy()
        Built[Scene] = nil
    end
end

return World
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX55">
			<Properties>
				<string name="Name">Harness</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Minimal test harness. No dependencies or runner to install: require it,
-- declare groups and tests, call Report at the end.

const Harness = {}
Harness.__index = Harness

export type Suite = {
    Passed: number,
    Failed: number,
    Skipped: number,
    Group: string,
    Current: string,
    Errors: {string},
    Failures: {string},
    Skips: {string},
    SkipReason: string?,

    Describe: (self: Suite, Name: string) -> (),
    Test: (self: Suite, Name: string, Fn: () -> ()) -> (),
    Fail: (self: Suite, Message: string) -> (),
    Skip: (self: Suite, Reason: string) -> (),
    Eq: (self: Suite, Actual: any, Expected: any, What: string?) -> (),
    Ok: (self: Suite, Value: any, What: string?) -> (),
    Throws: (self: Suite, Fn: () -> (), What: string?) -> (),
    Eventually: (self: Suite, Check: () -> any, Timeout: number?, What: string?, Interval: number?) -> any,
    Report: (self: Suite) -> boolean,
}

const function Show(Value: any): string
    if typeof(Value) == "buffer" then
        return `buffer({buffer.len(Value)})`
    end

    return tostring(Value)
end

function Harness:Describe(Name: string)
    self.Group = Name
    print(`\n-- {Name}`)
end

function Harness:Test(Name: string, Fn: () -> ())
    self.Current = Name
    self.Errors = {}
    self.SkipReason = nil

    const Ok, Err = pcall(Fn)
    if not Ok then
        table.insert(self.Errors, `threw: {Err}`)
    end

    -- A test that recorded a failure and then skipped is still a failure. The
    -- skip used to be checked first and hid the error.
    if self.SkipReason and #self.Errors == 0 then
        self.Skipped += 1
        const Message = `[{self.Group}] {Name}: {self.SkipReason}`
        table.insert(self.Skips, Message)
        print(`  SKIP  {Name} ({self.SkipReason})`)
        return
    end

    if #self.Errors == 0 then
        self.Passed += 1
        print(`  PASS  {Name}`)
        return
    end

    self.Failed += 1
    print(`  FAIL  {Name}`)
    for _, Message in self.Errors do
        print(`          {Message}`)
        table.insert(self.Failures, `[{self.Group}] {Name}: {Message}`)
    end
end

function Harness:Fail(Message: string)
    table.insert(self.Errors, Message)
end

function Harness:Skip(Reason: string)
    self.SkipReason = Reason
end

function Harness:Eq(Actual: any, Expected: any, What: string?)
    if Actual ~= Expected then
        self:Fail(`{What or "value"}: expected {Show(Expected)}, got {Show(Actual)}`)
    end
end

function Harness:Ok(Value: any, What: string?)
    if not Value then
        self:Fail(`{What or "value"}: expected truthy, got {Show(Value)}`)
    end
end

function Harness:Throws(Fn: () -> (), What: string?)
    if (pcall(Fn)) then
        self:Fail(`{What or "call"}: expected an error, none raised`)
    end
end

function Harness:Eventually(Check: () -> any, Timeout: number?, What: string?, Interval: number?): any
    const Deadline = os.clock() + (Timeout or 5)
    local Last = "false"

    repeat
        const Ok, Result = pcall(Check)
        if Ok and Result then
            return Result
        end

        Last = if Ok then Show(Result) else `error: {Result}`
        task.wait(Interval or 0.05)
    until os.clock() >= Deadline

    self:Fail(`{What or "condition"}: timed out (last result: {Last})`)
    return nil
end

function Harness:Report(): boolean
    const Total = self.Passed + self.Failed + self.Skipped
    print(`\n{string.rep("=", 56)}`)
    print(`  {self.Passed}/{Total} passed, {self.Failed} failed, {self.Skipped} skipped`)

    if self.Failed > 0 then
        print(`\n  Failures:`)
        for _, Failure in self.Failures do
            print(`    {Failure}`)
        end
    end

    print(`{string.rep("=", 56)}\n`)
    return self.Failed == 0
end

function Harness.new(): Suite
    return setmetatable({
        Passed = 0,
        Failed = 0,
        Skipped = 0,
        Group = "",
        Current = "",
        Errors = {},
        Failures = {},
        Skips = {},
        SkipReason = nil,
    }, Harness) :: any
end

return Harness
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX56">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
    Prism test suite -- server half.

    Ships in PrismTests.rbxmx beside the client half, Harness and its own copy
    of Prism, and runs with RunContext Server from wherever the model sits. Run
    it with one test player.

    The Database section is on: it writes to real DataStore and MemoryStore keys
    and needs Studio API access enabled. Set RUN_DATABASE to false to skip it.
    Its cleanup step is commented out, so the PrismSelfTest key survives a run.
]]

const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const ServerStorage = game:GetService("ServerStorage")

const RUN_DATABASE = true
const DATABASE_KEY = "PrismSelfTest"

const Prism = require("./Prism")
const Harness = require("./Harness")

const Networking = Prism.Networking
const Properties = Prism.Properties
const PropertyTypes = require("./Prism/Properties/Types")
const Compressor = Prism.Compressor
const Permissions = Prism.Permissions
const CustomEnum = Prism.CustomEnum
const Encoding = Prism.Encoding
const Objects = Prism.Objects
const Handles = Prism.Handles
const Scenes = Prism.Scenes
const World = Prism.World
const IdPool = Prism.IdPool
const Codecs = Prism.Codecs
const Varint = Prism.Varint
const Try = Prism.Try

const T = Harness.new()

--=============================================================================
-- Varint
--=============================================================================

T:Describe("Varint")

T:Test("round trips across byte boundaries", function()
    const Cases = {0, 1, 127, 128, 129, 16383, 16384, 2097151, 2097152, 1e9, Varint.MAX_SAFE}
    const Buf = buffer.create(16)

    for _, Value in Cases do
        const Written = Varint.Write(Buf, 0, Value)
        const Read, Consumed = Varint.Read(Buf, 0)

        T:Eq(Read, Value, `value {Value}`)
        T:Eq(Consumed, Written, `consumed for {Value}`)
        T:Eq(Written, Varint.Measure(Value), `measure agrees for {Value}`)
    end
end)

T:Test("uses the expected widths", function()
    T:Eq(Varint.Measure(0), 1, "zero")
    T:Eq(Varint.Measure(127), 1, "127")
    T:Eq(Varint.Measure(128), 2, "128")
    T:Eq(Varint.Measure(16383), 2, "16383")
    T:Eq(Varint.Measure(16384), 3, "16384")
end)

T:Test("zigzag keeps small negatives small", function()
    T:Eq(Varint.Zigzag(0), 0, "0")
    T:Eq(Varint.Zigzag(-1), 1, "-1")
    T:Eq(Varint.Zigzag(1), 2, "1")
    T:Eq(Varint.Zigzag(-2), 3, "-2")
    T:Eq(Varint.MeasureSigned(-1), 1, "-1 is one byte")

    const Buf = buffer.create(16)
    for _, Value in {0, -1, 1, -63, 63, -1e6, 1e6, Varint.MAX_SIGNED, -Varint.MAX_SIGNED - 1} do
        const Written = Varint.WriteSigned(Buf, 0, Value)
        const Read, Consumed = Varint.ReadSigned(Buf, 0)
        T:Eq(Read, Value, `signed {Value}`)
        T:Eq(Consumed, Written, `signed consumed {Value}`)
    end
end)

T:Test("rejects what it cannot represent", function()
    const Buf = buffer.create(16)
    T:Throws(function() Varint.Write(Buf, 0, -1) end, "negative")
    T:Throws(function() Varint.Write(Buf, 0, 1.5) end, "fractional")
    T:Throws(function() Varint.Write(Buf, 0, Varint.MAX_SAFE * 4) end, "past 2^53")
end)

T:Test("refuses a runaway varint", function()
    const Buf = buffer.create(16)
    for Index = 0, 15 do
        buffer.writeu8(Buf, Index, 255) -- continuation bit set forever
    end

    T:Throws(function() Varint.Read(Buf, 0) end, "no terminator")
end)

--=============================================================================
-- Codecs
--=============================================================================

T:Describe("Codecs")

const function RoundTrip(Codec, Value, What: string)
    const Extras = {}
    const Size = Codec.Measure(Value)
    const Buf = buffer.create(math.max(Size, 1))

    const Written = Codec.Write(Buf, 0, Value, Extras)
    T:Eq(Written, Size, `{What}: measure agrees with write`)

    const Read, Consumed = Codec.Read(Buf, 0, Extras)
    T:Eq(Consumed, Written, `{What}: consumed agrees`)
    return Read
end

T:Test("fixed width codecs round trip", function()
    T:Eq(RoundTrip(Codecs.u8, 200, "u8"), 200)
    T:Eq(RoundTrip(Codecs.u16, 65535, "u16"), 65535)
    T:Eq(RoundTrip(Codecs.u32, 4294967295, "u32"), 4294967295)
    T:Eq(RoundTrip(Codecs.i16, -300, "i16"), -300)
    T:Eq(RoundTrip(Codecs.f64, 0.1, "f64"), 0.1)
    T:Eq(RoundTrip(Codecs.Bool, true, "bool true"), true)
    T:Eq(RoundTrip(Codecs.Bool, false, "bool false"), false)
end)

T:Test("variable width codecs round trip", function()
    T:Eq(RoundTrip(Codecs.Varint, 300, "varint"), 300)
    T:Eq(RoundTrip(Codecs.SignedVarint, -300, "signed varint"), -300)
    T:Eq(RoundTrip(Codecs.String, "hello", "string"), "hello")
    T:Eq(RoundTrip(Codecs.String, "", "empty string"), "")
    T:Eq(RoundTrip(Codecs.LongString, string.rep("x", 70000), "long string"):len(), 70000)
end)

T:Test("roblox datatype codecs round trip", function()
    T:Eq(RoundTrip(Codecs.Vector, Vector3.new(1, 2, 3), "vector"), Vector3.new(1, 2, 3))
    T:Eq(RoundTrip(Codecs.Color, Color3.fromRGB(10, 20, 30), "color"), Color3.fromRGB(10, 20, 30))

    const Frame = CFrame.new(1, 2, 3)
    const Back = RoundTrip(Codecs.CFrame, Frame, "cframe")
    T:Ok((Back.Position - Frame.Position).Magnitude < 1e-4, "cframe position")
end)

T:Test("buffer codec preserves bytes", function()
    const Source = buffer.create(4)
    buffer.writeu32(Source, 0, 123456)

    const Back = RoundTrip(Codecs.Buffer, Source, "buffer")
    T:Eq(buffer.len(Back), 4, "length")
    T:Eq(buffer.readu32(Back, 0), 123456, "contents")
end)

T:Test("Any rides the side channel and survives nil", function()
    const Part = Instance.new("Part")

    const Extras = {}
    const Buf = buffer.create(4)
    const A = Codecs.Any.Write(Buf, 0, Part, Extras)
    const B = Codecs.Any.Write(Buf, A, nil, Extras)

    T:Eq(#Extras, 1, "nil does not take a slot")
    T:Eq((Codecs.Any.Read(Buf, 0, Extras)), Part, "instance")
    T:Eq((Codecs.Any.Read(Buf, A, Extras)), nil, "nil")
    T:Eq(A + B, 4, "two bytes each")

    Part:Destroy()
end)

T:Test("Optional distinguishes nil from a value", function()
    const Inner = Codecs.Optional(Codecs.u16)
    T:Eq(RoundTrip(Inner, 500, "optional present"), 500)
    T:Eq(RoundTrip(Inner, nil, "optional absent"), nil)
    T:Eq(Inner.Measure(nil), 1, "absent costs one byte")
end)

T:Test("Array round trips including empty", function()
    const Inner = Codecs.Array(Codecs.Varint)
    const Back = RoundTrip(Inner, {1, 128, 70000}, "array")
    T:Eq(#Back, 3, "count")
    T:Eq(Back[2], 128, "second")
    T:Eq(Back[3], 70000, "third")
    T:Eq(#RoundTrip(Inner, {}, "empty array"), 0, "empty")
end)

--=============================================================================
-- Networking manifest
--=============================================================================

T:Describe("Networking")

T:Test("channel lookups are stable", function()
    const First = Networking:Get("Prism.Ready")
    const Second = Networking:Get("Prism.Ready")
    T:Eq(First, Second, "same manifest entry")
    T:Eq(First.Name, "Prism.Ready", "channel name")
    T:Ok(First.Id > 0 and First.Id <= 255, "channel id fits the packet header")
end)

T:Test("unknown channels are rejected", function()
    T:Throws(function()
        Networking:Get("Tests.DoesNotExist")
    end, "unknown channel")
end)

T:Test("schema arity is checked before transport", function()
    const Removed = Networking:Get("Objects.ObjectRemoved")
    T:Throws(function()
        Removed:FireAll(1, 2)
    end, "too many arguments")
end)

T:Test("server-to-client invokes are rejected", function()
    T:Throws(function()
        Networking:Get("Prism.Ready"):Invoke()
    end, "server invoke")
end)

T:Test("connections disconnect idempotently", function()
    const Ready = Networking:Get("Prism.Ready")
    const Before = #Ready.Connections
    const Disconnect = Ready:Connect(function() end)

    T:Eq(#Ready.Connections, Before + 1, "connected")
    Disconnect()
    Disconnect()
    T:Eq(#Ready.Connections, Before, "disconnected once")
end)

--=============================================================================
-- IdPool
--=============================================================================

T:Describe("IdPool")

T:Test("hands out sequential ids", function()
    const Pool = IdPool.new()
    T:Eq(Pool:Claim(), 1, "first")
    T:Eq(Pool:Claim(), 2, "second")
    T:Eq(Pool:Claim(), 3, "third")
end)

T:Test("reuses a released id when recycling", function()
    const Pool = IdPool.new(nil, true)
    Pool:Claim()
    Pool:Claim()
    Pool:Release(1)

    T:Ok(not Pool:IsUsed(1), "released")
    T:Eq(Pool:Claim(), 1, "reused")
end)

T:Test("never reuses when recycling is off", function()
    const Pool = IdPool.new(nil, false)
    Pool:Claim()
    Pool:Claim()
    Pool:Release(1)

    T:Eq(Pool:Claim(), 3, "moved past the hole")
end)

-- The pool takes no id: naming a retired one was a way to make saved records
-- decode as something else. One passed anyway is ignored.
T:Test("hands out its own id, never the one asked for", function()
    const Pool = IdPool.new()
    T:Eq((Pool.Claim :: any)(Pool, 50), 1, "the pool picks")
    T:Eq(Pool:Claim(), 2, "and keeps counting from there")
end)

T:Test("errors when exhausted", function()
    const Pool = IdPool.new(2)
    Pool:Claim()
    Pool:Claim()
    T:Throws(function() Pool:Claim() end, "exhausted")
end)

--=============================================================================
-- CustomEnum
--=============================================================================

T:Describe("CustomEnum")

const Shapes = CustomEnum:Register("TestShapes", {Circle = 1, Square = 2, Triangle = 3})

T:Test("registers and looks up", function()
    T:Ok(Shapes, "registered")
    T:Eq(#Shapes.Options, 3, "option count")
    T:Eq(Shapes:GetById(2).Value, "Square", "by id")
    T:Eq(Shapes:GetByValue("Triangle").Id, 3, "by value")
    T:Eq(Shapes:GetById(99), nil, "missing id")
end)

T:Test("options are ordered deterministically", function()
    T:Eq(Shapes.Options[1].Id, 1, "first")
    T:Eq(Shapes.Options[2].Id, 2, "second")
    T:Eq(Shapes.Options[3].Id, 3, "third")
end)

T:Test("refuses duplicate registration", function()
    T:Eq(CustomEnum:Register("TestShapes", {A = 1}), nil, "duplicate name")
end)

T:Test("skips invalid options rather than failing", function()
    const Mixed = CustomEnum:Register("TestMixed", {Good = 1, AlsoGood = 2, Bad = 1})
    T:Eq(#Mixed.Options, 2, "duplicate id dropped")
end)

T:Test("UNKNOWN exists for unresolvable options", function()
    T:Ok(CustomEnum.UNKNOWN, "present")
    T:Eq(CustomEnum.UNKNOWN.Parent, "Unknown", "parent")
end)

--=============================================================================
-- Property types and validation
--=============================================================================

T:Describe("Property validation")

T:Test("type ids are stable and reversible", function()
    for Name, Id in PropertyTypes.Ids do
        T:Eq(PropertyTypes:GetTypeFromId(Id), Name, `id {Id}`)
        T:Ok(Id < 32, `{Name} fits five bits`)
    end
end)

T:Test("IsValid checks the underlying type", function()
    T:Ok(PropertyTypes:IsValid("Number", 5), "number")
    T:Ok(not PropertyTypes:IsValid("Number", "5"), "string is not a number")
    T:Ok(PropertyTypes:IsValid("Text", "hi"), "text")
    T:Ok(not PropertyTypes:IsValid("Text", 5), "number is not text")
    T:Ok(PropertyTypes:IsValid("Vector", Vector3.new()), "vector")
    T:Ok(not PropertyTypes:IsValid("Number", nil), "nil")
end)

T:Test("a reference is valid as an id and nothing else", function()
    T:Ok(PropertyTypes:IsValid("Object", 0), "zero is no target")
    T:Ok(PropertyTypes:IsValid("Object", 12), "a local id")
    T:Ok(PropertyTypes:IsValid("Object", Handles.MAX_LOCAL), "the largest one")
    T:Ok(not PropertyTypes:IsValid("Object", -1), "not negative")
    T:Ok(not PropertyTypes:IsValid("Object", 1.5), "not fractional")
    T:Ok(not PropertyTypes:IsValid("Object", Handles.MAX_LOCAL + 1), "not past the id space")
    T:Ok(not PropertyTypes:IsValid("Object", "4"), "not a string")

    -- What an id names, and whether that is something the property may point
    -- at, is not a question a value can answer on its own: it needs the copy
    -- doing the asking. Objects/Shared is where that is settled.
    T:Ok(PropertyTypes:IsValid("Object", 999999, {Types = {"Nothing"}}), "a dangling id passes here")
end)

T:Test("a plain number reads back as a Number, not an Object", function()
    -- Both are Luau numbers, so the reverse map has two candidates for one
    -- entry and used to pick whichever hash order reached first.
    T:Eq(PropertyTypes:GetTypeFromValue(5), "Number", "number")
    T:Eq(PropertyTypes:GetTypeFromValue("hi"), "Text", "and the unambiguous ones still answer")
end)

T:Test("FixValue clamps numbers into range", function()
    const Constraints = {MinValue = 0, MaxValue = 10}
    T:Eq(PropertyTypes:FixValue("Number", 20, Constraints), 10, "over")
    T:Eq(PropertyTypes:FixValue("Number", -5, Constraints), 0, "under")
    T:Eq(PropertyTypes:FixValue("Number", 5, Constraints), 5, "inside")
end)

T:Test("FixValue truncates text and applies AllowDecimals", function()
    T:Eq(PropertyTypes:FixValue("Text", "abcdef", {MaxLength = 3}), "abc", "truncated")
    T:Eq(PropertyTypes:FixValue("Number", 5.7, {AllowDecimals = false}), 6, "rounded")
end)

T:Test("Table is gone from the type system", function()
    T:Eq(PropertyTypes.Ids.Table, nil, "no id")
    T:Eq(PropertyTypes.Map.Table, nil, "no map entry")
end)

--=============================================================================
-- Compressor: values
--=============================================================================

T:Describe("Compressor values")

const function ValueRoundTrip(Type: string, Value: any, What: string): any
    const Buf = Compressor:CompressValue(Type, Value)
    T:Ok(Buf, `{What}: compressed`)
    if not Buf then
        return nil
    end

    const Back, Consumed, ReadType = Compressor:DecompressValue(Buf, 0)
    T:Eq(Consumed, buffer.len(Buf), `{What}: consumed the whole buffer`)
    T:Eq(ReadType, Type, `{What}: type survived`)
    return Back
end

T:Test("text round trips including empty and long", function()
    T:Eq(ValueRoundTrip("Text", "hello", "text"), "hello")
    T:Eq(ValueRoundTrip("Text", "", "empty text"), "")
    T:Eq(ValueRoundTrip("Text", string.rep("a", 70000), "long text"):len(), 70000)
end)

T:Test("whole numbers survive exactly", function()
    for _, Value in {0, 1, -1, 42, -42, 1000000} do
        T:Eq(ValueRoundTrip("Number", Value, `number {Value}`), Value)
    end
end)

T:Test("REGRESSION: integers past f32 are not mangled", function()
    -- f32 has a 24 bit mantissa, so it snaps anything past 16,777,216 onto a
    -- grid. Timestamps and user ids both live well past that.
    const Timestamp = 1767000000
    const UserId = 8000000000

    T:Eq(ValueRoundTrip("Number", 16777217, "just past f32"), 16777217)
    T:Eq(ValueRoundTrip("Number", Timestamp, "unix timestamp"), Timestamp)
    T:Eq(ValueRoundTrip("Number", UserId, "user id"), UserId)
    T:Eq(ValueRoundTrip("Number", 4503599627370495, "2^52 - 1"), 4503599627370495)
end)

T:Test("fractional numbers pick a width that round trips", function()
    T:Eq(ValueRoundTrip("Number", 0.5, "f32 exact"), 0.5)
    T:Eq(ValueRoundTrip("Number", 1.5, "f32 exact"), 1.5)
    T:Eq(ValueRoundTrip("Number", 0.1, "needs f64"), 0.1)
    T:Eq(ValueRoundTrip("Number", -0.3, "needs f64"), -0.3)
end)

T:Test("number encoding is chosen by value, not schema", function()
    T:Eq(buffer.len(Compressor:CompressValue("Number", 42)), 2, "small int: tag + 1")
    T:Eq(buffer.len(Compressor:CompressValue("Number", 0.5)), 5, "f32: tag + 4")
    T:Eq(buffer.len(Compressor:CompressValue("Number", 0.1)), 9, "f64: tag + 8")
end)

T:Test("a reference round trips as the local id it stores", function()
    T:Eq(ValueRoundTrip("Object", 0, "no target"), 0)
    T:Eq(ValueRoundTrip("Object", 1, "first id"), 1)
    T:Eq(ValueRoundTrip("Object", 70000, "past two bytes"), 70000)
    T:Eq(ValueRoundTrip("Object", Handles.MAX_LOCAL, "the largest local id"), Handles.MAX_LOCAL)

    -- A varint, so an id a hand built scene actually uses costs one byte and
    -- a reference is no dearer than the number it is.
    T:Eq(buffer.len(Compressor:CompressValue("Object", 4)), 2, "tag + 1")
end)

T:Test("other value types round trip", function()
    T:Eq(ValueRoundTrip("Bool", true, "true"), true)
    T:Eq(ValueRoundTrip("Bool", false, "false"), false)
    T:Eq(ValueRoundTrip("Color", Color3.fromRGB(10, 20, 30), "color"), Color3.fromRGB(10, 20, 30))
    T:Eq(ValueRoundTrip("Vector", Vector3.new(1, 2, 3), "vector"), Vector3.new(1, 2, 3))
    T:Eq(ValueRoundTrip("Enum", Enum.Material.Plastic, "enum"), Enum.Material.Plastic)
    T:Eq(ValueRoundTrip("CustomEnum", Shapes:GetById(2), "custom enum"), Shapes:GetById(2))
end)

T:Test("nil compresses to nothing", function()
    T:Eq(Compressor:CompressValue("Number", nil), nil, "nil value")
end)

T:Test("SCHEMA DRIFT: an unknown semantic type is skipped, not fatal", function()
    -- Rewrite the tag's type bits to a semantic type this build has no name
    -- for, keeping the wire shape. A reader must still know how far to move.
    const Buf = Compressor:CompressValue("Text", "hello") :: buffer
    const Original = buffer.readu8(Buf, 0)
    const Wire = Original // 32

    buffer.writeu8(Buf, 0, Wire * 32 + 20) -- semantic type 20 does not exist

    const Value, Consumed, Type = Compressor:DecompressValue(Buf, 0)
    T:Eq(Value, nil, "value dropped")
    T:Eq(Type, nil, "type unknown")
    T:Eq(Consumed, buffer.len(Buf), "skipped exactly the whole value")
end)

--=============================================================================
-- Compressor: packing
--=============================================================================

T:Describe("Compressor packing")

T:Test("packs and unpacks buffers in order", function()
    const Parts = {}
    for Index = 1, 5 do
        const Part = buffer.create(Index)
        buffer.writeu8(Part, 0, Index * 10)
        table.insert(Parts, Part)
    end

    const Unpacked = Compressor:UnpackBuffers(Compressor:PackBuffers(Parts))
    T:Eq(#Unpacked, 5, "count")

    for Index = 1, 5 do
        T:Eq(buffer.len(Unpacked[Index]), Index, `part {Index} length`)
        T:Eq(buffer.readu8(Unpacked[Index], 0), Index * 10, `part {Index} contents`)
    end
end)

T:Test("handles an empty pack", function()
    T:Eq(#Compressor:UnpackBuffers(Compressor:PackBuffers({})), 0, "empty")
end)

T:Test("rejects a buffer that is not a pack", function()
    T:Throws(function()
        Compressor:UnpackBuffers(buffer.create(16))
    end, "bad header")
end)

--=============================================================================
-- Properties
--=============================================================================

T:Describe("Properties")

-- Registered at load like the rest, so the client receives them too and checks
-- the metadata came across.
const SpeedId = Properties:Register({
    Name = "TestSpeed",
    Type = "Number",
    DefaultValue = 1,
    Display = {Category = "Motion", Order = 2, Description = "Studs a second"},
}) :: number

const SpinId = Properties:Register({
    Name = "TestSpin",
    Type = "Number",
    DefaultValue = 0,
    Display = {Category = "Motion", Order = 1},
}) :: number

const SecretId = Properties:Register({
    Name = "TestSecret",
    Type = "Text",
    DefaultValue = "",
    Display = {Hidden = true},
}) :: number

const PlainId = Properties:Register({
    Name = "TestPlain",
    Type = "Bool",
    DefaultValue = false,
    Display = {Order = "first" :: any},
}) :: number

T:Test("display metadata is filled in at registration", function()
    const Display = Properties:GetRegistry(PlainId).Display

    T:Eq(Display.Category, "General", "a category by default")
    T:Eq(Display.Order, 0, "a malformed order falls back")
    T:Eq(Display.Hidden, false, "nothing hidden unless it says so")
    T:Eq(Display.ReadOnly, false, "nor read only")

    T:Eq(Properties:GetRegistry(SpeedId).Display.Description, "Studs a second", "what was given is kept")
    T:Eq(Properties:GetRegistryPayload(SpeedId).Display.Category, "Motion", "and goes out with the registry")
end)

T:Test("a panel is laid out from the metadata", function()
    const Layout = Properties:Layout({SpeedId, SecretId, PlainId, SpinId})

    T:Eq(#Layout, 2, "two categories, the hidden property left out")
    T:Eq(Layout[1].Category, "General", "the category holding the lowest order comes first")
    T:Eq(Layout[2].Category, "Motion", "then the next")
    T:Eq(Layout[2].Properties[1].Id, SpinId, "within one, lowest order first")
    T:Eq(Layout[2].Properties[2].Id, SpeedId, "then the next")

    T:Eq(#Properties:Layout({SecretId}), 0, "hidden on its own is nothing")
    T:Eq(#Properties:Layout({SecretId}, true), 1, "unless hidden ones are asked for")
    T:Eq(#Properties:Layout({99999}), 0, "an id nothing is registered under is skipped")
end)

const TitleId = Properties:Register({
    Name = "TestTitle",
    Type = "Text",
    DefaultValue = "Untitled",
    Constraints = {MaxLength = 20},
}) :: number

const HealthId = Properties:Register({
    Name = "TestHealth",
    Type = "Number",
    DefaultValue = 100,
    Constraints = {MinValue = 0, MaxValue = 100, AllowDecimals = false},
}) :: number

const PlaysId = Properties:Register({
    Name = "TestPlays",
    Type = "Number",
    DefaultValue = 0,
}) :: number

const TintId = Properties:Register({
    Name = "TestTint",
    Type = "Color",
    DefaultValue = Color3.new(1, 1, 1),
}) :: number

const ShapeId = Properties:Register({
    Name = "TestShape",
    Type = "CustomEnum",
    DefaultValue = Shapes.Options[1],
    Constraints = {CustomEnum = Shapes},
}) :: number

T:Test("registration returns usable ids", function()
    T:Ok(TitleId, "title")
    T:Ok(HealthId, "health")
    T:Eq(Properties:GetRegistry(TitleId).Name, "TestTitle", "registry name")
    T:Eq(Properties:GetRegistry(TitleId).Type, "Text", "registry type")
end)

T:Test("REGRESSION: a CustomEnum registry crosses the wire without its methods", function()
    -- The enum table carries GetById and GetByValue, and a remote refuses to
    -- serialize a function, so broadcasting the registry raw threw for every
    -- CustomEnum property and no client ever received one.
    const Payload = Properties:GetRegistryPayload(ShapeId)
    T:Ok(Payload, "payload built")
    T:Eq(type(Payload.Constraints.CustomEnum), "string", "enum reduced to its name")
    T:Eq(Payload.Constraints.CustomEnum, "TestShapes", "the right name")

    for Key, Value in Payload.Constraints do
        T:Ok(type(Value) ~= "function", `constraint {Key} is not a function`)
    end

    -- The server's own registry keeps the real table.
    T:Eq(type(Properties:GetRegistry(ShapeId).Constraints.CustomEnum), "table", "server copy untouched")
end)

T:Test("a CustomEnum property validates and round trips", function()
    const Prop = Properties.new(ShapeId)
    T:Eq(Prop.Value.Id, 1, "starts at the default option")

    T:Ok((Prop:Set(Shapes:GetById(2))), "accepted a real option")
    T:Eq(Prop.Value.Value, "Square", "value applied")
    T:Ok(not (Prop:Set("Square")), "refused a bare string")

    const Buf = Compressor:CompressValue("CustomEnum", Prop.Value)
    T:Ok(Buf, "compressed")

    const Back, _, Type = Compressor:DecompressValue(Buf :: buffer, 0)
    T:Eq(Type, "CustomEnum", "tag preserved")
    T:Eq(Back.Id, 2, "option id preserved")
    T:Eq(Back.Parent, "TestShapes", "parent preserved")
end)

T:Test("ids are the pool's to give, never the caller's to ask for", function()
    -- There is no way to name the id a registration gets. An explicit claim
    -- only ever checked whether an id was in use now, not whether it had been,
    -- so asking for a retired one was a way to make every saved record carrying
    -- it decode as something else.
    const First = Properties:Register({Name = "TestPoolA", Type = "Bool", DefaultValue = false})
    const Second = Properties:Register({Name = "TestPoolB", Type = "Bool", DefaultValue = false})

    T:Ok(First and Second, "both registered")
    T:Ok(First ~= Second, "under ids of their own")
    T:Ok(First ~= TitleId and Second ~= TitleId, "and never one already spoken for")
end)

T:Test("instances start at the registry default", function()
    const Prop = Properties.new(TitleId)
    T:Eq(Prop.Value, "Untitled", "value")
    T:Eq(Prop.DefaultValue, "Untitled", "default")
    T:Eq(Prop.Parent, TitleId, "parent")
end)

T:Test("Set reports accepted and changed separately", function()
    const Prop = Properties.new(HealthId)

    const Accepted, Changed = Prop:Set(50)
    T:Ok(Accepted, "accepted")
    T:Ok(Changed, "changed")

    const AcceptedAgain, ChangedAgain = Prop:Set(50)
    T:Ok(AcceptedAgain, "same value still accepted")
    T:Ok(not ChangedAgain, "same value is not a change")

    const Rejected = Prop:Set("not a number")
    T:Ok(not Rejected, "wrong type rejected")
    T:Eq(Prop.Value, 50, "value untouched after rejection")
end)

T:Test("constraints clamp on the way in", function()
    const Prop = Properties.new(HealthId)
    Prop:Set(500)
    T:Eq(Prop.Value, 100, "clamped to max")

    Prop:Set(-20)
    T:Eq(Prop.Value, 0, "clamped to min")

    Prop:Set(5.7)
    T:Eq(Prop.Value, 6, "rounded by AllowDecimals")
end)

T:Test("text is truncated to MaxLength", function()
    const Prop = Properties.new(TitleId)
    Prop:Set(string.rep("x", 50))
    T:Eq(#Prop.Value, 20, "truncated")
end)

T:Test("OnChange allocates only when used", function()
    const Prop = Properties.new(HealthId)
    T:Eq(Prop.Listeners, nil, "no listeners before OnChange")

    local Seen: any = nil
    const Disconnect = Prop:OnChange(function(Value)
        Seen = Value
    end)

    T:Ok(Prop.Listeners, "allocated on connect")

    Prop:Set(42)
    task.wait()
    T:Eq(Seen, 42, "listener fired")

    Disconnect()
    T:Eq(Prop.Listeners, nil, "freed when the last listener leaves")

    Prop:Set(43)
    task.wait()
    T:Eq(Seen, 42, "no longer firing")
end)

T:Test("OnChange does not fire for an unchanged value", function()
    const Prop = Properties.new(HealthId)
    Prop:Set(10)

    local Count = 0
    Prop:OnChange(function()
        Count += 1
    end)

    Prop:Set(10)
    task.wait()
    T:Eq(Count, 0, "no fire")

    Prop:Set(11)
    task.wait()
    T:Eq(Count, 1, "fired once")
end)

T:Test("disconnecting twice is harmless", function()
    const Prop = Properties.new(HealthId)
    const Disconnect = Prop:OnChange(function() end)
    Disconnect()
    Disconnect()
    T:Eq(Prop.Listeners, nil, "still clean")
end)

--=============================================================================
-- Compressor: objects and metadata
--=============================================================================

T:Describe("Compressor records")

T:Test("metadata round trips", function()
    const Title = Properties.new(TitleId)
    Title:Set("My Level")

    const Plays = Properties.new(PlaysId)
    Plays:Set(1767000000) -- past f32, the regression case

    const Record = {
        Id = 7,
        SavedVersion = 2,
        PublishedVersion = 1,
        Title,
        Plays,
    }

    const Back = Compressor:DecompressMetadata(Compressor:CompressMetadata(Record :: any))
    T:Eq(Back.Id, 7, "id")
    T:Eq(Back.SavedVersion, 2, "saved version")
    T:Eq(Back.PublishedVersion, 1, "published version")
    T:Eq(#Back, 2, "property count")

    -- Indexed rather than iterated: the record carries Id, SavedVersion and
    -- PublishedVersion beside the array of properties, and a generic for walks
    -- those numbers too and then tries to index them.
    for Index = 1, #Back do
        const Prop = Back[Index]
        if Prop.Parent == TitleId then
            T:Eq(Prop.Value, "My Level", "title")
        elseif Prop.Parent == PlaysId then
            T:Eq(Prop.Value, 1767000000, "plays exact")
        end
    end
end)

T:Test("metadata packs round trip and preserve LastId", function()
    const function Build(Id: number, Name: string)
        const Title = Properties.new(TitleId)
        Title:Set(Name)
        return {Id = Id, SavedVersion = 0, PublishedVersion = 0, Title}
    end

    const Records = {Build(1, "One"), Build(2, "Two"), Build(3, "Three")}
    const LastId, Back = Compressor:DecompressMetadatas(Compressor:CompressMetadatas(42, Records :: any))

    T:Eq(LastId, 42, "last id")
    T:Eq(#Back, 3, "count")
    T:Eq(Back[1].Id, 1, "order preserved")
    T:Eq(Back[3][1].Value, "Three", "third record value")
end)

T:Test("rejects a buffer that is not metadata", function()
    T:Throws(function()
        Compressor:DecompressMetadata(buffer.create(32))
    end, "bad header")
end)

--=============================================================================
-- Objects
--=============================================================================

T:Describe("Objects")

const Template = Instance.new("Part")
Template.Name = "PrismTestTemplate"
Template.Anchored = true
Template.Parent = ServerStorage

const CrateId = Objects:Register({
    Name = "TestCrate",
    Properties = {TitleId, HealthId, TintId},
    Instance = Template,
    Links = {
        {Property = TintId, Type = "Property", Name = "Color"},
        {Property = HealthId, Type = "Attribute", Name = "Health"},
    },
}) :: number

const BareId = Objects:Register({
    Name = "TestBare",
    Properties = {TitleId},
}) :: number

-- A template clients can see, so its registry reaches them carrying a
-- reference that resolves -- which is what a client building its own objects
-- clones. TestCrate's sits in ServerStorage and reaches them as nil.
const ShownTemplate = Instance.new("Part")
ShownTemplate.Name = "PrismShownTemplate"
ShownTemplate.Anchored = true
ShownTemplate.Parent = ReplicatedStorage

const ShownId = Objects:Register({
    Name = "TestShown",
    Properties = {TitleId},
    Instance = ShownTemplate,
    Links = {{Property = TitleId, Type = "Attribute", Name = "TestTitle"}},
}) :: number

-- Data only for the players a scene admits. The client checks that a scene it
-- was not admitted to still sends it objects of every other type, and none of
-- these.
const PrivateId = Objects:Register({
    Name = "TestPrivate",
    Properties = {TitleId},
    Replicate = "Admitted",
}) :: number

T:Test("registration validates its property list", function()
    T:Ok(CrateId, "registered")
    T:Eq(Objects:GetRegistry(CrateId).Name, "TestCrate", "name")

    const Sparse = Objects:Register({
        Name = "TestSparse",
        Properties = {TitleId, 99999}, -- second is not registered
    }) :: number

    T:Eq(#Objects:GetRegistry(Sparse).Properties, 1, "unregistered property dropped")
end)

T:Test("a registry payload carries its template and links", function()
    const Crate = Objects:GetRegistryPayload(CrateId)
    T:Eq(Crate.Instance, Template, "the template, as a reference")
    T:Eq(#Crate.Links, 2, "the validated links")

    const Shown = Objects:GetRegistryPayload(ShownId)
    T:Eq(Shown.Instance, ShownTemplate, "a replicated template too")
    T:Eq(Shown.Links[1].Name, "TestTitle", "with its link")

    const Bare = Objects:GetRegistryPayload(BareId)
    T:Eq(Bare.Instance, nil, "a type with no template sends none")
    T:Eq(Bare.Links, nil, "and no links")
end)

T:Test("an object type replicates to everyone unless it says otherwise", function()
    T:Eq(Objects:GetRegistry(BareId).Replicate, "Everyone", "everyone by default")
    T:Eq(Objects:GetRegistry(PrivateId).Replicate, "Admitted", "the admitted, when asked")
    T:Eq(Objects:GetRegistryPayload(PrivateId).Replicate, "Admitted", "and the client is told which")

    const Typo = Objects:Register({
        Name = "TestReplicateTypo",
        Properties = {TitleId},
        Replicate = "admitted" :: any,
    }) :: number

    T:Eq(Objects:GetRegistry(Typo).Replicate, "Admitted", "a value that is neither keeps it back")
end)

T:Test("a property cannot be unregistered while anything is built on it", function()
    T:Ok(not Properties:Unregister(TitleId), "refused: object types carry it")
    T:Ok(Properties:GetRegistry(TitleId), "and still registered")

    const Loose = Properties:Register({Name = "TestLoose", Type = "Text", DefaultValue = ""}) :: number
    T:Ok(Properties:Unregister(Loose), "one nothing carries goes")
    T:Eq(Properties:GetRegistry(Loose), nil, "gone")

    const Next = Properties:Register({Name = "TestLooseAfter", Type = "Text", DefaultValue = ""}) :: number
    T:Ok(Next ~= Loose, "and its id is not handed out again")
end)

T:Test("an object type cannot be unregistered while objects of it are live", function()
    const Carried = Properties:Register({Name = "TestCarried", Type = "Text", DefaultValue = ""}) :: number
    const Doomed = Objects:Register({Name = "TestDoomed", Properties = {Carried}}) :: number
    const Obj = Objects.new(Doomed)

    T:Ok(not Objects:Unregister(Doomed), "refused while one is live")
    T:Ok(not Properties:Unregister(Carried), "and its property is held by it")

    Obj:Destroy()
    T:Ok(Objects:Unregister(Doomed), "goes once none are")
    T:Eq(Objects:GetRegistry(Doomed), nil, "gone")
    T:Ok(Properties:Unregister(Carried), "and lets go of its property")

    T:Throws(function()
        Objects.new(Doomed)
    end, "nothing can be made of it")
end)

T:Test("instances get their own clone of the template", function()
    const A = Objects.new(CrateId)
    const B = Objects.new(CrateId)

    T:Ok(A.Instance, "A has an instance")
    T:Ok(B.Instance, "B has an instance")
    T:Ok(A.Instance ~= B.Instance, "instances are distinct")
    T:Ok(A.Instance ~= Template, "not the template itself")

    -- Both landed in the default scene, so both are in that copy's folder.
    const Copy = A.Instance.Parent
    T:Ok(Copy and Copy:IsA("Folder"), "parented into a copy's folder")
    T:Eq(B.Instance.Parent, Copy, "and both into the same one")
    T:Eq(Copy.Parent.Parent.Name, World.RootName, "which hangs under the prism root")

    A:Destroy()
    T:Ok(B.Instance and B.Instance.Parent == Copy, "destroying A leaves B alone")
    B:Destroy()
end)

T:Test("get and set work by id and by name", function()
    const Obj = Objects.new(CrateId)

    T:Eq(Obj:Get(TitleId), "Untitled", "default by id")
    T:Eq(Obj:Get("TestTitle"), "Untitled", "default by name")

    T:Ok(Obj:Set(TitleId, "Renamed"), "set accepted")
    T:Eq(Obj:Get(TitleId), "Renamed", "set applied")
    T:Eq(Obj:Get("TestTitle"), "Renamed", "visible by name")

    T:Ok(not Obj:Set(99999, "x"), "unknown property refused")
    T:Ok(not Obj:Set(HealthId, "not a number"), "wrong type refused")

    Obj:Destroy()
end)

T:Test("OnChange watches by id and by name", function()
    const Obj = Objects.new(CrateId)

    local ById: any = nil
    local ByName: any = nil

    const StopId = Obj:OnChange(HealthId, function(Value)
        ById = Value
    end)

    const StopName = Obj:OnChange("TestTitle", function(Value)
        ByName = Value
    end)

    Obj:Set(HealthId, 42)
    Obj:Set("TestTitle", "Watched")
    task.wait()

    T:Eq(ById, 42, "id listener fired")
    T:Eq(ByName, "Watched", "name listener fired")

    StopId()
    StopName()

    Obj:Set(HealthId, 7)
    task.wait()
    T:Eq(ById, 42, "disconnected listener stays quiet")

    Obj:Destroy()
end)

T:Test("watching what the object does not carry still returns a disconnect", function()
    const Obj = Objects.new(CrateId)

    -- Neither of these may throw, here or when released: a caller that stores
    -- the disconnect and calls it later cannot be asked to check first.
    const Unknown = Obj:OnChange("NotAProperty", function() end)
    T:Eq(typeof(Unknown), "function", "unknown name answers a disconnect")
    Unknown()

    Obj:Destroy()

    const Destroyed = Obj:OnChange(TitleId, function() end)
    T:Eq(typeof(Destroyed), "function", "destroyed object answers a disconnect")
    Destroyed()
end)

T:Test("GetProperty resolves the same reference Get and Set take", function()
    const Obj = Objects.new(CrateId)

    T:Eq(Obj:GetProperty(TitleId), Obj.Properties[TitleId], "by id")
    T:Eq(Obj:GetProperty("TestTitle"), Obj.Properties[TitleId], "by name")
    T:Eq(Obj.Names["TestTitle"], TitleId, "name map points at the id")

    T:Eq(Obj:GetProperty(99999), nil, "unknown id")
    T:Eq(Obj:GetProperty("NotAProperty"), nil, "unknown name")

    -- What Get and Set do not expose.
    T:Eq(Obj:GetProperty("TestHealth").Constraints.MaxValue, 100, "reaches the constraints")

    Obj:Destroy()
    T:Eq(Obj:GetProperty(TitleId), nil, "destroyed answers nil")
end)

T:Test("links mirror properties onto the instance", function()
    const Obj = Objects.new(CrateId)
    T:Ok(Obj.Links, "links built")

    Obj:Set(TintId, Color3.fromRGB(255, 0, 0))
    task.wait()
    T:Eq(Obj.Instance.Color, Color3.fromRGB(255, 0, 0), "property link followed")

    Obj:Set(HealthId, 55)
    task.wait()
    T:Eq(Obj.Instance:GetAttribute("Health"), 55, "attribute link followed")

    Obj:Destroy()
end)

T:Test("an object with no instance still works", function()
    const Obj = Objects.new(BareId)
    T:Eq(Obj.Instance, nil, "no instance")
    T:Eq(Obj.Links, nil, "no links")
    T:Ok(Obj:Set(TitleId, "Bare"), "set still works")
    Obj:Destroy()
end)

T:Test("destroy is idempotent and answers instead of throwing", function()
    const Obj = Objects.new(CrateId)
    const Inst = Obj.Instance
    const RuntimeId = Obj.RuntimeId

    Obj:Destroy()
    T:Ok(Obj.Destroyed, "flagged")
    T:Eq(Obj.RuntimeId, RuntimeId, "identity readable after destroy")
    T:Eq(Inst.Parent, nil, "instance destroyed")
    T:Eq(Objects:GetWorkspace()[RuntimeId], nil, "removed from workspace")

    -- None of these may throw.
    Obj:Destroy()
    T:Eq(Obj:Get(TitleId), nil, "get answers nil")
    T:Eq(Obj:Set(TitleId, "x"), false, "set answers false")
end)

T:Test("links are disconnected on destroy", function()
    const Obj = Objects.new(CrateId)
    const Prop = Obj.Properties[TintId]

    T:Ok(Prop.Listeners, "listener attached while alive")
    Obj:Destroy()
    T:Eq(Prop.Listeners, nil, "listener released")
end)

T:Test("links that cannot work are refused at registration", function()
    -- Validated once against the template. These used to be checked inside
    -- Objects.new, so one malformed link warned again for every object made.
    const Bad = Objects:Register({
        Name = "TestBadLinks",
        Properties = {TitleId, HealthId, ShapeId},
        Instance = Template,
        Links = {
            -- SetAttribute throws on a table, which is what an option is.
            {Property = ShapeId, Type = "Attribute", Name = "Shape"},
            -- Readable, but assigning to it throws.
            {Property = TitleId, Type = "Property", Name = "ClassName"},
            -- Not a member at all.
            {Property = TitleId, Type = "Property", Name = "NotARealProperty"},
            -- Neither Property nor Attribute.
            {Property = HealthId, Type = "Nonsense" :: any, Name = "Health"},
        },
    }) :: number

    T:Eq(Objects:GetRegistry(Bad).Links, nil, "every bad link dropped")

    const Obj = Objects.new(Bad)
    T:Eq(Obj.Links, nil, "so nothing is wired onto the instance")
    Obj:Destroy()
end)

T:Test("a property linked twice keeps only the first link", function()
    const Dupe = Objects:Register({
        Name = "TestDuplicateLink",
        Properties = {TintId},
        Instance = Template,
        Links = {
            {Property = TintId, Type = "Property", Name = "Color"},
            {Property = TintId, Type = "Attribute", Name = "Tint"},
        },
    }) :: number

    const Links = Objects:GetRegistry(Dupe).Links
    T:Ok(Links, "a link survived")
    T:Eq(#(Links :: any), 1, "exactly one")
    T:Eq((Links :: any)[1].Type, "Property", "the first one wins")
end)

T:Test("initial values are applied before links and before the broadcast", function()
    const Tint = Color3.fromRGB(10, 20, 30)
    const Obj = Objects.new(CrateId, {[TitleId] = "Preloaded", [TintId] = Tint})

    T:Eq(Obj:Get(TitleId), "Preloaded", "text applied")
    T:Eq(Obj:Get(TintId), Tint, "colour applied")

    -- Wired after the values land, so the part carries the real colour rather
    -- than the registry default followed by a correction.
    T:Ok(Obj.Instance, "has an instance")
    if Obj.Instance then
        T:Eq((Obj.Instance :: any).Color, Tint, "link seeded from the initial value")
    end

    Obj:Destroy()
end)

T:Test("round trips through compression", function()
    const Obj = Objects.new(CrateId)
    Obj:Set(TitleId, "Compressed")
    Obj:Set(HealthId, 33)

    const Copy = Objects.fromCompression(Compressor:CompressObject(Obj :: any))
    T:Ok(Copy, "rebuilt")

    if Copy then
        T:Eq(Copy.Registry, CrateId, "same registry")
        T:Eq(Copy:Get(TitleId), "Compressed", "title carried")
        T:Eq(Copy:Get(HealthId), 33, "health carried")
        -- A copy, not a restore: it gets its own persistent id rather than
        -- aliasing the original, which is still alive and still holds the
        -- saved one.
        T:Ok(Copy.PersistentId ~= Obj.PersistentId, "distinct persistent id")
        T:Ok(Copy.RuntimeId ~= Obj.RuntimeId, "and its own runtime id")
        T:Eq(Copy.Scene, Obj.Scene, "same scene")
        Copy:Destroy()
    end

    Obj:Destroy()
end)

T:Test("runtime ids are unique", function()
    const Seen = {}
    const Made = {}

    for _ = 1, 20 do
        const Obj = Objects.new(BareId)
        T:Ok(not Seen[Obj.RuntimeId], `runtime id {Obj.RuntimeId} is fresh`)
        Seen[Obj.RuntimeId] = true
        table.insert(Made, Obj)
    end

    for _, Obj in Made do
        Obj:Destroy()
    end
end)

--=============================================================================
-- Scenes
--=============================================================================

T:Describe("Scenes")

T:Test("a persistent id carries its scene and survives the round trip", function()
    const Persistent = Handles.Join(7, 1234)
    const Scene, Local = Handles.Split(Persistent)

    T:Eq(Scene, 7, "scene half")
    T:Eq(Local, 1234, "local half")
    T:Eq(Handles.Scene(Persistent), 7, "scene alone")
    T:Eq(Handles.Local(Persistent), 1234, "local alone")

    -- The largest id the scheme can produce still has to be an exact integer,
    -- or two different objects start comparing equal.
    const Biggest = Handles.Join(Handles.MAX_SCENE, Handles.MAX_LOCAL)
    T:Eq(Biggest % 1, 0, "still an integer")
    T:Ok(Biggest ~= Biggest - 1, "still distinguishable from its neighbour")
    T:Eq(Handles.Local(Biggest), Handles.MAX_LOCAL, "reads back at the top")
end)

T:Test("registering a scene puts nothing in the world", function()
    const Scene = Scenes.new({Name = "TestRegistered"})

    T:Eq(#Scene:GetInstances(), 0, "no copies")
    T:Eq(Scene.Data, nil, "and nothing committed")

    const Live = Scene:Load()
    T:Ok(Live, "loading makes one")
    T:Eq(#Scene:GetInstances(), 1, "listed by the scene")

    Scene:Destroy()
end)

T:Test("objects land in the default scene when none is named", function()
    const Obj = Objects.new(BareId)
    const Default = Scenes:GetDefault()
    const Live = Default:GetInstances()[1]

    T:Ok(Live, "the default scene loaded itself on first use")
    T:Eq(Obj.Scene, Default.Id, "scene recorded on the object")
    T:Eq(Handles.Scene(Obj.PersistentId), Default.Id, "and inside the persistent id")
    T:Eq(Live:Find(Obj.LocalId), Obj, "the copy holds it")

    Obj:Destroy()
    T:Eq(Live:Find(Obj.LocalId), nil, "and lets go on destroy")
end)

T:Test("refuses a duplicate name", function()
    const First = Scenes.new({Name = "TestDuplicate"})
    T:Ok(First, "registered")

    T:Eq(Scenes.new({Name = "TestDuplicate"}), nil, "same name refused")

    First:Destroy()
end)

T:Test("local ids are per scene, so two scenes reuse the same numbers", function()
    const A = Scenes.new({Name = "TestSceneA"}):Load()
    const B = Scenes.new({Name = "TestSceneB"}):Load()

    const InA = A:Create(BareId)
    const InB = B:Create(BareId)

    T:Eq(InA.LocalId, 1, "first in A")
    T:Eq(InB.LocalId, 1, "first in B")
    T:Ok(InA.PersistentId ~= InB.PersistentId, "but the persistent ids differ")

    A.Owner:Destroy()
    B.Owner:Destroy()
end)

T:Test("commit then reload brings the same ids back", function()
    const Scene = Scenes.new({Name = "TestRoundTrip"})
    const Live = Scene:Load()

    const One = Live:Create(CrateId, {[TitleId] = "First"})
    const Two = Live:Create(CrateId, {[TitleId] = "Second"})
    const Saved = {One.LocalId, Two.LocalId}

    Live:Commit()
    T:Ok(Scene.Data, "the scene kept a pack")

    Scene:Unload()
    T:Ok(One.Destroyed and Two.Destroyed, "objects torn down")
    T:Eq(Objects:GetWorkspace()[One.RuntimeId], nil, "and out of the workspace")
    T:Eq(#Scene:GetInstances(), 0, "no copies left")

    const Again = Scene:Load()

    -- The whole point: an id written down before the unload still names the
    -- same object afterwards, even though its runtime id is new.
    const Back = Again:Find(Saved[1])
    T:Ok(Back, "the first saved id resolves again")
    T:Eq(Back:Get(TitleId), "First", "with its value")
    T:Ok(Back.RuntimeId ~= One.RuntimeId, "under a new runtime id")
    T:Eq(Again:Find(Saved[2]):Get(TitleId), "Second", "and so does the second")

    Scene:Destroy()
end)

T:Test("unloading does not save on its own", function()
    const Scene = Scenes.new({Name = "TestNoImplicitSave"})
    const Live = Scene:Load()

    Live:Create(CrateId, {[TitleId] = "Unsaved"})
    Scene:Unload()

    -- With more than one copy live, saving on unload would have to pick one and
    -- cannot, so it never saves and committing is always the caller's call.
    T:Eq(Scene.Data, nil, "nothing was written back")
    T:Eq(#Scene:Load():GetObjects(), 0, "so the scene reloads empty")

    Scene:Destroy()
end)

T:Test("a local id is never handed out twice, even across a reload", function()
    const Scene = Scenes.new({Name = "TestNoReuse"})
    const Live = Scene:Load()

    const First = Live:Create(BareId)
    const Taken = First.LocalId
    First:Destroy()

    Live:Commit()
    Scene:Unload()

    const Next = Scene:Load():Create(BareId)
    T:Ok(Next.LocalId > Taken, `{Next.LocalId} is past the id already spent`)

    Scene:Destroy()
end)

T:Test("a pack loads into a different scene without colliding", function()
    const Source = Scenes.new({Name = "TestSource"})
    const Live = Source:Load()
    Live:Create(CrateId, {[TitleId] = "Shared"})

    const Pack = Live:Serialize()

    -- Same bytes, two scenes. This is what per scene ids buy: a prefab is not
    -- tied to the scene that produced it.
    const Copy = Scenes.fromBuffer({Name = "TestCopy"}, Pack)
    T:Eq(#Copy:GetInstances(), 0, "registered with nothing live")

    const Original = Live:GetObjects()[1]
    const Restored = Copy:Load():GetObjects()[1]

    T:Eq(Restored:Get(TitleId), "Shared", "value carried")
    T:Eq(Restored.LocalId, Original.LocalId, "same id inside its scene")
    T:Ok(Restored.PersistentId ~= Original.PersistentId, "different persistent id, because a different scene")

    Source:Destroy()
    Copy:Destroy()
end)

-- A pack an older or newer build wrote: an object of a type this one never
-- registered, and on a known object a property nobody registered plus one its
-- type does not list. Built by hand, because nothing registered here can
-- produce it. HealthId is registered but not on TestBare, which is what taking
-- a property off a type leaves behind.
const UNKNOWN_TYPE = 99990
const UNKNOWN_PROPERTY = 99991

const function Foreign(): buffer
    return Compressor:CompressScene(3, {
        {
            __type = "DecompressedObject",
            LocalId = 1,
            Registry = BareId,
            Properties = {[TitleId] = "Known", [HealthId] = 42},
            Unknown = {[UNKNOWN_PROPERTY] = Compressor:CompressValue("Text", "FromElsewhere")},
        },
        {
            __type = "DecompressedObject",
            LocalId = 2,
            Registry = UNKNOWN_TYPE,
            Properties = {[TitleId] = "Stranger"},
            Unknown = {[UNKNOWN_PROPERTY] = Compressor:CompressValue("Text", "StrangerToo")},
        },
        {
            __type = "DecompressedObject",
            LocalId = 3,
            Registry = BareId,
            Properties = {[TitleId] = "After"},
        },
    } :: any)
end

T:Test("an object of an unknown type survives a load and a commit", function()
    const Scene = Scenes.fromBuffer({Name = "TestForeignType"}, Foreign())
    const Live = Scene:Load()

    T:Eq(#Live:GetObjects(), 2, "only the known objects were built")
    T:Eq(Live:Find(2), nil, "nothing answers for the unknown one")
    T:Eq(#Live.Unknown, 1, "but the copy kept it")

    -- A new object must not take the id the kept one is saved under.
    const Made = Live:Create(BareId)
    T:Ok(Made.LocalId > 3, "a new object is minted past it")

    Live:Commit()
    Scene:Unload()

    const _, Back = Compressor:DecompressScene(Scene:Serialize())
    local Kept = nil
    for _, Saved in Back do
        if Saved.LocalId == 2 then
            Kept = Saved
        end
    end

    T:Ok(Kept, "still in the pack after the commit")
    if Kept then
        T:Eq(Kept.Registry, UNKNOWN_TYPE, "under its own type")
        T:Eq(Kept.Properties[TitleId], "Stranger", "with its values")
        T:Ok(Kept.Unknown and Kept.Unknown[UNKNOWN_PROPERTY], "including the ones nobody here can read")
    end

    T:Eq(Back[1].LocalId, 1, "and in its place by local id")
    T:Eq(Back[2].LocalId, 2, "between its neighbours")
    T:Eq(Back[3].LocalId, 3, "rather than at the end")

    Scene:Destroy()
end)

T:Test("a property the type no longer lists survives a load and a commit", function()
    const Scene = Scenes.fromBuffer({Name = "TestForeignProperty"}, Foreign())
    const Live = Scene:Load()
    const Obj = Live:Find(1)

    T:Ok(Obj, "restored")
    if not Obj then
        Scene:Destroy()
        return
    end

    T:Eq(Obj:Get(TitleId), "Known", "a listed property reads as usual")
    T:Eq(Obj:Get(HealthId), nil, "one the type does not list is not the object's")
    T:Ok(Obj.Unknown and Obj.Unknown[HealthId], "but it is kept")
    T:Ok(Obj.Unknown and Obj.Unknown[UNKNOWN_PROPERTY], "and so is one nobody registered")

    -- Replication is not a save: a client has no use for what it cannot read.
    const Sent = Compressor:DecompressObject(Compressor:CompressObject(Obj))
    T:Eq(Sent.Properties[HealthId], nil, "not replicated")
    T:Eq(Sent.Unknown, nil, "at all")

    Obj:Set(TitleId, "Edited")
    Live:Commit()
    Scene:Unload()

    const _, Back = Compressor:DecompressScene(Scene:Serialize())
    const Saved = Back[1]
    T:Eq(Saved.Properties[TitleId], "Edited", "the edit landed")
    T:Eq(Saved.Properties[HealthId], 42, "the unlisted value came back with it")
    T:Ok(Saved.Unknown and Saved.Unknown[UNKNOWN_PROPERTY], "and the unregistered one")

    -- Put back on the type, the value is the object's again. Simulated by
    -- decoding against a registry that lists it: TestCrate carries Health.
    const AsCrate = table.clone(Saved)
    AsCrate.Registry = CrateId
    const Load = Scenes.fromBuffer({Name = "TestForeignBack"}, Compressor:CompressScene(1, {AsCrate} :: any))
    const Crate = Load:Load():Find(1)
    T:Eq(Crate and Crate:Get(HealthId), 42, "a type that lists it reads it")

    Scene:Destroy()
    Load:Destroy()
end)

T:Test("a duplicate carries what its original was keeping", function()
    const Scene = Scenes.fromBuffer({Name = "TestForeignDuplicate"}, Foreign())
    const Live = Scene:Load()
    const Obj = Live:Find(1)

    const Copy = if Obj then Objects:Duplicate(Obj) else nil
    T:Ok(Copy and Copy.Unknown and Copy.Unknown[HealthId], "kept values came along")
    T:Ok(Copy and Obj and Copy.Unknown ~= Obj.Unknown, "as a copy, not the same table")

    Scene:Destroy()
end)

T:Test("loading twice gives two equal copies", function()
    const Scene = Scenes.new({Name = "TestRoom"})
    const A = Scene:Load()
    A:Create(CrateId, {[TitleId] = "Room"})
    A:Commit()

    const B = Scene:Load()
    T:Eq(#Scene:GetInstances(), 2, "both live")

    const InA = A:GetObjects()[1]
    const InB = B:GetObjects()[1]
    T:Ok(InB, "the second copy has the object")

    -- Same thing, different one of it: that is the whole split between the two
    -- identities.
    T:Eq(InB.PersistentId, InA.PersistentId, "they agree on what it is")
    T:Ok(InB.RuntimeId ~= InA.RuntimeId, "and disagree on which it is")
    T:Eq(InB:Get(TitleId), "Room", "and it carries the value")

    -- Each copy answers for its own, so Find is never ambiguous.
    T:Eq(A:Find(InA.LocalId), InA, "A resolves to its own")
    T:Eq(B:Find(InA.LocalId), InB, "B resolves to its own")

    -- Editing one leaves the other alone.
    InA:Set(TitleId, "Edited")
    T:Eq(InB:Get(TitleId), "Room", "copies do not share state")

    Scene:Destroy()
end)

T:Test("a copy unloads itself, the scene unloads all of them", function()
    const Scene = Scenes.new({Name = "TestUnloadScope"})
    const A = Scene:Load()
    A:Create(BareId)
    A:Commit()

    const B = Scene:Load()
    const InA = A:GetObjects()[1]
    const InB = B:GetObjects()[1]

    B:Unload()
    T:Ok(InB.Destroyed, "the copy took its own objects")
    T:Ok(not InA.Destroyed, "and left the other alone")
    T:Eq(#Scene:GetInstances(), 1, "one copy left")

    Scene:Unload()
    T:Ok(InA.Destroyed, "the scene took the rest")
    T:Eq(#Scene:GetInstances(), 0, "none left")

    Scene:Destroy()
end)

T:Test("naming a scene loaded twice is refused rather than guessed", function()
    const Scene = Scenes.new({Name = "TestAmbiguous"})

    -- No copy at all: there is nowhere to put it.
    T:Throws(function()
        Objects.new(BareId, nil, Scene)
    end, "refused with no copy live")

    Scene:Load()
    T:Ok(Objects.new(BareId, nil, Scene), "accepted while there is one obvious answer")

    -- Two equally good copies, so picking one would put the object somewhere
    -- the caller did not choose.
    Scene:Load()
    T:Throws(function()
        Objects.new(BareId, nil, Scene)
    end, "refused once there are two")

    Scene:Destroy()
end)

T:Test("destroying a scene deregisters it", function()
    const Scene = Scenes.new({Name = "TestGone"})
    const Identifier = Scene.Id
    Scene:Load()

    T:Eq(Scenes:GetById(Identifier), Scene, "listed while it exists")
    T:Eq(Scenes:Get("TestGone"), Scene, "and findable by name")

    Scene:Destroy()
    T:Eq(Scenes:GetById(Identifier), nil, "gone by id")
    T:Eq(Scenes:Get("TestGone"), nil, "gone by name")

    -- The name is free again, but the id is not: a pack still naming the old
    -- scene must never decode as the new one.
    const Reused = Scenes.new({Name = "TestGone"})
    T:Ok(Reused, "the name can be registered again")
    T:Ok(Reused.Id ~= Identifier, "under a different id")

    Reused:Destroy()
end)

T:Test("the scene serializes what was committed, a copy what it holds", function()
    const Scene = Scenes.new({Name = "TestCommitted"})
    const Live = Scene:Load()

    Live:Create(CrateId, {[TitleId] = "Committed"})
    Live:Commit()

    Live:GetObjects()[1]:Set(TitleId, "Drifted")

    const _, Stored = Compressor:DecompressScene(Scene:Serialize())
    T:Eq(Stored[1].Properties[TitleId], "Committed", "the scene still says what it was told")

    const _, Current = Compressor:DecompressScene(Live:Serialize())
    T:Eq(Current[1].Properties[TitleId], "Drifted", "the copy says what it holds")

    Scene:Destroy()
end)

T:Test("a copy owns a folder, in the default tree when none is named", function()
    const Scene = Scenes.new({Name = "TestWorldTree"})
    const A = Scene:Load()
    const B = Scene:Load()

    T:Ok(A.Folder and A.Folder:IsA("Folder"), "a copy has a folder")
    T:Ok(A.Folder ~= B.Folder, "one each, because a copy is what gets placed")
    T:Eq(A.Folder.Name, `__copy_{A.Id}`, "named for the copy")

    const SceneFolder = A.Folder.Parent
    T:Eq(B.Folder.Parent, SceneFolder, "both under the scene's folder")
    T:Eq(SceneFolder.Name, `__scene_{Scene.Id}`, "named for the scene")
    T:Eq(SceneFolder.Parent.Name, World.RootName, "which hangs under the prism root")

    const Obj = A:Create(CrateId)
    T:Eq(Obj.Instance.Parent, A.Folder, "objects land in their own copy's folder")

    A:Unload()
    T:Eq(A.Folder.Parent, nil, "unloading takes the folder with it")
    T:Ok(SceneFolder.Parent, "the scene's folder stays while a copy remains")

    B:Unload()
    T:Eq(SceneFolder.Parent, nil, "and goes with the last of them")

    Scene:Destroy()
end)

T:Test("a copy goes wherever it is told, and takes its objects with it", function()
    -- A folder rather than a model precisely so this works: a scene of
    -- interfaces loads into PlayerGui, one of atmospheres into Lighting.
    const Elsewhere = Instance.new("Folder")
    Elsewhere.Name = "PrismTestElsewhere"
    Elsewhere.Parent = workspace

    const Scene = Scenes.new({Name = "TestNamedParent"})
    const Copy = Scene:Load(Elsewhere)

    T:Eq(Copy.Folder.Parent, Elsewhere, "parented where it was told")
    T:Eq(Copy:Create(CrateId).Instance.Parent, Copy.Folder, "and its objects with it")

    Copy:Unload()
    T:Eq(#Elsewhere:GetChildren(), 0, "unloading took the copy's folder")
    T:Ok(Elsewhere.Parent, "and left the parent alone, because it is not ours")

    Scene:Destroy()
    Elsewhere:Destroy()
end)

T:Test("an opened copy holds its objects and builds none of them", function()
    const Scene = Scenes.new({Name = "TestOpened"})
    const Copy = Scene:Open()

    T:Ok(Copy and Copy.Opened, "opened")
    T:Eq(Copy.Folder, nil, "with no folder on the server")

    const Obj = Copy:Create(CrateId, {[TitleId] = "Opened"})
    T:Eq(Obj.Instance, nil, "and no part: each admitted client draws its own")
    T:Eq(Obj:Get(TitleId), "Opened", "while the data is the server's as ever")
    T:Eq(Objects.ReachOf(Obj), "Admitted", "and kept for the admitted, whatever its type says")

    Copy:Commit()
    Copy:Unload()

    const Loaded = Scene:Load()
    T:Eq(#Loaded:GetObjects(), 1, "the same pack loads either way")
    T:Ok(Loaded:GetObjects()[1].Instance, "and loading builds the part")
    T:Eq(Objects.ReachOf(Loaded:GetObjects()[1]), "Everyone", "and follows its type again")

    Scene:Destroy()
end)

-- User ids 1 and 2 stand in for people who are not here. Nobody running this
-- suite is either of them.
T:Test("a scene that has admitted nobody is public", function()
    const Scene = Scenes.new({Name = "TestPublic"})

    T:Ok(Scene:IsPublic(), "public by default")
    T:Ok(Scene:Admits(1), "so it admits anyone")

    -- A list on a public scene is inert: privacy is a flag now, not something
    -- read off the list, so admitting somebody does not close the scene.
    Scene:Admit(1)
    T:Ok(Scene:IsPublic(), "still public")
    T:Ok(Scene:Admits(2), "and still everybody's")

    Scene:SetPrivate(true)
    T:Ok(not Scene:IsPublic(), "closed")
    T:Ok(Scene:Admits(1), "to the one admitted")
    T:Ok(not Scene:Admits(2), "and to nobody else")

    -- The edge this closes: evicting the last admitted player used to throw the
    -- scene open, to everybody, including the person just shut out of it.
    Scene:Evict(1)
    T:Ok(not Scene:IsPublic(), "evicting the last leaves it closed")
    T:Ok(not Scene:Admits(1), "admitting nobody at all")

    Scene:SetPrivate(false)
    T:Ok(Scene:IsPublic(), "and opening it is its own act")

    Scene:Destroy()
end)

T:Test("admission takes a player or a user id, and belongs to the scene", function()
    const Scene = Scenes.new({Name = "TestAdmitted", Private = true, Admitted = {1, 2}})
    T:Eq(#Scene:GetAdmitted(), 2, "admitted as it was registered")

    Scene:Admit(2)
    T:Eq(#Scene:GetAdmitted(), 2, "admitting twice is admitting once")

    Scene:Admit("somebody" :: any)
    T:Eq(#Scene:GetAdmitted(), 2, "something that is neither admits nobody")

    const Plr = Players:GetPlayers()[1]
    if Plr then
        Scene:Admit(Plr)
        T:Ok(Scene:Admits(Plr.UserId), "a player is kept by user id")

        Scene:Evict(Plr.UserId)
        T:Ok(not Scene:Admits(Plr), "and evicted by it")
        T:Ok(not Scene:IsPublic(), "leaving the rest of the list private")
    end

    Scene:Destroy()
end)

--=============================================================================
-- Permissions
--=============================================================================

T:Describe("Permissions")

Permissions:Register("TestViewer", {})
Permissions:Register("TestBuilder", {
    Global = {Rate = 5, CanPush = true, Capabilities = {"TestPublish"}},
    Scene = {
        CanCreate = true,
        CanEdit = true,
        CanDestroy = true,
        Objects = {Blacklist = {CrateId}},
        Capabilities = {"TestInvite"},
    },
})

-- Stands in for a player who is not connected. Rights are keyed by user id and
-- a table carrying one is all a check reads; the budget is keyed by the table,
-- so each stand-in starts with a fresh one. Ids this far below zero are never a
-- real player, Studio's test players included.
const function Ghost(UserId: number): any
    return {UserId = UserId}
end

T:Test("roles register once", function()
    T:Ok(Permissions:GetRegistered().TestBuilder, "registered")
    T:Eq(Permissions:Register("TestBuilder", {}), nil, "duplicate refused")
end)

T:Test("a player with no grant on a scene can do nothing there", function()
    const Plr = Ghost(-2001)
    const Obj = Objects.new(BareId)

    T:Ok(not Permissions:Can(Plr, "Edit", Obj), "cannot edit")
    T:Ok(not Permissions:Can(Plr, "Destroy", Obj), "cannot destroy")
    T:Ok(not Permissions:Can(Plr, "Create", {Scene = Obj.Scene, Registry = BareId}), "cannot create")

    Obj:Destroy()
end)

T:Test("a role granted on a scene holds there and nowhere else", function()
    const Plr = Ghost(-2002)
    const Here = Scenes.new({Name = "TestRightsHere"}):Load()
    const There = Scenes.new({Name = "TestRightsThere"}):Load()
    const InHere = Here:Create(BareId)
    const InThere = There:Create(BareId)

    T:Ok(Here.Owner:Grant(Plr, "TestBuilder"), "granted")
    T:Ok(Permissions:Can(Plr, "Edit", InHere), "may edit here")
    T:Ok(not Permissions:Can(Plr, "Edit", InThere), "and not there")
    T:Eq(Here.Owner:GetRights(Plr).Role, "TestBuilder", "the role it came from is recorded")

    Here.Owner:Destroy()
    There.Owner:Destroy()
end)

T:Test("a present object whitelist is exhaustive, and the blacklist always holds", function()
    Permissions:Register("TestBareOnly", {Scene = {CanEdit = true, Objects = {Whitelist = {BareId}}}})

    const Plr = Ghost(-2003)
    const Copy = Scenes.new({Name = "TestObjectLists"}):Load()
    const Bare = Copy:Create(BareId)
    const Crate = Copy:Create(CrateId)

    Copy.Owner:Grant(Plr, "TestBareOnly")
    T:Ok(Permissions:Can(Plr, "Edit", Bare), "the whitelisted type")
    T:Ok(not Permissions:Can(Plr, "Edit", Crate), "and nothing else")

    Copy.Owner:Grant(Plr, "TestBuilder")
    T:Ok(Permissions:Can(Plr, "Edit", Bare), "an absent whitelist constrains nothing")
    T:Ok(not Permissions:Can(Plr, "Edit", Crate), "but the blacklist does")

    Copy.Owner:Destroy()
end)

T:Test("property lists govern writing, per type where they say so", function()
    Permissions:Register("TestNoCrateTint", {
        Scene = {CanEdit = true, CanDestroy = true, Properties = {Blacklist = {[TintId] = {CrateId}}}},
    })
    Permissions:Register("TestTitleOnly", {Scene = {CanEdit = true, Properties = {Whitelist = {TitleId}}}})

    const Plr = Ghost(-2004)
    const Copy = Scenes.new({Name = "TestPropertyLists"}):Load()
    const Crate = Copy:Create(CrateId)

    Copy.Owner:Grant(Plr, "TestNoCrateTint")
    T:Ok(not Permissions:Can(Plr, "Edit", Crate, TintId), "tint is kept off crates")
    T:Ok(Permissions:Can(Plr, "Edit", Crate, TitleId), "other properties are not")
    T:Ok(Permissions:Can(Plr, "Destroy", Crate), "and a destroy writes no property")

    Copy.Owner:Grant(Plr, "TestTitleOnly")
    T:Ok(Permissions:Can(Plr, "Edit", Crate, TitleId), "the whitelisted property")
    T:Ok(not Permissions:Can(Plr, "Edit", Crate, HealthId), "and nothing else")

    Copy.Owner:Destroy()
end)

T:Test("granting a role replaces what was there, and capabilities come one at a time", function()
    const Plr = Ghost(-2005)
    const Scene = Scenes.new({Name = "TestCapabilities"})

    Scene:Grant(Plr, "TestBuilder")
    T:Ok(Permissions:Has(Plr, "TestInvite", Scene.Id), "the role's capability")

    Scene:GrantCapability(Plr, "TestKick")
    T:Ok(Permissions:Has(Plr, "TestKick", Scene.Id), "one granted on its own")

    Scene:RevokeCapability(Plr, "TestInvite")
    T:Ok(not Permissions:Has(Plr, "TestInvite", Scene.Id), "one revoked on its own")

    Scene:Grant(Plr, "TestViewer")
    T:Ok(not Permissions:Has(Plr, "TestKick", Scene.Id), "a new role clears the set")
    T:Eq(Scene:GetRights(Plr).CanEdit, false, "verbs included")

    Scene:Destroy()
end)

T:Test("a grant names a user id, and goes with its scene", function()
    const Scene = Scenes.new({Name = "TestByUserId", Rights = {[-2006] = "TestBuilder"}})
    const Obj = Scene:Load():Create(BareId)

    -- Granted before anyone holding the id was here, and held by whoever holds
    -- it -- which is what lets an owner rejoin into their own level.
    T:Ok(Permissions:Can(Ghost(-2006), "Edit", Obj), "held by whoever holds the id")
    T:Ok(Scene:GetRights(-2006), "and readable by id")

    Scene:Destroy()
    T:Eq(Permissions:GetOn(Scene, -2006), nil, "gone with the scene")
end)

T:Test("global rights: a budget and whether you may push", function()
    const Plr = Ghost(-2007)

    T:Eq(Permissions:Get(Plr).Rate, 60, "the default budget for anyone ungranted")
    T:Ok(not Permissions:CanPush(Plr), "and no pushing")

    T:Ok(Permissions:Grant(Plr, "TestBuilder"), "granted")
    T:Eq(Permissions:Get(Plr).Rate, 5, "the role's budget")
    T:Ok(Permissions:CanPush(Plr), "its right to push")
    T:Ok(Permissions:Has(Plr, "TestPublish"), "and its global capability")

    Permissions:Revoke(Plr)
    T:Ok(not Permissions:CanPush(Plr), "revoked back to the default")
end)

T:Test("REGRESSION: every set in the payload is a sequential array", function()
    -- Sent as a map, non-sequential numeric keys are not guaranteed to survive
    -- remote serialization, and the client silently allowed blacklisted types.
    const Scene = Scenes.new({Name = "TestPayload", Rights = {[-2009] = "TestBuilder"}})
    const Payload = Permissions:GetPayloadOn(Scene, -2009)

    T:Ok(Payload, "built")

    if Payload then
        T:Eq(#Payload.ObjectBlacklist, 1, "one entry, reachable by length")
        T:Eq(Payload.ObjectBlacklist[1], CrateId, "entry is the object id")
        T:Eq(Payload.Capabilities[1], "TestInvite", "capabilities as a list")
        T:Eq(Payload.Role, "TestBuilder", "role name carried")
    end

    Scene:Destroy()
end)

T:Test("rate limiting cuts off past the budget", function()
    const Plr = Ghost(-2008)
    Permissions:Grant(Plr, "TestBuilder") -- Rate = 5

    local Allowed = 0
    for _ = 1, 20 do
        if Permissions:Consume(Plr) then
            Allowed += 1
        end
    end

    T:Eq(Allowed, 5, "exactly the budget")
    Permissions:Revoke(Plr)
end)

--=============================================================================
-- Transactions
--=============================================================================

T:Describe("Transactions")

const Transactions = Prism.Transactions

-- TestBuilder's rate is five, which is what the budget test wants and what
-- every other test here would trip over. This one is the same role with room to
-- work in, blacklist included.
Permissions:Register("TestBulk", {
    Global = {Rate = 200, CanPush = true},
    Scene = {
        CanCreate = true,
        CanEdit = true,
        CanDestroy = true,
        Objects = {Blacklist = {CrateId}},
    },
})

T:Test("the wire form round trips every operation kind", function()
    const Operations = {
        {Kind = "Create", Object = CrateId, Instance = 0, Properties = {[TitleId] = "Made", [HealthId] = 40}},
        {Kind = "Set", Target = 7, Property = TitleId, Value = "Changed"},
        {Kind = "Destroy", Target = 9},
    }

    const Read = Compressor:DecompressTransaction(Compressor:CompressTransaction(Operations :: any))

    T:Eq(#Read, 3, "three operations")

    T:Eq(Read[1].Kind, "Create", "first is a create")
    T:Eq(Read[1].Object, CrateId, "object type carried")
    T:Eq(Read[1].Instance, 0, "scene copy carried")
    T:Eq(Read[1].Properties[TitleId], "Made", "initial text")
    T:Eq(Read[1].Properties[HealthId], 40, "initial number")

    T:Eq(Read[2].Kind, "Set", "second is a set")
    T:Eq(Read[2].Target, 7, "target carried")
    T:Eq(Read[2].Property, TitleId, "property carried")
    T:Eq(Read[2].Value, "Changed", "value carried")
    T:Eq(Read[2].Type, "Text", "the value's own tag came back with it")

    T:Eq(Read[3].Kind, "Destroy", "third is a destroy")
    T:Eq(Read[3].Target, 9, "target carried")
end)

T:Test("the same edit always produces the same bytes", function()
    -- Written in id order rather than hash order, so one edit can be compared
    -- against another rather than only replayed. The two tables hold the same
    -- pairs, inserted in opposite orders.
    const First = {}
    First[TitleId] = "Same"
    First[HealthId] = 10

    const Second = {}
    Second[HealthId] = 10
    Second[TitleId] = "Same"

    const A = Compressor:CompressTransaction({{Kind = "Create", Object = CrateId, Instance = 3, Properties = First}} :: any)
    const B = Compressor:CompressTransaction({{Kind = "Create", Object = CrateId, Instance = 3, Properties = Second}} :: any)

    T:Eq(buffer.tostring(A), buffer.tostring(B), "byte identical")
end)

T:Test("an operation of an unknown kind is refused outright", function()
    const Encoded = Compressor:CompressTransaction({{Kind = "Destroy", Target = 4}} :: any)

    -- Header, version, count, then the first operation's kind byte.
    buffer.writeu8(Encoded, 5, 200)

    T:Throws(function()
        Compressor:DecompressTransaction(Encoded)
    end, "unknown kind")
end)

T:Test("a truncated transaction throws rather than half decoding", function()
    const Encoded = Compressor:CompressTransaction({
        {Kind = "Set", Target = 1, Property = TitleId, Value = "Cut"},
    } :: any)

    -- Everything up to and including the kind byte, and nothing of the target.
    const Short = buffer.create(6)
    buffer.copy(Short, 0, Encoded, 0, 6)

    T:Throws(function()
        Compressor:DecompressTransaction(Short)
    end, "truncated")
end)

T:Test("a transaction creates, sets and destroys as one", function()
    const Existing = Objects.new(BareId)
    const Doomed = Objects.new(BareId)

    const Applied, Created = Transactions.new()
        :Create(CrateId, {[TitleId] = "FromTransaction"})
        :Set(Existing, TitleId, "Edited")
        :Destroy(Doomed)
        :Commit()

    T:Ok(Applied, "applied")
    T:Eq(#Created, 1, "one object created")

    const Made = Objects:Get(Created[1])
    T:Ok(Made, "the created object is live")
    T:Eq(Made:Get(TitleId), "FromTransaction", "initial value applied")
    T:Eq(Existing:Get(TitleId), "Edited", "the set applied")
    T:Ok(Doomed.Destroyed, "the destroy applied")

    Made:Destroy()
    Existing:Destroy()
end)

T:Test("committing nothing succeeds and sends nothing", function()
    const Applied, Created = Transactions.new():Commit()
    T:Ok(Applied, "succeeded")
    T:Eq(#Created, 0, "created nothing")
end)

T:Test("an operation that cannot be built stops the whole commit", function()
    const Obj = Objects.new(BareId)

    const Edit = Transactions.new()
        :Set(Obj, TitleId, "First")
        :Set(Obj, "NoSuchProperty", "Second")

    T:Eq(Edit.Rejected, 1, "one operation refused while building")
    T:Eq(#Edit.Operations, 1, "the other was still built")
    T:Ok(not Edit:Commit(), "commit refused rather than sending what is left")
    T:Eq(Obj:Get(TitleId), "Untitled", "nothing applied")

    Obj:Destroy()
end)

T:Test("one refused operation applies none of the others", function()
    const Obj = Objects.new(BareId)

    const Applied = Transactions.Apply(nil, {
        {Kind = "Set", Target = Obj.RuntimeId, Property = TitleId, Value = "Never", Type = "Text"},
        {Kind = "Destroy", Target = 999999},
    } :: any)

    T:Ok(not Applied, "refused")
    T:Eq(Obj:Get(TitleId), "Untitled", "the set that came first never happened")

    Obj:Destroy()
end)

T:Test("a value whose tag disagrees with the property is refused", function()
    const Obj = Objects.new(CrateId)

    const Applied = Transactions.Apply(nil, {
        {Kind = "Set", Target = Obj.RuntimeId, Property = HealthId, Value = "not a number", Type = "Text"},
    } :: any)

    T:Ok(not Applied, "refused")
    T:Eq(Obj:Get(HealthId), 100, "unchanged")

    Obj:Destroy()
end)

T:Test("changing and destroying the same object in one transaction applies", function()
    const Obj = Objects.new(BareId)

    -- Declared the other way round. Every operation is resolved before any of
    -- them run, and destroys run last, so the set lands on a live object and
    -- the object goes afterwards.
    const Applied = Transactions.Apply(nil, {
        {Kind = "Destroy", Target = Obj.RuntimeId},
        {Kind = "Set", Target = Obj.RuntimeId, Property = TitleId, Value = "Ordered", Type = "Text"},
    } :: any)

    T:Ok(Applied, "applied")
    T:Ok(Obj.Destroyed, "the destroy landed")
    T:Eq(Obj.Properties[TitleId].Value, "Ordered", "and the set landed before it")
end)

T:Test("naming the same object for destruction twice is not a failure", function()
    const Obj = Objects.new(BareId)

    const Applied = Transactions.Apply(nil, {
        {Kind = "Destroy", Target = Obj.RuntimeId},
        {Kind = "Destroy", Target = Obj.RuntimeId},
    } :: any)

    T:Ok(Applied, "applied")
    T:Ok(Obj.Destroyed, "destroyed once")
end)

T:Test("a list past the cap is refused before anything is planned", function()
    const Obj = Objects.new(BareId)
    const Operations = table.create(1025)

    Operations[1] = {Kind = "Set", Target = Obj.RuntimeId, Property = TitleId, Value = "Never", Type = "Text"}
    for Index = 2, 1025 do
        Operations[Index] = {Kind = "Destroy", Target = 999999}
    end

    T:Ok(not Transactions.Apply(nil, Operations :: any), "refused")
    T:Eq(Obj:Get(TitleId), "Untitled", "nothing applied")

    Obj:Destroy()
end)

T:Test("a create carrying a value its type cannot hold is refused", function()
    T:Ok(not Transactions.Apply(nil, {
        {Kind = "Create", Object = CrateId, Instance = 0, Properties = {[HealthId] = "not a number"}},
    } :: any), "refused")
end)

T:Test("a create carrying a property its type does not have drops it", function()
    -- What restoring a saved object does with one, rather than a refusal: the
    -- object is still the object that was asked for.
    const Applied, Created = Transactions.Apply(nil, {
        {Kind = "Create", Object = BareId, Instance = 0, Properties = {[TitleId] = "Kept", [HealthId] = 50}},
    } :: any)

    T:Ok(Applied, "applied")

    const Made = Objects:Get(Created[1])
    T:Eq(Made:Get(TitleId), "Kept", "the value it does carry")
    T:Eq(Made:Get(HealthId), nil, "the one it does not")

    Made:Destroy()
end)

T:Test("a create lands in the copy it names", function()
    const Scene = Scenes.new({Name = "TransactionRoom"})
    const Copy = Scene:Load()

    const Applied, Created = Transactions.new()
        :Create(BareId, {[TitleId] = "InRoom"}, Copy.Id)
        :Commit()

    T:Ok(Applied, "applied")

    const Made = Objects:Get(Created[1])
    T:Eq(Made.InstanceId, Copy.Id, "landed in the copy")
    T:Eq(Copy:Find(Made.LocalId), Made, "the copy answers for it")

    T:Ok(not Transactions.Apply(nil, {
        {Kind = "Create", Object = BareId, Instance = 999999, Properties = {}},
    } :: any), "a copy that is not live is refused")

    Copy:Unload()
end)

T:Test("the create verb and the blacklist are both checked", function()
    const Plr = Ghost(-3001)
    const Default = Scenes:GetDefault()
    Permissions:Grant(Plr, "TestBulk")
    Default:Grant(Plr, "TestBulk")

    T:Ok(not Transactions.Apply(Plr, {
        {Kind = "Create", Object = CrateId, Instance = 0, Properties = {}},
    } :: any), "a blacklisted type is refused")

    const Applied, Created = Transactions.Apply(Plr, {
        {Kind = "Create", Object = BareId, Instance = 0, Properties = {}},
    } :: any)

    T:Ok(Applied, "a permitted type is created")

    Default:Grant(Plr, "TestViewer")
    T:Ok(not Transactions.Apply(Plr, {
        {Kind = "Create", Object = BareId, Instance = 0, Properties = {}},
    } :: any), "a role without the verb cannot create")

    Default:Revoke(Plr)
    Permissions:Revoke(Plr)

    const Made = if Created[1] then Objects:Get(Created[1]) else nil
    if Made then
        Made:Destroy()
    end
end)

T:Test("a transaction is charged one action per operation", function()
    const Plr = Ghost(-3002)
    Permissions:Grant(Plr, "TestBuilder") -- Rate = 5
    Scenes:GetDefault():Grant(Plr, "TestBuilder")

    const Objs = {Objects.new(BareId), Objects.new(BareId), Objects.new(BareId)}

    const function Edit(Count: number): boolean
        const Operations = {}
        for Index = 1, Count do
            table.insert(Operations, {
                Kind = "Set",
                Target = Objs[Index].RuntimeId,
                Property = TitleId,
                Value = `Value{Index}`,
                Type = "Text",
            })
        end

        return (Transactions.Apply(Plr, Operations :: any))
    end

    T:Ok(Edit(3), "three operations fit a budget of five")
    T:Ok(not Edit(3), "three more do not, in the same window")

    Scenes:GetDefault():Revoke(Plr)
    Permissions:Revoke(Plr)

    for _, Obj in Objs do
        Obj:Destroy()
    end
end)

T:Test("an object duplicates into its own copy, values and all", function()
    const Copy = Scenes.new({Name = "TestDuplicated"}):Load()
    const Original = Copy:Create(CrateId, {[TitleId] = "Original", [HealthId] = 40})
    const Twin = Objects:Duplicate(Original)

    T:Ok(Twin and Twin ~= Original, "a new object")

    if not Twin then
        Copy.Owner:Destroy()
        return
    end

    T:Eq(Twin:Get(TitleId), "Original", "holding its text")
    T:Eq(Twin:Get(HealthId), 40, "and its number")
    T:Eq(Twin.InstanceId, Copy.Id, "in the same copy")
    T:Ok(Twin.LocalId ~= Original.LocalId, "under a new local id")
    T:Ok(Twin.Instance and Twin.Instance ~= Original.Instance, "with a part of its own")

    Twin:Set(TitleId, "Twin")
    T:Eq(Original:Get(TitleId), "Original", "and nothing shared with the original")

    const Elsewhere = Scenes.new({Name = "TestDuplicatedElsewhere"}):Load()
    const Moved = Objects:Duplicate(Original, Elsewhere)
    T:Eq(Moved and Moved.InstanceId, Elsewhere.Id, "or into another copy when named")

    Copy.Owner:Destroy()
    Elsewhere.Owner:Destroy()
end)

T:Test("a transaction duplicates as a create", function()
    const Source = Objects.new(BareId, {[TitleId] = "Source"})
    const Applied, Created = Transactions.new():Duplicate(Source):Commit()

    T:Ok(Applied, "applied")

    const Made = if Created[1] then Objects:Get(Created[1]) else nil
    T:Ok(Made, "made one")

    if Made then
        T:Eq(Made:Get(TitleId), "Source", "holding the source's value")
        T:Eq(Made.InstanceId, Source.InstanceId, "in the source's copy")
        Made:Destroy()
    end

    Source:Destroy()
end)

--=============================================================================
-- Locks
--=============================================================================

T:Describe("Locks")

T:Test("a lock keeps everyone else's edits off an object", function()
    const Holder = Ghost(-3101)
    const Other = Ghost(-3102)
    const Default = Scenes:GetDefault()

    for _, Plr in {Holder, Other} do
        Permissions:Grant(Plr, "TestBulk")
        Default:Grant(Plr, "TestBulk")
    end

    const Obj = Objects.new(BareId)

    const function SetAs(Plr: any, Value: string): boolean
        return (Transactions.Apply(Plr, {
            {Kind = "Set", Target = Obj.RuntimeId, Property = TitleId, Value = Value, Type = "Text"},
        } :: any))
    end

    T:Ok(Objects:Lock({Obj}, Holder), "locked")
    T:Eq(Objects:GetLock(Obj), -3101, "held by its user id")
    T:Ok(Objects:Lock({Obj}, Holder), "taking it again is fine for the holder")
    T:Ok(not Objects:Lock({Obj}, Other), "but not for anyone else")

    T:Ok(not SetAs(Other, "Theirs"), "another player's edit is refused")
    T:Ok(SetAs(Holder, "Mine"), "the holder's goes through")
    T:Ok(Transactions.Apply(nil, {
        {Kind = "Set", Target = Obj.RuntimeId, Property = TitleId, Value = "Server", Type = "Text"},
    } :: any), "and the server's own ignores it")

    T:Ok(not Objects:Unlock({Obj}, Other), "someone else cannot release it")
    T:Eq(Objects:GetLock(Obj), -3101, "which stays held")
    T:Ok(Objects:Unlock({Obj}, Holder), "the holder can")
    T:Eq(Objects:GetLock(Obj), nil, "free again")
    T:Ok(SetAs(Other, "Theirs"), "and anyone with rights may edit it")

    -- All or nothing, so a multi-object drag never ends up half held.
    const Second = Objects.new(BareId)
    Objects:Lock({Obj}, Other)
    T:Ok(not Objects:Lock({Second, Obj}, Holder), "one taken refuses the lot")
    T:Eq(Objects:GetLock(Second), nil, "and takes none of it")

    Objects:Unlock({Obj})
    T:Eq(Objects:GetLock(Obj), nil, "the server can release anyone's")

    Objects:Lock({Second}, Holder)
    Second:Destroy()
    T:Eq(Objects:GetLock(Second), nil, "a lock goes with its object")

    Obj:Destroy()

    for _, Plr in {Holder, Other} do
        Default:Revoke(Plr)
        Permissions:Revoke(Plr)
    end
end)

T:Test("a hold does not need a player", function()
    const Scene = Scenes.new({Name = "HolderRoom"}) :: any
    const Copy = Scene:Load()
    const Door = Copy:Create(BareId)
    const Tool = {}

    -- Anything at all. The server holding an object while it animates one used
    -- to mean inventing a player to hold it with.
    T:Ok(Objects:Lock({Door}, Tool), "held by a table standing for nobody")
    T:Ok(Objects:IsLocked(Door), "held")
    T:Eq(Objects:GetLock(Door), nil, "by nobody with a user id")
    T:Eq(Objects:GetHolder(Door), Tool, "by that")

    T:Ok(Objects.LockedAgainst(Door, Ghost(-7000)), "against everybody else")
    T:Ok(not Objects.LockedAgainst(Door, Tool), "and not against itself")

    T:Ok(Objects:Unlock({Door}, Tool), "released by the same holder")
    T:Ok(not Objects:IsLocked(Door), "free")

    Scene:Destroy()
end)

T:Test("a hold by a user id and by the player it names are one hold", function()
    const Scene = Scenes.new({Name = "HolderIdRoom"}) :: any
    const Copy = Scene:Load()
    const Door = Copy:Create(BareId)

    T:Ok(Objects:Lock({Door}, -7001), "held by a bare user id")
    T:Eq(Objects:GetLock(Door), -7001, "which is who has it")
    T:Ok(not Objects.LockedAgainst(Door, Ghost(-7001)), "the same person either way")
    T:Ok(Objects.LockedAgainst(Door, Ghost(-7002)), "and somebody else is somebody else")

    Objects:Unlock({Door})
    Scene:Destroy()
end)

T:Test("a hold goes with the admission it was taken under", function()
    const Scene = Scenes.new({Name = "HolderEvicted", Private = true, Admitted = {-7003}}) :: any
    const Copy = Scene:Load()
    const Door = Copy:Create(BareId)

    T:Ok(Objects:Lock({Door}, -7003), "held")

    Scene:Evict(-7003)

    -- Shut out of the room while still holding something in it is a way to stop
    -- everybody else working without being able to work yourself.
    T:Ok(not Objects:IsLocked(Door), "and let go when they were shut out")

    Scene:Destroy()
end)

T:Test("a hold goes with the right that took it", function()
    const Scene = Scenes.new({Name = "HolderRevoked"}) :: any
    const Copy = Scene:Load()
    const Door = Copy:Create(BareId)
    const Plr = Ghost(-7004)

    Scene:Grant(Plr, "TestBulk")
    T:Ok(Objects:Lock({Door}, Plr), "held while they could edit")

    Scene:Revoke(Plr)
    T:Ok(not Objects:IsLocked(Door), "and let go when they no longer could")

    Scene:Destroy()
end)

--=============================================================================
-- Scene commits from a client
--=============================================================================

T:Describe("Scene commits")

-- The handler is a plain function on the manifest entry, so it can be called
-- with a stand-in for a Player exactly as the permission tests do -- there is
-- no client in a server-only run to invoke it for real.
const Commit = Networking:Get("Scenes.Commit").OnInvoke

-- Every commit test pushes as the same user, granted and revoked around each
-- one; a fresh table each time gives each test a fresh budget.
const function Pusher(): any
    return {UserId = -5000}
end

const function Packed(LastId: number, Entries: {{Registry: number, LocalId: number, Properties: {[number]: any}}}): buffer
    const Objects_ = {}
    for Index, Entry in Entries do
        Objects_[Index] = {
            __type = "DecompressedObject",
            LocalId = Entry.LocalId,
            Registry = Entry.Registry,
            Properties = Entry.Properties,
        }
    end

    return Compressor:CompressScene(LastId, Objects_ :: any)
end

T:Test("a pushed pack keeps nothing the server cannot read", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted = Commit(Ghost, "PushedForeign", Compressor:CompressScene(1, {
        {
            __type = "DecompressedObject",
            LocalId = 1,
            Registry = BareId,
            Properties = {[TitleId] = "Pushed"},
            Unknown = {[99992] = Compressor:CompressValue("Text", "Smuggled")},
        },
    } :: any))

    Permissions:Revoke(Ghost)
    T:Ok(Accepted, "accepted")

    const Scene = Scenes:Get("PushedForeign")
    if not Scene then
        T:Ok(false, "not registered")
        return
    end

    -- A save of the server's own keeps what an older build wrote. A packet
    -- from a client is not a save, and its unreadable bytes are not kept.
    const _, Back = Compressor:DecompressScene(Scene:Serialize())
    T:Eq(Back[1].Properties[TitleId], "Pushed", "the readable value landed")
    T:Eq(Back[1].Unknown, nil, "the unreadable one did not")

    Scene:Destroy()
end)

T:Test("a pack a client built becomes a scene of its own", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted, Identifier = Commit(Ghost, "PushedRoom", Packed(1, {
        {Registry = BareId, LocalId = 1, Properties = {[TitleId] = "Pushed"}},
    }))

    Permissions:Revoke(Ghost)

    T:Ok(Accepted, "accepted")
    T:Ok(Identifier and Identifier > 0, "answered with an id")

    const Scene = Scenes:Get("PushedRoom")
    T:Ok(Scene, "registered under the name it asked for")

    if not Scene then
        return
    end

    T:Eq(Scene.Id, Identifier, "the id it answered with")
    T:Eq(#Scene:GetInstances(), 0, "registered, not loaded")
    T:Ok(not Scene:IsPublic(), "private")
    T:Ok(Scene:Admits(-5000), "to the player who pushed it")
    T:Eq(Scene:GetRights(-5000), nil, "who holds nothing on it with no push role set")

    const Copy = Scene:Load()
    const Restored = Copy:Find(1)

    T:Ok(Restored, "the object came across")
    T:Eq(Restored:Get(TitleId), "Pushed", "with its value")
    T:Eq(Restored.Scene, Scene.Id, "stamped with the server's scene id")

    -- The pack claimed a last id of 1 and held exactly one object, so the next
    -- one is 2 either way. What this checks is that the scene reads a pack the
    -- server wrote rather than the client's bytes: see the next test.
    const Fresh = Copy:Create(BareId)
    T:Eq(Fresh.LocalId, 2, "the counter continues from what the pack held")

    Copy:Unload()
end)

T:Test("a push role is granted to whoever pushes", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")
    Scenes:SetPushRole("TestBulk")

    const Accepted, Identifier = Commit(Ghost, "RoleRoom", Packed(1, {
        {Registry = BareId, LocalId = 1, Properties = {}},
    }))

    Scenes:SetPushRole(nil)
    Permissions:Revoke(Ghost)

    T:Ok(Accepted, "accepted")

    const Scene = Scenes:GetById(Identifier)
    const Rights = if Scene then Scene:GetRights(-5000) else nil
    T:Ok(Rights, "the pusher holds rights on it")

    if Rights then
        T:Eq(Rights.Role, "TestBulk", "from the push role")
    end
end)

T:Test("the id space a pack claims is not taken on trust", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    -- One object, and a last id near the top of the space. Kept as it arrived,
    -- the scene would have room for one more object ever.
    const Accepted = Commit(Ghost, "ClaimedRoom", Packed(Handles.MAX_LOCAL - 1, {
        {Registry = BareId, LocalId = 1, Properties = {}},
    }))

    Permissions:Revoke(Ghost)
    T:Ok(Accepted, "accepted")

    const Scene = Scenes:Get("ClaimedRoom")
    if not Scene then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Scene:Load()
    T:Eq(Copy:Create(BareId).LocalId, 2, "the counter was rewritten to what the pack actually held")
    Copy:Unload()
end)

T:Test("a player who may not push cannot commit at all", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestViewer")

    const Accepted = Commit(Ghost, "ViewerRoom", Packed(1, {
        {Registry = BareId, LocalId = 1, Properties = {}},
    }))

    Permissions:Revoke(Ghost)

    T:Ok(not Accepted, "refused")
    T:Eq(Scenes:Get("ViewerRoom"), nil, "and registered nothing")
end)

T:Test("an unregistered object type refuses the pack", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted = Commit(Ghost, "UnknownRoom", Packed(1, {
        {Registry = 99999, LocalId = 1, Properties = {}},
    }))

    Permissions:Revoke(Ghost)

    T:Ok(not Accepted, "refused")
    T:Eq(Scenes:Get("UnknownRoom"), nil, "and registered nothing")
end)

T:Test("a name already taken is refused before the pack is read", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted = Commit(Ghost, "PushedRoom", Packed(1, {
        {Registry = BareId, LocalId = 1, Properties = {}},
    }))

    Permissions:Revoke(Ghost)
    T:Ok(not Accepted, "refused")
end)

T:Test("bytes that are not a pack are refused rather than thrown", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted = Commit(Ghost, "GarbageRoom", buffer.fromstring("not a pack at all"))

    Permissions:Revoke(Ghost)

    T:Ok(not Accepted, "refused")
    T:Eq(Scenes:Get("GarbageRoom"), nil, "and registered nothing")
end)

T:Test("an empty name is refused", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Accepted = Commit(Ghost, "", Packed(1, {
        {Registry = BareId, LocalId = 1, Properties = {}},
    }))

    Permissions:Revoke(Ghost)
    T:Ok(not Accepted, "refused")
end)

T:Test("a pack past the object cap is refused", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBulk")

    const Entries = table.create(4097)
    for Index = 1, 4097 do
        Entries[Index] = {Registry = BareId, LocalId = Index, Properties = {}}
    end

    const Accepted = Commit(Ghost, "HugeRoom", Packed(4097, Entries))

    Permissions:Revoke(Ghost)

    T:Ok(not Accepted, "refused")
    T:Eq(Scenes:Get("HugeRoom"), nil, "and registered nothing")
end)

T:Test("a commit costs one action, not one per object", function()
    const Ghost = Pusher()
    Permissions:Grant(Ghost, "TestBuilder") -- Rate = 5

    const Pack = Packed(3, {
        {Registry = BareId, LocalId = 1, Properties = {}},
        {Registry = BareId, LocalId = 2, Properties = {}},
        {Registry = BareId, LocalId = 3, Properties = {}},
    })

    local Allowed = 0
    for Index = 1, 6 do
        const Accepted = Commit(Ghost, `BudgetRoom{Index}`, Pack)
        if Accepted then
            Allowed += 1
        end
    end

    Permissions:Revoke(Ghost)

    -- Five commits of three objects each, not one and two thirds.
    T:Eq(Allowed, 5, "the budget counted packets")
end)

--=============================================================================
-- References
--=============================================================================

T:Describe("References")

-- Registered at load with everything else, so the client receives them too and
-- checks that a reference resolves on its side as well.
const TargetId = Properties:Register({
    Name = "TestTarget",
    Type = "Object",
    DefaultValue = 0,
}) :: number

const DoorOnlyId = Properties:Register({
    Name = "TestDoorOnly",
    Type = "Object",
    DefaultValue = 0,
    Constraints = {Types = {"TestDoor"}},
}) :: number

const DoorId = Objects:Register({
    Name = "TestDoor",
    Properties = {TitleId},
}) :: number

const ButtonId = Objects:Register({
    Name = "TestButton",
    Properties = {TitleId, TargetId, DoorOnlyId},
}) :: number

const function Room(Name: string)
    const Scene = Scenes.new({Name = Name})
    return Scene, Scene:Load() :: any
end

T:Test("a reference reads back as the object it names", function()
    const Scene, Copy = Room("RefRoom")
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})

    T:Eq(Button:Get(TargetId), nil, "nothing pointed at to begin with")

    T:Ok(Button:Set(TargetId, Door), "takes the object itself")
    T:Eq(Button:Get(TargetId), Door, "and hands the object back")
    T:Eq(Button:GetProperty(TargetId).Value, Door.LocalId, "storing its local id")

    T:Ok(Button:Set(TargetId, Door.LocalId), "takes a raw id too")
    T:Eq(Button:Get(TargetId), Door, "resolving to the same object")

    T:Ok(Button:Set(TargetId, nil), "and clears")
    T:Eq(Button:GetProperty(TargetId).Value, 0, "to no target")

    Scene:Destroy()
end)

T:Test("a destroyed target reads as nil and the id stays put", function()
    const Scene, Copy = Room("RefDangling")
    const Door = Copy:Create(DoorId)
    const Button = Copy:Create(ButtonId)

    Button:Set(TargetId, Door)
    const Stored = Button:GetProperty(TargetId).Value

    Door:Destroy()

    T:Eq(Button:Get(TargetId), nil, "reads as nothing")
    T:Eq(Button:GetProperty(TargetId).Value, Stored, "but the id is kept")

    Scene:Destroy()
end)

T:Test("each copy of one scene resolves its own", function()
    const Scene = Scenes.new({Name = "RefTwice"})
    const First = Scene:Load() :: any

    const Door = First:Create(DoorId, {[TitleId] = "Door"})
    const Button = First:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)
    First:Commit()

    const Second = Scene:Load() :: any

    const OtherButton = Second:Find(Button.LocalId)
    const OtherDoor = Second:Find(Door.LocalId)

    T:Ok(OtherButton and OtherDoor, "the second copy restored both")
    T:Ok(OtherButton ~= Button, "and they are not the same objects")

    T:Eq(Button:Get(TargetId), Door, "the first copy's button points at the first copy's door")
    T:Eq(OtherButton:Get(TargetId), OtherDoor, "and the second's at the second's")

    Scene:Destroy()
end)

T:Test("a reference only names objects in the same copy", function()
    const Scene, Here = Room("RefHere")
    const Elsewhere = Scene:Load() :: any

    const Door = Elsewhere:Create(DoorId)
    const Button = Here:Create(ButtonId)

    T:Ok(not Button:Set(TargetId, Door), "refused across copies")
    T:Eq(Button:GetProperty(TargetId).Value, 0, "and it still points at nothing")

    Scene:Destroy()
end)

T:Test("a constrained reference refuses what it may not point at", function()
    const Scene, Copy = Room("RefConstrained")
    const Door = Copy:Create(DoorId)
    const Button = Copy:Create(ButtonId)
    const Other = Copy:Create(ButtonId)

    T:Ok(Button:Set(DoorOnlyId, Door), "a door is allowed")
    T:Ok(not Button:Set(DoorOnlyId, Other), "a button is not")
    T:Eq(Button:Get(DoorOnlyId), Door, "and the refusal changed nothing")

    -- Nothing to check the constraint against, and refusing would make a pack
    -- restorable only in the order it happened to be written.
    T:Ok(Button:Set(DoorOnlyId, 999999), "a dangling id is allowed")
    T:Eq(Button:Get(DoorOnlyId), nil, "and reads as nothing")

    Scene:Destroy()
end)

T:Test("a reference survives a commit and a reload", function()
    const Scene = Scenes.new({Name = "RefSaved"})
    const Copy = Scene:Load() :: any

    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)

    Copy:Commit()
    Copy:Unload()

    const Reloaded = Scene:Load() :: any
    const Back = Reloaded:Find(Button.LocalId)

    T:Ok(Back, "the button came back")
    T:Eq(Back:Get(TargetId), Reloaded:Find(Door.LocalId), "still pointing at the door")

    Scene:Destroy()
end)

T:Test("a link on a reference is refused at registration", function()
    -- An Object is a number as far as Luau is concerned, so the type check
    -- would pass and the part would be driven with an id meaning nothing
    -- outside its copy.
    const Linked = Objects:Register({
        Name = "TestLinkedReference",
        Properties = {TargetId},
        Instance = Template,
        Links = {{Property = TargetId, Type = "Attribute", Name = "Target"}},
    }) :: number

    T:Eq(Objects:GetRegistry(Linked).Links, nil, "the link was dropped")
    Objects:Unregister(Linked)
end)

T:Test("duplicating one object keeps its reference, a group remaps it", function()
    const Scene, Copy = Room("RefDuplicate")
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)

    -- One object on its own: the copy still works the original door, which is
    -- what duplicating a lever without its door should do.
    const Alone = Objects:Duplicate(Button)
    T:Eq(Alone:Get(TargetId), Door, "the lone duplicate keeps the original target")

    const Made = Objects:DuplicateGroup({Button, Door})
    T:Eq(#Made, 2, "both were made")

    const NewButton, NewDoor = Made[1], Made[2]
    T:Ok(NewButton ~= Button and NewDoor ~= Door, "new objects")
    T:Eq(NewButton:Get(TargetId), NewDoor, "and the copy points at the copy")
    T:Eq(Button:Get(TargetId), Door, "the original is untouched")

    Scene:Destroy()
end)

T:Test("a group duplicate keeps references pointing outside it", function()
    const Scene, Copy = Room("RefOutside")
    const Door = Copy:Create(DoorId)
    const First = Copy:Create(ButtonId)
    const Second = Copy:Create(ButtonId)

    First:Set(TargetId, Door)
    Second:Set(TargetId, Door)

    -- The door is not in the group, so both copies keep working it.
    const Made = Objects:DuplicateGroup({First, Second})

    T:Eq(Made[1]:Get(TargetId), Door, "first copy still points outside")
    T:Eq(Made[2]:Get(TargetId), Door, "and so does the second")

    Scene:Destroy()
end)

T:Test("a transaction can create two objects already wired together", function()
    const Scene, Copy = Room("RefWired")

    const Applied, Created = Transactions.Apply(nil, {
        {
            Kind = "Create",
            Object = ButtonId,
            Instance = Copy.Id,
            Properties = {[TitleId] = "Button"},
            References = {[TargetId] = 2},
        },

        {Kind = "Create", Object = DoorId, Instance = Copy.Id, Properties = {[TitleId] = "Door"}},
    } :: any)

    T:Ok(Applied, "applied")
    T:Eq(#Created, 2, "two objects")

    const Button = Objects:Get(Created[1])
    const Door = Objects:Get(Created[2])

    -- The id the door answers to did not exist when the operation naming it
    -- was written, which is the whole reason a reference names the operation.
    T:Eq(Button:Get(TargetId), Door, "the button points at the door")

    Scene:Destroy()
end)

T:Test("a reference to something this transaction does not create is refused", function()
    const Scene, Copy = Room("RefBadOperation")
    const Standing = Copy:Create(DoorId, {[TitleId] = "Standing"})

    T:Ok(not Transactions.Apply(nil, {
        {
            Kind = "Create",
            Object = ButtonId,
            Instance = Copy.Id,
            Properties = {},
            References = {[TargetId] = 4},
        },
    } :: any), "no operation 4")

    -- A valid operation, and still not something that makes an object.
    T:Ok(not Transactions.Apply(nil, {
        {Kind = "Create", Object = ButtonId, Instance = Copy.Id, Properties = {}, References = {[TargetId] = 2}},
        {Kind = "Set", Target = Standing.RuntimeId, Property = TitleId, Value = "Moved", Type = "Text"},
    } :: any), "operation 2 is not a create")

    T:Ok(not Transactions.Apply(nil, {
        {Kind = "Create", Object = ButtonId, Instance = Copy.Id, Properties = {}, References = {[TitleId] = 2}},
        {Kind = "Create", Object = DoorId, Instance = Copy.Id, Properties = {}},
    } :: any), "a Text property cannot hold a reference")

    T:Eq(#Copy:GetObjects(), 1, "nothing was created")
    T:Eq(Standing:Get(TitleId), "Standing", "and the set that rode along never landed")

    Scene:Destroy()
end)

T:Test("references ride the wire inside the create that carries them", function()
    const Operations = {
        {
            Kind = "Create",
            Object = ButtonId,
            Instance = 3,
            Properties = {[TitleId] = "Button"},
            References = {[TargetId] = 2},
        },

        {Kind = "Create", Object = DoorId, Instance = 3, Properties = {}},
    }

    const Read = Compressor:DecompressTransaction(Compressor:CompressTransaction(Operations :: any))

    T:Eq(Read[1].Properties[TitleId], "Button", "the values still came across")
    T:Eq(Read[1].References[TargetId], 2, "and the reference with them")
    T:Eq(Read[2].References, nil, "a create with none carries none")

    -- References are a hash map on the way in and sorted on the way out, for
    -- the reason the values are: one edit has to write one set of bytes.
    T:Eq(
        buffer.tostring(Compressor:CompressTransaction(Operations :: any)),
        buffer.tostring(Compressor:CompressTransaction(Operations :: any)),
        "the same operations write the same bytes"
    )
end)

T:Test("a transaction duplicates a group with its references remapped", function()
    const Scene, Copy = Room("RefGroupTransaction")
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)

    const Applied, Created = Transactions.new():DuplicateGroup({Button, Door}):Commit()

    T:Ok(Applied, "applied")
    T:Eq(#Created, 2, "two objects")

    const NewButton = Objects:Get(Created[1])
    const NewDoor = Objects:Get(Created[2])

    T:Eq(NewButton:Get(TargetId), NewDoor, "the new button points at the new door")
    T:Eq(Button:Get(TargetId), Door, "and the originals are untouched")

    Scene:Destroy()
end)

--=============================================================================
-- Object signals
--=============================================================================

T:Describe("Object signals")

T:Test("added and removed fire for every object, however it came and went", function()
    const Seen: {any} = {}
    const Gone: {any} = {}
    local Loaded = 0

    const StopAdded = Objects:OnAdded(function(Obj, Restored)
        if Restored then
            Loaded += 1
        else
            table.insert(Seen, Obj)
        end
    end)

    const StopRemoved = Objects:OnRemoved(function(Obj)
        table.insert(Gone, Obj)
    end)

    const Scene, Copy = Room("SignalRoom")
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})

    T:Eq(Seen[1], Door, "creating fired added")
    T:Eq(Loaded, 0, "and did not call it a restore")

    -- Filed by the time the listener runs, both ways it can be looked up.
    T:Eq(Objects:Get(Door.RuntimeId), Door, "already in the workspace")
    T:Eq(Copy:Find(Door.LocalId), Door, "and in its copy")

    Objects.Suspend(Door)
    T:Eq(Gone[1], Door, "suspending fired removed")
    T:Ok(Door.Destroyed, "with the object already gone")

    Objects.Revive(Door)
    T:Eq(Seen[2], Door, "and reviving fired added again")

    Door:Destroy()
    T:Eq(Gone[2], Door, "destroying fired removed")

    -- A scene load builds its objects silently and sends them in one batch;
    -- the signal is about the object existing, so it fires for each of them.
    Copy:Create(DoorId)
    Copy:Commit()
    Copy:Unload()

    const Before = Loaded
    Scene:Load()
    T:Ok(Loaded > Before, "a load fired added for what it read back")

    StopAdded()
    StopRemoved()
    Scene:Destroy()
end)

T:Test("unloading a copy fires removed for everything it held", function()
    const Scene, Copy = Room("SignalUnload")
    Copy:Create(DoorId)
    Copy:Create(DoorId)

    local Count = 0
    const Stop = Objects:OnRemoved(function()
        Count += 1
    end)

    Copy:Unload()
    T:Eq(Count, 2, "one for each object the copy held")

    Stop()
    Scene:Destroy()
end)

--=============================================================================
-- Suspending
--=============================================================================

T:Describe("Suspending")

T:Test("a suspended object is out of the world but whole", function()
    const Scene, Copy = Room("SuspendRoom")

    -- A crate rather than a door: it has a template, so there is a part to
    -- keep out of the world.
    const Door = Copy:Create(CrateId, {[TitleId] = "Door"})
    const RuntimeId = Door.RuntimeId
    const LocalId = Door.LocalId
    const Part = Door.Instance

    T:Ok(Part, "built with a part")

    T:Ok(Objects.Suspend(Door), "suspended")

    T:Ok(Door.Destroyed, "reads as destroyed")
    T:Ok(Door.Suspended, "and as suspended")
    T:Eq(Objects:Get(RuntimeId), nil, "gone from the workspace")
    T:Eq(Copy:Find(LocalId), nil, "and from its copy")
    T:Eq(Door:Get(TitleId), nil, "and it answers like any destroyed object")

    -- What survives is the whole point: the values, both ids, and the part
    -- itself -- out of the world rather than destroyed.
    T:Eq(Door.Properties[TitleId].Value, "Door", "the value is still there")
    T:Eq(Door.RuntimeId, RuntimeId, "same runtime id")
    T:Eq(Door.LocalId, LocalId, "same local id")
    T:Eq(Door.Instance, Part, "the part is kept")
    T:Eq(Part.Parent, nil, "parented out of the world")

    T:Ok(Objects.Revive(Door), "revived")
    T:Ok(not Door.Destroyed, "alive again")
    T:Eq(Objects:Get(RuntimeId), Door, "back in the workspace, as itself")
    T:Eq(Copy:Find(LocalId), Door, "and in its copy under its own id")
    T:Eq(Door:Get(TitleId), "Door", "still holding what it held")

    -- The same part, not a fresh clone of the template: whatever a game hung
    -- on it is still hanging there.
    T:Eq(Door.Instance, Part, "the part it always had")
    T:Eq(Part.Parent, Copy.Folder, "back in the copy's folder")

    Scene:Destroy()
end)

T:Test("disposing a suspended object ends it, part and all", function()
    const Scene, Copy = Room("DisposeRoom")
    const Door = Copy:Create(DoorId)
    const Part = Door.Instance

    Objects.Suspend(Door)
    T:Eq(Door.Instance, Part, "the part was kept by the suspend")

    Objects.Dispose(Door)

    T:Eq(Door.Suspended, nil, "no longer suspended")
    T:Ok(Door.Destroyed, "still destroyed")
    T:Eq(Door.Instance, nil, "and the part went with it")
    T:Ok(not Objects.Revive(Door), "past reviving")

    Scene:Destroy()
end)

T:Test("a reference relinks when its target comes back", function()
    const Scene, Copy = Room("SuspendReference")
    const Door = Copy:Create(DoorId)
    const Button = Copy:Create(ButtonId)
    Button:Set(TargetId, Door)

    Objects.Suspend(Door)
    T:Eq(Button:Get(TargetId), nil, "reads as nothing while it is gone")
    T:Eq(Button:GetProperty(TargetId).Value, Door.LocalId, "but the id is kept")

    Objects.Revive(Door)

    -- The reason a destroy withdraws rather than ends: the same local id comes
    -- back, so everything pointing at it is pointing at it again.
    T:Eq(Button:Get(TargetId), Door, "and points at it again")

    Scene:Destroy()
end)

T:Test("a copy that has gone cannot take its objects back", function()
    const Scene, Copy = Room("SuspendUnloaded")
    const Door = Copy:Create(DoorId)

    Objects.Suspend(Door)
    Copy:Unload()

    T:Ok(not Objects.Revive(Door), "nowhere to come back to")
    Scene:Destroy()
end)

--=============================================================================
-- History
--=============================================================================

T:Describe("History")

const History = Prism.History

const function Editor(UserId: number, Scene: any): any
    const Plr = Ghost(UserId)
    Permissions:Grant(Plr, "TestBulk")
    Scene:Grant(Plr, "TestBulk")
    return Plr
end

T:Test("the stack is capped by what its steps hold, not only by count", function()
    const Scene, Copy = Room("HistoryWeight")
    const Plr = Editor(-6090, Scene)
    const Limits = History:GetLimits()
    History:SetLimits({Objects = 3})

    const Doors = {}
    for Index = 1, 5 do
        Doors[Index] = Copy:Create(DoorId, {[TitleId] = `Door{Index}`})
    end

    -- Five destroys, one step each, each holding the door it took.
    for _, Door in Doors do
        Transactions.Apply(Plr, {{Kind = "Destroy", Target = Door.RuntimeId}} :: any)
    end

    T:Ok(not Doors[1].Suspended and not Doors[2].Suspended, "the two oldest were let go")
    T:Ok(Doors[3].Suspended and Doors[5].Suspended, "the three that fit are still kept")

    T:Ok(History:Undo(Plr), "one")
    T:Ok(History:Undo(Plr), "two")
    T:Ok(History:Undo(Plr), "three")
    T:Ok(not History:CanUndo(Plr), "and no further")
    T:Eq(#Copy:GetObjects(), 3, "the kept doors came back")

    -- One step heavier than the whole budget is still the newest thing done,
    -- and is kept: an undo that cannot reach the last action is no undo.
    History:Clear(Plr)
    const Ids = {}
    for _, Obj in Copy:GetObjects() do
        table.insert(Ids, {Kind = "Destroy", Target = Obj.RuntimeId})
    end

    const Extra = Copy:Create(DoorId)
    table.insert(Ids, {Kind = "Destroy", Target = Extra.RuntimeId})
    Transactions.Apply(Plr, Ids :: any)

    T:Ok(History:CanUndo(Plr), "a step over the budget on its own is kept")
    T:Ok(Extra.Suspended, "with what it holds")

    History:SetLimits(Limits)
    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a transaction is one step, undone and redone as a unit", function()
    const Scene, Copy = Room("HistoryUnit")
    const Plr = Editor(-6001, Scene)
    const Door = Copy:Create(DoorId, {[TitleId] = "Before"})

    const Applied = Transactions.Apply(Plr, {
        {Kind = "Set", Target = Door.RuntimeId, Property = TitleId, Value = "After", Type = "Text"},
        {Kind = "Create", Object = DoorId, Instance = Copy.Id, Properties = {[TitleId] = "Made"}},
    } :: any)

    T:Ok(Applied, "applied")
    T:Eq(Door:Get(TitleId), "After", "the set landed")
    T:Ok(History:CanUndo(Plr), "and became a step")

    T:Ok(History:Undo(Plr), "undone")
    T:Eq(Door:Get(TitleId), "Before", "the set is back")
    T:Eq(#Copy:GetObjects(), 1, "and what it created is gone")

    T:Ok(History:Redo(Plr), "redone")
    T:Eq(Door:Get(TitleId), "After", "the set again")
    T:Eq(#Copy:GetObjects(), 2, "and the object again")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("undoing a destroy brings back the same object, wired", function()
    const Scene, Copy = Room("HistoryDestroy")
    const Plr = Editor(-6002, Scene)

    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId)
    Button:Set(TargetId, Door)

    const LocalId = Door.LocalId
    const RuntimeId = Door.RuntimeId

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Destroy", Target = RuntimeId},
    } :: any), "destroyed")

    T:Ok(Door.Suspended, "kept rather than ended")
    T:Eq(Button:Get(TargetId), nil, "and the button points at nothing")

    T:Ok(History:Undo(Plr), "undone")

    -- Not a lookalike: the same table, under the same ids, which is what the
    -- reference was holding all along.
    T:Eq(Copy:Find(LocalId), Door, "the same object, under its own local id")
    T:Eq(Objects:Get(RuntimeId), Door, "and its own runtime id")
    T:Eq(Button:Get(TargetId), Door, "so the reference is live again")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a lone destroy is a step of its own", function()
    const Scene, Copy = Room("HistoryLone")
    const Plr = Editor(-6003, Scene)
    const Door = Copy:Create(DoorId)

    -- What the single destroy channel does, which used to be the one edit
    -- nothing could take back.
    Objects.Retire(Plr, Door, true)

    T:Ok(Door.Suspended, "kept")
    T:Ok(History:CanUndo(Plr), "and recorded")
    T:Ok(History:Undo(Plr), "undone")
    T:Eq(Copy:Find(Door.LocalId), Door, "back as itself")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("nothing keeping a destroy makes it final", function()
    const Scene, Copy = Room("HistoryUnkept")
    const Door = Copy:Create(DoorId)

    -- No player, so no stack wants it: exactly what a game that never requires
    -- History gets.
    Objects.Retire(nil, Door, true)

    T:Ok(Door.Destroyed, "destroyed")
    T:Eq(Door.Suspended, nil, "and disposed on the spot")

    Scene:Destroy()
end)

T:Test("a new action forks the redo stack and ends what it held", function()
    const Scene, Copy = Room("HistoryFork")
    const Plr = Editor(-6004, Scene)

    -- Place, undo, place: the first placement sits on the redo stack holding a
    -- suspended object, and the second forks it away.
    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Create", Object = DoorId, Instance = Copy.Id, Properties = {}},
    } :: any), "placed")

    const Made = Copy:GetObjects()[1]
    T:Ok(Made, "made")

    T:Ok(History:Undo(Plr), "undone")
    T:Ok(Made.Suspended, "held against the redo")

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Create", Object = DoorId, Instance = Copy.Id, Properties = {}},
    } :: any), "placed again")

    T:Ok(not History:CanRedo(Plr), "the redo is gone")
    T:Eq(Made.Suspended, nil, "and so is what it was holding")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("clearing ends everything the stacks were holding", function()
    const Scene, Copy = Room("HistoryClear")
    const Plr = Editor(-6005, Scene)
    const Door = Copy:Create(DoorId)

    Objects.Retire(Plr, Door, true)
    T:Ok(Door.Suspended, "held")

    History:Clear(Plr)

    T:Ok(not History:CanUndo(Plr), "the stack is empty")
    T:Eq(Door.Suspended, nil, "and the object it held is gone")

    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("an action of the game's own takes its place in the order", function()
    const Scene, Copy = Room("HistoryCustom")
    const Plr = Editor(-6008, Scene)
    const Door = Copy:Create(DoorId, {[TitleId] = "Start"})

    -- Pushed as the action happens, so it starts where the action left it.
    local Where = "after"
    T:Ok(History:Push(Plr, {
        Undo = function()
            Where = "before"
        end,

        Redo = function()
            Where = "after"
        end,
    }), "pushed")

    -- An edit after it, so the custom step is not the one on top: undoing has
    -- to reach the edit first and the action second, in the order they happened.
    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Set", Target = Door.RuntimeId, Property = TitleId, Value = "Edited", Type = "Text"},
    } :: any), "edited")

    T:Ok(History:Undo(Plr), "the edit undone")
    T:Eq(Door:Get(TitleId), "Start", "the edit went back")
    T:Eq(Where, "after", "and the action has not been reached yet")

    T:Ok(History:Undo(Plr), "the action undone")
    T:Eq(Where, "before", "its Undo ran")

    T:Ok(History:Redo(Plr), "redone")
    T:Eq(Where, "after", "its Redo ran")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a custom action clears when nothing can reach it", function()
    const Scene = Scenes.new({Name = "HistoryCustomClear"})
    const Plr = Editor(-6009, Scene)

    local Held = true
    History:Push(Plr, {
        Undo = function() end,
        Redo = function() end,
        Clear = function()
            Held = false
        end,
    })

    T:Ok(Held, "held while the step is reachable")

    History:Clear(Plr)
    T:Ok(not Held, "and let go when it is not")

    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a custom action that throws stays on the stack", function()
    const Scene = Scenes.new({Name = "HistoryCustomThrow"})
    const Plr = Editor(-6010, Scene)

    History:Push(Plr, {
        Undo = function()
            error("no")
        end,

        Redo = function() end,
    })

    T:Ok(not History:Undo(Plr), "refused")
    T:Ok(History:CanUndo(Plr), "and left where it was, to be tried again")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("what a custom action does while undoing is not a new step", function()
    const Scene, Copy = Room("HistoryCustomQuiet")
    const Plr = Editor(-6011, Scene)
    const Door = Copy:Create(DoorId, {[TitleId] = "Start"})

    History:Push(Plr, {
        Undo = function()
            -- The ordinary API, from inside a reversal. Recording this would
            -- put a step on top of the one being undone, and the stack would
            -- grow every time it was emptied.
            Transactions.Apply(Plr, {
                {Kind = "Set", Target = Door.RuntimeId, Property = TitleId, Value = "Moved", Type = "Text"},
            } :: any)
        end,

        Redo = function() end,
    })

    T:Ok(History:Undo(Plr), "undone")
    T:Eq(Door:Get(TitleId), "Moved", "what it did landed")
    T:Ok(not History:CanUndo(Plr), "and was not recorded as a step of its own")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a step past the limit lets go of what it held", function()
    const Scene, Copy = Room("HistoryLimit")
    const Plr = Editor(-6006, Scene)

    -- One destroy per step, more of them than the stack keeps. The first is the
    -- one pushed off the end.
    const First = Copy:Create(DoorId)
    Objects.Retire(Plr, First, true)
    T:Ok(First.Suspended, "the first is held")

    for _ = 1, 100 do
        Objects.Retire(Plr, Copy:Create(DoorId), true)
    end

    T:Eq(First.Suspended, nil, "and let go once it fell off the stack")
    T:Ok(History:CanUndo(Plr), "while the rest are still there")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

--=============================================================================
-- Placing
--=============================================================================

T:Describe("Placing")

-- A pack holding a door and a button wired to it, for the placing tests to
-- paste around. Built once, in a scene of its own, and committed.
const Prefab = (function(): buffer
    const Scene = Scenes.new({Name = "PrefabSource"}) :: any
    const Copy = Scene:Load()

    const Door = Copy:Create(DoorId, {[TitleId] = "PrefabDoor"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "PrefabButton"})
    Button:Set(TargetId, Door)

    const Pack = Copy:Serialize()
    Scene:Destroy()
    return Pack
end)()

T:Test("a placed pack lands under this copy's own ids", function()
    const Scene, Copy = Room("PlaceRoom")
    const Sitting = Copy:Create(DoorId, {[TitleId] = "Sitting"})

    const Made = Copy:Place(Prefab)
    T:Ok(Made and #Made == 2, "both objects placed")

    if not Made then
        Scene:Destroy()
        return
    end

    T:Eq(#Copy:GetObjects(), 3, "beside what was already there")

    for _, Obj in Made do
        T:Ok(Obj.LocalId ~= Sitting.LocalId, "a fresh id, not the saved one")
        T:Eq(Copy:Find(Obj.LocalId), Obj, "filed under it")
        T:Eq(Obj.InstanceId, Copy.Id, "in this copy")
    end

    Scene:Destroy()
end)

T:Test("references inside a placed pack follow it", function()
    const Scene, Copy = Room("PlaceReferences")
    const Made = Copy:Place(Prefab) :: any

    local Door, Button
    for _, Obj in Made do
        if Obj:Get(TitleId) == "PrefabDoor" then
            Door = Obj
        else
            Button = Obj
        end
    end

    T:Ok(Door and Button, "found both")

    if Door and Button then
        -- The saved id named a door in the scene the pack was written in. What
        -- it names here is whatever the placement made.
        T:Eq(Button:Get(TargetId), Door, "the button works the door it came with")
        T:Ok(Button:GetProperty(TargetId).Value ~= 0, "by a real id")
    end

    Scene:Destroy()
end)

T:Test("placing twice gives two independent sets", function()
    const Scene, Copy = Room("PlaceTwice")

    const First = Copy:Place(Prefab) :: any
    const Second = Copy:Place(Prefab) :: any

    T:Eq(#Copy:GetObjects(), 4, "four objects in the copy")

    local FirstButton, SecondButton
    for _, Obj in First do
        if Obj:Get(TitleId) == "PrefabButton" then
            FirstButton = Obj
        end
    end

    for _, Obj in Second do
        if Obj:Get(TitleId) == "PrefabButton" then
            SecondButton = Obj
        end
    end

    T:Ok(FirstButton and SecondButton, "a button in each")

    if FirstButton and SecondButton then
        T:Ok(FirstButton:Get(TargetId) ~= SecondButton:Get(TargetId), "each works its own door")
        T:Ok(table.find(First, FirstButton:Get(TargetId)) ~= nil, "the door it was placed with")
        T:Ok(table.find(Second, SecondButton:Get(TargetId)) ~= nil, "and likewise")
    end

    Scene:Destroy()
end)

T:Test("a reference the pack did not carry is dropped", function()
    const Source = Scenes.new({Name = "PlaceDangling"}) :: any
    const SourceCopy = Source:Load()

    -- A button whose door is not in the pack: the door is destroyed before the
    -- pack is written, so the reference is an id naming nothing.
    const Door = SourceCopy:Create(DoorId)
    const Button = SourceCopy:Create(ButtonId)
    Button:Set(TargetId, Door)
    const Saved = Door.LocalId
    Door:Destroy()

    const Pack = SourceCopy:Serialize()
    Source:Destroy()

    const Scene, Copy = Room("PlaceDanglingTarget")

    -- Something in the target copy answering to the id the pack carried, which
    -- is the whole hazard: carried over, the placed button would come up wired
    -- to this.
    local Filler = Copy:Create(DoorId, {[TitleId] = "NotYours"})
    while Filler.LocalId < Saved do
        Filler = Copy:Create(DoorId, {[TitleId] = "NotYours"})
    end

    const Made = Copy:Place(Pack) :: any
    T:Ok(Made and #Made == 1, "the button placed")

    if Made and Made[1] then
        T:Eq(Made[1]:Get(TargetId), nil, "pointing at nothing")
        T:Eq(Made[1]:GetProperty(TargetId).Value, 0, "with the empty reference written")
    end

    Scene:Destroy()
end)

T:Test("a client places through create rights, as one step", function()
    const Scene, Copy = Room("PlaceTransaction")
    const Plr = Editor(-6100, Scene)

    -- Built as a client builds it, applied as the player rather than as the
    -- server, so the create rights are the ones actually being asked for.
    const Edit = Transactions.new():Place(Prefab, Copy.Id)
    T:Eq(#Edit.Operations, 2, "one create per object in the pack")

    const Applied, Created = Transactions.Apply(Plr, Edit.Operations)

    T:Ok(Applied, "applied")
    T:Eq(#Created, 2, "both landed")

    const First = Objects:Get(Created[1])
    const Second = Objects:Get(Created[2])
    T:Ok(First and Second, "both are here")

    if First and Second then
        const Button = if First:Get(TitleId) == "PrefabButton" then First else Second
        const Door = if Button == First then Second else First
        T:Eq(Button:Get(TargetId), Door, "wired to the door placed with it")
    end

    -- One transaction, so one step: undoing takes the whole placement back
    -- rather than one object of it.
    T:Ok(History:CanUndo(Plr), "recorded")
    T:Ok(History:Undo(Plr), "undone")
    T:Eq(#Copy:GetObjects(), 0, "the placement went as a unit")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a placement a client is not allowed refuses whole", function()
    const Scene, Copy = Room("PlaceRefused")
    const Plr = Ghost(-6101)

    -- No rights on this scene at all.
    const Applied = Transactions.Apply(Plr, Transactions.new():Place(Prefab, Copy.Id).Operations)

    T:Ok(not Applied, "refused")
    T:Eq(#Copy:GetObjects(), 0, "and placed nothing")

    Scene:Destroy()
end)

--=============================================================================
-- Holds and copies as operations
--=============================================================================

T:Describe("Holds and copies as operations")

T:Test("a transaction takes holds, edits, and lets go", function()
    const Scene, Copy = Room("HoldRoom")
    const Plr = Editor(-6200, Scene)
    const Other = Ghost(-6201)

    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})

    const Applied = Transactions.Apply(Plr, {
        {Kind = "Lock", Target = Door.RuntimeId},
        {Kind = "Set", Target = Door.RuntimeId, Property = TitleId, Value = "Held", Type = "Text"},
    } :: any)

    T:Ok(Applied, "applied")
    T:Eq(Door:Get(TitleId), "Held", "the edit landed")
    T:Eq(Objects:GetLock(Door), -6200, "and the hold is still taken")

    -- Held, so somebody else cannot have it.
    T:Ok(Objects.LockedAgainst(Door, Other), "against everyone else")

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Unlock", Target = Door.RuntimeId},
    } :: any), "released")

    T:Eq(Objects:GetLock(Door), nil, "and let go")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a hold somebody else has refuses the whole transaction", function()
    const Scene, Copy = Room("HoldTaken")
    const Plr = Editor(-6202, Scene)
    const Other = Ghost(-6203)

    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    T:Ok(Objects:Lock({Door}, Other), "somebody else has it")

    const Applied = Transactions.Apply(Plr, {
        {Kind = "Lock", Target = Door.RuntimeId},
        {Kind = "Set", Target = Door.RuntimeId, Property = TitleId, Value = "Mine", Type = "Text"},
    } :: any)

    T:Ok(not Applied, "refused")
    T:Eq(Door:Get(TitleId), "Door", "and the edit that rode with it never landed")

    Objects:Unlock({Door})
    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("holds are not undoable", function()
    const Scene, Copy = Room("HoldHistory")
    const Plr = Editor(-6204, Scene)
    const Door = Copy:Create(DoorId)

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Lock", Target = Door.RuntimeId},
    } :: any), "held")

    -- A lock is not a change to the world, so there is nothing to take back.
    T:Ok(not History:CanUndo(Plr), "nothing recorded")
    T:Eq(Objects:GetLock(Door), -6204, "and the hold stands")

    Objects:Unlock({Door})
    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a client loads a scene through create rights", function()
    const Scene = Scenes.new({Name = "LoadTarget"}) :: any
    const Plr = Editor(-6205, Scene)

    -- Something committed, so the copy it loads is not empty.
    const Seed = Scene:Load()
    Seed:Create(DoorId, {[TitleId] = "Inside"})
    Seed:Commit()
    Seed:Unload()

    T:Eq(#Scene:GetInstances(), 0, "nothing live to begin with")

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Load", Scene = Scene.Id},
    } :: any), "loaded")

    const Live = Scene:GetInstances()[1]
    T:Ok(Live, "a copy appeared")

    if Live then
        T:Eq(#Live:GetObjects(), 1, "holding what the scene had")
    end

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a load without create rights on the scene is refused", function()
    const Scene = Scenes.new({Name = "LoadRefused"}) :: any
    const Plr = Ghost(-6206)

    T:Ok(not Transactions.Apply(Plr, {
        {Kind = "Load", Scene = Scene.Id},
    } :: any), "refused")

    T:Eq(#Scene:GetInstances(), 0, "and loaded nothing")
    Scene:Destroy()
end)

T:Test("an unload withdraws the copy, and undoing brings back what was in it", function()
    const Scene, Copy = Room("UnloadRoom")
    const Plr = Editor(-6207, Scene)

    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId)
    Button:Set(TargetId, Door)

    -- Never committed, so the scene's data holds none of this: reloading would
    -- read nothing, and only a withdrawal can bring it back.
    const CopyId = Copy.Id
    const Folder = Copy.Folder

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Unload", Instance = CopyId},
    } :: any), "unloaded")

    T:Ok(Copy.Suspended, "the copy was kept rather than unloaded")
    T:Eq(Scenes:GetInstance(CopyId), nil, "and is not live")
    T:Ok(Door.Suspended and Button.Suspended, "with its objects held")
    T:Eq(Folder.Parent, nil, "and its folder out of the world")

    T:Ok(History:Undo(Plr), "undone")

    T:Eq(Scenes:GetInstance(CopyId), Copy, "the same copy is live again")
    T:Eq(Copy:Find(Door.LocalId), Door, "holding the same objects")
    T:Eq(Button:Get(TargetId), Door, "still wired to each other")
    T:Eq(Door:Get(TitleId), "Door", "with what they held")
    T:Ok(Folder.Parent ~= nil, "and its folder back in the world")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("a withdrawn copy ends when nothing can reach the step", function()
    const Scene, Copy = Room("UnloadCleared")
    const Plr = Editor(-6208, Scene)
    const Door = Copy:Create(DoorId)

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Unload", Instance = Copy.Id},
    } :: any), "unloaded")

    T:Ok(Copy.Suspended, "held")

    History:Clear(Plr)

    T:Eq(Copy.Suspended, nil, "and let go once nothing could bring it back")
    T:Eq(Door.Suspended, nil, "its objects with it")

    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("undoing a load withdraws the copy it made", function()
    const Scene = Scenes.new({Name = "LoadUndo"}) :: any
    const Plr = Editor(-6209, Scene)

    T:Ok(Transactions.Apply(Plr, {
        {Kind = "Load", Scene = Scene.Id},
    } :: any), "loaded")

    const Live = Scene:GetInstances()[1]
    T:Ok(Live, "a copy appeared")

    T:Ok(History:Undo(Plr), "undone")
    T:Eq(#Scene:GetInstances(), 0, "the copy went")

    if Live then
        T:Ok(Live.Suspended, "withdrawn rather than unloaded")
    end

    T:Ok(History:Redo(Plr), "redone")
    T:Eq(Scene:GetInstances()[1], Live, "and the same copy came back")

    History:Clear(Plr)
    Permissions:Revoke(Plr)
    Scene:Destroy()
end)

T:Test("the four new kinds round trip on the wire", function()
    const Operations = {
        {Kind = "Lock", Target = 11},
        {Kind = "Unlock", Target = 12},
        {Kind = "Load", Scene = 13},
        {Kind = "Unload", Instance = 14},
    }

    const Read = Compressor:DecompressTransaction(Compressor:CompressTransaction(Operations :: any))

    T:Eq(#Read, 4, "four operations")
    T:Eq(Read[1].Kind, "Lock", "lock")
    T:Eq(Read[1].Target, 11, "its target")
    T:Eq(Read[2].Kind, "Unlock", "unlock")
    T:Eq(Read[2].Target, 12, "its target")
    T:Eq(Read[3].Kind, "Load", "load")
    T:Eq(Read[3].Scene, 13, "its scene")
    T:Eq(Read[4].Kind, "Unload", "unload")
    T:Eq(Read[4].Instance, 14, "its copy")
end)

--=============================================================================
-- Client integration fixtures
--=============================================================================

T:Describe("Client integration fixtures")

-- The builder may edit and destroy bare objects, but TestCrate is blacklisted.
-- Keeping all three objects alive lets the client verify both authorization
-- paths as well as object removal without coupling those checks together.
const DeniedFixture = Objects.new(CrateId)
DeniedFixture:Set(TitleId, "FixtureDenied")

-- An object with a part the server builds and a link onto it, in the default
-- scene. The client previews a drag on it and checks its own view of the part
-- follows, which it used to for drawn and local parts only.
Objects.new(ShownId, {[TitleId] = "FixtureDragged"})

-- Held by the server itself for the whole run, under a holder that is not a
-- person. The client checks it refuses an edit to it on the spot rather than
-- showing the edit and snapping back when the server says no.
const HeldFixture = Objects.new(BareId, {[TitleId] = "FixtureHeld"})
Objects:Lock({HeldFixture}, "FixtureAnimator")

const EditableFixture = Objects.new(BareId)
EditableFixture:Set(TitleId, "FixtureEditable")

const DestroyFixture = Objects.new(BareId)
DestroyFixture:Set(TitleId, "FixtureDestroy")

-- A button pointing at a door, both in the default scene so both replicate to
-- everyone. The client resolves the reference from its own index rather than
-- from the copy's, and this is what it resolves.
const ReferenceDoor = Objects.new(DoorId)
ReferenceDoor:Set(TitleId, "FixtureReferenceDoor")

const ReferenceButton = Objects.new(ButtonId)
ReferenceButton:Set(TitleId, "FixtureRefButton")
ReferenceButton:Set(TargetId, ReferenceDoor)

-- Two private scenes, each admitting only user id 1, which nobody running this
-- is, and each holding one object that replicates to everyone and one kept for
-- the admitted. The test player never gets into the first, and the client
-- checks it is sent the first object and neither the second nor the scene's
-- name. The player is admitted to the second as they arrive, and evicted from
-- it when the client writes the evict marker on the editable fixture.
const HiddenCopy = Scenes.new({Name = "FixtureHidden", Private = true, Admitted = {1}}):Load()
HiddenCopy:Create(BareId, {[TitleId] = "FixtureHiddenScenery"})
HiddenCopy:Create(PrivateId, {[TitleId] = "FixtureHiddenPrivate"})

const AdmittedScene = Scenes.new({Name = "FixtureAdmitted", Private = true, Admitted = {1}})
const AdmittedCopy = AdmittedScene:Load()
AdmittedCopy:Create(BareId, {[TitleId] = "FixtureAdmitScenery"})
AdmittedCopy:Create(PrivateId, {[TitleId] = "FixtureAdmitPrivate"})

-- A copy the server opened rather than loaded, holding an object whose template
-- replicates. The server builds no part for it; the test player, admitted as
-- they arrive, draws one.
const OpenedScene = Scenes.new({Name = "FixtureOpened", Private = true, Admitted = {1}})
OpenedScene:Open():Create(ShownId, {[TitleId] = "FixtureOpenedObject"})

-- An opened copy the test player is never admitted to. Its object is created
-- when the client writes the opened marker, after the player has joined: an
-- object already there at join goes down the replay, which always checked, and
-- it was a live create that used to reach every player in the server. A
-- control object follows it into the default scene, so the client knows when
-- the hidden one would have arrived.
const OpenedHiddenCopy = Scenes.new({Name = "FixtureOpenedHidden", Private = true, Admitted = {1}}):Open()

-- A property and a type the client watches go. Registered here so they reach
-- the client with everything else, and unregistered when the client writes the
-- unregister marker, by which point it has seen them arrive.
const DoomedProperty = Properties:Register({Name = "FixtureDoomedProperty", Type = "Text", DefaultValue = ""}) :: number
const DoomedType = Objects:Register({Name = "FixtureDoomedType", Properties = {DoomedProperty}}) :: number

-- What the client holds on a scene it pushes, which its push test checks for.
Scenes:SetPushRole("TestBuilder")

-- Global rights for the budget and pushing, and rights on the default scene,
-- which is where every editable fixture above lives.
const function AssignBuilder(Plr: Player)
    Permissions:Grant(Plr, "TestBuilder")
    Scenes:GetDefault():Grant(Plr, "TestBuilder")
    AdmittedScene:Admit(Plr)
    OpenedScene:Admit(Plr)
end

for _, Plr in Players:GetPlayers() do
    AssignBuilder(Plr)
end
Players.PlayerAdded:Connect(AssignBuilder)

-- A client writes this marker while its Permissions.OnChange listener is
-- attached. The server briefly grants the viewer role on the default scene,
-- then the builder again, so the remaining accepted-edit and destroy tests can
-- proceed deterministically.
EditableFixture:OnChange(TitleId, function(Value)
    if Value == "UnregisterPulse" then
        Objects:Unregister(DoomedType)
        Properties:Unregister(DoomedProperty)
        return
    end

    if Value == "OpenedPulse" then
        OpenedHiddenCopy:Create(ShownId, {[TitleId] = "FixtureOpenedLeak"})
        Objects.new(BareId, {[TitleId] = "FixtureOpenedControl"})
        return
    end

    if Value == "EvictPulse" then
        for _, Plr in Players:GetPlayers() do
            AdmittedScene:Evict(Plr)
        end

        return
    end

    if Value ~= "PermissionPulse" then
        return
    end

    for _, Plr in Players:GetPlayers() do
        Scenes:GetDefault():Grant(Plr, "TestViewer")
        task.delay(0.2, function()
            if Plr.Parent then
                Scenes:GetDefault():Grant(Plr, "TestBuilder")
            end
        end)
    end
end)

T:Test("fixtures are live and carry distinct markers", function()
    T:Eq(DeniedFixture:Get(TitleId), "FixtureDenied", "denied fixture")
    T:Eq(EditableFixture:Get(TitleId), "FixtureEditable", "editable fixture")
    T:Eq(DestroyFixture:Get(TitleId), "FixtureDestroy", "destroy fixture")
    T:Ok(DeniedFixture.Instance, "instance-backed fixture")
    T:Eq(ReferenceButton:Get(TargetId), ReferenceDoor, "reference fixture")
end)

--=============================================================================
-- Try and Encoding
--=============================================================================

T:Describe("Try")

T:Test("returns the value on first success", function()
    const Ok, Value = Try(3, function()
        return "done"
    end)

    T:Ok(Ok, "succeeded")
    T:Eq(Value, "done", "value")
end)

T:Test("retries until it succeeds", function()
    local Calls = 0
    const Ok = Try(5, function()
        Calls += 1
        if Calls < 3 then
            error("not yet")
        end
        return true
    end)

    T:Ok(Ok, "eventually succeeded")
    T:Eq(Calls, 3, "stopped as soon as it worked")
end)

T:Test("gives up and reports failure", function()
    local Calls = 0
    const Ok = Try(3, function()
        Calls += 1
        error("always")
    end)

    T:Ok(not Ok, "failed")
    T:Eq(Calls, 3, "used every attempt")
end)

T:Test("forwards arguments and preserves trailing nils", function()
    const Ok, A, B, C = Try(1, function(X, Y)
        return X, Y, nil
    end, "first", "second")

    T:Ok(Ok, "succeeded")
    T:Eq(A, "first", "first argument")
    T:Eq(B, "second", "second argument")
    T:Eq(C, nil, "trailing nil")
end)

T:Describe("Encoding")

T:Test("base64 round trips through EncodingService", function()
    -- If this fails, the EncodingService signature in src/Encoding.luau needs
    -- correcting; it is the only place that touches the service.
    const Source = buffer.create(8)
    for Index = 0, 7 do
        buffer.writeu8(Source, Index, Index * 31 % 256)
    end

    const Back = Encoding.Decode(Encoding.Encode(Source))
    T:Eq(buffer.len(Back), 8, "length")

    for Index = 0, 7 do
        T:Eq(buffer.readu8(Back, Index), Index * 31 % 256, `byte {Index}`)
    end
end)

T:Test("survives a compressed record", function()
    const Title = Properties.new(TitleId)
    Title:Set("Encoded")

    const Packed = Compressor:CompressMetadatas(1, {
        {Id = 1, SavedVersion = 0, PublishedVersion = 0, Title} :: any,
    })

    const _, Back = Compressor:DecompressMetadatas(Encoding.Decode(Encoding.Encode(Packed)))
    T:Eq(#Back, 1, "record count")
    T:Eq(Back[1][1].Value, "Encoded", "value")
end)

--=============================================================================
-- Database (opt in: writes real DataStore and MemoryStore keys)
--=============================================================================

if RUN_DATABASE then
    T:Describe("Database")

    const Title = Properties.new(TitleId)
    Title:Set("New Level")

    const Plays = Properties.new(PlaysId)
    Plays:Set(0)

    -- ShardLimit is deliberately tiny so the seal path runs after a handful of
    -- records instead of needing three megabytes of them.
    const db = Prism.Database.new({
        Key = DATABASE_KEY,
        InitialMetadata = {Title, Plays},
        ShardLimit = 400,
        Expiration = 1,
    })

    db:RegisterCache("Newest", {IdOrdered = "Desc", PageSize = 3})
    db:RegisterCache("Oldest", {IdOrdered = "Asc", PageSize = 3})
    db:RegisterCache("Popular", {
        PageSize = 3,
        Sort = function(A, B)
            const Left = A[2] and A[2].Value or 0
            const Right = B[2] and B[2].Value or 0
            return Left > Right
        end,
    })

    const Created = {}

    T:Test("creates records with increasing ids", function()
        for Index = 1, 8 do
            const Ok, Id = db:Create()
            T:Ok(Ok, `create {Index}`)

            if Id then
                table.insert(Created, Id)
                -- Annotated: the default solver types a mixed literal by its
                -- first value and then refuses the number.
                const Changes: {[number]: any} = {[TitleId] = `Level {Index}`, [PlaysId] = Index * 10}
                db:Edit(Id, Changes)
            end
        end

        T:Eq(#Created, 8, "all created")
        T:Ok(Created[8] > Created[1], "ids increase")
    end)

    T:Test("reads a record back by id", function()
        db:Refresh()
        const Record = db:GetById(Created[1])
        T:Ok(Record, "found")

        if Record then
            T:Eq(Record.Id, Created[1], "id matches")
            for Index = 1, #Record do
                const Prop = Record[Index]
                if Prop.Parent == TitleId then
                    T:Eq(Prop.Value, "Level 1", "title")
                end
            end
        end
    end)

    T:Test("sharding sealed at least once", function()
        db:Refresh()
        const Page = db:Get("Oldest", 1)
        T:Ok(#Page.Records > 0, "records readable across shards")

        -- Every created id must still be reachable, which only holds if the
        -- boundary lookup and the multi shard walk agree.
        for _, Id in Created do
            T:Ok(db:GetById(Id) ~= nil, `id {Id} still reachable`)
        end
    end)

    T:Test("id ordered paging walks in both directions", function()
        db:Refresh()

        const Newest = db:Get("Newest", 1)
        T:Eq(#Newest.Records, 3, "page size respected")
        T:Ok(Newest.HasMore, "more pages exist")
        T:Eq(Newest.Records[1].Id, Created[8], "newest first")

        -- Records from earlier runs stay in the store (the cleanup below is off),
        -- so the oldest is only known to be no newer than this run's first.
        const Oldest = db:Get("Oldest", 1)
        T:Ok(Oldest.Records[1].Id <= Created[1], "oldest first")
        T:Ok(Oldest.Records[1].Id < Oldest.Records[2].Id, "ascending")
    end)

    T:Test("paging reaches the end cleanly", function()
        db:Refresh()

        const Seen = {}
        local Page = 1

        while Page < 200 do
            const Result = db:Get("Oldest", Page)
            for _, Record in Result.Records do
                T:Ok(not Seen[Record.Id], `id {Record.Id} appears once`)
                Seen[Record.Id] = true
            end

            if not Result.HasMore then
                break
            end

            Page += 1
        end

        -- Earlier runs' records page too, so this checks the ones it made.
        for _, Id in Created do
            T:Ok(Seen[Id], `id {Id} paged`)
        end
        T:Eq(#db:Get("Oldest", 99).Records, 0, "past the end is empty")
    end)

    T:Test("sorted caches order by the comparator", function()
        db:Refresh()
        const Page = db:Get("Popular", 1)
        T:Eq(#Page.Records, 3, "page size")

        const Top = Page.Records[1]
        for Index = 1, #Top do
            const Prop = Top[Index]
            if Prop.Parent == PlaysId then
                T:Eq(Prop.Value, 80, "highest plays first")
            end
        end
    end)

    T:Test("Find filters and honours its limit", function()
        db:Refresh()

        const Matches = db:Find(function(Record)
            for Index = 1, #Record do
                const Prop = Record[Index]
                if Prop.Parent == TitleId and type(Prop.Value) == "string" then
                    return string.find(Prop.Value, "Level", 1, true) ~= nil
                end
            end
            return false
        end, 4)

        T:Eq(#Matches, 4, "stopped at the limit")

        const None = db:Find(function()
            return false
        end)

        T:Eq(#None, 0, "no matches")
    end)

    T:Test("REGRESSION: returned records are frozen", function()
        db:Refresh()
        const Record = db:GetById(Created[1])
        T:Ok(Record, "found")

        if Record then
            -- Must be a valid value that differs from the current one, or Set
            -- returns early without ever attempting to mutate.
            T:Throws(function()
                Record[1]:Set("mutated from outside")
            end, "mutating a cached record")
        end
    end)

    T:Test("edits persist and deletes remove", function()
        T:Ok(db:Edit(Created[2], {[TitleId] = "Edited"}), "edit accepted")
        db:Refresh()

        const Record = db:GetById(Created[2])
        if Record then
            for Index = 1, #Record do
                const Prop = Record[Index]
                if Prop.Parent == TitleId then
                    T:Eq(Prop.Value, "Edited", "edit visible")
                end
            end
        end

        T:Ok(not db:Edit(999999, {[TitleId] = "x"}), "editing a missing id fails")
        T:Ok(not db:Edit(Created[2], {[99999] = "x"}), "unregistered property fails")

        T:Ok(db:Delete(Created[3]), "delete accepted")
        db:Refresh()
        T:Eq(db:GetById(Created[3]), nil, "gone")
        T:Ok(not db:Delete(Created[3]), "second delete fails")
    end)

    T:Test("a deleted id is never handed out again", function()
        const Ok, NewId = db:Create()
        T:Ok(Ok, "created")
        T:Ok(NewId and NewId > Created[8], "counter did not reuse the deleted id")

        if NewId then
            db:Delete(NewId)
        end
    end)

    T:Describe("Database cleanup")

    --T:Test("removes its test keys", function()
    --    for _, Id in Created do
    --        db:Delete(Id)
    --    end

    --    const Store = db.DataStore
    --    for Index = 1, 10 do
    --        pcall(function()
    --            Store:RemoveAsync(`{DATABASE_KEY}:{Index}`)
    --        end)
    --    end

    --    pcall(function()
    --        Store:RemoveAsync("Manifest")
    --    end)

    --    T:Ok(true, "cleanup ran")
    --end)
end

--=============================================================================

-- The template and the three fixtures deliberately remain alive until
-- the play session ends so a late-starting client can receive them via replay.

const Passed = T:Report()
if not Passed then
    error("[ PRISM TEST ] Server suite failed; see the failures above.", 0)
end

if not RUN_DATABASE then
    print("[ PRISM TEST ] Database suite skipped. Set RUN_DATABASE = true to run it.")
end

print("[ PRISM TEST ] Client fixtures are ready; the client half runs on its own.")
]]></ProtectedString>
				<token name="RunContext">1</token>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX57">
			<Properties>
				<string name="Name">Client</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
    Prism test suite -- client half.

    Ships in PrismTests.rbxmx beside the server half, Harness and its own copy
    of Prism, and runs with RunContext Client from wherever the model sits.
    It verifies the things a server-only test cannot: that the ready handshake
    actually delivers, registries and live objects replicate, permissions
    update, and accepted/refused edits converge on the server's decision.

    It waits for the fixture the server script leaves behind, so run both.
]]

const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Running from ReplicatedStorage, this can start before the rest of the model
-- has replicated, and Prism's requires resolve by child name.
if not game:IsLoaded() then
    game.Loaded:Wait()
end

const CRATE_OBJECT = "TestCrate"
const BARE_OBJECT = "TestBare"
const SHOWN_OBJECT = "TestShown"
const PRIVATE_OBJECT = "TestPrivate"
const FIXTURE_PROPERTY = "TestTitle"
const DENIED_MARKER = "FixtureDenied"
const EDITABLE_MARKER = "FixtureEditable"
const DESTROY_MARKER = "FixtureDestroy"
const EVICT_MARKER = "EvictPulse"
const UNREGISTER_MARKER = "UnregisterPulse"
const OPENED_MARKER = "OpenedPulse"
const TIMEOUT = 15

const Prism = require("./Prism")
const Harness = require("./Harness")

const Transactions = Prism.Transactions
const Permissions = Prism.Permissions
const Scenes = Prism.Scenes
const Objects = Prism.Objects
const Properties = Prism.Properties

const T = Harness.new()

--=============================================================================
-- Wait for the handshake to deliver
--=============================================================================

const function FindProperty(Name: string): number?
    for Id, Registry in Properties:GetRegistered() do
        if Registry.Name == Name then
            return Id
        end
    end

    return nil
end

const function FindObjectType(Name: string): number?
    for Id, Registry in Objects:GetRegistered() do
        if Registry.Name == Name then
            return Id
        end
    end

    return nil
end

const function FindLiveObject(TypeId: number, PropertyId: number, Marker: string)
    for _, Obj in Objects:GetWorkspace() do
        if Obj.Registry == TypeId and Obj:Get(PropertyId) == Marker then
            return Obj
        end
    end

    return nil
end

const function WaitFor(What: string, Check: () -> any): any
    const Deadline = os.clock() + TIMEOUT

    while os.clock() < Deadline do
        const Result = Check()
        if Result then
            return Result
        end

        task.wait(0.1)
    end

    warn(`[ PRISM TEST ] Timed out waiting for {What}.`)
    return nil
end

print("[ PRISM TEST ] Waiting for replication...")

const TitleId = WaitFor("property registry", function()
    return FindProperty(FIXTURE_PROPERTY)
end)

const CrateId = WaitFor("crate registry", function()
    return FindObjectType(CRATE_OBJECT)
end)

const BareId = WaitFor("bare registry", function()
    return FindObjectType(BARE_OBJECT)
end)

const ShownId = WaitFor("shown registry", function()
    return FindObjectType(SHOWN_OBJECT)
end)

const PrivateId = WaitFor("private registry", function()
    return FindObjectType(PRIVATE_OBJECT)
end)

const Denied = if CrateId and TitleId
    then WaitFor("denied fixture", function()
        return FindLiveObject(CrateId, TitleId, DENIED_MARKER)
    end)
    else nil

const Editable = if BareId and TitleId
    then WaitFor("editable fixture", function()
        return FindLiveObject(BareId, TitleId, EDITABLE_MARKER)
    end)
    else nil

const Destroyable = if BareId and TitleId
    then WaitFor("destroy fixture", function()
        return FindLiveObject(BareId, TitleId, DESTROY_MARKER)
    end)
    else nil

-- Rights on the default scene, where every editable fixture lives.
const Builder = if Editable
    then WaitFor("TestBuilder rights", function()
        const Rights = Permissions:GetOn(Editable.Scene)
        return if Rights and Rights.Role == "TestBuilder" then Rights else nil
    end)
    else nil

--=============================================================================
-- Replication
--=============================================================================

T:Describe("Replication")

T:Test("the ready handshake delivered the property registry", function()
    T:Ok(TitleId, "property arrived")

    if TitleId then
        const Registry = Properties:GetRegistry(TitleId)
        T:Eq(Registry.Name, FIXTURE_PROPERTY, "name")
        T:Eq(Registry.Type, "Text", "type")
        T:Eq(Registry.DefaultValue, "Untitled", "default value")
        T:Ok(Registry.Constraints, "constraints came across")
    end
end)

T:Test("display metadata came across with the registry", function()
    const Speed = FindProperty("TestSpeed")
    const Spin = FindProperty("TestSpin")
    T:Ok(Speed and Spin, "the displayed properties arrived")

    if not Speed or not Spin then
        return
    end

    const Display = Properties:GetRegistry(Speed).Display
    T:Eq(Display.Category, "Motion", "category")
    T:Eq(Display.Description, "Studs a second", "description")

    const Layout = Properties:Layout({Speed, Spin})
    T:Eq(Layout[1].Properties[1].Id, Spin, "and the client lays it out the same way")
end)

T:Test("the object registries arrived", function()
    T:Ok(CrateId, "object type arrived")
    T:Ok(BareId, "bare type arrived")

    if CrateId then
        const Registry = Objects:GetRegistry(CrateId)
        T:Eq(Registry.Name, CRATE_OBJECT, "crate name")
        T:Ok(#Registry.Properties > 0, "crate property list")
        T:Eq(Registry.Instance, nil, "crate template is not replicated")
    end

    if BareId then
        const Registry = Objects:GetRegistry(BareId)
        T:Eq(Registry.Name, BARE_OBJECT, "bare name")
        T:Ok(#Registry.Properties > 0, "bare property list")
    end
end)

T:Test("the live fixtures arrived with distinct values", function()
    T:Ok(Denied, "denied fixture arrived")
    T:Ok(Editable, "editable fixture arrived")
    T:Ok(Destroyable, "destroy fixture arrived")

    if Denied and TitleId then
        T:Eq(Denied:Get(TitleId), DENIED_MARKER, "value carried through the buffer")
        T:Eq(Denied:Get(FIXTURE_PROPERTY), DENIED_MARKER, "readable by name")
        T:Ok(not Denied.Destroyed, "alive")
        T:Ok(Denied.Properties[TitleId], "property instance rebuilt")
        T:Eq(Denied:GetProperty(FIXTURE_PROPERTY), Denied.Properties[TitleId], "name map built on the client too")
    end
end)

T:Test("the object's instance is reachable", function()
    if not Denied then
        T:Ok(false, "no instance-backed fixture")
        return
    end

    -- Waited on rather than sampled. The object arrives over the remote and the
    -- part over ordinary replication, and when the reference sent beside the
    -- object does not survive the trip the link is rebuilt from the part's own
    -- tag, which lands whenever replication gets to it.
    T:Eventually(function()
        return Denied.Instance ~= nil
    end, 5, "instance came across")

    if Denied.Instance then
        T:Eq(Objects:FromInstance(Denied.Instance), Denied, "mapped back from the part")

        const Child = Instance.new("Part")
        Child.Parent = Denied.Instance
        T:Eq(Objects:FromInstance(Child), Denied, "mapped back from a descendant")
        Child:Destroy()
    end
end)

T:Test("an unrelated instance maps to nothing", function()
    const Stray = Instance.new("Part")
    Stray.Parent = workspace
    T:Eq(Objects:FromInstance(Stray), nil, "not an object")
    Stray:Destroy()
end)

--=============================================================================
-- Admission
--=============================================================================

T:Test("a custom enum registered here late still resolves", function()
    -- The server registers TestShapes and a property constrained to it. This
    -- client registers it only now, after the property arrived, which used to
    -- leave the constraint unresolved for the rest of the session.
    const ShapeId = FindProperty("TestShape")
    T:Ok(ShapeId, "the property arrived")

    if not ShapeId then
        return
    end

    const Prop = Properties.new(ShapeId)
    const Circle = {__type = "CustomEnumOption", Id = 1, Value = "Circle", Parent = "TestShapes"}
    T:Ok(not (Prop:Set(Circle :: any)), "refused while the enum is unknown here")

    const Shapes = Prism.CustomEnum:Register("TestShapes", {Circle = 1, Square = 2, Triangle = 3})
    T:Ok(Shapes, "registered here")

    if not Shapes then
        return
    end

    T:Eventually(function()
        return Properties:GetRegistry(ShapeId).Constraints.CustomEnum == Shapes
    end, 2, "the constraint resolved")

    T:Ok((Prop:Set(Shapes:GetById(2))), "and an option is accepted")
end)

T:Describe("Admission")

T:Test("a scene you were not admitted to sends only what replicates to everyone", function()
    -- The admitted one first, so this does not pass merely because nothing has
    -- arrived yet.
    T:Eventually(function()
        return Scenes:Get("FixtureAdmitted")
    end, 5, "the scene beside it arrived")

    T:Eq(Scenes:Get("FixtureHidden"), nil, "not its name")

    if not BareId or not PrivateId or not TitleId then
        T:Ok(false, "no registries")
        return
    end

    const Scenery = T:Eventually(function()
        return FindLiveObject(BareId, TitleId, "FixtureHiddenScenery")
    end, 5, "its scenery")

    if Scenery then
        T:Eq(Scenes:GetInstanceScene(Scenery.InstanceId), Scenery.Scene, "filed under a copy it was told of")
        T:Eq(Scenes:GetById(Scenery.Scene), nil, "belonging to a scene it was not told the name of")
    end

    T:Eq(FindLiveObject(PrivateId, TitleId, "FixtureHiddenPrivate"), nil, "not what is kept for the admitted")
end)

T:Test("a scene you were admitted to arrives whole", function()
    const Admitted = Scenes:Get("FixtureAdmitted")
    T:Ok(Admitted, "its registry")

    if not Admitted or not BareId or not PrivateId or not TitleId then
        return
    end

    T:Eq(#Scenes:GetInstances(Admitted.Id), 1, "its copy")

    T:Eventually(function()
        return FindLiveObject(BareId, TitleId, "FixtureAdmitScenery")
    end, 5, "its scenery")

    T:Eventually(function()
        return FindLiveObject(PrivateId, TitleId, "FixtureAdmitPrivate")
    end, 5, "and what is kept for the admitted")
end)

T:Test("eviction takes the name and what is kept for the admitted", function()
    const Admitted = Scenes:Get("FixtureAdmitted")
    const Scenery = if BareId and TitleId
        then FindLiveObject(BareId, TitleId, "FixtureAdmitScenery")
        else nil
    const Private = if PrivateId and TitleId
        then FindLiveObject(PrivateId, TitleId, "FixtureAdmitPrivate")
        else nil

    if not Admitted or not Scenery or not Private or not Editable or not TitleId then
        T:Ok(false, "no admitted fixture")
        return
    end

    -- The server evicts this player when the editable fixture carries the
    -- marker, the same way the permission pulse is asked for.
    Editable:Set(TitleId, EVICT_MARKER)

    T:Eventually(function()
        return Scenes:Get("FixtureAdmitted") == nil
    end, 5, "the name went")

    T:Eventually(function()
        return Private.Destroyed
    end, 5, "the private object went")

    T:Ok(not Scenery.Destroyed, "the scenery stayed, because every player is owed it")
    T:Eq(#Scenes:GetInstances(Admitted.Id), 1, "and so did its copy")

    Editable:Set(TitleId, EDITABLE_MARKER)
end)

--=============================================================================
-- Opened copies
--=============================================================================

T:Describe("Opened copies")

T:Test("an opened copy is drawn here, from the replicated template", function()
    if not ShownId or not TitleId then
        T:Ok(false, "no shown registry")
        return
    end

    const Obj = T:Eventually(function()
        return FindLiveObject(ShownId, TitleId, "FixtureOpenedObject")
    end, 5, "the object arrived")

    if not Obj then
        return
    end

    T:Ok(Obj.Drawn, "marked as drawn by this client")
    T:Ok(Obj.Instance, "with a part built here")

    if Obj.Instance then
        T:Eq(Obj.Instance.Parent, Scenes:GetFolder(Obj.InstanceId), "in the folder this client keeps for the copy")
        T:Eq(Obj.Instance:GetAttribute(FIXTURE_PROPERTY), "FixtureOpenedObject", "driven by the links that came with the registry")
        T:Eq(Objects:FromInstance(Obj.Instance), Obj, "and mapped back from the part")
    end
end)

T:Test("a loaded copy is the server's to draw", function()
    if not Editable then
        T:Ok(false, "no editable fixture")
        return
    end

    T:Eq(Scenes:GetFolder(Editable.InstanceId), nil, "so this client keeps no folder for it")
    T:Ok(not Editable.Drawn, "and drew nothing")
end)

T:Test("an object created in an opened copy reaches only the admitted", function()
    if not Editable or not ShownId or not BareId or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    -- The server creates the hidden object and then the control when the
    -- editable fixture carries the marker. Both go down the same remote, so by
    -- the time the control is here the hidden one would have been too.
    task.wait(1.1)
    Editable:Set(TitleId, OPENED_MARKER)

    T:Eventually(function()
        return FindLiveObject(BareId, TitleId, "FixtureOpenedControl")
    end, 5, "the control arrived")

    T:Eq(FindLiveObject(ShownId, TitleId, "FixtureOpenedLeak"), nil, "the object in a copy this player is not admitted to did not")
    T:Eq(Scenes:Get("FixtureOpenedHidden"), nil, "nor the scene's name")

    Editable:Set(TitleId, EDITABLE_MARKER)
end)

T:Test("watching copies hands back a disconnect", function()
    const Disconnect = Scenes:OnCopyAdded(function() end)
    T:Ok(type(Disconnect) == "function", "a function")
    Disconnect()
    Disconnect()
    T:Ok(true, "safe to call twice")
end)

--=============================================================================
-- Locks
--=============================================================================

T:Describe("Locks")

T:Test("a lock is taken, announced and released", function()
    if not Editable or not Builder then
        T:Ok(false, "no editable fixture")
        return
    end

    const Me = game:GetService("Players").LocalPlayer.UserId
    local HeardHeld = false
    local HeardFree = false

    const Stop = Objects:OnLockChanged(function(RuntimeId, UserId)
        if RuntimeId ~= Editable.RuntimeId then
            return
        end

        if UserId == Me then
            HeardHeld = true
        elseif UserId == nil then
            HeardFree = true
        end
    end)

    -- The builder's budget is five a second, and earlier tests spend it.
    task.wait(1.1)

    T:Ok(Objects:Lock(Editable), "locked")

    -- On the answer, not on the broadcast, which travels on the other remote
    -- and used to land after Lock had returned.
    T:Ok(Objects:IsLocked(Editable), "held the moment Lock returns")
    T:Eq(Objects:GetLock(Editable), Me, "by this player")

    T:Eventually(function()
        return Objects:GetLock(Editable) == Me and HeardHeld
    end, 3, "announced back as this player's")

    T:Ok(Objects:Unlock(Editable), "released")
    T:Ok(not Objects:IsLocked(Editable), "free the moment Unlock returns")

    T:Eventually(function()
        return Objects:GetLock(Editable) == nil and HeardFree
    end, 3, "announced free")

    Stop()
end)

T:Test("an object someone else holds refuses an edit on the spot", function()
    if not BareId or not TitleId then
        T:Ok(false, "no bare registry")
        return
    end

    const Held = T:Eventually(function()
        const Obj = FindLiveObject(BareId, TitleId, "FixtureHeld")
        return if Obj and Objects:IsLocked(Obj) then Obj else nil
    end, 5, "the held fixture arrived, held")

    if not Held then
        return
    end

    T:Eq(Objects:GetLock(Held), nil, "by something that is not a person")

    T:Ok(not Held:Set(TitleId, "Grabbed"), "a set is refused")
    T:Eq(Held:Get(TitleId), "FixtureHeld", "and never shown")

    T:Ok(not Held:Set(TitleId, "Grabbed", true), "so is a preview")
    T:Eq(Held:Get(TitleId), "FixtureHeld", "which is not shown either")

    T:Ok(not Held:Destroy(), "and a destroy")
    T:Ok(not Held.Destroyed, "which left it where it was")
end)

T:Test("a transaction's holds are known the moment it returns", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    const Me = game:GetService("Players").LocalPlayer.UserId
    local Heard = 0

    const Stop = Objects:OnLockChanged(function(RuntimeId)
        if RuntimeId == Editable.RuntimeId then
            Heard += 1
        end
    end)

    task.wait(1.1)
    T:Ok(Transactions.new():Lock(Editable):Commit(), "locked through a transaction")
    T:Eq(Objects:GetLock(Editable), Me, "held by this player on return")

    -- The broadcast still comes, and says nothing new.
    task.wait(0.5)
    T:Eq(Heard, 1, "and heard once, not once from the answer and again from the broadcast")

    task.wait(1.1)
    T:Ok(Transactions.new():Set(Editable, TitleId, EDITABLE_MARKER):Unlock(Editable):Commit(), "released through a transaction")
    T:Ok(not Objects:IsLocked(Editable), "free on return")

    Stop()
end)

--=============================================================================
-- Unregistering
--=============================================================================

T:Describe("Unregistering")

T:Test("an unregistered type and property leave the client too", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    const Type = WaitFor("doomed type", function()
        return FindObjectType("FixtureDoomedType")
    end)

    T:Ok(Type, "the type arrived")
    T:Ok(FindProperty("FixtureDoomedProperty"), "and its property")

    -- The server drops both when the editable fixture carries the marker.
    T:Ok(Editable:Set(TitleId, UNREGISTER_MARKER), "asked the server to drop them")

    T:Eventually(function()
        return FindObjectType("FixtureDoomedType") == nil
    end, 5, "the type went")

    T:Eventually(function()
        return FindProperty("FixtureDoomedProperty") == nil
    end, 5, "and so did the property")

    Editable:Set(TitleId, EDITABLE_MARKER)
end)

--=============================================================================
-- Permissions
--=============================================================================

T:Describe("Permissions")

T:Test("the client received its global rights", function()
    const Global = Permissions:Get()
    T:Eq(Global.Role, "TestBuilder", "from the role granted")
    T:Eq(Global.Rate, 5, "its budget")
    T:Ok(Global.CanPush, "its right to push")
    T:Ok(Permissions:Has("TestPublish"), "and its global capability")
end)

T:Test("Can reflects the rights on the object's own scene", function()
    if not Builder or not Editable or not Denied or not BareId then
        T:Ok(false, "no builder rights on the fixtures")
        return
    end

    T:Ok(Permissions:Can("Edit", Editable), "may edit a bare object")
    T:Ok(Permissions:Can("Destroy", Editable), "and destroy one")
    T:Ok(Permissions:Can("Create", {Scene = Editable.Scene, Registry = BareId}), "and create one")
    T:Ok(not Permissions:Can("Edit", Denied), "but a crate is blacklisted")
    T:Ok(Permissions:Get().Capabilities, "capabilities rebuilt as a map")
    T:Ok(Permissions:Has("TestInvite", Editable.Scene), "and the scene's capability")

    -- A scene that has granted this player nothing: the admitted fixture was
    -- admitted, which is not the same thing.
    const Scenery = if TitleId then FindLiveObject(BareId, TitleId, "FixtureAdmitScenery") else nil
    if Scenery then
        T:Ok(not Permissions:Can("Edit", Scenery), "and nothing at all on a scene that granted nothing")
    end
end)

T:Test("OnChange fires when the rights on a scene change", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    const Scene = Editable.Scene
    local SawViewer = false
    const Disconnect = Permissions:OnChange(function(Changed)
        const Rights = if Changed == Scene then Permissions:GetOn(Scene) else nil
        if Rights and Rights.Role == "TestViewer" then
            SawViewer = true
        end
    end)

    T:Ok(type(Disconnect) == "function", "returns a disconnect")
    T:Ok(Editable:Set(TitleId, "PermissionPulse"), "pulse edit accepted locally")
    T:Eventually(function()
        return SawViewer
    end, 3, "viewer grant observed")
    T:Eventually(function()
        const Rights = Permissions:GetOn(Scene)
        return Rights ~= nil and Rights.Role == "TestBuilder"
    end, 3, "builder grant restored")
    Disconnect()
end)

--=============================================================================
-- Client edits
--=============================================================================

T:Describe("Client edits")

T:Test("a denied set applies optimistically, then rolls back", function()
    if not Denied or not TitleId then
        T:Ok(false, "no denied fixture")
        return
    end

    const Before = Denied:Get(TitleId)
    const Accepted = Denied:Set(TitleId, "ShouldBeReverted")

    T:Ok(Accepted, "accepted locally")
    T:Eq(Denied:Get(TitleId), "ShouldBeReverted", "applied without waiting")
    T:Eventually(function()
        return Denied:Get(TitleId) == Before
    end, 3, "server rejection rolled back")
end)

T:Test("an allowed set survives the server round trip", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    -- TestBuilder allows 5 calls a second, and the tests just before this can
    -- spend them. A set past the budget is refused and rolls back, which reads
    -- as this test failing, so start a fresh window first.
    task.wait(1.1)

    T:Ok(Editable:Set(TitleId, "ClientAccepted"), "accepted locally")
    T:Eq(Editable:Get(TitleId), "ClientAccepted", "applied immediately")

    -- A refused invoke rolls back asynchronously; surviving this interval also
    -- verifies the server accepted the edit and broadcast its authoritative value.
    task.wait(1)
    T:Eq(Editable:Get(TitleId), "ClientAccepted", "accepted value survived")
end)

T:Test("an invalid value is refused before it reaches the server", function()
    if not Editable then
        T:Ok(false, "no editable fixture")
        return
    end

    T:Ok(not Editable:Set(99999, "x"), "unknown property")
end)

T:Test("setting the same value twice is a no-op", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    const Current = Editable:Get(TitleId)
    T:Ok(Editable:Set(TitleId, Current), "accepted")
    T:Eq(Editable:Get(TitleId), Current, "unchanged")
end)

-- TestBuilder may spend five actions a second. Thirty frames of a drag sent one
-- by one would be refused from the sixth on; previewed, they cost the one set
-- that ends the drag.
T:Test("a ClientSided drag costs one action and lands where it ends", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    task.wait(1.1)

    const Start = Editable:Get(TitleId)
    local Edits = 0
    local From: any = nil
    const Disconnect = Objects:OnEdited(function(Obj, _, Before)
        if Obj == Editable then
            Edits += 1
            From = Before
        end
    end)

    for Frame = 1, 30 do
        T:Ok(Editable:Set(TitleId, `Drag{Frame}`, true), `frame {Frame} shown`)
    end

    T:Eq(Editable:Get(TitleId), "Drag30", "the preview is on screen")
    T:Eq(Edits, 0, "and nobody was told of an edit")

    -- The last frame's value again, which on screen changes nothing. It has to
    -- be sent anyway: the server has never heard of it.
    T:Ok(Editable:Set(TitleId, "Drag30"), "the drag ends")
    T:Eq(Edits, 1, "one edit")
    T:Eq(From, Start, "starting from before the drag")

    task.wait(1)
    T:Eq(Editable:Get(TitleId), "Drag30", "the server kept it")

    Disconnect()
end)

T:Test("a preview moves a part the server built, on this client", function()
    if not ShownId or not TitleId then
        T:Ok(false, "no shown registry")
        return
    end

    const Dragged = T:Eventually(function()
        const Obj = FindLiveObject(ShownId, TitleId, "FixtureDragged")
        return if Obj and Obj.Instance then Obj else nil
    end, 5, "the object and its part arrived")

    if not Dragged then
        return
    end

    T:Ok(not Dragged.Drawn and not Dragged.Local, "a part the server built")

    -- The link writes the part the moment the preview does. It used to wait
    -- for the server, which a preview never asks.
    T:Ok(Dragged:Set(TitleId, "DragPreview", true), "previewed")
    T:Eq(Dragged.Instance:GetAttribute(FIXTURE_PROPERTY), "DragPreview", "the part shows the preview")

    -- Let go where it started: nothing is sent, and the part goes back.
    T:Ok(Dragged:Set(TitleId, "FixtureDragged"), "cancelled")
    T:Eq(Dragged.Instance:GetAttribute(FIXTURE_PROPERTY), "FixtureDragged", "the part is back")
end)

T:Test("a drag let go where it started sends and records nothing", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    const Start = Editable:Get(TitleId)
    local Edits = 0
    const Disconnect = Objects:OnEdited(function(Obj)
        if Obj == Editable then
            Edits += 1
        end
    end)

    Editable:Set(TitleId, "Wandered", true)
    T:Ok(Editable:Set(TitleId, Start), "cancelled")
    T:Eq(Editable:Get(TitleId), Start, "back where it was")
    T:Eq(Edits, 0, "and no edit was made")

    Disconnect()
end)

T:Test("a refused drag rolls back to before it began", function()
    if not Denied or not TitleId then
        T:Ok(false, "no denied fixture")
        return
    end

    task.wait(1.1)

    const Start = Denied:Get(TitleId)
    for Frame = 1, 10 do
        Denied:Set(TitleId, `Refused{Frame}`, true)
    end

    -- Nothing was sent, so nothing was refused yet: a preview is not judged.
    task.wait(0.5)
    T:Eq(Denied:Get(TitleId), "Refused10", "the preview stands until it ends")

    T:Ok(Denied:Set(TitleId, "Refused10"), "accepted locally")
    T:Eventually(function()
        return Denied:Get(TitleId) == Start
    end, 3, "rolled back to the value before the drag")
end)

T:Test("an allowed destroy tears down the client object", function()
    if not Destroyable then
        T:Ok(false, "no destroy fixture")
        return
    end

    const RuntimeId = Destroyable.RuntimeId
    T:Ok(Destroyable:Destroy(), "server accepted destroy")
    T:Eventually(function()
        return Objects:Get(RuntimeId) == nil and Destroyable.Destroyed
    end, 3, "removal replicated")
    T:Eq(Destroyable:Get(FIXTURE_PROPERTY), nil, "stale getter is safe")
    T:Eq(Destroyable:Set(FIXTURE_PROPERTY, "x"), false, "stale setter is safe")
    T:Eq(Destroyable:GetProperty(FIXTURE_PROPERTY), nil, "stale lookup is safe")
    T:Eq(typeof(Destroyable:OnChange(FIXTURE_PROPERTY, function() end)), "function", "stale watch answers a disconnect")
    T:Eq(Destroyable.Instance, nil, "instance reference released")
end)

--=============================================================================
-- Client transactions
--=============================================================================

T:Describe("Client transactions")

-- TestBuilder's budget is five operations a second and a transaction spends one
-- per operation, so every test that sends one opens a fresh window first.
const function Window()
    task.wait(1.1)
end

local CreatedId: number? = nil

T:Test("a client creates an object, which it cannot do any other way", function()
    if not BareId or not TitleId then
        T:Ok(false, "no bare registry")
        return
    end

    Window()

    const Applied, Created = Transactions.new()
        :Create(BareId, {[TitleId] = "FromClient"})
        :Commit()

    T:Ok(Applied, "the server applied it")
    T:Eq(#Created, 1, "one runtime id came back")

    CreatedId = Created[1]

    const Made = T:Eventually(function()
        return Objects:Get(Created[1])
    end, 5, "the created object replicated back")

    if Made then
        T:Eq(Made:Get(TitleId), "FromClient", "with the value the create carried")
        T:Eq(Made.Registry, BareId, "of the type the create named")
    end
end)

T:Test("a blacklisted type is refused", function()
    if not CrateId then
        T:Ok(false, "no crate registry")
        return
    end

    Window()

    const Applied = Transactions.new():Create(CrateId, {}):Commit()
    T:Ok(not Applied, "refused")
end)

T:Test("a copy that is not live is refused", function()
    if not BareId then
        T:Ok(false, "no bare registry")
        return
    end

    Window()

    const Applied = Transactions.new():Create(BareId, {}, 999999):Commit()
    T:Ok(not Applied, "refused")
end)

T:Test("a set and a destroy land as one edit", function()
    const Made = if CreatedId then Objects:Get(CreatedId) else nil
    if not Made or not TitleId then
        T:Ok(false, "nothing to edit")
        return
    end

    Window()

    const Applied = Transactions.new()
        :Set(Made, TitleId, "EditedThenGone")
        :Destroy(Made)
        :Commit()

    T:Ok(Applied, "applied")
    T:Eventually(function()
        return Objects:Get(CreatedId :: number) == nil and Made.Destroyed
    end, 5, "the removal replicated")
end)

T:Test("an operation that cannot be built never reaches the server", function()
    if not Editable then
        T:Ok(false, "no editable fixture")
        return
    end

    const Edit = Transactions.new():Set(Editable, "NoSuchProperty", "x")

    T:Eq(Edit.Rejected, 1, "refused while building")
    T:Eq(#Edit.Operations, 0, "nothing to send")
    T:Ok(not Edit:Commit(), "commit refused")
end)

T:Test("duplicating a server object builds a create into its copy", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    -- Built, not committed: what goes on the wire is the whole of it.
    const Edit = Transactions.new():Duplicate(Editable)
    const Operation = Edit.Operations[1] :: any

    T:Eq(Edit.Rejected, 0, "built")
    T:Eq(Operation.Kind, "Create", "as a create")
    T:Eq(Operation.Object, Editable.Registry, "of the same type")
    T:Eq(Operation.Instance, Editable.InstanceId, "into its copy")
    T:Eq(Operation.Properties[TitleId], Editable:Get(TitleId), "holding its value")
end)

T:Test("committing nothing succeeds without a round trip", function()
    const Applied, Created = Transactions.new():Commit()
    T:Ok(Applied, "succeeded")
    T:Eq(#Created, 0, "created nothing")
end)

--=============================================================================
-- Scenes this client owns
--=============================================================================

T:Describe("Local scenes")

-- A registry arrives carrying its template and links, and a local object
-- clones, tags and drives that template exactly as a server side object does.
-- Only a template this client can see arrives as anything: TestShown's sits in
-- ReplicatedStorage, TestCrate's in ServerStorage.
const ShownTemplate = ReplicatedStorage:WaitForChild("PrismShownTemplate", TIMEOUT)

T:Test("a registry arrives with its template and links", function()
    const Shown = if ShownId then Objects:GetRegistry(ShownId) else nil
    const Crate = if CrateId then Objects:GetRegistry(CrateId) else nil

    if not Shown or not Crate then
        T:Ok(false, "no registries")
        return
    end

    T:Ok(ShownTemplate, "the template replicated")
    T:Eq(Shown.Instance, ShownTemplate, "and the registry names it")
    T:Ok(Shown.Links and #Shown.Links == 1, "its link came with it")

    T:Eq(Crate.Instance, nil, "a template in ServerStorage arrives as nil")
    T:Ok(Crate.HasTemplate, "while the registry says there is one")
    T:Ok(Crate.Links and #Crate.Links == 2, "its links still arrive, and drive nothing without it")
end)

T:Test("a local scene loads a copy and builds objects in it", function()
    const Sandbox = Scenes.new({Name = "ClientSandbox"})
    T:Ok(Sandbox, "registered")

    if not Sandbox then
        return
    end

    T:Eq(Scenes:GetLocal("ClientSandbox"), Sandbox, "reachable by name")
    T:Eq(Scenes.new({Name = "ClientSandbox"}), nil, "a second scene cannot take the name")

    const Copy = Sandbox:Load()
    T:Ok(Copy, "loaded a copy")

    const Obj = Copy:Create(ShownId, {[TitleId] = "Local"})
    T:Ok(Obj, "created")
    T:Ok(Obj.Local, "marked as this client's own")
    T:Eq(Obj:Get(TitleId), "Local", "initial value applied")
    T:Eq(Obj.LocalId, 1, "first local id")
    T:Eq(Obj.Scene, Sandbox.Id, "stamped with its scene")
    T:Eq(Copy:Find(1), Obj, "the copy answers for it")
    T:Eq(Objects:Get(Obj.RuntimeId), Obj, "and so does the workspace")

    -- Local runtime ids count down from the top; the server's count up from
    -- one, and this client is holding both kinds at once.
    T:Ok(Obj.RuntimeId > 4000000000, "runtime id came from the local end of the space")

    T:Ok(Obj.Instance, "cloned the template it was handed")

    if Obj.Instance then
        T:Eq(Obj.Instance.Parent, Copy.Folder, "parented into the copy's folder")
        T:Ok(Obj.Instance ~= ShownTemplate, "not the template itself")
        T:Eq(Obj.Instance:GetAttribute(FIXTURE_PROPERTY), "Local", "the link drove the attribute")
        T:Eq(Objects:FromInstance(Obj.Instance), Obj, "and maps back from the part")
    end

    Sandbox:Destroy()
end)

T:Test("an edit applies on the spot and nothing takes it back", function()
    const Sandbox = Scenes.new({Name = "ClientEdits"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(ShownId, {[TitleId] = "Before"})

    T:Ok(Obj:Set(TitleId, "After"), "accepted")
    T:Eq(Obj:Get(TitleId), "After", "applied immediately")

    if Obj.Instance then
        T:Eq(Obj.Instance:GetAttribute(FIXTURE_PROPERTY), "After", "the link followed it")
    end

    -- A refused set on a replicated object rolls back within a round trip.
    -- There is no round trip here, and this is what that means.
    task.wait(1)
    T:Eq(Obj:Get(TitleId), "After", "still what it was set to")

    T:Ok(not Obj:Set(99999, "x"), "an unknown property is still refused")

    Sandbox:Destroy()
end)

T:Test("a copy serialises and reads back under the same ids", function()
    const Sandbox = Scenes.new({Name = "ClientRoundTrip"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const First = Copy:Create(BareId, {[TitleId] = "One"})
    const Second = Copy:Create(BareId, {[TitleId] = "Two"})
    const Persistent = Second.PersistentId

    Copy:Commit()
    Copy:Unload()

    T:Eq(Objects:Get(First.RuntimeId), nil, "unloading took its objects")
    T:Ok(First.Destroyed, "and tore them down")

    const Reloaded = Sandbox:Load()
    const Back = Reloaded:Find(2)

    T:Ok(Back, "the second object came back")

    if Back then
        T:Eq(Back:Get(TitleId), "Two", "with its value")
        T:Eq(Back.PersistentId, Persistent, "under the identity it was saved with")
        T:Ok(Back.RuntimeId ~= Second.RuntimeId, "but a new live identity")
    end

    -- The counter rode along in the pack, so a fresh object cannot answer to a
    -- name one of the restored ones already holds.
    T:Eq(Reloaded:Create(BareId).LocalId, 3, "the counter continued")

    Sandbox:Destroy()
end)

-- A level written by a build that had a type and a property this one does not.
T:Test("what this build cannot read survives a local save", function()
    const Compressor = Prism.Compressor
    const Foreign = Compressor:CompressScene(2, {
        {
            __type = "DecompressedObject",
            LocalId = 1,
            Registry = BareId,
            Properties = {[TitleId] = "Known"},
            Unknown = {[99991] = Compressor:CompressValue("Text", "FromElsewhere")},
        },
        {
            __type = "DecompressedObject",
            LocalId = 2,
            Registry = 99990,
            Properties = {[TitleId] = "Stranger"},
        },
    } :: any)

    const Sandbox = Scenes.fromBuffer({Name = "ClientForeign"}, Foreign)
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    T:Eq(#Copy:GetObjects(), 1, "only the known object was built")
    T:Eq(#Copy.Unknown, 1, "the other was kept")

    const Obj = Copy:Find(1)
    T:Ok(Obj and Obj.Unknown and Obj.Unknown[99991], "and so was the unreadable value")

    Copy:Commit()

    const _, Back = Compressor:DecompressScene(Sandbox:Serialize())
    T:Eq(#Back, 2, "both objects are still in the pack")
    T:Eq(Back[2] and Back[2].Registry, 99990, "the unknown one under its own type")
    T:Ok(Back[1] and Back[1].Unknown and Back[1].Unknown[99991], "the unreadable value too")

    Sandbox:Destroy()
end)

T:Test("loading twice gives two copies that do not touch each other", function()
    const Sandbox = Scenes.new({Name = "ClientTwice"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    Copy:Create(BareId, {[TitleId] = "Original"})
    Copy:Commit()
    Copy:Unload()

    const A = Sandbox:Load()
    const B = Sandbox:Load()

    T:Ok(A.Id ~= B.Id, "two copies")
    T:Ok(A:Find(1) ~= B:Find(1), "each holds its own object")
    T:Eq(A:Find(1).PersistentId, B:Find(1).PersistentId, "agreeing on what it is")
    T:Eq(#Sandbox:GetInstances(), 2, "the scene knows about both")

    A:Unload()
    T:Ok(B:Find(1) and not B:Find(1).Destroyed, "unloading one leaves the other alone")

    Sandbox:Destroy()
    T:Eq(Scenes:GetLocal("ClientTwice"), nil, "destroying takes the scene with it")
end)

T:Test("destroying a local object takes its part with it", function()
    const Sandbox = Scenes.new({Name = "ClientDestroy"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(ShownId)
    const Part = Obj.Instance

    T:Ok(Part, "built with a part")
    T:Ok(Obj:Destroy(), "destroyed")
    T:Ok(Obj.Destroyed, "marked")
    T:Eq(Objects:Get(Obj.RuntimeId), nil, "out of the workspace")
    T:Eq(Copy:Find(Obj.LocalId), nil, "out of the copy")

    if Part then
        T:Eq(Part.Parent, nil, "the part it owned went with it")
    end

    Sandbox:Destroy()
end)

T:Test("a local object duplicates into its own copy", function()
    const Sandbox = Scenes.new({Name = "ClientDuplicate"})
    if not Sandbox or not ShownId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Original = Copy:Create(ShownId, {[TitleId] = "Original"})
    const Twin = Objects:Duplicate(Original)

    T:Ok(Twin and Twin.Local, "a local object")

    if Twin then
        T:Eq(Twin:Get(TitleId), "Original", "holding the original's value")
        T:Eq(Copy:Find(Twin.LocalId), Twin, "filed in the same copy")
        T:Ok(Twin.Instance and Twin.Instance ~= Original.Instance, "with a part of its own")
    end

    if Editable then
        T:Eq(Objects:Duplicate(Editable), nil, "a server object is a transaction's to duplicate")
    end

    Sandbox:Destroy()
end)

T:Test("objects appearing and going are announced", function()
    const Sandbox = Scenes.new({Name = "ClientSignals"})
    if not Sandbox or not BareId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    local Added: any = nil
    local Removed: any = nil

    const StopAdded = Objects:OnAdded(function(Obj)
        Added = Obj
    end)

    const StopRemoved = Objects:OnRemoved(function(Obj)
        Removed = Obj
    end)

    const Obj = Copy:Create(BareId)
    T:Eventually(function()
        return Added == Obj
    end, 2, "added fired with the object")
    T:Eq(Objects:Get(Obj.RuntimeId), Obj, "already filed when told")

    Obj:Destroy()
    T:Eventually(function()
        return Removed == Obj
    end, 2, "removed fired with it")
    T:Ok(Removed and Removed.Destroyed, "already torn down when told")

    StopAdded()
    StopRemoved()
    StopAdded()

    const Later = Copy:Create(BareId)
    task.wait(0.2)
    T:Ok(Added ~= Later, "a disconnected listener hears nothing more")

    Sandbox:Destroy()
end)

T:Test("creating without a copy of your own is refused", function()
    T:Throws(function()
        Objects.new(BareId, nil, nil)
    end, "no local copy named")
end)

T:Test("a local scene is handed to the server as a pack", function()
    const Sandbox = Scenes.new({Name = "ClientPush"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    Copy:Create(BareId, {[TitleId] = "Handed over"})
    Copy:Commit()

    Window()

    const Accepted, Identifier = Sandbox:Push("ClientPushedRoom")
    T:Ok(Accepted, "the server took it")
    T:Ok(Identifier and Identifier > 0, "and answered with its id")

    -- It registers on the server admitting only its author, which is this
    -- client, so its registry comes back here and nowhere else.
    T:Eventually(function()
        return Scenes:Get("ClientPushedRoom")
    end, 5, "the scene came back as one of the server's")

    T:Eventually(function()
        const Pushed = Scenes:Get("ClientPushedRoom")
        const Rights = if Pushed then Permissions:GetOn(Pushed.Id) else nil
        return Rights ~= nil and Rights.Role == "TestBuilder"
    end, 5, "and this client holds the push role on it")

    T:Ok(Scenes:GetLocal("ClientPush"), "and the local one is still local")
    T:Ok(Copy:Find(1), "still holding its own objects")

    Sandbox:Destroy()
end)

--=============================================================================

--=============================================================================
-- References
--=============================================================================

T:Describe("References")

const DoorId = FindObjectType("TestDoor")
const ButtonId = FindObjectType("TestButton")
const TargetId = FindProperty("TestTarget")
const DoorOnlyId = FindProperty("TestDoorOnly")

T:Test("a replicated reference resolves to the object it names", function()
    if not DoorId or not ButtonId or not TargetId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Door = WaitFor("reference door", function()
        return FindLiveObject(DoorId, TitleId, "FixtureReferenceDoor")
    end)

    const Button = WaitFor("reference button", function()
        return FindLiveObject(ButtonId, TitleId, "FixtureRefButton")
    end)

    if not Door or not Button then
        T:Ok(false, "fixtures never arrived")
        return
    end

    -- The id came across as a plain number inside the object, and this side
    -- resolved it through its own index of the same copy.
    T:Eq(Button:GetProperty(TargetId).Value, Door.LocalId, "the id came across")
    T:Eq(Button:Get(TargetId), Door, "and reads back as the door")
    T:Eq(Door.InstanceId, Button.InstanceId, "both in the copy the server put them in")
end)

T:Test("a reference in a local scene behaves as it does on the server", function()
    if not DoorId or not ButtonId or not TargetId or not DoorOnlyId then
        T:Ok(false, "not registered")
        return
    end

    const Sandbox = Scenes.new({Name = "ClientReferences"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})

    T:Ok(Button:Set(TargetId, Door), "takes the object")
    T:Eq(Button:Get(TargetId), Door, "and hands it back")
    T:Eq(Button:GetProperty(TargetId).Value, Door.LocalId, "storing the local id")

    T:Ok(not Button:Set(DoorOnlyId, Button), "a constrained reference refuses the wrong type")
    T:Ok(Button:Set(DoorOnlyId, Door), "and takes the right one")

    Door:Destroy()
    T:Eq(Button:Get(TargetId), nil, "a destroyed target reads as nothing")
    T:Ok(Button:GetProperty(TargetId).Value ~= 0, "while the id stays")

    Sandbox:Destroy()
end)

T:Test("a reference survives a local commit and reload", function()
    if not DoorId or not ButtonId or not TargetId then
        T:Ok(false, "not registered")
        return
    end

    const Sandbox = Scenes.new({Name = "ClientReferencesSaved"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)

    Copy:Commit()
    Copy:Unload()

    const Reloaded = Sandbox:Load()
    const Back = Reloaded:Find(Button.LocalId)

    T:Ok(Back, "the button came back")

    if Back then
        T:Eq(Back:Get(TargetId), Reloaded:Find(Door.LocalId), "still pointing at the door")
    end

    Sandbox:Destroy()
end)

T:Test("a group duplicate remaps what points inside it", function()
    if not DoorId or not ButtonId or not TargetId then
        T:Ok(false, "not registered")
        return
    end

    const Sandbox = Scenes.new({Name = "ClientReferencesGroup"})
    if not Sandbox then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Door = Copy:Create(DoorId, {[TitleId] = "Door"})
    const Button = Copy:Create(ButtonId, {[TitleId] = "Button"})
    Button:Set(TargetId, Door)

    const Alone = Objects:Duplicate(Button)
    T:Eq(Alone:Get(TargetId), Door, "one on its own keeps the original target")

    const Made = Objects:DuplicateGroup({Button, Door})
    T:Eq(#Made, 2, "both were made")

    if #Made == 2 then
        T:Eq(Made[1]:Get(TargetId), Made[2], "and the copy points at the copy")
        T:Eq(Button:Get(TargetId), Door, "the original is untouched")
    end

    Sandbox:Destroy()
end)

--=============================================================================
-- History
--=============================================================================

T:Describe("History")

const History = Prism.History

T:Test("a ClientSided drag is one step however long it pauses", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryDrag"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(BareId, {[TitleId] = "Start"})
    History:Clear()

    -- Longer than the merge window: sent as plain sets, this would be two.
    Obj:Set(TitleId, "Held", true)
    T:Ok(not History:CanUndo(), "a preview records nothing")
    task.wait(1.2)
    Obj:Set(TitleId, "Released", true)
    Obj:Set(TitleId, "Released")

    T:Ok(History:Undo(), "undone")
    T:Eq(Obj:Get(TitleId), "Start", "back to before the drag")
    T:Ok(not History:CanUndo(), "which was one step")

    -- Let go where it began: no step at all.
    History:Clear()
    Obj:Set(TitleId, "Elsewhere", true)
    Obj:Set(TitleId, "Start")
    T:Ok(not History:CanUndo(), "a cancelled drag is not an action")

    History:Clear()
    Sandbox:Destroy()
end)

T:Test("this client's own steps are capped by what they hold", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryWeight"})
    if not Sandbox or not BareId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Limits = History:GetLimits()
    History:Clear()
    History:SetLimits({Objects = 2})

    -- Three creates, one object held each once undone or kept.
    const Made = {}
    for Index = 1, 3 do
        Made[Index] = Copy:Create(BareId)
    end

    T:Ok(History:Undo(), "one")
    T:Ok(History:Undo(), "two")
    T:Ok(not History:CanUndo(), "and the oldest create was let go")
    T:Ok(not Made[1].Destroyed, "which leaves its object where it was")

    History:SetLimits(Limits)
    History:Clear()
    Sandbox:Destroy()
end)

T:Test("a run of sets in a local scene is one step", function()
    const Sandbox = Scenes.new({Name = "ClientHistory"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(BareId, {[TitleId] = "Start"})

    -- Creating is a step of its own now, and this test is about the sets.
    History:Clear()

    -- Two sets back to back are one drag.
    Obj:Set(TitleId, "A")
    Obj:Set(TitleId, "B")
    T:Ok(History:CanUndo(), "recorded")

    T:Ok(History:Undo(), "undone")
    T:Eq(Obj:Get(TitleId), "Start", "back to before the run")
    T:Ok(not History:CanUndo(), "which was one step")

    T:Ok(History:Redo(), "redone")
    T:Eq(Obj:Get(TitleId), "B", "forward to where the run ended")

    -- A pause ends the run.
    task.wait(1.1)
    Obj:Set(TitleId, "C")
    T:Ok(History:Undo(), "the later edit undone on its own")
    T:Eq(Obj:Get(TitleId), "B", "leaving the run in place")

    -- A change from elsewhere since is left alone. Setting the property itself
    -- goes around Object:Set, the way a change arriving from the server does.
    T:Ok(History:Redo(), "redone again")
    Obj.Properties[TitleId]:Set("Theirs")
    T:Ok(History:Undo(), "the undo still goes through")
    T:Eq(Obj:Get(TitleId), "Theirs", "without writing over it")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("a create in a local scene undoes as the same object", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryCreate"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    History:Clear()

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(BareId, {[TitleId] = "Placed"})
    const RuntimeId = Obj.RuntimeId
    const LocalId = Obj.LocalId

    T:Ok(History:CanUndo(), "creating was recorded")

    T:Ok(History:Undo(), "undone")
    T:Ok(Obj.Suspended, "the object is held rather than ended")
    T:Eq(Copy:Find(LocalId), nil, "and gone from the copy")

    T:Ok(History:Redo(), "redone")

    -- The same table, under the same ids: the whole reason a create is undone
    -- by withdrawing rather than destroying.
    T:Eq(Objects:Get(RuntimeId), Obj, "back as itself")
    T:Eq(Copy:Find(LocalId), Obj, "under its own local id")
    T:Eq(Obj:Get(TitleId), "Placed", "still holding what it held")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("a destroy in a local scene undoes, and Clear ends it", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryDestroy"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(BareId, {[TitleId] = "Doomed"})
    const LocalId = Obj.LocalId
    History:Clear()

    T:Ok(Obj:Destroy(), "destroyed")
    T:Ok(Obj.Suspended, "kept rather than ended")

    T:Ok(History:Undo(), "undone")
    T:Eq(Copy:Find(LocalId), Obj, "back as itself")
    T:Eq(Obj:Get(TitleId), "Doomed", "with what it held")

    -- Redo puts the destroy back on the undo stack, so acting again forks
    -- nothing away: the step can still be undone, and it keeps the object.
    T:Ok(History:Redo(), "redone")
    T:Ok(Obj.Suspended, "held again")

    Copy:Create(BareId, {[TitleId] = "Later"})
    T:Ok(Obj.Suspended, "still held by the step under the new one")

    -- Clear is what lets go of it.
    History:Clear()
    T:Eq(Obj.Suspended, nil, "and what it held is gone for good")

    Sandbox:Destroy()
end)

T:Test("a local transaction applies here and is one step", function()
    const Sandbox = Scenes.new({Name = "ClientLocalTransaction"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Standing = Copy:Create(BareId, {[TitleId] = "Standing"})
    History:Clear()

    const Applied, Created = Transactions.new()
        :Create(BareId, {[TitleId] = "One"}, Copy.Id)
        :Create(BareId, {[TitleId] = "Two"}, Copy.Id)
        :Set(Standing, TitleId, "Moved")
        :Commit()

    -- No round trip: a scene this client owns is this client's to edit, so
    -- Commit has already done it by the time it returns.
    T:Ok(Applied, "applied")
    T:Eq(#Created, 2, "two created")
    T:Eq(Standing:Get(TitleId), "Moved", "and the set landed")
    T:Eq(#Copy:GetObjects(), 3, "three objects in the copy")

    T:Ok(History:CanUndo(), "recorded")
    T:Ok(History:Undo(), "undone")

    T:Eq(#Copy:GetObjects(), 1, "the whole edit went back at once")
    T:Eq(Standing:Get(TitleId), "Standing", "including the set")

    T:Ok(History:Redo(), "redone")
    T:Eq(#Copy:GetObjects(), 3, "and came back at once")
    T:Eq(Standing:Get(TitleId), "Moved", "set and all")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("a transaction cannot mix a local scene with the server's", function()
    const Sandbox = Scenes.new({Name = "ClientMixed"})
    if not Sandbox or not BareId or not TitleId or not Editable then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Mine = Copy:Create(BareId, {[TitleId] = "Mine"})

    -- Half of this would have to be asked for and could come back refused, with
    -- the other half already applied. There is no atomicity to be had, so it is
    -- refused where it is built rather than half done.
    const Edit = Transactions.new()
        :Set(Mine, TitleId, "Local")
        :Set(Editable, TitleId, "Server")

    T:Ok(Edit.Rejected > 0, "the second kind was rejected")
    T:Ok(not Edit:Commit(), "and it refuses to commit")
    T:Eq(Mine:Get(TitleId), "Mine", "nothing applied")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("a local transaction destroys as one step, and undoes as the same objects", function()
    const Sandbox = Scenes.new({Name = "ClientLocalDestroy"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const First = Copy:Create(BareId, {[TitleId] = "First"})
    const Second = Copy:Create(BareId, {[TitleId] = "Second"})
    History:Clear()

    T:Ok(Transactions.new():Destroy(First):Destroy(Second):Commit(), "applied")
    T:Ok(First.Suspended and Second.Suspended, "both kept rather than ended")
    T:Eq(#Copy:GetObjects(), 0, "and both gone")

    T:Ok(History:Undo(), "undone")
    T:Eq(Copy:Find(First.LocalId), First, "the same object back")
    T:Eq(Copy:Find(Second.LocalId), Second, "and the other")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("a pack places into a copy this client owns", function()
    const Source = Scenes.new({Name = "ClientPlaceSource"})
    if not Source or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const SourceCopy = Source:Load()
    SourceCopy:Create(BareId, {[TitleId] = "PackOne"})
    SourceCopy:Create(BareId, {[TitleId] = "PackTwo"})
    const Pack = SourceCopy:Serialize()
    Source:Destroy()

    const Target = Scenes.new({Name = "ClientPlaceTarget"})
    if not Target then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Target:Load()
    const Sitting = Copy:Create(BareId, {[TitleId] = "Sitting"})

    const Made = Copy:Place(Pack)
    T:Ok(Made and #Made == 2, "both objects placed")

    if Made then
        T:Eq(#Copy:GetObjects(), 3, "beside what was already there")

        for _, Obj in Made do
            T:Ok(Obj.LocalId ~= Sitting.LocalId, "under a fresh id")
            T:Eq(Copy:Find(Obj.LocalId), Obj, "filed under it")
            T:Ok(Obj.Local, "and owned by this client")
        end
    end

    -- One step per object: copy:Place creates them one at a time and the
    -- history records each. Placing as a single step is what the transaction
    -- form is for -- Transactions.new():Place(pack, copy.Id) -- and Scenes
    -- cannot reach for that itself without requiring the module that now
    -- requires it.
    T:Ok(History:Undo(), "undone")
    T:Eq(#Copy:GetObjects(), 2, "one object at a time")

    Target:Destroy()
    History:Clear()
end)

T:Test("a local scene loading its own pack is not a step", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryLoad"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    Copy:Create(BareId, {[TitleId] = "One"})
    Copy:Create(BareId, {[TitleId] = "Two"})
    Copy:Commit()
    Copy:Unload()

    History:Clear()
    Sandbox:Load()

    -- Reading a pack back is not something anybody did, and a level of five
    -- hundred objects is not five hundred undo steps.
    T:Ok(not History:CanUndo(), "nothing recorded")

    Sandbox:Destroy()
    History:Clear()
end)

T:Test("an action of the game's own sits in the same order", function()
    const Sandbox = Scenes.new({Name = "ClientHistoryCustom"})
    if not Sandbox or not BareId or not TitleId then
        T:Ok(false, "not registered")
        return
    end

    const Copy = Sandbox:Load()
    const Obj = Copy:Create(BareId, {[TitleId] = "Start"})
    History:Clear()

    -- Pushed as the action happens, so it starts where the action left it.
    local Where = "after"
    local Held = true

    T:Ok(History:Push({
        Undo = function()
            Where = "before"
        end,

        Redo = function()
            Where = "after"
        end,

        Clear = function()
            Held = false
        end,
    }), "pushed")

    -- An edit after it, so the action is not the one on top.
    Obj:Set(TitleId, "Edited")

    T:Ok(History:Undo(), "the edit undone")
    T:Eq(Obj:Get(TitleId), "Start", "the edit went back")
    T:Eq(Where, "after", "and the action has not been reached yet")

    T:Ok(History:Undo(), "the action undone")
    T:Eq(Where, "before", "its Undo ran")

    T:Ok(History:Redo(), "and redone")
    T:Eq(Where, "after", "its Redo ran")

    T:Ok(Held, "still holding what it holds")
    History:Clear()
    T:Ok(not Held, "and let go when nothing can reach it")

    Sandbox:Destroy()
end)

T:Test("a custom action that throws stays on the stack", function()
    History:Clear()

    T:Ok(History:Push({
        Undo = function()
            error("no")
        end,

        Redo = function() end,
    }), "pushed")

    T:Ok(not History:Undo(), "refused")
    T:Ok(History:CanUndo(), "and left where it was")

    History:Clear()
end)

T:Test("a custom action needs both verbs", function()
    History:Clear()
    T:Ok(not History:Push({Undo = function() end} :: any), "refused without a Redo")
    T:Ok(not History:CanUndo(), "and nothing was recorded")
end)

T:Test("clearing lands in order with the edits around it", function()
    if not Editable or not TitleId then
        T:Ok(false, "no editable fixture")
        return
    end

    -- An edit straight after a clear. The clear used to cross on the remote
    -- event and the set on the remote function, and the clear landed second
    -- and wiped the step the set had just made.
    Window()
    History:Clear()
    Editable:Set(TitleId, "ClearedBefore")

    T:Eventually(function()
        return History:CanUndo()
    end, 3, "the edit after the clear was recorded")

    task.wait(0.5)
    T:Ok(History:CanUndo(), "and stayed recorded")

    -- And the other way round: an edit straight before a clear is cleared.
    Window()
    Editable:Set(TitleId, EDITABLE_MARKER)
    History:Clear()

    task.wait(1)
    T:Ok(not History:CanUndo(), "the edit before the clear went with it")
end)

T:Test("a transaction is a step the server keeps", function()
    if not BareId or not TitleId then
        T:Ok(false, "no bare registry")
        return
    end

    History:Clear()
    Window()

    const Applied, Created = Transactions.new()
        :Create(BareId, {[TitleId] = "Undoable"})
        :Commit()

    T:Ok(Applied, "created")

    const Made = Created[1]
    T:Eventually(function()
        return Made and Objects:Get(Made)
    end, 3, "the object arrived")

    -- Recorded on the server, which tells this side where the step sits in the
    -- order and nothing else about it.
    T:Eventually(function()
        return History:CanUndo()
    end, 3, "and the commit was recorded")

    Window()
    T:Ok(History:Undo(), "undone")
    T:Eventually(function()
        return Objects:Get(Made) == nil
    end, 3, "the create was taken back")

    Window()
    T:Ok(History:Redo(), "redone")

    const Again = T:Eventually(function()
        return FindLiveObject(BareId, TitleId, "Undoable")
    end, 3, "made again")

    if Again then
        -- The same object, not a replacement: the server withdrew it rather
        -- than destroying it, so it came back under the id it always had.
        T:Eq(Again.RuntimeId, Made, "under the same runtime id")
        Window()
        Again:Destroy()
    end

    History:Clear()
end)

T:Test("a lone destroy of a server object is undoable", function()
    if not BareId or not TitleId then
        T:Ok(false, "no bare registry")
        return
    end

    History:Clear()
    Window()

    const Applied, Created = Transactions.new()
        :Create(BareId, {[TitleId] = "Loner"})
        :Commit()

    T:Ok(Applied, "created")

    const Made = Created[1]
    const Obj = T:Eventually(function()
        return Made and Objects:Get(Made)
    end, 3, "the object arrived")

    if not Obj then
        return
    end

    History:Clear()
    Window()

    -- Object:Destroy on its own, which used to be the one edit nothing could
    -- take back: it goes down a channel of its own, and the stack that records
    -- it is now on the side that channel lands on.
    T:Ok(Obj:Destroy(), "destroyed")
    T:Eventually(function()
        return Objects:Get(Made) == nil
    end, 3, "gone")

    T:Eventually(function()
        return History:CanUndo()
    end, 3, "and recorded")

    Window()
    T:Ok(History:Undo(), "undone")

    const Back = T:Eventually(function()
        return Objects:Get(Made)
    end, 3, "back again")

    if Back then
        T:Eq(Back.RuntimeId, Made, "as the same object")
        Window()
        Back:Destroy()
    end

    History:Clear()
end)

--=============================================================================

if not T:Report() then
    error("[ PRISM TEST ] Client suite failed; see the failures above.", 0)
end
